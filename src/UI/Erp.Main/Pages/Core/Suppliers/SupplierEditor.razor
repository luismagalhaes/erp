@page "/suppliers/new"
@page "/suppliers/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@(IsNew ? Localizer["SupplierEditor_NewTitle"] : Localizer["SupplierEditor_EditTitle"])</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="@(IsNew ? Localizer["SupplierEditor_NewTitle"] : Localizer["SupplierEditor_EditTitle"])"
                Breadcrumbs="Breadcrumbs">
        <Actions>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("suppliers"))">
                @Localizer["Common_Back"]
            </MudButton>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @* Without this the button would just sit disabled with nothing explaining why. *@
    @if (!Company.HasCompany)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            @Localizer["SupplierEditor_NoCompanyWarning"]
        </MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <EditorCard Title="@Localizer["SupplierEditor_CardTitle"]" Icon="@Icons.Material.Filled.Business"
                    Description="@(IsNew ? null : Localizer["SupplierEditor_UpdateHint"].Value)">
            <HeaderActions>
                @if (!IsNew)
                {
                    <MudSwitch @bind-Value="_model.IsActive" Color="Color.Primary" Size="Size.Small" Label="@Localizer["SupplierEditor_ActiveLabel"]" />
                }
            </HeaderActions>
            <ChildContent>
                @* ModelChanged is what re-renders this page, so the save button follows what is typed. *@
                <PartnerFormFields Model="_model" ModelChanged="OnModelChanged" AllowCodeEdit="IsNew" />
            </ChildContent>
        </EditorCard>

        <FormActions Busy="_saving" Disabled="@(!_model.IsValid() || !Company.HasCompany)"
                     Hint="@(Company.HasCompany ? null : Localizer["SupplierEditor_NoCompanyWarning"].Value)"
                     OnSubmit="SaveAsync"
                     OnCancel="@(() => Navigation.NavigateTo("suppliers"))" />
    }
</MudStack>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNew => Id is null;

    private List<BreadcrumbItem> Breadcrumbs =>
    [
        new(Localizer["Suppliers_PageTitle"].Value, href: "suppliers"),
        new(IsNew ? Localizer["SupplierEditor_NewTitle"].Value : Localizer["SupplierEditor_EditTitle"].Value, href: null, disabled: true)
    ];

    private bool _loading;
    private bool _saving;
    private string? _error;

    private bool _loaded;
    private Guid? _loadedId;

    private PartnerFormModel _model = new();

    protected override async Task OnParametersSetAsync()
    {
        await Company.EnsureLoadedAsync();

        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loaded && _loadedId == Id)
            return;

        _loaded = true;
        _loadedId = Id;

        if (IsNew)
        {
            _model = new PartnerFormModel();
            return;
        }

        _loading = true;

        try
        {
            var supplier = await Catalog.GetSupplierAsync(Id!.Value);

            if (supplier is null)
            {
                _error = Localizer["SupplierEditor_NotFound"];
                return;
            }

            _model = PartnerFormModel.From(supplier);
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["SupplierEditor_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// The model is mutated in place by the field component; receiving the callback is what makes
    /// this page render again and re-evaluate the save button.
    /// </summary>
    private void OnModelChanged(PartnerFormModel model) => _model = model;

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var error = IsNew
                ? await Catalog.CreateSupplierAsync(_model.ToCreateRequest(Company.SelectedCompanyId))
                : await Catalog.UpdateSupplierAsync(Id!.Value, _model.ToUpdateRequest());

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(IsNew ? Localizer["SupplierEditor_Created"].Value : Localizer["SupplierEditor_Updated"].Value, Severity.Success);
            Navigation.NavigateTo("suppliers");
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["SupplierEditor_SaveError"], ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }
}
