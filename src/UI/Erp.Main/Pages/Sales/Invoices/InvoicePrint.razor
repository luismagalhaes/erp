@page "/invoices/{Id:guid}/print"
@attribute [Authorize]
@layout PrintLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Printing
@using Erp.Main.Layout
@using Erp.Main.Models
@using Erp.Main.Services
@using Microsoft.Extensions.Localization
@using Erp.Main.Resources
@inject SalesApiClient SalesApi
@inject CoreApiClient CoreApi
@inject CompanyState Company
@inject IStringLocalizer<MainResources> L

<PageTitle>@(_invoice?.DocumentNumber ?? L["InvoicePrint_DefaultTitle"])</PageTitle>

<PrintToolbar Copy="_copy" CopyChanged="@(copy => _copy = copy)" BackUrl="@($"invoices/{Id}")" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_invoice is null)
{
    <MudAlert Severity="Severity.Error">@(_error ?? L["InvoicePrint_DocumentNotFound"])</MudAlert>
}
else
{
    <PrintDocumentHeader Company="_company"
                         Designation="@InvoiceTypes.Describe(_invoice.DocumentType)"
                         DocumentNumber="@_invoice.DocumentNumber"
                         DocumentDate="_invoice.DocumentDate"
                         Copy="@_copy" />

    @if (_invoice.Status == "A")
    {
        <div class="print-voided">@L["InvoicePrint_VoidedNotice"]</div>
    }

    <div class="print-parties">
        <div class="print-box">
            <div class="label">@L["InvoicePrint_CustomerLabel"]</div>
            <div><strong>@_invoice.CustomerTaxId — @_invoice.CustomerName</strong></div>
            @if (!string.IsNullOrWhiteSpace(_invoice.CustomerAddress))
            {
                <div>@_invoice.CustomerAddress</div>
            }
            @if (!string.IsNullOrWhiteSpace(PostalCodeAndCity))
            {
                <div>@PostalCodeAndCity</div>
            }
        </div>

        <div class="print-box">
            <div class="label">@L["InvoicePrint_DatesLabel"]</div>
            <div>@L["InvoicePrint_DocumentDatePrefix", _invoice.DocumentDate.ToString("yyyy-MM-dd")]</div>
            <div>@L["InvoicePrint_DueDatePrefix", _invoice.DueDate?.ToString("yyyy-MM-dd") ?? "—"]</div>
        </div>

        @* Menção obrigatória num documento retificativo. *@
        @if (!string.IsNullOrWhiteSpace(_invoice.RectifiedDocumentNumber))
        {
            <div class="print-box">
                <div class="label">@L["InvoicePrint_RectifiedDocumentLabel"]</div>
                <div><strong>@_invoice.RectifiedDocumentNumber</strong></div>
                <div>@_invoice.RectificationReason</div>
            </div>
        }
    </div>

    <table class="print-table">
        <thead>
            <tr>
                <th style="width: 24px;">@L["InvoicePrint_NumberColumn"]</th>
                <th style="width: 70px;">@L["InvoicePrint_CodeColumn"]</th>
                <th>@L["InvoicePrint_DescriptionColumn"]</th>
                <th class="num" style="width: 60px;">@L["InvoicePrint_QuantityColumn"]</th>
                <th style="width: 34px;">@L["InvoicePrint_UnitColumn"]</th>
                <th class="num" style="width: 70px;">@L["InvoicePrint_PriceColumn"]</th>
                <th class="num" style="width: 44px;">@L["InvoicePrint_DiscountColumn"]</th>
                <th class="num" style="width: 44px;">@L["InvoicePrint_TaxColumn"]</th>
                <th class="num" style="width: 76px;">@L["InvoicePrint_ValueColumn"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in _invoice.Lines)
            {
                <tr>
                    <td>@line.LineNumber</td>
                    <td>@line.ProductCode</td>
                    <td>
                        @line.ProductDescription
                        @if (!string.IsNullOrWhiteSpace(line.TaxExemptionCode))
                        {
                            <span> (@line.TaxExemptionCode)</span>
                        }
                    </td>
                    <td class="num">@line.Quantity.ToString("N3")</td>
                    <td>@line.UnitOfMeasure</td>
                    <td class="num">@line.UnitPrice.ToString("N2")</td>
                    <td class="num">@(line.DiscountPercentage == 0 ? string.Empty : $"{line.DiscountPercentage:0.##}%")</td>
                    <td class="num">@line.TaxPercentage.ToString("N0")%</td>
                    <td class="num">@line.LineAmount.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="print-summary">
        <div>
            <table class="print-table" style="width: auto;">
                <thead>
                    <tr>
                        <th>@L["InvoicePrint_TaxSpaceColumn"]</th>
                        <th>@L["InvoicePrint_RateColumn"]</th>
                        <th class="num">@L["InvoicePrint_TaxableBaseColumn"]</th>
                        <th class="num">@L["InvoicePrint_TaxColumn"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tax in _invoice.Taxes)
                    {
                        <tr>
                            <td>@tax.TaxCountryRegion</td>
                            <td>@tax.TaxCode @tax.TaxPercentage.ToString("N0")%</td>
                            <td class="num">@tax.TaxableBase.ToString("N2")</td>
                            <td class="num">@tax.TaxAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="print-totals">
            <div class="row"><span>@L["DocumentTotals_GrossLinesLabel"]</span><span>@_invoice.GrossLinesTotal.ToString("N2")</span></div>
            <div class="row"><span>@L["DocumentTotals_DiscountLabel"]</span><span>@((-_invoice.DiscountTotal).ToString("N2"))</span></div>
            <div class="row"><span>@L["InvoicePrint_NetTotalLabel"]</span><span>@_invoice.NetTotal.ToString("N2")</span></div>
            <div class="row"><span>@L["InvoicePrint_TaxLabel"]</span><span>@_invoice.TaxPayable.ToString("N2")</span></div>
            <div class="row grand"><span>@L["InvoicePrint_TotalLabel"]</span><span>@_invoice.GrossTotal.ToString("N2") EUR</span></div>
        </div>
    </div>

    @* A fatura-recibo was paid when it was issued, and the paper has to say how. *@
    @if (_invoice.Payments is { Count: > 0 } payments)
    {
        <table class="print-table" style="width: auto;">
            <thead>
                <tr>
                    <th>@L["PaymentMethods_MethodColumn"]</th>
                    <th style="width: 80px;">@L["PaymentMethods_DateColumn"]</th>
                    <th class="num" style="width: 90px;">@L["PaymentMethods_AmountColumn"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in payments)
                {
                    <tr>
                        <td>@PaymentMechanismOptions.Describe(payment.Mechanism)</td>
                        <td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                        <td class="num">@payment.Amount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_exemptionReasons.Count > 0)
    {
        <div class="print-exemptions">
            @foreach (var reason in _exemptionReasons)
            {
                <div>@L["InvoicePrint_ExemptionPrefix", reason]</div>
            }
        </div>
    }

    <PrintFiscalFooter PrintableHash="@_invoice.PrintableHash"
                       Atcud="@_invoice.Atcud"
                       QrCodePayload="@_invoice.QrCodePayload">
        <div>@L["InvoicePrint_IssuedOn", _invoice.SystemEntryDateUtc.ToString("yyyy-MM-dd HH:mm:ss")]</div>
    </PrintFiscalFooter>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private string? _error;
    private string _copy = "Original";
    private Guid? _loadedId;

    private InvoiceDetail? _invoice;
    private CompanyDetail? _company;
    private List<string> _exemptionReasons = [];

    private string PostalCodeAndCity =>
        string.Join(" ", new[] { _invoice?.CustomerPostalCode, _invoice?.CustomerCity }
            .Where(part => !string.IsNullOrWhiteSpace(part)));

    protected override async Task OnParametersSetAsync()
    {
        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loadedId == Id)
            return;

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            await Company.EnsureLoadedAsync();

            _invoice = await SalesApi.GetInvoiceAsync(Id);

            if (_invoice is null)
            {
                _error = L["InvoicePrint_DocumentNotFound"];
                return;
            }

            // Each exemption reason is printed once, however many lines carry it.
            _exemptionReasons = [.. _invoice.Lines
                .Select(line => line.TaxExemptionReason)
                .Where(reason => !string.IsNullOrWhiteSpace(reason))
                .Select(reason => reason!)
                .Distinct(StringComparer.Ordinal)];

            if (Company.HasCompany)
                _company = await CoreApi.GetCompanyAsync(Company.SelectedCompanyId);
        }
        catch (Exception ex)
        {
            _error = L["InvoicePrint_LoadError", ex.Message];
        }
        finally
        {
            _loading = false;
        }
    }
}
