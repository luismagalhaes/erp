@page "/purchase-orders"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@inject PurchasingApiClient Purchasing
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Encomendas a fornecedores</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="Encomendas">
        <Actions>
            <MudSwitch T="bool" Value="_openOnly" ValueChanged="OnOpenOnlyChangedAsync"
                       Color="Color.Primary" Label="Só por receber" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("purchase-orders/new"))">
                Nova encomenda
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid @ref="_grid" T="PurchaseOrderListItem"
              LoadAsync="LoadAsync"
              SearchFields="SearchFields" DefaultOrderBy="OrderDate desc,Number desc"
              SearchPlaceholder="Procurar número ou fornecedor"
              EmptyIcon="@Icons.Material.Filled.ShoppingCart"
              EmptyTitle="Sem encomendas para mostrar"
              EmptyDescription="Ajuste os filtros ou crie a primeira encomenda."
              ItemsLabel="encomendas"
              LoadErrorMessage="Não foi possível carregar as encomendas">
        <Columns>
            <PropertyColumn Property="x => x.Number" Title="Número" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.OrderDate" Title="Data" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.ExpectedDate" Title="Prevista">
                <CellTemplate>
                    <MudText Typo="Typo.body2" Color="@ExpectedColor(context.Item)">
                        @(context.Item.ExpectedDate?.ToString("yyyy-MM-dd") ?? "—")
                    </MudText>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.SupplierName" Title="Fornecedor" />
            <PropertyColumn Property="x => x.SupplierTaxId" Title="NIF" />
            <PropertyColumn Property="x => x.Status" Title="Estado">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@StatusColor(context.Item.Status)">
                        @PurchaseOrderStatuses.Describe(context.Item.Status)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.LineCount" Title="Linhas"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.GrossTotal" Title="Total" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"purchase-orders/{context.Item.Id}"))">
                            Abrir encomenda
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["Number", "SupplierName", "SupplierTaxId"];

    private DataGrid<PurchaseOrderListItem>? _grid;
    private bool _openOnly;

    /// <summary>
    /// The "still owed" switch is added to the query rather than applied to the page, so the count
    /// and the paging the grid receives are already the ones of the orders being shown.
    /// </summary>
    private Task<(IReadOnlyList<PurchaseOrderListItem> Items, int Count, string? Error)> LoadAsync(
        Guid companyId, ODataQuery query, CancellationToken cancellationToken)
    {
        if (_openOnly)
            query.Filter("IsOpen eq true");

        return Purchasing.QueryOrdersAsync(companyId, query, cancellationToken);
    }

    private async Task OnOpenOnlyChangedAsync(bool openOnly)
    {
        _openOnly = openOnly;

        if (_grid is not null)
            await _grid.ReloadAsync();
    }

    private static Color StatusColor(string status) => status switch
    {
        "Received" => Color.Success,
        "PartiallyReceived" => Color.Info,
        "Cancelled" => Color.Error,
        "Closed" => Color.Secondary,
        _ => Color.Default
    };

    /// <summary>An order that is still owed and past its date is worth pointing out.</summary>
    private static Color ExpectedColor(PurchaseOrderListItem order) =>
        order.IsOpen && order.ExpectedDate is { } expected && expected < DateOnly.FromDateTime(DateTime.Today)
            ? Color.Warning
            : Color.Default;
}
