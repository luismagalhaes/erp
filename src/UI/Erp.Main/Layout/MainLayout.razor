@inherits LayoutComponentBase
@implements IDisposable
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Erp.Main.Services
@using Erp.Main.Theme
@using Erp.Main.Resources
@inject NavigationManager Navigation
@inject CompanyState Company
@inject IStringLocalizer<MainResources> Localizer

<MudThemeProvider Theme="AppTheme.Default" @bind-IsDarkMode="_isDarkMode" />
@* Required by every component that opens an overlay: selects, date pickers and menus. *@
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Default" Class="erp-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-4 erp-brand">SmartInvoice</MudText>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                @if (Company.Companies.Count > 0)
                {
                    <MudSelect T="Guid" Value="Company.SelectedCompanyId" ValueChanged="OnCompanyChanged"
                               Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                               Class="company-picker" Style="min-width: 260px;"
                               AdornmentIcon="@Icons.Material.Filled.Domain" Adornment="Adornment.Start">
                        @foreach (var company in Company.Companies)
                        {
                            <MudSelectItem T="Guid" Value="@company.CompanyId">@company.CompanyName</MudSelectItem>
                        }
                    </MudSelect>
                }
            </Authorized>
        </AuthorizeView>

        <MudTooltip Text="@(_isDarkMode ? Localizer["Layout_LightMode"] : Localizer["Layout_DarkMode"])">
            <MudIconButton Color="Color.Inherit"
                           Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           OnClick="@ToggleDarkMode" />
        </MudTooltip>

        <MudMenu Icon="@Icons.Material.Filled.Language" Color="Color.Inherit" Class="ml-1"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem OnClick='@(() => SetCulture("pt-PT"))'>Português</MudMenuItem>
            <MudMenuItem OnClick='@(() => SetCulture("en-US"))'>English</MudMenuItem>
        </MudMenu>

        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                         ActivationEvent="MouseEvent.LeftClick" Class="ml-2">
                    <ActivatorContent>
                        <MudTooltip Text="@context.User.Identity?.Name">
                            <MudAvatar Color="Color.Primary" Size="Size.Medium" Class="erp-user-avatar">
                                @Initials(context.User.Identity?.Name)
                            </MudAvatar>
                        </MudTooltip>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="@Logout">@Localizer["Layout_Logout"]</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Mini" ClipMode="DrawerClipMode.Always"
               Class="erp-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="erp-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
    .company-picker .mud-input-slot,
    .company-picker .mud-input-adornment .mud-icon-root,
    .company-picker .mud-select-input .mud-input-slot {
        color: var(--mud-palette-text-primary);
    }
</style>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyStateChanged;
        await Company.EnsureLoadedAsync();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;

    private static string Initials(string? name)
        => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private void OnCompanyChanged(Guid companyId) => Company.Select(companyId);

    private void OnCompanyStateChanged() => InvokeAsync(StateHasChanged);

    private void Logout()
    {
        var currentPath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"authentication/logout?returnUrl={Uri.EscapeDataString(currentPath)}", forceLoad: true);
    }

    private void SetCulture(string culture)
    {
        var currentPath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(
            $"/culture/set?culture={Uri.EscapeDataString(culture)}&redirectUri={Uri.EscapeDataString(currentPath)}",
            forceLoad: true);
    }

    public void Dispose() => Company.Changed -= OnCompanyStateChanged;
}
