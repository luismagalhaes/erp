@page "/customers/new"
@page "/customers/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@(IsNew ? Localizer["CustomerEditor_NewTitle"] : Localizer["CustomerEditor_EditTitle"])</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="@(IsNew ? Localizer["CustomerEditor_NewTitle"] : Localizer["CustomerEditor_EditTitle"])"
                Breadcrumbs="Breadcrumbs">
        <Actions>
            @if (Id is { } customerId)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AccountBalanceWallet"
                           OnClick="@(() => Navigation.NavigateTo($"customer-statements?customerId={customerId}"))">
                    @Localizer["Statement_OpenButton"]
                </MudButton>
            }
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("customers"))">
                @Localizer["Common_Back"]
            </MudButton>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @* Without this the button would just sit disabled with nothing explaining why. *@
    @if (!Company.HasCompany)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            @Localizer["CustomerEditor_NoCompanyWarning"]
        </MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <EditorCard Title="@Localizer["CustomerEditor_CardTitle"]" Icon="@Icons.Material.Filled.PersonOutline"
                    Description="@(IsNew ? null : Localizer["CustomerEditor_UpdateHint"].Value)">
            <HeaderActions>
                @if (!IsNew)
                {
                    <MudSwitch @bind-Value="_model.IsActive" Color="Color.Primary" Size="Size.Small" Label="@Localizer["CustomerEditor_ActiveLabel"]" />
                }
            </HeaderActions>
            <ChildContent>
                @* ModelChanged is what re-renders this page, so the save button follows what is typed. *@
                <PartnerFormFields Model="_model" ModelChanged="OnModelChanged"
                                   RequireTaxId="false" />
            </ChildContent>
        </EditorCard>

        <FormActions Busy="_saving" Disabled="@(!_model.IsValid(requireTaxId: false) || !Company.HasCompany)"
                     Hint="@(Company.HasCompany ? null : Localizer["CustomerEditor_NoCompanyWarning"].Value)"
                     OnSubmit="SaveAsync"
                     OnCancel="@(() => Navigation.NavigateTo("customers"))" />
    }
</MudStack>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNew => Id is null;

    private List<BreadcrumbItem> Breadcrumbs =>
    [
        new(Localizer["Customers_PageTitle"].Value, href: "customers"),
        new(IsNew ? Localizer["CustomerEditor_NewTitle"].Value : Localizer["CustomerEditor_EditTitle"].Value, href: null, disabled: true)
    ];

    private bool _loading;
    private bool _saving;
    private string? _error;

    private bool _loaded;
    private Guid? _loadedId;

    private PartnerFormModel _model = new();

    protected override async Task OnParametersSetAsync()
    {
        await Company.EnsureLoadedAsync();

        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loaded && _loadedId == Id)
            return;

        _loaded = true;
        _loadedId = Id;

        if (IsNew)
        {
            _model = new PartnerFormModel();
            return;
        }

        _loading = true;

        try
        {
            var customer = await Catalog.GetCustomerAsync(Id!.Value);

            if (customer is null)
            {
                _error = Localizer["CustomerEditor_NotFound"];
                return;
            }

            _model = PartnerFormModel.From(customer);
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CustomerEditor_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// The model is mutated in place by the field component; receiving the callback is what makes
    /// this page render again and re-evaluate the save button.
    /// </summary>
    private void OnModelChanged(PartnerFormModel model) => _model = model;

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            // The tax id is optional in this form — fill in the final-consumer id before sending,
            // since the API still requires one. The code is numbered by the API.
            _model.ApplyDefaults();

            var error = IsNew
                ? await Catalog.CreateCustomerAsync(_model.ToCreateRequest(Company.SelectedCompanyId))
                : await Catalog.UpdateCustomerAsync(Id!.Value, _model.ToUpdateRequest());

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(IsNew ? Localizer["CustomerEditor_Created"].Value : Localizer["CustomerEditor_Updated"].Value, Severity.Success);
            Navigation.NavigateTo("customers");
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CustomerEditor_SaveError"], ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }
}
