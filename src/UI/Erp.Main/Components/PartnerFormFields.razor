@using MudBlazor
@using Erp.Main.Models
@using Microsoft.Extensions.Localization
@using Erp.Main.Resources
@inject IStringLocalizer<MainResources> Localizer

@*
    Customers and suppliers are filled in the same way, so they share these fields.

    Every field reports back through ModelChanged. Without it the parent never re-renders when the
    model changes here, and anything it derives from the model — a save button enabled by
    Model.IsValid, for one — would stay frozen at whatever it was on first render.

    The three fields that decide validity are Immediate so the parent reacts as the user types,
    instead of only when the field loses focus.
*@
<MudGrid>
    <MudItem xs="12" md="3">
        <MudTextField @bind-Value="Model.Code" @bind-Value:after="NotifyChangedAsync" Immediate="true"
                      Label="@Localizer["PartnerForm_CodeLabel"]" Variant="Variant.Outlined"
                      Required="true" Disabled="@(!AllowCodeEdit)"
                      HelperText="@(AllowCodeEdit ? null : Localizer["PartnerForm_CodeHelperText"].Value)" />
    </MudItem>
    <MudItem xs="12" md="6">
        <MudTextField @bind-Value="Model.Name" @bind-Value:after="NotifyChangedAsync" Immediate="true"
                      Label="@Localizer["PartnerForm_NameLabel"]" Variant="Variant.Outlined" Required="true" />
    </MudItem>
    <MudItem xs="12" md="3">
        <MudTextField @bind-Value="Model.TaxId" @bind-Value:after="NotifyChangedAsync" Immediate="true"
                      Label="@Localizer["PartnerForm_TaxIdLabel"]" Variant="Variant.Outlined" Required="true"
                      HelperText="@Localizer["PartnerForm_TaxIdHelperText"]" />
    </MudItem>

    <MudItem xs="12" md="6">
        <MudTextField @bind-Value="Model.Address" @bind-Value:after="NotifyChangedAsync"
                      Label="@Localizer["PartnerForm_AddressLabel"]" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" md="2">
        <MudTextField @bind-Value="Model.PostalCode" @bind-Value:after="NotifyChangedAsync"
                      Label="@Localizer["PartnerForm_PostalCodeLabel"]" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" md="2">
        <MudTextField @bind-Value="Model.City" @bind-Value:after="NotifyChangedAsync"
                      Label="@Localizer["PartnerForm_CityLabel"]" Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" md="2">
        <MudTextField @bind-Value="Model.Country" @bind-Value:after="NotifyChangedAsync"
                      Label="@Localizer["PartnerForm_CountryLabel"]" Variant="Variant.Outlined"
                      HelperText="@Localizer["PartnerForm_CountryHelperText"]" />
    </MudItem>

    <MudItem xs="12" md="6">
        <MudTextField @bind-Value="Model.Email" @bind-Value:after="NotifyChangedAsync"
                      Label="@Localizer["PartnerForm_EmailLabel"]" Variant="Variant.Outlined" InputType="InputType.Email" />
    </MudItem>
    <MudItem xs="12" md="6">
        <MudTextField @bind-Value="Model.Phone" @bind-Value:after="NotifyChangedAsync"
                      Label="@Localizer["PartnerForm_PhoneLabel"]" Variant="Variant.Outlined" />
    </MudItem>

    @if (ShowActive)
    {
        <MudItem xs="12">
            <MudSwitch @bind-Value="Model.IsActive" @bind-Value:after="NotifyChangedAsync"
                       Color="Color.Primary" Label="@(ActiveLabel ?? Localizer["PartnerForm_ActiveLabel"])" />
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter, EditorRequired]
    public PartnerFormModel Model { get; set; } = new();

    /// <summary>
    /// Raised whenever a field changes. Invoking it re-renders the parent, which is what keeps
    /// anything derived from the model in step with what the user typed.
    /// </summary>
    [Parameter]
    public EventCallback<PartnerFormModel> ModelChanged { get; set; }

    [Parameter]
    public bool AllowCodeEdit { get; set; } = true;

    [Parameter]
    public bool ShowActive { get; set; }

    [Parameter]
    public string? ActiveLabel { get; set; }

    private Task NotifyChangedAsync() => ModelChanged.InvokeAsync(Model);
}
