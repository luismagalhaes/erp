@using MudBlazor

@* Standard header for every page: title, supporting text and right aligned actions. *@
<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1 gap-4">
    <MudStack Spacing="0">
        @if (Breadcrumbs is not null && Breadcrumbs.Count > 0)
        {
            <MudBreadcrumbs Items="Breadcrumbs" Class="pa-0 mb-1" Separator="/" />
        }
        <MudText Typo="Typo.h4">@Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Description</MudText>
        }
    </MudStack>

    @if (Actions is not null)
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @Actions
        </MudStack>
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Description { get; set; }

    [Parameter] public List<BreadcrumbItem>? Breadcrumbs { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }
}
