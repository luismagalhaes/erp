@page "/companies/new"
@page "/companies/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using MudBlazor
@using Erp.Common
@using Erp.Main.Models
@using Erp.Main.Models.Core
@using Erp.Main.Resources
@using Erp.Main.Services
@inject CoreApiClient CoreApi
@inject IdentityApiClient IdentityApi
@inject StockApiClient StockApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@(IsNew ? Localizer["CompanyEditor_NewTitle"] : Localizer["CompanyEditor_EditTitle"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(IsNew ? Localizer["CompanyEditor_NewTitle"] : _name)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Localizer["CompanyEditor_TaxIdHelperText"]
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("companies"))">
            @Localizer["Common_Back"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="1">
            <MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pa-4">
                <MudTabPanel Text="@Localizer["CompanyEditor_DataTab"]" Icon="@Icons.Material.Filled.Domain">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6" md="6">
                            <MudTextField @bind-Value="_name" Label="@Localizer["Common_NameColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="6">
                            <MudTextField @bind-Value="_legalName" Label="@Localizer["CompanyEditor_LegalNameLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField @bind-Value="_taxId" Label="@Localizer["Companies_TaxIdColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField @bind-Value="_email" Label="@Localizer["CompanyEditor_EmailColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Email" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField @bind-Value="_phone" Label="@Localizer["PartnerForm_PhoneLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                                @Localizer["CompanyEditor_AddressSectionHint"]
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="6">
                            <MudTextField @bind-Value="_address" Label="@Localizer["PartnerForm_AddressLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="3" md="3">
                            <MudTextField @bind-Value="_postalCode" Label="@Localizer["PartnerForm_PostalCodeLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="3" md="3">
                            <MudTextField @bind-Value="_city" Label="@Localizer["CompanyEditor_CityColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect @bind-Value="_country" Label="@Localizer["PartnerForm_CountryLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var country in Countries.All)
                                {
                                    <MudSelectItem T="string" Value="@country.Code">@country.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        @if (!IsNew)
                        {
                            <MudItem xs="12">
                                <MudSwitch @bind-Value="_isActive" Color="Color.Primary" Label="@Localizer["CompanyEditor_ActiveLabel"]" />
                            </MudItem>
                        }
                    </MudGrid>

                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@(_saving || !CanSave)"
                                   OnClick="SaveAsync">
                            @Localizer["Common_SaveButton"]
                        </MudButton>
                    </MudStack>
                </MudTabPanel>

                <MudTabPanel Text="@Localizer["CompanyEditor_UsersTab"]" Icon="@Icons.Material.Filled.Group" Disabled="IsNew"
                             ToolTip="@(IsNew ? Localizer["CompanyEditor_UsersTabDisabledHint"].Value : null)">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        @Localizer["CompanyEditor_UsersTabDescription"]
                    </MudText>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                        <MudGrid>
                            <MudItem xs="12" md="5">
                                <MudSelect @bind-Value="_newUserId" Label="@Localizer["CompanyEditor_UserLabel"]" Variant="Variant.Outlined"
                                           Dense="true" Disabled="@(_availableUsers.Count == 0)">
                                    @foreach (var user in _availableUsers)
                                    {
                                        <MudSelectItem T="string" Value="@user.Id">
                                            @(string.IsNullOrWhiteSpace(user.FullName) ? user.Email : $"{user.FullName} ({user.Email})")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect @bind-Value="_newRole" Label="@Localizer["CompanyEditor_RoleLabel"]" Variant="Variant.Outlined" Dense="true">
                                    @foreach (var role in CompanyRoles)
                                    {
                                        <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3" Class="d-flex align-center">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.PersonAdd"
                                           Disabled="@(_working || string.IsNullOrWhiteSpace(_newUserId))"
                                           OnClick="AssignAsync">
                                    @Localizer["CompanyEditor_AssignButton"]
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (_availableUsers.Count == 0 && _users.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @Localizer["CompanyEditor_AllUsersAssignedHint"]
                            </MudText>
                        }
                    </MudPaper>

                    <MudTable Items="_memberships" Hover="true" Striped="true" Dense="true" Loading="_workingUsers"
                              Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>@Localizer["CompanyEditor_UserColumn"]</MudTh>
                            <MudTh>@Localizer["CompanyEditor_EmailColumn"]</MudTh>
                            <MudTh Style="width: 200px;">@Localizer["CompanyEditor_RoleLabel"]</MudTh>
                            <MudTh Style="width: 140px;">@Localizer["Common_StatusColumn"]</MudTh>
                            <MudTh Style="text-align: right;">@Localizer["CompanyEditor_ActionsColumn"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@Localizer["CompanyEditor_UserColumn"]">@DescribeUser(context.UserId)</MudTd>
                            <MudTd DataLabel="@Localizer["CompanyEditor_EmailColumn"]">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@DescribeEmail(context.UserId)</MudText>
                            </MudTd>
                            <MudTd DataLabel="@Localizer["CompanyEditor_RoleLabel"]">
                                <MudSelect T="string" Value="context.Role" Dense="true" Margin="Margin.Dense"
                                           ValueChanged="@(role => ChangeRoleAsync(context, role))">
                                    @foreach (var role in CompanyRoles)
                                    {
                                        <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd DataLabel="@Localizer["Common_StatusColumn"]">
                                <MudSwitch T="bool" Value="context.IsActive" Color="Color.Primary" Size="Size.Small"
                                           ValueChanged="@(active => ChangeActiveAsync(context, active))" />
                            </MudTd>
                            <MudTd DataLabel="@Localizer["CompanyEditor_ActionsColumn"]" Style="text-align: right;">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               title="@Localizer["CompanyEditor_RemoveAccessTitle"]"
                                               Disabled="_working"
                                               OnClick="@(() => RemoveAsync(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @Localizer["CompanyEditor_NoUsersMessage"]
                            </MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudTabPanel>

                <MudTabPanel Text="@Localizer["CompanyEditor_WarehousesTab"]" Icon="@Icons.Material.Filled.Warehouse" Disabled="IsNew"
                             ToolTip="@(IsNew ? Localizer["CompanyEditor_WarehousesTabDisabledHint"].Value : null)">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @Localizer["CompanyEditor_WarehousesTabDescription"]
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(() => OpenWarehouse(null))">
                            @Localizer["CompanyEditor_NewWarehouse"]
                        </MudButton>
                    </MudStack>

                    <MudTable Items="_warehouses" Hover="true" Striped="true" Dense="true"
                              Loading="_workingWarehouses" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>@Localizer["Common_CodeColumn"]</MudTh>
                            <MudTh>@Localizer["Common_NameColumn"]</MudTh>
                            <MudTh>@Localizer["CompanyEditor_CityColumn"]</MudTh>
                            <MudTh Style="width: 140px;">@Localizer["CompanyEditor_DefaultColumn"]</MudTh>
                            <MudTh Style="width: 120px;">@Localizer["Common_StatusColumn"]</MudTh>
                            <MudTh Style="text-align: right;">@Localizer["CompanyEditor_ActionsColumn"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@Localizer["Common_CodeColumn"]">
                                <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.Code</MudText>
                            </MudTd>
                            <MudTd DataLabel="@Localizer["Common_NameColumn"]">@context.Name</MudTd>
                            <MudTd DataLabel="@Localizer["CompanyEditor_CityColumn"]">@DescribeCity(context)</MudTd>
                            <MudTd DataLabel="@Localizer["CompanyEditor_DefaultColumn"]">
                                @if (context.IsDefault)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                        @Localizer["CompanyEditor_DefaultChip"]
                                    </MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="@Localizer["Common_StatusColumn"]">
                                @if (context.IsActive)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                                        @Localizer["Common_Active"]
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                                        @Localizer["Common_Inactive"]
                                    </MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="@Localizer["CompanyEditor_ActionsColumn"]" Style="text-align: right;">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               title="@Localizer["CompanyEditor_EditWarehouseTitle"]"
                                               OnClick="@(() => OpenWarehouse(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @Localizer["CompanyEditor_NoWarehousesMessage"]
                            </MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudTabPanel>

                <MudTabPanel Text="@Localizer["CompanyEditor_AtTab"]" Icon="@Icons.Material.Filled.Https" Disabled="IsNew"
                             ToolTip="@(IsNew ? Localizer["CompanyEditor_AtTabDisabledHint"].Value : null)">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        @Localizer["CompanyEditor_AtTabDescription"]
                    </MudText>

                    @if (_atStatus is not null)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">
                            @string.Format(Localizer["CompanyEditor_AtCredentialsRegistered"],
                                _atStatus.SubUserId, _atStatus.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")) UTC.
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                            @Localizer["CompanyEditor_AtCredentialsMissing"]
                        </MudAlert>
                    }

                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField @bind-Value="_atSubUserId" Label="@Localizer["CompanyEditor_AtSubUserIdLabel"]"
                                          HelperText="@Localizer["CompanyEditor_AtSubUserIdHelperText"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField @bind-Value="_atPassword" Label="@Localizer["CompanyEditor_AtPasswordLabel"]"
                                          InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@(_workingAt || string.IsNullOrWhiteSpace(_atSubUserId) || string.IsNullOrWhiteSpace(_atPassword))"
                                   OnClick="SaveAtCredentialsAsync">
                            @Localizer["Common_SaveButton"]
                        </MudButton>
                    </MudStack>
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    }
</MudStack>

@* --- Armazém --- *@
<MudDialog @bind-Visible="_warehouseOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_warehouseId is null ? Localizer["CompanyEditor_NewWarehouseTitle"] : Localizer["CompanyEditor_EditWarehouseTitle"])</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="3" md="3">
                <MudTextField @bind-Value="_warehouseCode" @bind-Value:after="StateHasChanged" Immediate="true"
                              Label="@Localizer["Common_CodeColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                              Disabled="@(_warehouseId is not null)"
                              HelperText="@(_warehouseId is null ? Localizer["CompanyEditor_WarehouseCodeUniqueHint"].Value : Localizer["CompanyEditor_WarehouseCodeHelperText"].Value)" />
            </MudItem>
            <MudItem xs="12" sm="9" md="9">
                <MudTextField @bind-Value="_warehouseName" @bind-Value:after="StateHasChanged" Immediate="true"
                              Label="@Localizer["Common_NameColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="6">
                <MudTextField @bind-Value="_warehouseAddress" Label="@Localizer["PartnerForm_AddressLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3" md="3">
                <MudTextField @bind-Value="_warehousePostalCode" Label="@Localizer["PartnerForm_PostalCodeLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3" md="3">
                <MudTextField @bind-Value="_warehouseCity" Label="@Localizer["CompanyEditor_CityColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudSelect @bind-Value="_warehouseCountry" Label="@Localizer["PartnerForm_CountryLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var country in Countries.All)
                    {
                        <MudSelectItem T="string" Value="@country.Code">@country.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="4" md="4">
                <MudSwitch @bind-Value="_warehouseIsDefault" Color="Color.Primary" Label="@Localizer["CompanyEditor_WarehouseIsDefaultLabel"]" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @Localizer["CompanyEditor_WarehouseIsDefaultHint"]
                </MudText>
            </MudItem>

            @if (_warehouseId is not null)
            {
                <MudItem xs="12" sm="4" md="4">
                    <MudSwitch @bind-Value="_warehouseIsActive" Color="Color.Primary" Label="@Localizer["CompanyEditor_WarehouseActiveLabel"]" />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _warehouseOpen = false)">@Localizer["Common_CancelButton"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@(_working || !CanSaveWarehouse)"
                   OnClick="SaveWarehouseAsync">
            @Localizer["Common_SaveButton"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>As mesmas roles que o Identity emite, para não haver duas listas a divergir.</summary>
    private static readonly string[] CompanyRoles = Constants.Roles.All;

    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNew => Id is null;

    private bool _loading;
    private bool _saving;
    private bool _working;
    private bool _workingUsers;
    private string? _error;

    private bool _loaded;
    private Guid? _loadedId;

    private string _name = string.Empty;
    private string _legalName = string.Empty;
    private string _taxId = string.Empty;
    private string _email = string.Empty;
    private string _phone = string.Empty;
    private string _address = string.Empty;
    private string _city = string.Empty;
    private string _postalCode = string.Empty;
    private string _country = "PT";
    private bool _isActive = true;

    private string _newUserId = string.Empty;
    private string _newRole = Constants.Roles.User;

    private List<UserCompanyAdmin> _memberships = [];
    private List<IdentityUser> _users = [];

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private bool _workingWarehouses;
    private List<Warehouse> _warehouses = [];

    private bool _workingAt;
    private CompanyAtCredentialStatus? _atStatus;
    private string _atSubUserId = string.Empty;
    private string _atPassword = string.Empty;

    private bool _warehouseOpen;
    private Guid? _warehouseId;
    private string _warehouseCode = string.Empty;
    private string _warehouseName = string.Empty;
    private string _warehouseAddress = string.Empty;
    private string _warehouseCity = string.Empty;
    private string _warehousePostalCode = string.Empty;
    private string _warehouseCountry = "PT";
    private bool _warehouseIsDefault;
    private bool _warehouseIsActive = true;

    private bool CanSaveWarehouse =>
        !string.IsNullOrWhiteSpace(_warehouseCode) && !string.IsNullOrWhiteSpace(_warehouseName);

    private List<IdentityUser> _availableUsers =>
        [.. _users.Where(user => _memberships.All(m => m.UserId != user.Id))];

    private bool CanSave => !string.IsNullOrWhiteSpace(_name) && !string.IsNullOrWhiteSpace(_taxId);

    protected override async Task OnParametersSetAsync()
    {
        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loaded && _loadedId == Id)
            return;

        _loaded = true;
        _loadedId = Id;

        if (IsNew)
            return;

        _loading = true;

        try
        {
            var company = await CoreApi.GetCompanyAsync(Id!.Value);

            if (company is null)
            {
                _error = Localizer["CompanyEditor_NotFound"];
                return;
            }

            _name = company.Name;
            _legalName = company.LegalName ?? string.Empty;
            _taxId = company.TaxId;
            _email = company.Email ?? string.Empty;
            _phone = company.Phone ?? string.Empty;
            _address = company.Address ?? string.Empty;
            _city = company.City ?? string.Empty;
            _postalCode = company.PostalCode ?? string.Empty;
            _country = string.IsNullOrWhiteSpace(company.Country) ? "PT" : company.Country;
            _isActive = company.IsActive;

            await LoadUsersAsync();
            await LoadWarehousesAsync();
            await LoadAtCredentialStatusAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CompanyEditor_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadUsersAsync()
    {
        _workingUsers = true;

        // Each source is loaded on its own: the Identity being down still leaves the
        // memberships readable, and the other way round.
        var problems = new List<string>();

        try
        {
            var (memberships, error) = await CoreApi.GetUserCompaniesAsync(Id!.Value);
            _memberships = [.. memberships];

            if (error is not null)
                problems.Add(error);
        }
        catch (Exception ex)
        {
            problems.Add(string.Format(Localizer["CompanyEditor_LoadAccessesError"], ex.Message));
        }

        try
        {
            var (users, error) = await IdentityApi.GetUsersAsync();
            _users = [.. users.Where(user => user.IsActive).OrderBy(user => user.Email)];

            if (error is not null)
                problems.Add(string.Format(Localizer["CompanyEditor_LoadUsersError"], error));
        }
        catch (Exception ex)
        {
            problems.Add(string.Format(Localizer["CompanyEditor_LoadUsersError"], ex.Message));
        }

        _newUserId = _availableUsers.FirstOrDefault()?.Id ?? string.Empty;
        _error = problems.Count == 0 ? null : string.Join(" ", problems);
        _workingUsers = false;
    }

    private async Task LoadWarehousesAsync()
    {
        _workingWarehouses = true;

        try
        {
            var (warehouses, error) = await StockApi.GetWarehousesAsync(Id!.Value);
            _warehouses = [.. warehouses];

            if (error is not null)
                _error = error;
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CompanyEditor_LoadWarehousesError"], ex.Message);
        }
        finally
        {
            _workingWarehouses = false;
        }
    }

    private async Task LoadAtCredentialStatusAsync()
    {
        try
        {
            _atStatus = await CoreApi.GetCompanyAtCredentialStatusAsync(Id!.Value);
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CompanyEditor_LoadAtCredentialsError"], ex.Message);
        }
    }

    private async Task SaveAtCredentialsAsync()
    {
        _workingAt = true;
        _error = null;

        try
        {
            var error = await CoreApi.SetCompanyAtCredentialsAsync(
                Id!.Value, new SetCompanyAtCredentialsRequest(_atSubUserId.Trim(), _atPassword));

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(Localizer["CompanyEditor_AtCredentialsSaved"].Value, Severity.Success);
            _atPassword = string.Empty;
            await LoadAtCredentialStatusAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CompanyEditor_SaveAtCredentialsError"], ex.Message);
        }
        finally
        {
            _workingAt = false;
        }
    }

    /// <summary>Opens the dialog on an existing warehouse, or empty for a new one.</summary>
    private void OpenWarehouse(Warehouse? warehouse)
    {
        _warehouseId = warehouse?.Id;
        _warehouseCode = warehouse?.Code ?? string.Empty;
        _warehouseName = warehouse?.Name ?? string.Empty;
        _warehouseAddress = warehouse?.Address ?? string.Empty;
        _warehouseCity = warehouse?.City ?? string.Empty;
        _warehousePostalCode = warehouse?.PostalCode ?? string.Empty;
        _warehouseCountry = string.IsNullOrWhiteSpace(warehouse?.Country) ? "PT" : warehouse.Country;
        _warehouseIsDefault = warehouse?.IsDefault ?? _warehouses.Count == 0;
        _warehouseIsActive = warehouse?.IsActive ?? true;
        _warehouseOpen = true;
    }

    private async Task SaveWarehouseAsync()
    {
        _working = true;
        _error = null;

        try
        {
            var address = Trimmed(_warehouseAddress);
            var city = Trimmed(_warehouseCity);
            var postalCode = Trimmed(_warehousePostalCode);
            var country = string.IsNullOrWhiteSpace(_warehouseCountry) ? "PT" : _warehouseCountry.Trim();

            var error = _warehouseId is { } id
                ? await StockApi.UpdateWarehouseAsync(id, new UpdateWarehouseRequest(
                    _warehouseName.Trim(), address, city, postalCode, country,
                    _warehouseIsDefault, _warehouseIsActive))
                : await StockApi.CreateWarehouseAsync(new CreateWarehouseRequest(
                    Id!.Value, _warehouseCode.Trim(), _warehouseName.Trim(), address, city, postalCode,
                    country, _warehouseIsDefault));

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(string.Format(Localizer["CompanyEditor_WarehouseSaved"], _warehouseCode), Severity.Success);
            _warehouseOpen = false;
            await LoadWarehousesAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CompanyEditor_SaveWarehouseError"], ex.Message);
        }
        finally
        {
            _working = false;
        }
    }

    private static string? Trimmed(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string DescribeCity(Warehouse warehouse) =>
        string.Join(" ", new[] { warehouse.PostalCode, warehouse.City }
            .Where(part => !string.IsNullOrWhiteSpace(part)));

    private string DescribeUser(string userId) =>
        _users.FirstOrDefault(user => user.Id == userId) is { FullName: { Length: > 0 } fullName }
            ? fullName
            : DescribeEmail(userId);

    private string DescribeEmail(string userId) =>
        _users.FirstOrDefault(user => user.Id == userId)?.Email ?? userId;

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            if (IsNew)
            {
                var request = new CreateCompanyRequest(
                    _name.Trim(), _taxId.Trim(), Normalize(_legalName), Normalize(_email), Normalize(_phone),
                    Normalize(_address), Normalize(_city), Normalize(_postalCode), NormalizeCountry(_country));

                var (created, error) = await CoreApi.CreateCompanyAsync(request);

                if (error is not null)
                {
                    _error = error;
                    return;
                }

                await Company.RefreshAsync();
                Snackbar.Add(Localizer["CompanyEditor_Created"].Value, Severity.Success);

                // Straight into the users tab of the company that was just created.
                Navigation.NavigateTo($"companies/{created!.Id}");
                return;
            }

            var updateRequest = new UpdateCompanyRequest(
                _name.Trim(), _taxId.Trim(), Normalize(_legalName), Normalize(_email), Normalize(_phone), _isActive,
                Normalize(_address), Normalize(_city), Normalize(_postalCode), NormalizeCountry(_country));

            var (_, updateError) = await CoreApi.UpdateCompanyAsync(Id!.Value, updateRequest);

            if (updateError is not null)
            {
                _error = updateError;
                return;
            }

            await Company.RefreshAsync();
            Snackbar.Add(Localizer["CompanyEditor_Updated"].Value, Severity.Success);
            Navigation.NavigateTo("companies");
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CompanyEditor_SaveError"], ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AssignAsync()
    {
        await RunAsync(
            () => CoreApi.CreateUserCompanyAsync(new CreateUserCompanyRequest(_newUserId, Id!.Value, _newRole)),
            string.Format(Localizer["CompanyEditor_UserGainedAccess"], DescribeEmail(_newUserId)));
    }

    private async Task ChangeRoleAsync(UserCompanyAdmin membership, string role)
    {
        await RunAsync(
            () => CoreApi.UpdateUserCompanyAsync(membership.Id, new UpdateUserCompanyRequest(role, membership.IsActive)),
            Localizer["CompanyEditor_RoleUpdated"]);
    }

    private async Task ChangeActiveAsync(UserCompanyAdmin membership, bool isActive)
    {
        await RunAsync(
            () => CoreApi.UpdateUserCompanyAsync(membership.Id, new UpdateUserCompanyRequest(membership.Role, isActive)),
            isActive ? Localizer["CompanyEditor_AccessReactivated"] : Localizer["CompanyEditor_AccessDeactivated"]);
    }

    private async Task RemoveAsync(UserCompanyAdmin membership)
    {
        await RunAsync(
            () => CoreApi.DeleteUserCompanyAsync(membership.Id),
            string.Format(Localizer["CompanyEditor_UserLostAccess"], DescribeUser(membership.UserId)));
    }

    /// <summary>Runs an operation on the memberships and refreshes what depends on them.</summary>
    private async Task RunAsync(Func<Task<string?>> operation, string successMessage)
    {
        _working = true;
        _error = null;

        try
        {
            var error = await operation();

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(successMessage, Severity.Success);

            // The header picker lists the companies of the signed in user.
            await Company.RefreshAsync();
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CompanyEditor_OperationError"], ex.Message);
        }
        finally
        {
            _working = false;
        }
    }

    private static string? Normalize(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string NormalizeCountry(string value) =>
        string.IsNullOrWhiteSpace(value) ? "PT" : value.Trim().ToUpperInvariant();
}
