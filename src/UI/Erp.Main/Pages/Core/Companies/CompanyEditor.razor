    private async Task ChangeActiveAsync(UserCompanyAdmin membership, bool isActive)
    {
        await RunAsync(
            () => CoreApi.UpdateUserCompanyAsync(membership.Id, new UpdateUserCompanyRequest(membership.Role, isActive)),
            isActive ? Localizer["CompanyEditor_AccessReactivated"] : Localizer["CompanyEditor_AccessDeactivated"]);
