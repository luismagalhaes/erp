@page "/credit-notes/new"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@using Microsoft.Extensions.Localization
@using Erp.Main.Resources
@inject SalesApiClient SalesApi
@inject SeriesApiClient SeriesApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@Heading</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="@Heading" Breadcrumbs="Breadcrumbs">
        <Actions>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("credit-notes"))">
                @L["NewCreditNote_BackButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_series.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">
            @L["NewCreditNote_NoSeriesWarning"]
            <MudLink Href="series/new" Class="ml-2">@L["NewCreditNote_CreateSeriesLink"]</MudLink>
        </MudAlert>
    }
    else if (_rectifiable.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            @L["NewCreditNote_NoRectifiableInfo"]
        </MudAlert>
    }
    else
    {
        <EditorCard Title="@L["NewCreditNote_DocumentSectionTitle"]" Icon="@Icons.Material.Filled.CreditCard"
                    Description="@L["NewCreditNote_Description"]">
            <MudGrid Spacing="3">
                @* The customer comes first: picking one narrows the invoices to that customer's. *@
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="CustomerOption" Value="_customer" ValueChanged="OnCustomerChangedAsync"
                                     SearchFunc="SearchCustomersAsync"
                                     ToStringFunc="@(option => option is null ? string.Empty : $"{option.Name} ({option.TaxId})")"
                                     Label="@L["NewCreditNote_CustomerSelectLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Clearable="true" ResetValueOnEmptyText="true" Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="Guid?" Value="_rectifiedDocumentId" ValueChanged="OnDocumentChangedAsync"
                               Label="@L["NewCreditNote_InvoiceToCorrectLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Required="true" Disabled="@(_customer is null)">
                        @foreach (var document in _visibleDocuments)
                        {
                            <MudSelectItem T="Guid?" Value="@document.Id">
                                @L["NewCreditNote_InvoiceOption", document.DocumentNumber, document.DocumentDate.ToString("yyyy-MM-dd"), document.GrossTotal.ToString("N2")]
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudSelect @bind-Value="_seriesId" Label="@L["NewCreditNote_SeriesLabel"]" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Required="true">
                        @foreach (var series in _series)
                        {
                            <MudSelectItem T="Guid" Value="@series.Id">
                                @L["NewCreditNote_SeriesNextNumber", series.DocumentType, series.SeriesCode, series.CurrentSequence + 1]
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudDatePicker @bind-Date="_documentDate" Label="@L["NewCreditNote_DateLabel"]" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_reason" @bind-Value:after="StateHasChanged" Immediate="true"
                                  Label="@L["NewCreditNote_ReasonLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" HelperText="@L["NewCreditNote_ReasonHelpText"]" />
                </MudItem>
            </MudGrid>
        </EditorCard>

        @if (_source is not null)
        {
            <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NewCreditNote_CustomerLabel"]</MudText>
                        <MudText>@_source.CustomerName</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NewCreditNote_CustomerTaxIdPrefix", _source.CustomerTaxId]</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NewCreditNote_CorrectedDocumentLabel"]</MudText>
                        <MudText Style="font-family: monospace;">@_source.DocumentNumber</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @_source.DocumentDate.ToString("yyyy-MM-dd") · @_source.GrossTotal.ToString("N2")
                        </MudText>
                        @if (_source.CreditedAmount > 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Warning">
                                @L["NewCreditNote_AlreadyCredited", _source.CreditedAmount.ToString("N2"), Creditable.ToString("N2")]
                            </MudText>
                        }
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex align-center justify-end">
                        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                            <MudButton OnClick="CreditEverything">@L["NewCreditNote_CreditAllButton"]</MudButton>
                            <MudButton OnClick="CreditNothing">@L["NewCreditNote_ClearButton"]</MudButton>
                        </MudButtonGroup>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
                <MudText Typo="Typo.h6" Class="mb-3">@L["NewCreditNote_LinesSectionTitle"]</MudText>

                <MudTable Items="_lines" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh Style="width: 60px;"></MudTh>
                        <MudTh style="width: 90px;">@L["NewCreditNote_CodeColumn"]</MudTh>
                        <MudTh>@L["NewCreditNote_DescriptionColumn"]</MudTh>
                        <MudTh Style="width: 110px;">@L["NewCreditNote_InvoicedQuantityColumn"]</MudTh>
                        <MudTh Style="width: 130px;">@L["NewCreditNote_CreditQuantityColumn"]</MudTh>
                        <MudTh Style="width: 100px; text-align: right;">@L["NewCreditNote_PriceColumn"]</MudTh>
                        <MudTh Style="width: 70px; text-align: right;">@L["NewCreditNote_TaxColumn"]</MudTh>
                        <MudTh Style="width: 100px; text-align: right;">@L["NewCreditNote_TotalColumn"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudCheckBox T="bool" Value="@context.Selected"
                                         ValueChanged="@(selected => ToggleLine(context, selected))"
                                         Color="Color.Primary" Dense="true" />
                        </MudTd>
                        <MudTd DataLabel="@L["NewCreditNote_CodeColumn"]">@context.ProductCode</MudTd>
                        <MudTd DataLabel="@L["NewCreditNote_DescriptionColumn"]">@context.ProductDescription</MudTd>
                        <MudTd DataLabel="@L["NewCreditNote_InvoicedQuantityColumn"]">@context.InvoicedQuantity.ToString("N3")</MudTd>
                        <MudTd DataLabel="@L["NewCreditNote_CreditQuantityColumn"]">
                            @if (context.Selected)
                            {
                                <MudNumericField T="decimal" Value="@context.Quantity"
                                                 ValueChanged="@(quantity => SetQuantity(context, quantity))"
                                                 Margin="Margin.Dense" Min="0" Max="@context.InvoicedQuantity" />
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="@L["NewCreditNote_PriceColumn"]" Style="text-align: right;">@context.UnitPrice.ToString("N2")</MudTd>
                        <MudTd DataLabel="@L["NewCreditNote_TaxColumn"]" Style="text-align: right;">@context.TaxPercentage.ToString("N0")%</MudTd>
                        <MudTd DataLabel="@L["NewCreditNote_TotalColumn"]" Style="text-align: right;">@LineTotal(context).ToString("N2")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Row="true" Spacing="6">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NewCreditNote_NetTotalLabel"]</MudText>
                            <MudText Typo="Typo.h6">@NetTotal.ToString("N2")</MudText>
                        </MudStack>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NewCreditNote_TaxTotalLabel"]</MudText>
                            <MudText Typo="Typo.h6">@TaxTotal.ToString("N2")</MudText>
                        </MudStack>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NewCreditNote_GrossTotalLabel"]</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Primary">@GrossTotal.ToString("N2")</MudText>
                        </MudStack>
                    </MudStack>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.CreditCard"
                               Disabled="@(_issuing || !CanIssue)"
                               OnClick="IssueAsync">
                        @(_issuing ? L["NewCreditNote_IssuingButton"] : L["NewCreditNote_IssueButton", Designation.ToLowerInvariant()])
                    </MudButton>
                </MudStack>

                @if (ExceedsCreditable)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">
                        @L["NewCreditNote_ExceedsCreditable", _source.DocumentNumber, Creditable.ToString("N2"),
                            (_source.CreditedAmount > 0 ? L["NewCreditNote_ExceedsCreditableAlready", _source.CreditedAmount.ToString("N2")].Value : string.Empty)]
                    </MudAlert>
                }
                else if (IsFullCredit)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                        @L["NewCreditNote_FullCreditInfo", _source.DocumentNumber]
                    </MudAlert>
                }
            </MudPaper>
        }
    }
</MudStack>

@code {
    private bool _loading = true;
    private bool _issuing;
    private string? _error;

    private Guid _seriesId;
    private Guid? _rectifiedDocumentId;
    private DateTime? _documentDate = DateTime.Today;
    private string _reason = string.Empty;

    private List<SalesSeries> _series = [];
    private List<InvoiceListItem> _rectifiable = [];
    private List<InvoiceListItem> _visibleDocuments = [];
    private List<CustomerOption> _customers = [];
    private CustomerOption? _customer;
    private List<CreditLine> _lines = [];
    private InvoiceDetail? _source;

    /// <summary>A customer with documents left to correct, as the picker lists them.</summary>
    private sealed record CustomerOption(string TaxId, string Name);

    private List<BreadcrumbItem> Breadcrumbs =>
    [
        new(L["CreditNotes_PageTitle"].Value, href: "credit-notes"),
        new(Heading, href: null, disabled: true)
    ];

    private string SelectedDocumentType =>
        _series.FirstOrDefault(x => x.Id == _seriesId)?.DocumentType ?? "NC";

    private string Designation => InvoiceTypes.Describe(SelectedDocumentType);

    private string Heading => L["NewCreditNote_Heading", Designation.ToLowerInvariant()];

    private decimal NetTotal => _lines.Sum(LineTotal);

    private decimal TaxTotal => _lines.Sum(line =>
        Math.Round(LineTotal(line) * line.TaxPercentage / 100m, 2, MidpointRounding.AwayFromZero));

    private decimal GrossTotal => NetTotal + TaxTotal;

    /// <summary>True when every line is credited in full, which is the common case.</summary>
    private bool IsFullCredit =>
        _source is not null
        && _lines.Count > 0
        && _lines.All(line => line.Selected && line.Quantity == line.InvoicedQuantity);

    /// <summary>
    /// What is left of the invoice to credit: its total minus the credit notes already issued
    /// against it. The API enforces the same ceiling; this is only so the user sees it first.
    /// </summary>
    private decimal Creditable =>
        _source is null ? 0m : Math.Round(_source.GrossTotal - _source.CreditedAmount, 2, MidpointRounding.AwayFromZero);

    /// <summary>Only a credit note is capped; a debit note adds to what is owed.</summary>
    private bool IsCredit => !string.Equals(SelectedDocumentType, "ND", StringComparison.Ordinal);

    private bool ExceedsCreditable => _source is not null && IsCredit && GrossTotal > Creditable;

    private bool CanIssue =>
        _seriesId != Guid.Empty
        && _rectifiedDocumentId is not null
        && _documentDate is not null
        && !string.IsNullOrWhiteSpace(_reason)
        && _lines.Any(line => line.Selected && line.Quantity > 0)
        && !ExceedsCreditable;

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = Company.LoadError;

        if (!Company.HasCompany)
        {
            _series = [];
            _rectifiable = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            var series = await SeriesApi.GetSeriesAsync(Company.SelectedCompanyId);
            _series = [.. series.Where(x => x.CanIssue && InvoiceTypes.IsRectifying(x.DocumentType))];
            _seriesId = _series.FirstOrDefault()?.Id ?? Guid.Empty;

            // A voided document has nothing to correct, and a note cannot correct another note.
            var documents = await SalesApi.GetInvoicesAsync(Company.SelectedCompanyId);
            _rectifiable = [.. documents.Where(x => x.Status != "A" && !InvoiceTypes.IsRectifying(x.DocumentType))];

            // The customers come from those documents: offering one with nothing to correct would
            // only lead to an empty list of invoices.
            _customers = [.. _rectifiable
                .GroupBy(document => document.CustomerTaxId, StringComparer.Ordinal)
                .Select(group => new CustomerOption(group.Key, group.First().CustomerName))
                .OrderBy(customer => customer.Name)];

            await OnCustomerChangedAsync(_customers.Count == 1 ? _customers[0] : null);
        }
        catch (Exception ex)
        {
            _error = L["NewCreditNote_LoadError", ex.Message];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Task<IEnumerable<CustomerOption>> SearchCustomersAsync(string? text, CancellationToken cancellationToken)
    {
        IEnumerable<CustomerOption> matches = string.IsNullOrWhiteSpace(text)
            ? _customers
            : _customers.Where(customer =>
                customer.Name.Contains(text, StringComparison.OrdinalIgnoreCase)
                || customer.TaxId.Contains(text, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    /// <summary>
    /// Choosing the customer is the first step: the documents to correct are then only theirs, and
    /// the one at the top — the most recent — is loaded straight away.
    /// </summary>
    private async Task OnCustomerChangedAsync(CustomerOption? customer)
    {
        _customer = customer;
        _visibleDocuments = customer is null
            ? []
            : [.. _rectifiable.Where(document => string.Equals(document.CustomerTaxId, customer.TaxId, StringComparison.Ordinal))];

        await OnDocumentChangedAsync(_visibleDocuments.FirstOrDefault()?.Id);
    }

    /// <summary>
    /// Loads the invoice and copies its lines. Everything starts selected in full, so the common
    /// case — credit the whole invoice — is a single click away.
    /// </summary>
    private async Task OnDocumentChangedAsync(Guid? documentId)
    {
        _rectifiedDocumentId = documentId;
        _source = null;
        _lines = [];

        if (documentId is null)
            return;

        _source = await SalesApi.GetInvoiceAsync(documentId.Value);

        if (_source is null)
        {
            _error = L["NewCreditNote_LoadSourceInvoiceError"];
            return;
        }

        _lines = [.. _source.Lines.Select(line => new CreditLine
        {
            ProductCode = line.ProductCode,
            ProductDescription = line.ProductDescription,
            InvoicedQuantity = line.Quantity,
            Quantity = line.Quantity,
            UnitOfMeasure = line.UnitOfMeasure,
            UnitPrice = line.UnitPrice,
            TaxCode = line.TaxCode,
            TaxPercentage = line.TaxPercentage,
            TaxExemptionCode = line.TaxExemptionCode,
            TaxExemptionReason = line.TaxExemptionReason,
            DiscountPercentage = line.DiscountPercentage,
            Selected = true
        })];
    }

    private void ToggleLine(CreditLine line, bool selected)
    {
        line.Selected = selected;

        // Re-selecting a line brings back the full quantity, which is what is usually wanted.
        if (selected && line.Quantity == 0)
            line.Quantity = line.InvoicedQuantity;
    }

    private static void SetQuantity(CreditLine line, decimal quantity) =>
        line.Quantity = Math.Clamp(quantity, 0m, line.InvoicedQuantity);

    private void CreditEverything()
    {
        foreach (var line in _lines)
        {
            line.Selected = true;
            line.Quantity = line.InvoicedQuantity;
        }
    }

    private void CreditNothing()
    {
        foreach (var line in _lines)
            line.Selected = false;
    }

    /// <summary>
    /// The same arithmetic as the API: the line discount that came from the invoice is taken off the
    /// rounded gross amount, so a full credit gives back exactly what was charged.
    /// </summary>
    private static decimal LineTotal(CreditLine line)
    {
        if (!line.Selected)
            return 0m;

        var gross = Math.Round(line.Quantity * line.UnitPrice, 2, MidpointRounding.AwayFromZero);
        var discount = Math.Round(gross * line.DiscountPercentage / 100m, 2, MidpointRounding.AwayFromZero);

        return gross - discount;
    }

    private async Task IssueAsync()
    {
        _issuing = true;
        _error = null;

        try
        {
            var request = new CreateInvoiceRequest(
                Company.SelectedCompanyId,
                _seriesId,
                DateOnly.FromDateTime(_documentDate!.Value),
                // The note is issued to the customer of the document it corrects.
                new CustomerRequest(_source!.CustomerTaxId, _source.CustomerName, _source.CustomerAddress),
                [.. _lines
                    .Where(line => line.Selected && line.Quantity > 0)
                    .Select(line => new CreateInvoiceLineRequest(
                        line.ProductCode,
                        line.ProductDescription,
                        line.Quantity,
                        line.UnitPrice,
                        line.TaxCode,
                        line.TaxPercentage,
                        line.UnitOfMeasure,
                        TaxExemptionCode: line.TaxExemptionCode,
                        TaxExemptionReason: line.TaxExemptionReason,
                        DiscountPercentage: line.DiscountPercentage))],
                RectifiedDocumentId: _rectifiedDocumentId,
                RectificationReason: _reason.Trim());

            var (note, error) = await SalesApi.IssueInvoiceAsync(request);

            if (note is null)
            {
                _error = error ?? L["NewCreditNote_IssueFailed"];
                return;
            }

            Snackbar.Add(L["NewCreditNote_IssuedSuccess", InvoiceTypes.Describe(note.DocumentType), note.DocumentNumber].Value, Severity.Success);
            Navigation.NavigateTo($"invoices/{note.Id}");
        }
        catch (Exception ex)
        {
            _error = L["NewCreditNote_IssueError", ex.Message];
        }
        finally
        {
            _issuing = false;
        }
    }

    /// <summary>A line of the corrected invoice, with how much of it is being credited.</summary>
    private sealed class CreditLine
    {
        public bool Selected { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductDescription { get; set; } = string.Empty;
        public decimal InvoicedQuantity { get; set; }
        public decimal Quantity { get; set; }
        public string UnitOfMeasure { get; set; } = "UN";
        public decimal UnitPrice { get; set; }
        public string TaxCode { get; set; } = string.Empty;
        public decimal TaxPercentage { get; set; }
        public string? TaxExemptionCode { get; set; }
        public string? TaxExemptionReason { get; set; }
        public decimal DiscountPercentage { get; set; }
    }

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
