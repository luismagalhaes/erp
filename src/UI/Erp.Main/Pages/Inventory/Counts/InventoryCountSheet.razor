@page "/inventory-counts/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject StockApiClient StockApi
@inject CatalogApiClient Catalog
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@(_count?.Reference ?? Localizer["InventoryCountSheet_DefaultTitle"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(_count?.Reference ?? Localizer["InventoryCountSheet_DefaultTitle"])</MudText>
            @if (_count is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_count.CountDate.ToString("yyyy-MM-dd") · @ScopeLabel(_count.Scope) ·
                    @(_count.IsOpen ? Localizer["InventoryCountSheet_OpenStatus"] : string.Format(Localizer["InventoryCountSheet_ClosedStatus"], _count.ClosedAtUtc?.ToString("yyyy-MM-dd HH:mm")))
                </MudText>
            }
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("inventory-counts"))">
            @Localizer["InventoryCountSheet_BackButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_count is null)
    {
        <MudAlert Severity="Severity.Warning">@Localizer["InventoryCountSheet_NotFound"]</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["InventoryCountSheet_ProductsLabel"]</MudText>
                    <MudText Typo="Typo.h5">@_lines.Count</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["InventoryCountSheet_DifferenceLabel"]</MudText>
                    <MudText Typo="Typo.h5" Color="@(DifferenceCount == 0 ? Color.Default : Color.Warning)">
                        @DifferenceCount
                    </MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["InventoryCountSheet_TotalAdjustmentLabel"]</MudText>
                    <MudText Typo="Typo.h5">@TotalDifference.ToString("N3")</MudText>
                </MudItem>
                <MudItem xs="6" md="3" Class="d-flex align-center justify-end">
                    @if (_count.IsOpen)
                    {
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenAddLine">
                                @Localizer["InventoryCountSheet_ProductButton"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Disabled="@(_saving || !HasUnsavedChanges)"
                                       OnClick="SaveAsync">
                                @(_saving ? Localizer["InventoryCountSheet_Saving"] : Localizer["InventoryCountSheet_SaveButton"])
                            </MudButton>
                        </MudStack>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_count.IsOpen && HasUnsavedChanges)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                @Localizer["InventoryCountSheet_UnsavedNotice"]
            </MudAlert>
        }

        @if (_count.IsOpen && _lines.Count == 0)
        {
            <MudAlert Severity="Severity.Info">
                @string.Format(Localizer["InventoryCountSheet_EmptySheetNotice"], Localizer["InventoryCountSheet_OpeningStockTerm"], Localizer["InventoryCountSheet_ProductButton"])
            </MudAlert>
        }

        <MudPaper Elevation="1" Class="pa-2">
            <MudTable Items="Visible" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <ToolBarContent>
                    <MudTextField @bind-Value="_filter" @bind-Value:after="StateHasChanged" Immediate="true"
                                  Placeholder="@Localizer["InventoryCountSheet_SearchPlaceholder"]" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense"
                                  Class="mt-0" Style="max-width: 320px;" />
                    <MudSpacer />
                    <MudSwitch @bind-Value="_onlyDifferences" @bind-Value:after="StateHasChanged"
                               Color="Color.Primary" Label="@Localizer["InventoryCountSheet_OnlyDifferencesLabel"]" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>@Localizer["InventoryCountSheet_ProductColumn"]</MudTh>
                    <MudTh>@Localizer["InventoryCountSheet_DescriptionColumn"]</MudTh>
                    <MudTh>@Localizer["InventoryCountSheet_WarehouseColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["InventoryCountSheet_SystemColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["InventoryCountSheet_CountedColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["InventoryCountSheet_DifferenceColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Localizer["InventoryCountSheet_ProductColumn"]">
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.ProductCode</MudText>
                    </MudTd>
                    <MudTd DataLabel="@Localizer["InventoryCountSheet_DescriptionColumn"]">@context.ProductDescription</MudTd>
                    <MudTd DataLabel="@Localizer["InventoryCountSheet_WarehouseColumn"]">@WarehouseName(context.WarehouseId)</MudTd>
                    <MudTd DataLabel="@Localizer["InventoryCountSheet_SystemColumn"]" Style="text-align: right;">
                        @context.SystemQuantity.ToString("N3")
                    </MudTd>
                    <MudTd DataLabel="@Localizer["InventoryCountSheet_CountedColumn"]" Style="text-align: right;">
                        @if (_count.IsOpen)
                        {
                            <MudNumericField T="decimal" Value="context.CountedQuantity"
                                             ValueChanged="@(value => SetCounted(context, value))"
                                             Variant="Variant.Text" Margin="Margin.Dense"
                                             HideSpinButtons="true" Style="max-width: 120px;"
                                             Class="ml-auto" Format="N3" />
                        }
                        else
                        {
                            @context.CountedQuantity.ToString("N3")
                        }
                    </MudTd>
                    <MudTd DataLabel="@Localizer["InventoryCountSheet_DifferenceColumn"]" Style="text-align: right;">
                        <MudText Typo="Typo.body2" Color="@DifferenceColor(context.Difference)">
                            <strong>@Signed(context.Difference)</strong>
                        </MudText>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["InventoryCountSheet_NoRecords"]</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        @if (_count.IsOpen)
        {
            <MudExpansionPanels>
                <MudExpansionPanel Text="@Localizer["InventoryCountSheet_CloseTitle"]">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @Localizer["InventoryCountSheet_CloseDescription"]
                    </MudText>

                    @if (HasUnsavedChanges)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                            @Localizer["InventoryCountSheet_CloseUnsavedWarning"]
                        </MudAlert>
                    }

                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Lock"
                               Disabled="@(_closing || HasUnsavedChanges)"
                               OnClick="CloseAsync">
                        @(_closing ? Localizer["InventoryCountSheet_Closing"] : string.Format(Localizer["InventoryCountSheet_CloseButton"], DifferenceCount))
                    </MudButton>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
        else
        {
            <MudAlert Severity="Severity.Success">
                @string.Format(Localizer["InventoryCountSheet_ClosedNotice"], string.Format(Localizer["InventoryCountSheet_ClosedReferencePrefix"], _count.Reference))
                <MudLink Href="stock" Class="ml-2">@Localizer["InventoryCountSheet_ViewStockLink"]</MudLink>
            </MudAlert>
        }
    }
</MudStack>

@* --- Acrescentar artigo à folha --- *@
<MudDialog @bind-Visible="_addOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["InventoryCountSheet_AddLineTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            @Localizer["InventoryCountSheet_AddLineDescription"]
        </MudText>

        <MudGrid>
            <MudItem xs="12" md="7">
                <MudSelect T="Guid?" Value="_addProductId" ValueChanged="OnAddProductChanged"
                           Label="@Localizer["InventoryCountSheet_AddProductLabel"]" Variant="Variant.Outlined" Required="true">
                    @foreach (var product in _products)
                    {
                        <MudSelectItem T="Guid?" Value="@product.Id">
                            @product.ProductCode — @product.Description
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="5">
                <MudSelect T="Guid?" @bind-Value="_addWarehouseId" @bind-Value:after="StateHasChanged"
                           Label="@Localizer["InventoryCountSheet_AddWarehouseLabel"]" Variant="Variant.Outlined" Required="true"
                           Disabled="@(_count?.WarehouseId is not null)"
                           HelperText="@(_count?.WarehouseId is not null ? (string?)Localizer["InventoryCountSheet_AddWarehouseHelperText"] : null)">
                    @foreach (var warehouse in _warehouses)
                    {
                        <MudSelectItem T="Guid?" Value="@warehouse.Id">
                            @warehouse.Code — @warehouse.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="5">
                <MudNumericField T="decimal?" @bind-Value="_addUnitCost" Label="@Localizer["InventoryCountSheet_AddUnitCostLabel"]"
                                 Variant="Variant.Outlined" Format="N4" Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="7" Class="d-flex align-center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @Localizer["InventoryCountSheet_AddUnitCostNotice"]
                </MudText>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _addOpen = false)">@Localizer["InventoryCountSheet_CancelButton"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_adding || _addProductId is null || _addWarehouseId is null)"
                   OnClick="AddLineAsync">
            @Localizer["InventoryCountSheet_AddButton"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _closing;
    private bool _onlyDifferences;
    private string? _error;
    private string _filter = string.Empty;

    private InventoryCount? _count;
    private List<InventoryCountLine> _lines = [];
    private List<Warehouse> _warehouses = [];
    private List<ProductListItem> _products = [];

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private bool _addOpen;
    private bool _adding;
    private Guid? _addProductId;
    private Guid? _addWarehouseId;
    private decimal? _addUnitCost;

    /// <summary>
    /// What was typed but not yet sent. Only these lines travel on save, which keeps a count of a
    /// few thousand articles from resending everything on every keystroke.
    /// </summary>
    private readonly Dictionary<Guid, decimal> _pending = [];

    private bool HasUnsavedChanges => _pending.Count > 0;

    private int DifferenceCount => _lines.Count(line => line.Difference != 0);

    private decimal TotalDifference => _lines.Sum(line => line.Difference);

    private IEnumerable<InventoryCountLine> Visible => _lines
        .Where(line => !_onlyDifferences || line.Difference != 0)
        .Where(line => string.IsNullOrWhiteSpace(_filter)
                       || line.ProductCode.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                       || line.ProductDescription.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _count = await StockApi.GetInventoryCountAsync(Id);
            _lines = _count is null ? [] : [.. _count.Lines];
            _pending.Clear();

            if (_count is not null)
            {
                var (warehouses, error) = await StockApi.GetWarehousesAsync(_count.CompanyId);
                _warehouses = [.. warehouses.Where(warehouse => warehouse.IsActive)];

                // The sheet can grow, so the product file has to be at hand.
                var (products, productsError) = await Catalog.GetProductsAsync(_count.CompanyId);
                _products = [.. products.Where(product => product.IsActive)
                    .OrderBy(product => product.ProductCode, StringComparer.Ordinal)];

                _error = error ?? productsError;
            }
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["InventoryCountSheet_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenAddLine()
    {
        _addProductId = null;
        _addUnitCost = null;

        // A count of one warehouse has only one answer, so it is fixed rather than asked for.
        _addWarehouseId = _count?.WarehouseId ?? _warehouses.FirstOrDefault(x => x.IsDefault)?.Id
            ?? _warehouses.FirstOrDefault()?.Id;

        _addOpen = true;
    }

    /// <summary>Suggests the cost from the product file, which the user is free to overwrite.</summary>
    private void OnAddProductChanged(Guid? productId)
    {
        _addProductId = productId;

        if (_products.FirstOrDefault(x => x.Id == productId) is { } product && _addUnitCost is null)
            _addUnitCost = product.UnitCost == 0 ? null : product.UnitCost;

        StateHasChanged();
    }

    private async Task AddLineAsync()
    {
        if (_products.FirstOrDefault(x => x.Id == _addProductId) is not { } product)
            return;

        _adding = true;
        _error = null;

        try
        {
            var (count, error) = await StockApi.AddCountLineAsync(Id, new AddCountLineRequest(
                _addWarehouseId!.Value, product.ProductCode, product.Description, _addUnitCost));

            if (count is null)
            {
                _error = error ?? Localizer["InventoryCountSheet_AddLineFailed"];
                return;
            }

            // Reloading keeps whatever was typed and not yet saved, which the new sheet would drop.
            _count = count;
            _lines = [.. count.Lines.Select(line =>
                _pending.TryGetValue(line.Id, out var counted) ? line with { CountedQuantity = counted } : line)];

            Snackbar.Add(string.Format(Localizer["InventoryCountSheet_LineAdded"], product.ProductCode), Severity.Success);
            _addOpen = false;
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["InventoryCountSheet_AddLineError"], ex.Message);
        }
        finally
        {
            _adding = false;
        }
    }

    private void SetCounted(InventoryCountLine line, decimal counted)
    {
        var index = _lines.FindIndex(x => x.Id == line.Id);
        if (index < 0)
            return;

        _lines[index] = line with { CountedQuantity = counted };
        _pending[line.Id] = counted;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var changes = _pending
                .Select(entry => new CountedLineRequest(entry.Key, entry.Value))
                .ToList();

            var (count, error) = await StockApi.SetCountedAsync(Id, changes);

            if (count is null)
            {
                _error = error ?? Localizer["InventoryCountSheet_SaveFailed"];
                return;
            }

            _count = count;
            _lines = [.. count.Lines];
            _pending.Clear();

            Snackbar.Add(string.Format("{0} {1}.", changes.Count,
                changes.Count == 1 ? Localizer["InventoryCountSheet_LineSavedSingular"] : Localizer["InventoryCountSheet_LineSavedPlural"]), Severity.Success);
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["InventoryCountSheet_SaveError"], ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CloseAsync()
    {
        _closing = true;
        _error = null;

        try
        {
            var (count, error) = await StockApi.CloseInventoryCountAsync(Id);

            if (count is null)
            {
                _error = error ?? Localizer["InventoryCountSheet_CloseFailed"];
                return;
            }

            _count = count;
            _lines = [.. count.Lines];
            _pending.Clear();

            var applied = count.Lines.Count(line => line.AppliedDifference is not null and not 0);
            Snackbar.Add(
                applied == 0
                    ? Localizer["InventoryCountSheet_ClosedNoAdjustments"]
                    : string.Format(Localizer["InventoryCountSheet_ClosedWithAdjustments"], applied,
                        applied == 1 ? Localizer["InventoryCountSheet_ClosedWithAdjustmentSingular"] : Localizer["InventoryCountSheet_ClosedWithAdjustmentPlural"]),
                Severity.Success);
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["InventoryCountSheet_CloseError"], ex.Message);
        }
        finally
        {
            _closing = false;
        }
    }

    private string WarehouseName(Guid warehouseId) =>
        _warehouses.FirstOrDefault(x => x.Id == warehouseId)?.Code ?? "—";

    private static Color DifferenceColor(decimal difference) => difference switch
    {
        0 => Color.Default,
        < 0 => Color.Error,
        _ => Color.Success
    };

    private static string Signed(decimal difference) =>
        difference > 0 ? $"+{difference:N3}" : difference.ToString("N3");

    private string ScopeLabel(string scope) => scope switch
    {
        "Total" => Localizer["InventoryCountSheet_ScopeTotal"],
        "Warehouse" => Localizer["InventoryCountSheet_ScopeWarehouse"],
        "Products" => Localizer["InventoryCountSheet_ScopeProducts"],
        _ => scope
    };
}
