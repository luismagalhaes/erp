@page "/invoices/new"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject SalesApiClient SalesApi
@inject SeriesApiClient SeriesApi
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["NewInvoice_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@L["NewInvoice_HeaderTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["NewInvoice_Description"]
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("invoices"))">
            @L["NewInvoice_BackButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_series.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">
            @L["NewInvoice_NoSeriesWarning"]
            <MudLink Href="series" Class="ml-2">@L["NewInvoice_ManageSeriesLink"]</MudLink>
        </MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect @bind-Value="_seriesId" Label="@L["NewInvoice_SeriesLabel"]" Variant="Variant.Outlined" Required="true">
                        @foreach (var series in _series)
                        {
                            <MudSelectItem T="Guid" Value="@series.Id">
                                @string.Format(L["NewInvoice_SeriesNextNumber"], series.DocumentType, series.SeriesCode, series.CurrentSequence + 1)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_documentDate" Label="@L["NewInvoice_DocumentDateLabel"]"
                                   Variant="Variant.Outlined" DateFormat="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">@L["NewInvoice_CustomerSectionTitle"]</MudText>
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_customerTaxId" Label="@L["NewInvoice_TaxIdLabel"]"
                                  Variant="Variant.Outlined"
                                  HelperText="@L["NewInvoice_TaxIdHelperText"]" />
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudTextField @bind-Value="_customerName" Label="@L["NewInvoice_NameLabel"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_customerAddress" Label="@L["NewInvoice_AddressLabel"]" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">@L["NewInvoice_LinesSectionTitle"]</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">
                    @L["NewInvoice_AddLineButton"]
                </MudButton>
            </MudStack>

            <MudTable Items="_lines" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Style="width: 200px;">@L["NewInvoice_ProductColumn"]</MudTh>
                    <MudTh>@L["NewInvoice_DescriptionColumn"]</MudTh>
                    <MudTh Style="width: 100px;">@L["NewInvoice_QuantityColumn"]</MudTh>
                    <MudTh Style="width: 130px;">@L["NewInvoice_UnitPriceColumn"]</MudTh>
                    <MudTh Style="width: 150px;">@L["NewInvoice_TaxColumn"]</MudTh>
                    <MudTh Style="width: 110px; text-align: right;">@L["NewInvoice_TotalColumn"]</MudTh>
                    <MudTh Style="width: 70px; text-align: right;">@L["NewInvoice_ActionsColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["NewInvoice_ProductColumn"]">
                        @if (_products.Count > 0)
                        {
                            <MudSelect T="Guid?" Value="context.ProductId"
                                       ValueChanged="@(productId => OnProductChanged(context, productId))"
                                       Margin="Margin.Dense" Clearable="true" Placeholder="@L["NewInvoice_FreeProductPlaceholder"]">
                                @foreach (var product in _products)
                                {
                                    <MudSelectItem T="Guid?" Value="@product.Id">
                                        @product.ProductCode — @product.Description
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudTextField @bind-Value="context.ProductCode" Margin="Margin.Dense" Placeholder="@L["NewInvoice_ProductCodePlaceholder"]" />
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["NewInvoice_DescriptionColumn"]">
                        <MudTextField @bind-Value="context.ProductDescription" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd DataLabel="@L["NewInvoice_QuantityColumn"]">
                        <MudNumericField @bind-Value="context.Quantity" Margin="Margin.Dense" Min="0" />
                    </MudTd>
                    <MudTd DataLabel="@L["NewInvoice_UnitPriceColumn"]">
                        <MudNumericField @bind-Value="context.UnitPrice" Margin="Margin.Dense" Min="0" Format="N2" />
                    </MudTd>
                    <MudTd DataLabel="@L["NewInvoice_TaxColumn"]">
                        <MudSelect T="string" Value="context.TaxCode"
                                   ValueChanged="@(code => OnTaxCodeChanged(context, code))"
                                   Margin="Margin.Dense">
                            @foreach (var rate in _taxRates)
                            {
                                <MudSelectItem T="string" Value="@rate.Code">@rate.Label (@rate.Percentage.ToString("0.##")%)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd DataLabel="@L["NewInvoice_TotalColumn"]" Style="text-align: right;">@LineTotal(context).ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["NewInvoice_ActionsColumn"]" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       title="@L["NewInvoice_RemoveLineTooltip"]"
                                       Disabled="@(_lines.Count == 1)"
                                       OnClick="@(() => RemoveLine(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            @if (_lines.Any(x => x.TaxCode == ExemptCode))
            {
                <MudTextField @bind-Value="_exemptionReason" Class="mt-4"
                              Label="@L["NewInvoice_ExemptionReasonLabel"]" Variant="Variant.Outlined"
                              HelperText="@L["NewInvoice_ExemptionReasonHelperText"]" />
            }
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Row="true" Spacing="6">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NewInvoice_TaxableBaseLabel"]</MudText>
                        <MudText Typo="Typo.h6">@NetTotal.ToString("N2")</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NewInvoice_TaxLabel"]</MudText>
                        <MudText Typo="Typo.h6">@TaxTotal.ToString("N2")</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NewInvoice_TotalLabel"]</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Primary">@GrossTotal.ToString("N2")</MudText>
                    </MudStack>
                </MudStack>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Receipt"
                           Disabled="@(_issuing || !CanIssue)"
                           OnClick="IssueAsync">
                    @(_issuing ? L["NewInvoice_IssuingButton"] : L["NewInvoice_IssueButton"])
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    private const string ExemptCode = "ISE";

    private bool _loading = true;
    private bool _issuing;
    private string? _error;

    private Guid _seriesId;
    private DateTime? _documentDate = DateTime.Today;
    private string _customerTaxId = string.Empty;
    private string _customerName = string.Empty;
    private string _customerAddress = string.Empty;
    private string _exemptionReason = string.Empty;

    private List<SalesSeries> _series = [];
    private List<ProductListItem> _products = [];
    private List<VatRate> _taxRates = [];
    private readonly List<LineEditor> _lines = [new()];

    private decimal NetTotal => _lines.Sum(LineTotal);

    private decimal TaxTotal => _lines.Sum(line =>
        Math.Round(LineTotal(line) * line.TaxPercentage / 100m, 2, MidpointRounding.AwayFromZero));

    private decimal GrossTotal => NetTotal + TaxTotal;

    private bool CanIssue =>
        _seriesId != Guid.Empty
        && _documentDate is not null
        && !string.IsNullOrWhiteSpace(_customerName)
        && _lines.All(line => line.Quantity > 0 && !string.IsNullOrWhiteSpace(line.ProductDescription))
        && (!_lines.Any(line => line.TaxCode == ExemptCode) || !string.IsNullOrWhiteSpace(_exemptionReason));

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = Company.LoadError;

        if (!Company.HasCompany)
        {
            _series = [];
            _products = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            var series = await SeriesApi.GetSeriesAsync(Company.SelectedCompanyId);

            // Only series that create a sale. Notas de crédito e de débito têm ecrã próprio, onde
            // partem da fatura em vez de se escreverem outra vez, e as guias e recibos também.
            _series = [.. series.Where(x => x.CanIssue && InvoiceTypes.IsSale(x.DocumentType))];
            _seriesId = _series.FirstOrDefault()?.Id ?? Guid.Empty;

            // The catalogue is master data served by the Core module, not by Sales.
            var (products, _) = await Catalog.GetProductsAsync(Company.SelectedCompanyId);
            _products = [.. products.Where(x => x.IsActive)];

            // Mainland rates — this document has no fiscal-region selector of its own.
            var (rates, _) = await Catalog.GetVatRatesAsync();
            _taxRates = [.. rates.Where(x => x.FiscalRegion == "PT" && x.IsActive)];
        }
        catch (Exception ex)
        {
            _error = string.Format(L["NewInvoice_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void AddLine() => _lines.Add(new LineEditor());

    private void RemoveLine(LineEditor line)
    {
        if (_lines.Count > 1)
            _lines.Remove(line);
    }

    private void OnProductChanged(LineEditor line, Guid? productId)
    {
        line.ProductId = productId;

        var product = _products.FirstOrDefault(x => x.Id == productId);
        if (product is null)
            return;

        line.ProductCode = product.ProductCode;
        line.ProductDescription = product.Description;
        line.UnitPrice = product.UnitPrice;
        line.TaxCode = product.DefaultTaxCode;
        line.TaxPercentage = product.DefaultTaxPercentage;
    }

    private void OnTaxCodeChanged(LineEditor line, string taxCode)
    {
        line.TaxCode = taxCode;
        line.TaxPercentage = _taxRates.First(rate => rate.Code == taxCode).Percentage;
    }

    private static decimal LineTotal(LineEditor line) =>
        Math.Round(line.Quantity * line.UnitPrice, 2, MidpointRounding.AwayFromZero);

    private async Task IssueAsync()
    {
        _issuing = true;
        _error = null;

        try
        {
            var request = new CreateInvoiceRequest(
                Company.SelectedCompanyId,
                _seriesId,
                DateOnly.FromDateTime(_documentDate!.Value),
                new CustomerRequest(
                    string.IsNullOrWhiteSpace(_customerTaxId) ? null : _customerTaxId.Trim(),
                    _customerName.Trim(),
                    string.IsNullOrWhiteSpace(_customerAddress) ? null : _customerAddress.Trim()),
                [.. _lines.Select(line => new CreateInvoiceLineRequest(
                    string.IsNullOrWhiteSpace(line.ProductCode) ? "GEN" : line.ProductCode,
                    line.ProductDescription,
                    line.Quantity,
                    line.UnitPrice,
                    line.TaxCode,
                    line.TaxPercentage,
                    TaxExemptionReason: line.TaxCode == ExemptCode ? _exemptionReason : null))]);

            var (invoice, error) = await SalesApi.IssueInvoiceAsync(request);

            if (invoice is null)
            {
                _error = error ?? L["NewInvoice_IssueFailed"];
                return;
            }

            Snackbar.Add(string.Format(L["NewInvoice_IssuedSuccess"], InvoiceTypes.Describe(invoice.DocumentType), invoice.DocumentNumber), Severity.Success);
            Navigation.NavigateTo($"invoices/{invoice.Id}");
        }
        catch (Exception ex)
        {
            _error = string.Format(L["NewInvoice_IssueError"], ex.Message);
        }
        finally
        {
            _issuing = false;
        }
    }

    private sealed class LineEditor
    {
        public Guid? ProductId { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductDescription { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public string TaxCode { get; set; } = "NOR";
        public decimal TaxPercentage { get; set; } = 23m;
    }

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
