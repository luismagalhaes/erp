@page "/supplier-invoices"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@inject PurchasingApiClient Purchasing
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Faturas de fornecedor</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="Faturas de fornecedor">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("supplier-invoices/new"))">
                Registar fatura
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="PurchaseInvoiceListItem"
              LoadAsync="@((companyId, query, ct) => Purchasing.QueryInvoicesAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="SupplierDocumentDate desc,SupplierDocumentNumber desc"
              SearchPlaceholder="Procurar número, fornecedor ou NIF"
              EmptyIcon="@Icons.Material.Filled.ReceiptLong"
              EmptyTitle="Sem faturas para mostrar"
              EmptyDescription="Ajuste os filtros ou registe a primeira fatura de fornecedor."
              ItemsLabel="faturas"
              LoadErrorMessage="Não foi possível carregar as faturas">
        <Columns>
            <PropertyColumn Property="x => x.DocumentType" Title="Tipo" />
            <PropertyColumn Property="x => x.SupplierDocumentNumber" Title="Número" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.SupplierDocumentDate" Title="Data" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.DueDate" Title="Vencimento">
                <CellTemplate>
                    <MudText Typo="Typo.body2" Color="@DueColor(context.Item)">
                        @(context.Item.DueDate?.ToString("yyyy-MM-dd") ?? "—")
                    </MudText>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.SupplierName" Title="Fornecedor" />
            <PropertyColumn Property="x => x.SupplierTaxId" Title="NIF" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.NetTotal" Title="Base" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.TaxTotal" Title="IVA" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.GrossTotal" Title="Total" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.ReverseCharge" Title="Autoliquidação">
                <CellTemplate>
                    @if (context.Item.ReverseCharge)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                            Autoliq.
                        </MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">—</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Status" Title="Estado">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsVoided ? Color.Error : Color.Success)">
                        @(context.Item.IsVoided ? "Anulada" : "Escriturada")
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"supplier-invoices/{context.Item.Id}"))">
                            Abrir fatura
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["SupplierDocumentNumber", "SupplierName", "SupplierTaxId"];

    /// <summary>An unpaid invoice past its date is worth pointing at; a voided one is owed nothing.</summary>
    private static Color DueColor(PurchaseInvoiceListItem invoice) =>
        !invoice.IsVoided && invoice.DueDate is { } due && due < DateOnly.FromDateTime(DateTime.Today)
            ? Color.Error
            : Color.Default;
}
