@using MudBlazor
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using Erp.Common

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>

    <MudNavGroup Title="Clientes e Fornecedores" Icon="@Icons.Material.Filled.People" Expanded="false">
        <MudNavLink Href="customers" Icon="@Icons.Material.Filled.PersonOutline">Clientes</MudNavLink>
        <MudNavLink Href="suppliers" Icon="@Icons.Material.Filled.Business">Fornecedores</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Faturação" Icon="@Icons.Material.Filled.Receipt" Expanded="true">
        <MudNavLink Href="invoices" Icon="@Icons.Material.Filled.ReceiptLong">Faturas</MudNavLink>
        <MudNavLink Href="credit-notes" Icon="@Icons.Material.Filled.CreditCard">Notas de crédito</MudNavLink>
        <MudNavLink Href="payments" Icon="@Icons.Material.Filled.Payments">Recibos</MudNavLink>
        @* GR, GT, GA, GC e GD: documentos fiscais emitidos pelo módulo de vendas, não movimentos de existências. *@
        <MudNavLink Href="stock-movements" Icon="@Icons.Material.Filled.LocalShipping">Guias de movimentação</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Artigos" Icon="@Icons.Material.Filled.Inventory" Expanded="false">
        <MudNavLink Href="products" Icon="@Icons.Material.Filled.Category">Artigos</MudNavLink>
        <MudNavLink Href="product-families" Icon="@Icons.Material.Filled.AccountTree">Famílias</MudNavLink>
        <MudNavLink Href="product-subfamilies" Icon="@Icons.Material.Filled.Segment">Subfamílias</MudNavLink>
        <MudNavLink Href="brands" Icon="@Icons.Material.Filled.Sell">Marcas</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Stock" Icon="@Icons.Material.Filled.Warehouse" Expanded="false">
        <MudNavLink Href="stock" Icon="@Icons.Material.Filled.Inventory2">Existências</MudNavLink>
        <MudNavLink Href="warehouses" Icon="@Icons.Material.Filled.Warehouse">Armazéns</MudNavLink>
        <MudNavLink Href="inventory-counts" Icon="@Icons.Material.Filled.PlaylistAddCheck">Inventários</MudNavLink>
        <MudNavLink Href="stock/check" Icon="@Icons.Material.Filled.FactCheck">Teste de stock</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Compras" Icon="@Icons.Material.Filled.ShoppingCart" Expanded="false">
        <MudNavLink Href="purchase-orders" Icon="@Icons.Material.Filled.ShoppingBag">Encomendas</MudNavLink>
        <MudNavLink Href="goods-receipts" Icon="@Icons.Material.Filled.MoveToInbox">Receções</MudNavLink>
        <MudNavLink Href="supplier-returns" Icon="@Icons.Material.Filled.Undo">Devoluções</MudNavLink>
        <MudNavLink Href="supplier-invoices" Icon="@Icons.Material.Filled.RequestPage">Faturas de fornecedor</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Contabilidade" Icon="@Icons.Material.Filled.AccountBalance" Expanded="false">
        <MudNavLink Href="journal-entries" Icon="@Icons.Material.Filled.BookmarkAdd">Lançamentos</MudNavLink>
        <MudNavLink Href="chart-of-accounts" Icon="@Icons.Material.Filled.AccountTree">Plano de contas</MudNavLink>
        <MudNavLink Href="trial-balance" Icon="@Icons.Material.Filled.TableChart">Balancete</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Relatórios e AT" Icon="@Icons.Material.Filled.Assessment" Expanded="false">
        <MudNavLink Href="saft" Icon="@Icons.Material.Filled.FileDownload">SAF-T (PT)</MudNavLink>
        <MudNavLink Href="inventory-file" Icon="@Icons.Material.Filled.Inventory">Comunicação de inventários</MudNavLink>
        <MudNavLink Href="reports/vat" Icon="@Icons.Material.Filled.Percent">Declaração de IVA</MudNavLink>
        <MudNavLink Href="reports" Icon="@Icons.Material.Filled.BarChart">Relatórios</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Configuração" Icon="@Icons.Material.Filled.Settings" Expanded="false">
        <MudNavLink Href="series" Icon="@Icons.Material.Filled.FormatListNumbered">Séries de faturação</MudNavLink>
        <MudNavLink Href="users" Icon="@Icons.Material.Filled.ManageAccounts">Utilizadores</MudNavLink>
        <MudNavLink Href="vat-rates" Icon="@Icons.Material.Filled.TableView">Taxas de IVA</MudNavLink>
    </MudNavGroup>

    <AuthorizeView Roles="@Constants.Roles.SuperAdmin">
        <MudNavGroup Title="Backoffice" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
            <MudNavLink Href="companies" Icon="@Icons.Material.Filled.Domain">Empresas</MudNavLink>
            <MudNavLink Href="notifications" Icon="@Icons.Material.Filled.Email">Notificações</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>
</MudNavMenu>
