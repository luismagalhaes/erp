@page "/suppliers"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Fornecedores</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="Fornecedores">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("suppliers/new"))">
                Novo fornecedor
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="Partner"
              LoadAsync="@((companyId, query, ct) => Catalog.QuerySuppliersAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="Code"
              SearchPlaceholder="Procurar por código, nome ou NIF"
              EmptyIcon="@Icons.Material.Filled.LocalShipping"
              EmptyTitle="Sem fornecedores para mostrar"
              EmptyDescription="Ajuste os filtros ou crie o primeiro fornecedor."
              ItemsLabel="fornecedores"
              LoadErrorMessage="Não foi possível carregar os fornecedores">
        <Columns>
            <PropertyColumn Property="x => x.Code" Title="Código" />
            <PropertyColumn Property="x => x.Name" Title="Nome" />
            <PropertyColumn Property="x => x.TaxId" Title="NIF" />
            <PropertyColumn Property="x => x.City" Title="Localidade" />
            <PropertyColumn Property="x => x.PostalCode" Title="Código postal" Hidden="true" />
            <PropertyColumn Property="x => x.Country" Title="País" Hidden="true" />
            <PropertyColumn Property="x => x.Email" Title="Email" />
            <PropertyColumn Property="x => x.Phone" Title="Telefone" Hidden="true" />
            <PropertyColumn Property="x => x.IsActive" Title="Estado">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                        @(context.Item.IsActive ? "Ativo" : "Inativo")
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                     OnClick="@(() => Navigation.NavigateTo($"suppliers/{context.Item.Id}"))">
                            Editar
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    /// <summary>
    /// Maps the toolbar search to the DTO members the API exposes, so a renamed column never
    /// produces an invalid $filter.
    /// </summary>
    private static readonly string[] SearchFields = ["Code", "Name", "TaxId"];
}
