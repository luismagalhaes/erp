@page "/supplier-returns/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject PurchasingApiClient Purchasing
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@(_return?.Number ?? L["SupplierReturnView_DefaultTitle"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(_return?.Number ?? L["SupplierReturnView_DefaultTitle"])</MudText>
            @if (_return is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_return.Supplier.Name · @_return.ReturnDate.ToString("yyyy-MM-dd")
                </MudText>
            }
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("supplier-returns"))">
            @L["SupplierReturnView_BackButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_return is null)
    {
        <MudAlert Severity="Severity.Warning">@L["SupplierReturnView_NotFound"]</MudAlert>
    }
    else
    {
        @if (_return.IsVoided)
        {
            <MudAlert Severity="Severity.Error">
                @string.Format(L["SupplierReturnView_VoidedAlert"], _return.VoidedAtUtc?.ToString("yyyy-MM-dd HH:mm"), _return.VoidReason)
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                @L["SupplierReturnView_TransportInfoAlertPrefix"] <strong>@L["SupplierReturnView_TransportInfoAlertEmphasis"]</strong> —
                @L["SupplierReturnView_TransportInfoAlertSuffix"]
                <MudLink Href="stock-movements">@L["SupplierReturnView_TransportInfoAlertLink"]</MudLink>.
            </MudAlert>
        }

        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SupplierReturnView_TaxIdLabel"]</MudText>
                    <MudText Typo="Typo.body1">@_return.Supplier.TaxId</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SupplierReturnView_ReasonLabel"]</MudText>
                    <MudText Typo="Typo.body1">@_return.Reason</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SupplierReturnView_TotalCostLabel"]</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">@_return.TotalCost.ToString("N2")</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-2">
            <MudTable Items="_return.Lines" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@L["SupplierReturnView_ReturnedTitle"]</MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 50px;">@L["SupplierReturnView_NumberColumn"]</MudTh>
                    <MudTh>@L["SupplierReturnView_ProductColumn"]</MudTh>
                    <MudTh>@L["SupplierReturnView_DescriptionColumn"]</MudTh>
                    <MudTh>@L["SupplierReturnView_ReceiptColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["SupplierReturnView_QuantityColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["SupplierReturnView_UnitCostColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["SupplierReturnView_TotalColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["SupplierReturnView_NumberColumn"]">@context.LineNumber</MudTd>
                    <MudTd DataLabel="@L["SupplierReturnView_ProductColumn"]">
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.ProductCode</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["SupplierReturnView_DescriptionColumn"]">@context.ProductDescription</MudTd>
                    <MudTd DataLabel="@L["SupplierReturnView_ReceiptColumn"]">
                        <MudLink Href="@($"goods-receipts/{context.ReceiptId}")">@L["SupplierReturnView_ViewLink"]</MudLink>
                    </MudTd>
                    <MudTd DataLabel="@L["SupplierReturnView_QuantityColumn"]" Style="text-align: right;">
                        @context.Quantity.ToString("N2") @context.UnitOfMeasure
                    </MudTd>
                    <MudTd DataLabel="@L["SupplierReturnView_UnitCostColumn"]" Style="text-align: right;">
                        @context.UnitCost.ToString("N2")
                    </MudTd>
                    <MudTd DataLabel="@L["SupplierReturnView_TotalColumn"]" Style="text-align: right;">@context.LineAmount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        @if (!_return.IsVoided)
        {
            <MudExpansionPanels>
                <MudExpansionPanel Text="@L["SupplierReturnView_VoidPanelTitle"]">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @L["SupplierReturnView_VoidHelp"]
                    </MudText>

                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_reason" @bind-Value:after="StateHasChanged" Immediate="true"
                                      Label="@L["SupplierReturnView_ReasonLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Style="max-width: 480px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Disabled="@(_working || string.IsNullOrWhiteSpace(_reason))"
                                   OnClick="VoidAsync">
                            @L["SupplierReturnView_VoidButton"]
                        </MudButton>
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private bool _working;
    private string? _error;
    private string _reason = string.Empty;

    private SupplierReturn? _return;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _return = await Purchasing.GetReturnAsync(Id);
        }
        catch (Exception ex)
        {
            _error = string.Format(L["SupplierReturnView_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task VoidAsync()
    {
        _working = true;
        _error = null;

        try
        {
            var (result, error) = await Purchasing.VoidReturnAsync(Id, _reason.Trim());

            if (result is null)
            {
                _error = error ?? L["SupplierReturnView_VoidFallbackError"];
                return;
            }

            _return = result;
            _reason = string.Empty;
            Snackbar.Add(L["SupplierReturnView_VoidSuccess"], Severity.Success);
        }
        catch (Exception ex)
        {
            _error = string.Format(L["SupplierReturnView_VoidError"], ex.Message);
        }
        finally
        {
            _working = false;
        }
    }
}
