@page "/self-billed-invoices/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject PurchasingApiClient Purchasing
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@(_invoice?.DocumentNumber ?? L["SelfBilledInvoiceView_DefaultTitle"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(_invoice?.DocumentNumber ?? L["SelfBilledInvoiceView_DefaultTitle"])</MudText>
            @if (_invoice is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-family: monospace;">
                    ATCUD:@_invoice.Atcud
                </MudText>
            }
        </MudStack>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Print"
                       Disabled="@(_invoice is null)"
                       OnClick="@(() => Navigation.NavigateTo($"self-billed-invoices/{Id}/print"))">
                @L["SelfBilledInvoiceView_PrintButton"]
            </MudButton>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("self-billed-invoices"))">
                @L["SelfBilledInvoiceView_BackButton"]
            </MudButton>
        </MudStack>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_invoice is not null)
    {
        @if (_invoice.IsVoided)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @L["SelfBilledInvoiceView_VoidedWarning"]
            </MudAlert>
        }
        else if (!_invoice.IsAccepted)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @L["SelfBilledInvoiceView_NotAcceptedWarning"]
            </MudAlert>
        }

        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SelfBilledInvoiceView_SupplierLabel"]</MudText>
                    <MudText>@_invoice.Supplier.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@string.Format(L["SelfBilledInvoiceView_TaxIdPrefix"], _invoice.Supplier.TaxId)</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SelfBilledInvoiceView_DocumentDateLabel"]</MudText>
                    <MudText>@_invoice.IssueDate.ToString("yyyy-MM-dd")</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SelfBilledInvoiceView_SystemEntryLabel"]</MudText>
                    <MudText>@_invoice.SystemEntryDateUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SelfBilledInvoiceView_AcceptanceLabel"]</MudText>
                    <MudText>
                        @(_invoice.AcceptedBySupplierAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? L["SelfBilledInvoiceView_PendingAcceptance"])
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-2">
            <MudTable Items="_invoice.Lines" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>@L["SelfBilledInvoiceView_NumberColumn"]</MudTh>
                    <MudTh>@L["SelfBilledInvoiceView_CodeColumn"]</MudTh>
                    <MudTh>@L["SelfBilledInvoiceView_DescriptionColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["SelfBilledInvoiceView_QuantityColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["SelfBilledInvoiceView_UnitPriceColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["SelfBilledInvoiceView_NetColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["SelfBilledInvoiceView_TaxColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["SelfBilledInvoiceView_TaxAmountColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["SelfBilledInvoiceView_NumberColumn"]">@context.LineNumber</MudTd>
                    <MudTd DataLabel="@L["SelfBilledInvoiceView_CodeColumn"]">@context.ProductCode</MudTd>
                    <MudTd DataLabel="@L["SelfBilledInvoiceView_DescriptionColumn"]">@context.ProductDescription</MudTd>
                    <MudTd DataLabel="@L["SelfBilledInvoiceView_QuantityColumn"]" Style="text-align: right;">@context.Quantity.ToString("N3")</MudTd>
                    <MudTd DataLabel="@L["SelfBilledInvoiceView_UnitPriceColumn"]" Style="text-align: right;">@context.UnitPrice.ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["SelfBilledInvoiceView_NetColumn"]" Style="text-align: right;">@context.LineAmount.ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["SelfBilledInvoiceView_TaxColumn"]" Style="text-align: right;">@context.TaxPercentage.ToString("N0")%</MudTd>
                    <MudTd DataLabel="@L["SelfBilledInvoiceView_TaxAmountColumn"]" Style="text-align: right;">@context.TaxAmount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudStack Row="true" Spacing="4" Justify="Justify.FlexEnd">
            <MudPaper Elevation="1" Class="pa-4" Style="min-width: 280px;">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["SelfBilledInvoiceView_NetTotalLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_invoice.NetTotal.ToString("N2")</MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["SelfBilledInvoiceView_TaxLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_invoice.TaxPayable.ToString("N2")</MudText>
                    </MudStack>
                    <MudDivider />
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6">@L["SelfBilledInvoiceView_TotalLabel"]</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Primary">@_invoice.GrossTotal.ToString("N2")</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudStack>

        <MudExpansionPanels Elevation="1">
            <MudExpansionPanel Text="@L["SelfBilledInvoiceView_QrPanelTitle"]">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    @L["SelfBilledInvoiceView_QrPanelHelp"]
                </MudText>
                <MudPaper Elevation="0" Class="pa-3" Style="overflow-x: auto;">
                    <MudText Style="font-family: monospace; font-size: 0.8rem; white-space: nowrap;">
                        @_invoice.QrCodePayload
                    </MudText>
                </MudPaper>
            </MudExpansionPanel>

            @if (!_invoice.IsVoided && !_invoice.IsAccepted)
            {
                <MudExpansionPanel Text="@L["SelfBilledInvoiceView_AcceptancePanelTitle"]">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @L["SelfBilledInvoiceView_AcceptancePanelHelp"]
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Check"
                               Disabled="_accepting" OnClick="AcceptAsync">
                        @L["SelfBilledInvoiceView_RegisterAcceptanceButton"]
                    </MudButton>
                </MudExpansionPanel>
            }

            @if (!_invoice.IsVoided)
            {
                <MudExpansionPanel Text="@L["SelfBilledInvoiceView_VoidPanelTitle"]">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @L["SelfBilledInvoiceView_VoidPanelHelp"]
                    </MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_voidReason" Label="@L["SelfBilledInvoiceView_ReasonLabel"]" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Style="max-width: 480px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Disabled="@(_voiding || string.IsNullOrWhiteSpace(_voidReason))"
                                   OnClick="VoidAsync">
                            @L["SelfBilledInvoiceView_VoidButton"]
                        </MudButton>
                    </MudStack>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private bool _voiding;
    private bool _accepting;
    private string? _error;

    private Guid? _loadedId;
    private string _voidReason = string.Empty;
    private SelfBilledInvoice? _invoice;

    protected override async Task OnParametersSetAsync()
    {
        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loadedId == Id)
            return;

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _invoice = await Purchasing.GetSelfBilledInvoiceAsync(Id);
            if (_invoice is null)
                _error = L["SelfBilledInvoiceView_NotFound"];
        }
        catch (Exception ex)
        {
            _error = string.Format(L["SelfBilledInvoiceView_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AcceptAsync()
    {
        _accepting = true;
        _error = null;

        try
        {
            var (invoice, error) = await Purchasing.AcceptSelfBilledInvoiceAsync(Id);

            if (invoice is null)
            {
                _error = error ?? L["SelfBilledInvoiceView_AcceptFallbackError"];
                return;
            }

            _invoice = invoice;
            Snackbar.Add(L["SelfBilledInvoiceView_AcceptSuccess"], Severity.Success);
        }
        catch (Exception ex)
        {
            _error = string.Format(L["SelfBilledInvoiceView_AcceptError"], ex.Message);
        }
        finally
        {
            _accepting = false;
        }
    }

    private async Task VoidAsync()
    {
        _voiding = true;
        _error = null;

        try
        {
            var (invoice, error) = await Purchasing.VoidSelfBilledInvoiceAsync(Id, _voidReason.Trim());

            if (invoice is null)
            {
                _error = error ?? L["SelfBilledInvoiceView_VoidFallbackError"];
                return;
            }

            _invoice = invoice;
            _voidReason = string.Empty;
            Snackbar.Add(L["SelfBilledInvoiceView_VoidSuccess"], Severity.Success);
        }
        catch (Exception ex)
        {
            _error = string.Format(L["SelfBilledInvoiceView_VoidError"], ex.Message);
        }
        finally
        {
            _voiding = false;
        }
    }
}
