@page "/goods-receipts/new"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject PurchasingApiClient Purchasing
@inject CatalogApiClient Catalog
@inject StockApiClient StockApi
@inject CompanyState Company
@inject WarehouseState WarehouseState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["NewGoodsReceipt_Title"]</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@L["NewGoodsReceipt_Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["NewGoodsReceipt_Subtitle"]
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("goods-receipts"))">
            @L["NewGoodsReceipt_BackButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (!Company.HasCompany)
    {
        <MudAlert Severity="Severity.Info">@L["NewGoodsReceipt_NoCompanyWarning"]</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <PartnerAutocomplete SelectedPartner="_selectedSupplier" PartnerChanged="OnSupplierChangedAsync"
                                         Kind="PartnerKind.Supplier" Label="@L["NewGoodsReceipt_SupplierLabel"]" Required="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="Guid?" @bind-Value="_warehouseId" Label="@L["NewGoodsReceipt_WarehouseLabel"]"
                               Variant="Variant.Outlined" Required="true"
                               HelperText="@L["NewGoodsReceipt_WarehouseHelp"]">
                        @foreach (var warehouse in _warehouses)
                        {
                            <MudSelectItem T="Guid?" Value="@warehouse.Id">
                                @warehouse.Code — @warehouse.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudDatePicker @bind-Date="_receiptDate" Label="@L["NewGoodsReceipt_DateLabel"]" Variant="Variant.Outlined"
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_supplierDocumentNumber" Label="@L["NewGoodsReceipt_SupplierDocumentLabel"]"
                                  Variant="Variant.Outlined"
                                  HelperText="@L["NewGoodsReceipt_SupplierDocumentHelp"]" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_supplierId is not null)
        {
            <MudPaper Elevation="1" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">@L["NewGoodsReceipt_PendingTitle"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["NewGoodsReceipt_PendingHelp"]
                        </MudText>
                    </MudStack>
                    @if (_loadingPending)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    }
                </MudStack>

                @if (_pending.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @L["NewGoodsReceipt_NoPendingInfo"]
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="_pending" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh Style="width: 60px;"></MudTh>
                            <MudTh>@L["NewGoodsReceipt_OrderColumn"]</MudTh>
                            <MudTh>@L["NewGoodsReceipt_ProductColumn"]</MudTh>
                            <MudTh Style="text-align: right;">@L["NewGoodsReceipt_PendingColumn"]</MudTh>
                            <MudTh Style="width: 140px;">@L["NewGoodsReceipt_ToReceiveColumn"]</MudTh>
                            <MudTh Style="width: 140px;">@L["NewGoodsReceipt_UnitCostColumn"]</MudTh>
                            <MudTh Style="width: 110px;">@L["NewGoodsReceipt_DiscountColumn"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudCheckBox T="bool" Value="@IsChosen(context)"
                                             ValueChanged="@(chosen => ToggleAsync(context, chosen))"
                                             Color="Color.Primary" Dense="true" />
                            </MudTd>
                            <MudTd DataLabel="@L["NewGoodsReceipt_OrderColumn"]">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2" Style="font-family: monospace;">
                                        @context.OrderNumber
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @L["NewGoodsReceipt_ExpectedPrefix"] @(context.ExpectedDate?.ToString("yyyy-MM-dd") ?? "—")
                                    </MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="@L["NewGoodsReceipt_ProductColumn"]">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@context.ProductCode</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @context.ProductDescription
                                    </MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="@L["NewGoodsReceipt_PendingColumn"]" Style="text-align: right;">
                                @context.PendingQuantity.ToString("N3") @context.UnitOfMeasure
                            </MudTd>
                            <MudTd DataLabel="@L["NewGoodsReceipt_ToReceiveColumn"]">
                                @if (Chosen(context) is { } chosen)
                                {
                                    <MudNumericField T="decimal" Value="chosen.Quantity"
                                                     ValueChanged="@(quantity => SetQuantity(chosen, context, quantity))"
                                                     Margin="Margin.Dense" Min="0"
                                                     Max="@context.PendingQuantity" />
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["NewGoodsReceipt_UnitCostColumn"]">
                                @if (Chosen(context) is { } chosen)
                                {
                                    <MudNumericField @bind-Value="chosen.UnitCost" @bind-Value:after="StateHasChanged"
                                                     Margin="Margin.Dense" Min="0" Format="N2" />
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["NewGoodsReceipt_DiscountColumn"]">
                                @if (Chosen(context) is { } chosenDiscount)
                                {
                                    <MudNumericField @bind-Value="chosenDiscount.DiscountPercentage" @bind-Value:after="StateHasChanged"
                                                     Margin="Margin.Dense" Min="0" Max="100" Format="N2" Adornment="Adornment.End" AdornmentText="%" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">@L["NewGoodsReceipt_NoOrderTitle"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["NewGoodsReceipt_NoOrderHelp"]
                        </MudText>
                    </MudStack>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddFreeLine">
                        @L["NewGoodsReceipt_AddLineButton"]
                    </MudButton>
                </MudStack>

                @if (_freeLines.Count > 0)
                {
                    <MudTable Items="_freeLines" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh Style="width: 220px;">@L["NewGoodsReceipt_ProductColumn"]</MudTh>
                            <MudTh>@L["NewGoodsReceipt_DescriptionColumn"]</MudTh>
                            <MudTh Style="width: 120px;">@L["NewGoodsReceipt_QuantityColumn"]</MudTh>
                            <MudTh Style="width: 90px;">@L["NewGoodsReceipt_UnitColumn"]</MudTh>
                            <MudTh Style="width: 140px;">@L["NewGoodsReceipt_UnitCostColumn"]</MudTh>
                            <MudTh Style="width: 110px;">@L["NewGoodsReceipt_DiscountColumn"]</MudTh>
                            <MudTh Style="width: 70px; text-align: right;">@L["NewGoodsReceipt_ActionsColumn"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["NewGoodsReceipt_ProductColumn"]">
                                <ProductAutocomplete SelectedProduct="context.SelectedProduct"
                                                      ProductChanged="@(product => OnProductChanged(context, product))" />
                            </MudTd>
                            <MudTd DataLabel="@L["NewGoodsReceipt_DescriptionColumn"]">
                                <MudTextField @bind-Value="context.ProductDescription" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd DataLabel="@L["NewGoodsReceipt_QuantityColumn"]">
                                <MudNumericField @bind-Value="context.Quantity" @bind-Value:after="StateHasChanged"
                                                 Margin="Margin.Dense" Min="0" />
                            </MudTd>
                            <MudTd DataLabel="@L["NewGoodsReceipt_UnitColumn"]">
                                <MudTextField @bind-Value="context.UnitOfMeasure" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd DataLabel="@L["NewGoodsReceipt_UnitCostColumn"]">
                                <MudNumericField @bind-Value="context.UnitCost" @bind-Value:after="StateHasChanged"
                                                 Margin="Margin.Dense" Min="0" Format="N2" />
                            </MudTd>
                            <MudTd DataLabel="@L["NewGoodsReceipt_DiscountColumn"]">
                                <MudNumericField @bind-Value="context.DiscountPercentage" @bind-Value:after="StateHasChanged"
                                                 Margin="Margin.Dense" Min="0" Max="100" Format="N2" Adornment="Adornment.End" AdornmentText="%" />
                            </MudTd>
                            <MudTd DataLabel="@L["NewGoodsReceipt_ActionsColumn"]" Style="text-align: right;">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               OnClick="@(() => _freeLines.Remove(context))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NewGoodsReceipt_NoLines"]</MudText>
                }
            </MudPaper>

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @LineCount @(LineCount == 1 ? L["NewGoodsReceipt_LineCountSingular"] : L["NewGoodsReceipt_LineCountPlural"]) @L["NewGoodsReceipt_LineCountSuffix"]
                    </MudText>
                    <MudText Typo="Typo.h6">@string.Format(L["NewGoodsReceipt_TotalCostLabel"], TotalCost.ToString("N2"))</MudText>
                </MudStack>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               OnClick="@(() => Navigation.NavigateTo("goods-receipts"))">
                        @L["NewGoodsReceipt_CancelButton"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.MoveToInbox"
                               Disabled="@(_saving || !CanSave)"
                               OnClick="SaveAsync">
                        @(_saving ? L["NewGoodsReceipt_SavingButton"] : L["NewGoodsReceipt_SaveButton"])
                    </MudButton>
                </MudStack>
            </MudStack>
        }
    }
</MudStack>

@code {
    private bool _saving;
    private bool _loadingPending;
    private string? _error;

    private Partner? _selectedSupplier;
    private Guid? _supplierId;
    private Guid? _warehouseId;
    private DateTime? _receiptDate = DateTime.Today;
    private string _supplierDocumentNumber = string.Empty;

    private List<Warehouse> _warehouses = [];
    private List<PendingOrderLine> _pending = [];

    private readonly List<ChosenLine> _chosen = [];
    private readonly List<FreeLine> _freeLines = [];

    private int LineCount => _chosen.Count(line => line.Quantity > 0) + ValidFreeLines.Count();

    private decimal TotalCost =>
        _chosen.Where(line => line.Quantity > 0).Sum(line => Round(Round(line.Quantity * line.UnitCost) * (1 - line.DiscountPercentage / 100m)))
        + ValidFreeLines.Sum(line => Round(Round(line.Quantity * line.UnitCost) * (1 - line.DiscountPercentage / 100m)));

    private IEnumerable<FreeLine> ValidFreeLines =>
        _freeLines.Where(line => line.Quantity > 0 && !string.IsNullOrWhiteSpace(line.ProductCode));

    private bool CanSave => _supplierId is not null && _warehouseId is not null && LineCount > 0;

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        WarehouseState.Changed += OnWarehouseStateChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(async () =>
    {
        _selectedSupplier = null;
        _supplierId = null;
        _chosen.Clear();
        _freeLines.Clear();
        _pending = [];
        await LoadAsync();
    });

    private async Task LoadAsync()
    {
        if (!Company.HasCompany)
        {
            _error = Company.LoadError;
            StateHasChanged();
            return;
        }

        try
        {
            await WarehouseState.EnsureLoadedAsync();
            _warehouses = [.. WarehouseState.Warehouses];

            _error = WarehouseState.LoadError;

            _warehouseId ??= WarehouseState.HasWarehouse ? WarehouseState.SelectedWarehouseId : null;
        }
        catch (Exception ex)
        {
            _error = string.Format(L["NewGoodsReceipt_LoadError"], ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task OnSupplierChangedAsync(Partner? supplier)
    {
        _selectedSupplier = supplier;
        _supplierId = supplier?.Id;
        _chosen.Clear();
        _pending = [];

        if (_supplierId is null)
        {
            StateHasChanged();
            return;
        }

        _loadingPending = true;
        StateHasChanged();

        try
        {
            var (pending, error) = await Purchasing.GetPendingLinesAsync(Company.SelectedCompanyId, _supplierId);
            _pending = [.. pending];
            _error = error;

            // The order already says where the goods were meant to go, so the warehouse follows it.
            if (_pending.Count > 0)
                _warehouseId = _pending[0].WarehouseId;
        }
        catch (Exception ex)
        {
            _error = string.Format(L["NewGoodsReceipt_PendingLoadError"], ex.Message);
        }
        finally
        {
            _loadingPending = false;
            StateHasChanged();
        }
    }

    private ChosenLine? Chosen(PendingOrderLine line) =>
        _chosen.FirstOrDefault(chosen => chosen.LineId == line.LineId);

    private bool IsChosen(PendingOrderLine line) => Chosen(line) is not null;

    /// <summary>
    /// Ticking a line assumes everything still owed arrived, at the price that was ordered. Both
    /// are the common case and both can be changed.
    /// </summary>
    private void ToggleAsync(PendingOrderLine line, bool chosen)
    {
        var existing = Chosen(line);

        if (chosen && existing is null)
        {
            _chosen.Add(new ChosenLine
            {
                LineId = line.LineId,
                ProductCode = line.ProductCode,
                ProductDescription = line.ProductDescription,
                UnitOfMeasure = line.UnitOfMeasure,
                Quantity = line.PendingQuantity,
                UnitCost = line.UnitPrice,
                DiscountPercentage = line.DiscountPercentage
            });
        }
        else if (!chosen && existing is not null)
        {
            _chosen.Remove(existing);
        }

        StateHasChanged();
    }

    /// <summary>Never more than the order still owes — the API refuses it anyway.</summary>
    private void SetQuantity(ChosenLine chosen, PendingOrderLine line, decimal quantity)
    {
        chosen.Quantity = Math.Clamp(quantity, 0m, line.PendingQuantity);
        StateHasChanged();
    }

    private void AddFreeLine() => _freeLines.Add(new FreeLine());

    private void OnProductChanged(FreeLine line, ProductListItem? product)
    {
        line.SelectedProduct = product;

        if (product is null)
            return;

        line.ProductCode = product.ProductCode;
        line.ProductDescription = product.Description;
        line.UnitOfMeasure = product.UnitOfMeasure;
        line.UnitCost = product.UnitCost;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var lines = _chosen
                .Where(line => line.Quantity > 0)
                .Select(line => new GoodsReceiptLineRequest(
                    line.ProductCode,
                    line.ProductDescription,
                    line.Quantity,
                    line.UnitCost,
                    line.UnitOfMeasure,
                    line.LineId,
                    line.DiscountPercentage))
                .Concat(ValidFreeLines.Select(line => new GoodsReceiptLineRequest(
                    line.ProductCode.Trim(),
                    string.IsNullOrWhiteSpace(line.ProductDescription)
                        ? line.ProductCode.Trim()
                        : line.ProductDescription.Trim(),
                    line.Quantity,
                    line.UnitCost,
                    line.UnitOfMeasure,
                    DiscountPercentage: line.DiscountPercentage)))
                .ToList();

            var (receipt, error) = await Purchasing.CreateReceiptAsync(new CreateGoodsReceiptRequest(
                Company.SelectedCompanyId,
                _supplierId!.Value,
                DateOnly.FromDateTime(_receiptDate ?? DateTime.Today),
                _warehouseId!.Value,
                lines,
                string.IsNullOrWhiteSpace(_supplierDocumentNumber) ? null : _supplierDocumentNumber.Trim()));

            if (receipt is null)
            {
                _error = error ?? L["NewGoodsReceipt_SaveFallbackError"];
                return;
            }

            Snackbar.Add(string.Format(L["NewGoodsReceipt_SaveSuccess"], receipt.Number), Severity.Success);
            Navigation.NavigateTo($"goods-receipts/{receipt.Id}");
        }
        catch (Exception ex)
        {
            _error = string.Format(L["NewGoodsReceipt_SaveError"], ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private static decimal Round(decimal value) => Math.Round(value, 2, MidpointRounding.AwayFromZero);

    private sealed class ChosenLine
    {
        public Guid LineId { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductDescription { get; set; } = string.Empty;
        public string UnitOfMeasure { get; set; } = "UN";
        public decimal Quantity { get; set; }
        public decimal UnitCost { get; set; }
        public decimal DiscountPercentage { get; set; }
    }

    private sealed class FreeLine
    {
        /// <summary>The article behind the autocomplete's box, kept whole so the box can show its
        /// code without a lookup back into a catalogue that is never held in full.</summary>
        public ProductListItem? SelectedProduct { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductDescription { get; set; } = string.Empty;
        public string UnitOfMeasure { get; set; } = "UN";
        public decimal Quantity { get; set; } = 1;
        public decimal UnitCost { get; set; }
        public decimal DiscountPercentage { get; set; }
    }

    public void Dispose()
    {
        Company.Changed -= OnCompanyChanged;
        WarehouseState.Changed -= OnWarehouseStateChanged;
    }

    private void OnWarehouseStateChanged() => InvokeAsync(() =>
    {
        _warehouseId = WarehouseState.HasWarehouse ? WarehouseState.SelectedWarehouseId : null;
        StateHasChanged();
    });
}
