    private async Task RemoveAsync(UserCompanyAdmin membership)
    {
        await RunAsync(
            () => CoreApi.DeleteUserCompanyAsync(membership.Id),
            string.Format(Localizer["CompanyEditor_UserLostAccess"], DescribeUser(membership.UserId)));
    }

    /// <summary>Runs an operation on the memberships and refreshes what depends on them.</summary>
    private async Task RunAsync(Func<Task<string?>> operation, string successMessage)
    {
        _working = true;
        _error = null;

        try
        {
            var error = await operation();

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(successMessage, Severity.Success);

            // The header picker lists the companies of the signed in user.
            await Company.RefreshAsync();
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CompanyEditor_OperationError"], ex.Message);
        }
        finally
        {
            _working = false;
        }
    }

    private static string? Normalize(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string NormalizeCountry(string value) =>
        string.IsNullOrWhiteSpace(value) ? "PT" : value.Trim().ToUpperInvariant();

    /// <summary>Fills in the city when it is still blank; an existing value is never overwritten.</summary>
    private void OnPostalCodeResolvedAsync(PostalCodeLookupResult result)
    {
