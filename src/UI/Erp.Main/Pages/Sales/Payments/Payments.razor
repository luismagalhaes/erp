@page "/payments"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@inject SalesApiClient SalesApi
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Recibos</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="Recibos">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("payments/new"))">
                Novo recibo
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="PaymentListItem"
              LoadAsync="@((companyId, query, ct) => SalesApi.QueryPaymentsAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="TransactionDate desc,PaymentRefNo desc"
              SearchPlaceholder="Procurar por documento, cliente ou NIF"
              EmptyIcon="@Icons.Material.Filled.Payments"
              EmptyTitle="Sem recibos para mostrar"
              EmptyDescription="Ajuste os filtros ou emita o primeiro recibo."
              ItemsLabel="recibos"
              LoadErrorMessage="Não foi possível carregar os recibos">
        <Columns>
            <PropertyColumn Property="x => x.PaymentRefNo" Title="Documento" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.PaymentType" Title="Tipo">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.Item.PaymentType</MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Atcud" Title="ATCUD" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.TransactionDate" Title="Data" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.PartyName" Title="Cliente" />
            <PropertyColumn Property="x => x.PartyTaxId" Title="NIF" />
            <PropertyColumn Property="x => x.SettledInvoiceCount" Title="Faturas"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.GrossTotal" Title="Total" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.Status" Title="Estado">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.Status == "A" ? Color.Error : Color.Success)">
                        @(context.Item.Status == "A" ? "Anulado" : "Normal")
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"payments/{context.Item.Id}"))">
                            Ver recibo
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["PaymentRefNo", "PartyName", "PartyTaxId"];
}
