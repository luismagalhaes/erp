@page "/companies"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject CoreApiClient CoreApi
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@Localizer["Companies_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Companies_PageTitle"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Navigation.NavigateTo("companies/new"))">
                @Localizer["Companies_NewCompany"]
            </MudButton>
        </Actions>
    </PageHeader>

    @* Companies are the tenancy boundary itself, so this listing is not scoped to one of them. *@
    <DataGrid T="CompanyListItem" CompanyScoped="false"
              LoadAsync="@((_, query, ct) => CoreApi.QueryCompaniesAsync(query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="Name"
              SearchPlaceholder="@Localizer["Companies_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.Business"
              EmptyTitle="@Localizer["Companies_EmptyTitle"]"
              EmptyDescription="@Localizer["Companies_EmptyDescription"]"
              ItemsLabel="@Localizer["Companies_ItemsLabel"]"
              LoadErrorMessage="@Localizer["Companies_LoadErrorMessage"]">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="@Localizer["Common_NameColumn"]" />
            <PropertyColumn Property="x => x.LegalName" Title="@Localizer["Companies_LegalNameColumn"]" />
            <PropertyColumn Property="x => x.TaxId" Title="@Localizer["Companies_TaxIdColumn"]" />
            <PropertyColumn Property="x => x.IsActive" Title="@Localizer["Common_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                        @(context.Item.IsActive ? Localizer["Brands_Active"] : Localizer["Brands_Inactive"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                     OnClick="@(() => Navigation.NavigateTo($"companies/{context.Item.Id}"))">
                            @Localizer["Common_EditAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    /// <summary>
    /// Maps the toolbar search to the DTO members the API exposes, so a renamed column never
    /// produces an invalid $filter.
    /// </summary>
    private static readonly string[] SearchFields = ["Name", "LegalName", "TaxId"];
}
