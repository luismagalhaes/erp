@inherits LayoutComponentBase
@implements IDisposable
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using Erp.Main.Services
@inject NavigationManager Navigation
@inject CompanyState Company

<MudThemeProvider />
@* Required by every component that opens an overlay: selects, date pickers and menus. *@
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">ERP</MudText>

        <AuthorizeView>
            <Authorized>
                @if (Company.Companies.Count > 0)
                {
                    <MudSelect T="Guid" Value="Company.SelectedCompanyId" ValueChanged="OnCompanyChanged"
                               Dense="true" Margin="Margin.Dense" Variant="Variant.Text"
                               Class="ml-6 company-picker" Style="max-width: 260px;"
                               AdornmentIcon="@Icons.Material.Filled.Domain" Adornment="Adornment.Start">
                        @foreach (var company in Company.Companies)
                        {
                            <MudSelectItem T="Guid" Value="@company.CompanyId">@company.CompanyName</MudSelectItem>
                        }
                    </MudSelect>
                }
            </Authorized>
        </AuthorizeView>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <MudText Class="mr-3">@context.User.Identity?.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                               OnClick="@Logout" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Mini" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
    .company-picker .mud-input-slot,
    .company-picker .mud-input-adornment .mud-icon-root,
    .company-picker .mud-select-input .mud-input-slot {
        color: var(--mud-palette-primary-text);
    }
</style>

@code {
    private bool _drawerOpen = true;

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyStateChanged;
        await Company.EnsureLoadedAsync();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void OnCompanyChanged(Guid companyId) => Company.Select(companyId);

    private void OnCompanyStateChanged() => InvokeAsync(StateHasChanged);

    private void Logout()
    {
        var currentPath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"authentication/logout?returnUrl={Uri.EscapeDataString(currentPath)}", forceLoad: true);
    }

    public void Dispose() => Company.Changed -= OnCompanyStateChanged;
}
