@page "/Backoffice/Clients"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using IdentityResourcesType = Erp.Identity.Resources.IdentityResources
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IClientService ClientService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<IdentityResourcesType> Localizer

<PageTitle>@Localizer["Backoffice_Clients_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Backoffice_Clients_PageTitle"]" />

    <DataGrid T="ClientListItem" Items="@_clients" Loading="@_loading"
              SearchFields="@_searchFields"
              SearchPlaceholder="@Localizer["Backoffice_Common_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.Devices"
              EmptyTitle="@Localizer["Backoffice_Common_NoRecords"]"
              ItemsLabel="@Localizer["Backoffice_Clients_ItemsLabel"]"
              OnRefresh="LoadAsync">
        <Columns>
            <PropertyColumn Property="x => x.ClientId" Title="@Localizer["Backoffice_Clients_ClientIdColumn"]" />
            <PropertyColumn Property="x => x.ClientName" Title="@Localizer["Backoffice_Common_NameColumn"]" />
            <PropertyColumn Property="x => x.Enabled" Title="@Localizer["Backoffice_Clients_ActiveColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.Enabled ? Color.Success : Color.Default)">
                        @(context.Item.Enabled ? Localizer["Backoffice_Common_Yes"] : Localizer["Backoffice_Common_No"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.RedirectUris" Title="@Localizer["Backoffice_Clients_RedirectUrisColumn"]" Sortable="false" Filterable="false">
                <CellTemplate>@string.Join(", ", context.Item.RedirectUris)</CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.AllowedScopes" Title="@Localizer["Backoffice_Clients_ScopesColumn"]" Sortable="false" Filterable="false">
                <CellTemplate>@string.Join(", ", context.Item.AllowedScopes)</CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true" CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                     OnClick="@(() => Navigation.NavigateTo($"/Backoffice/Clients/{Uri.EscapeDataString(context.Item.ClientId)}"))">
                            @Localizer["Backoffice_Common_EditAction"]
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                     OnClick="@(() => DeleteAsync(context.Item.ClientId))">
                            @Localizer["Backoffice_Common_DeleteAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly Func<ClientListItem, string?>[] _searchFields = [x => x.ClientId, x => x.ClientName];

    private List<ClientListItem> _clients = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _clients = (await ClientService.GetClientsAsync()).ToList();
        _loading = false;
    }

    private async Task DeleteAsync(string clientId)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Localizer["Backoffice_Clients_DeleteHeading"].Value,
            string.Format(Localizer["Backoffice_Clients_DeleteConfirm"], clientId),
            yesText: Localizer["Backoffice_Common_DeleteButton"].Value,
            cancelText: Localizer["Backoffice_Common_CancelButton"].Value);

        if (confirmed != true)
            return;

        await ClientService.DeleteClientAsync(clientId);
        Snackbar.Add(Localizer["Backoffice_Clients_Deleted"].Value, Severity.Success);
        await LoadAsync();
    }
}
