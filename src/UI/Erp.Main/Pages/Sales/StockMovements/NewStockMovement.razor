@page "/stock-movements/new"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject SalesApiClient SalesApi
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Nova guia</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Nova guia de movimentação</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                O documento é assinado e numerado na emissão, e tem de ser comunicado à AT antes de o transporte começar.
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("stock-movements"))">
            Voltar
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_series.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">
            Não existe nenhuma série de movimentação comunicada à AT. Crie uma série do tipo GR, GT, GA, GC ou GD.
            <MudLink Href="series/new" Class="ml-2">Criar série</MudLink>
        </MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Documento</MudText>
            <MudGrid>
                <MudItem xs="12" md="5">
                    <MudSelect @bind-Value="_seriesId" Label="Série" Variant="Variant.Outlined" Required="true">
                        @foreach (var series in _series)
                        {
                            <MudSelectItem T="Guid" Value="@series.Id">
                                @series.DocumentType @series.SeriesCode — @MovementTypes.Describe(series.DocumentType)
                                (próximo n.º @(series.CurrentSequence + 1))
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudDatePicker @bind-Date="_movementDate" Label="Data do documento"
                                   Variant="Variant.Outlined" DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_vehiclePlate" Label="Matrícula do veículo" Variant="Variant.Outlined"
                                  HelperText="Exigida pelo regime de bens em circulação" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Destinatário</MudText>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudSelect T="Guid?" Value="_partnerId" ValueChanged="OnPartnerChanged"
                               Label="@(_partyIsSupplier ? "Fornecedor" : "Cliente")" Variant="Variant.Outlined"
                               Clearable="true" Placeholder="Livre">
                        @foreach (var partner in _partyIsSupplier ? _suppliers : _customers)
                        {
                            <MudSelectItem T="Guid?" Value="@partner.Id">@partner.Name (@partner.TaxId)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_partyTaxId" Label="NIF" Variant="Variant.Outlined"
                                  HelperText="Vazio para consumidor final" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_partyName" Label="Nome" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-center">
                    <MudSwitch T="bool" Value="_partyIsSupplier" ValueChanged="OnPartyKindChanged"
                               Color="Color.Primary" Label="É fornecedor" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Transporte</MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">Local de carga</MudText>
                    <MudTextField @bind-Value="_shipFromAddress" Label="Morada" Variant="Variant.Outlined"
                                  Required="true" Class="mb-3" />
                    <MudGrid>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_shipFromPostalCode" Label="Código postal" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_shipFromCity" Label="Localidade" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">Local de descarga</MudText>
                    <MudTextField @bind-Value="_shipToAddress" Label="Morada" Variant="Variant.Outlined"
                                  Required="true" Class="mb-3" />
                    <MudGrid>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_shipToPostalCode" Label="Código postal" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_shipToCity" Label="Localidade" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_startDate" Label="Data de início do transporte"
                                   Variant="Variant.Outlined" DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudTimePicker @bind-Time="_startTime" Label="Hora" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_comments" Label="Observações" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">Mercadoria</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">
                    Adicionar linha
                </MudButton>
            </MudStack>

            <MudTable Items="_lines" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Style="width: 200px;">Artigo</MudTh>
                    <MudTh>Descrição</MudTh>
                    <MudTh Style="width: 110px;">Qtd.</MudTh>
                    <MudTh Style="width: 130px;">Preço unit.</MudTh>
                    <MudTh Style="width: 150px;">IVA</MudTh>
                    <MudTh Style="width: 110px; text-align: right;">Total</MudTh>
                    <MudTh Style="width: 70px; text-align: right;">Ações</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Artigo">
                        @if (_products.Count > 0)
                        {
                            <MudSelect T="Guid?" Value="context.ProductId"
                                       ValueChanged="@(productId => OnProductChanged(context, productId))"
                                       Margin="Margin.Dense" Clearable="true" Placeholder="Livre">
                                @foreach (var product in _products)
                                {
                                    <MudSelectItem T="Guid?" Value="@product.Id">
                                        @product.ProductCode — @product.Description
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudTextField @bind-Value="context.ProductCode" Margin="Margin.Dense" Placeholder="Código" />
                        }
                    </MudTd>
                    <MudTd DataLabel="Descrição">
                        <MudTextField @bind-Value="context.ProductDescription" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd DataLabel="Qtd.">
                        <MudNumericField @bind-Value="context.Quantity" Margin="Margin.Dense" Min="0" />
                    </MudTd>
                    <MudTd DataLabel="Preço unit.">
                        <MudNumericField @bind-Value="context.UnitPrice" Margin="Margin.Dense" Min="0" Format="N2" />
                    </MudTd>
                    <MudTd DataLabel="IVA">
                        <MudSelect T="string" Value="context.TaxCode"
                                   ValueChanged="@(code => OnTaxCodeChanged(context, code))"
                                   Margin="Margin.Dense">
                            @foreach (var rate in TaxRates)
                            {
                                <MudSelectItem T="string" Value="@rate.Code">@rate.Label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd DataLabel="Total" Style="text-align: right;">@LineTotal(context).ToString("N2")</MudTd>
                    <MudTd DataLabel="Ações" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       title="Remover linha"
                                       Disabled="@(_lines.Count == 1)"
                                       OnClick="@(() => RemoveLine(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            @if (_lines.Any(line => line.TaxCode == ExemptCode))
            {
                <MudTextField @bind-Value="_exemptionReason" Class="mt-4"
                              Label="Motivo de isenção" Variant="Variant.Outlined"
                              HelperText="Obrigatório quando alguma linha está isenta de IVA" />
            }
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Row="true" Spacing="6">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Quantidade total</MudText>
                        <MudText Typo="Typo.h6">@TotalQuantity.ToString("N3")</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Base tributável</MudText>
                        <MudText Typo="Typo.h6">@NetTotal.ToString("N2")</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Primary">@GrossTotal.ToString("N2")</MudText>
                    </MudStack>
                </MudStack>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.LocalShipping"
                           Disabled="@(_issuing || !CanIssue)"
                           OnClick="IssueAsync">
                    @(_issuing ? "A emitir..." : "Emitir guia")
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    private const string ExemptCode = "ISE";

    private static readonly TaxRateOption[] TaxRates =
    [
        new("NOR", 23m, "Normal - 23%"),
        new("INT", 13m, "Intermédia - 13%"),
        new("RED", 6m, "Reduzida - 6%"),
        new(ExemptCode, 0m, "Isento")
    ];

    private bool _loading = true;
    private bool _issuing;
    private string? _error;

    private Guid _seriesId;
    private DateTime? _movementDate = DateTime.Today;
    private DateTime? _startDate = DateTime.Today;
    private TimeSpan? _startTime = DateTime.Now.TimeOfDay;
    private string _vehiclePlate = string.Empty;
    private string _comments = string.Empty;
    private string _exemptionReason = string.Empty;

    private Guid? _partnerId;
    private string _partyTaxId = string.Empty;
    private string _partyName = string.Empty;
    private bool _partyIsSupplier;

    private string _shipFromAddress = string.Empty;
    private string _shipFromCity = string.Empty;
    private string _shipFromPostalCode = string.Empty;
    private string _shipToAddress = string.Empty;
    private string _shipToCity = string.Empty;
    private string _shipToPostalCode = string.Empty;

    private List<SalesSeries> _series = [];
    private List<ProductListItem> _products = [];
    private List<Partner> _customers = [];
    private List<Partner> _suppliers = [];
    private readonly List<LineEditor> _lines = [new()];

    private decimal TotalQuantity => _lines.Sum(line => line.Quantity);

    private decimal NetTotal => _lines.Sum(LineTotal);

    private decimal TaxTotal => _lines.Sum(line =>
        Math.Round(LineTotal(line) * line.TaxPercentage / 100m, 2, MidpointRounding.AwayFromZero));

    private decimal GrossTotal => NetTotal + TaxTotal;

    private bool CanIssue =>
        _seriesId != Guid.Empty
        && _movementDate is not null
        && _startDate is not null
        && !string.IsNullOrWhiteSpace(_partyName)
        && !string.IsNullOrWhiteSpace(_shipFromAddress)
        && !string.IsNullOrWhiteSpace(_shipToAddress)
        && _lines.All(line => line.Quantity > 0 && !string.IsNullOrWhiteSpace(line.ProductDescription))
        && (!_lines.Any(line => line.TaxCode == ExemptCode) || !string.IsNullOrWhiteSpace(_exemptionReason));

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = Company.LoadError;

        if (!Company.HasCompany)
        {
            _series = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            // Only series of a movement type can issue these documents.
            var series = await SalesApi.GetSeriesAsync(Company.SelectedCompanyId);
            _series = [.. series.Where(x => x.CanIssue && MovementTypes.All.Any(type => type.Code == x.DocumentType))];
            _seriesId = _series.FirstOrDefault()?.Id ?? Guid.Empty;

            var (products, _) = await Catalog.GetProductsAsync(Company.SelectedCompanyId);
            _products = [.. products.Where(product => product.IsActive)];

            var (customers, _) = await Catalog.GetCustomersAsync(Company.SelectedCompanyId);
            _customers = [.. customers.Where(customer => customer.IsActive)];

            var (suppliers, _) = await Catalog.GetSuppliersAsync(Company.SelectedCompanyId);
            _suppliers = [.. suppliers.Where(supplier => supplier.IsActive)];
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível preparar a emissão: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>Switching between customer and supplier clears a selection that no longer applies.</summary>
    private void OnPartyKindChanged(bool isSupplier)
    {
        _partyIsSupplier = isSupplier;
        _partnerId = null;
    }

    private void OnPartnerChanged(Guid? partnerId)
    {
        _partnerId = partnerId;

        var partner = (_partyIsSupplier ? _suppliers : _customers).FirstOrDefault(x => x.Id == partnerId);
        if (partner is null)
            return;

        _partyName = partner.Name;
        _partyTaxId = partner.TaxId;

        // The delivery point defaults to the address on file, which is what it is most of the time.
        if (string.IsNullOrWhiteSpace(_shipToAddress) && !string.IsNullOrWhiteSpace(partner.Address))
        {
            _shipToAddress = partner.Address;
            _shipToCity = partner.City ?? string.Empty;
            _shipToPostalCode = partner.PostalCode ?? string.Empty;
        }
    }

    private void AddLine() => _lines.Add(new LineEditor());

    private void RemoveLine(LineEditor line)
    {
        if (_lines.Count > 1)
            _lines.Remove(line);
    }

    private void OnProductChanged(LineEditor line, Guid? productId)
    {
        line.ProductId = productId;

        var product = _products.FirstOrDefault(x => x.Id == productId);
        if (product is null)
            return;

        line.ProductCode = product.ProductCode;
        line.ProductDescription = product.Description;
        line.UnitPrice = product.UnitPrice;
        line.TaxCode = product.DefaultTaxCode;
        line.TaxPercentage = product.DefaultTaxPercentage;
    }

    private static void OnTaxCodeChanged(LineEditor line, string taxCode)
    {
        line.TaxCode = taxCode;
        line.TaxPercentage = TaxRates.First(rate => rate.Code == taxCode).Percentage;
    }

    private static decimal LineTotal(LineEditor line) =>
        Math.Round(line.Quantity * line.UnitPrice, 2, MidpointRounding.AwayFromZero);

    private async Task IssueAsync()
    {
        _issuing = true;
        _error = null;

        try
        {
            var startAt = _startDate!.Value.Date.Add(_startTime ?? TimeSpan.Zero);

            var request = new CreateStockMovementRequest(
                Company.SelectedCompanyId,
                _seriesId,
                DateOnly.FromDateTime(_movementDate!.Value),
                new MovementPartyRequest(
                    string.IsNullOrWhiteSpace(_partyTaxId) ? null : _partyTaxId.Trim(),
                    _partyName.Trim(),
                    _partyIsSupplier),
                new MovementLocationRequest(
                    _shipFromAddress.Trim(),
                    Normalize(_shipFromCity),
                    Normalize(_shipFromPostalCode)),
                new MovementLocationRequest(
                    _shipToAddress.Trim(),
                    Normalize(_shipToCity),
                    Normalize(_shipToPostalCode)),
                startAt.ToUniversalTime(),
                [.. _lines.Select(line => new CreateStockMovementLineRequest(
                    string.IsNullOrWhiteSpace(line.ProductCode) ? "GEN" : line.ProductCode,
                    line.ProductDescription,
                    line.Quantity,
                    line.UnitPrice,
                    line.TaxCode,
                    line.TaxPercentage,
                    TaxExemptionReason: line.TaxCode == ExemptCode ? _exemptionReason : null))],
                VehiclePlate: Normalize(_vehiclePlate),
                Comments: Normalize(_comments));

            var (movement, error) = await SalesApi.IssueStockMovementAsync(request);

            if (movement is null)
            {
                _error = error ?? "Não foi possível emitir a guia.";
                return;
            }

            Snackbar.Add($"Guia {movement.DocumentNumber} emitida. Falta comunicar à AT.", Severity.Success);
            Navigation.NavigateTo($"stock-movements/{movement.Id}");
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível emitir a guia: {ex.Message}";
        }
        finally
        {
            _issuing = false;
        }
    }

    private static string? Normalize(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed record TaxRateOption(string Code, decimal Percentage, string Label);

    private sealed class LineEditor
    {
        public Guid? ProductId { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductDescription { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public string TaxCode { get; set; } = "NOR";
        public decimal TaxPercentage { get; set; } = 23m;
    }

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
