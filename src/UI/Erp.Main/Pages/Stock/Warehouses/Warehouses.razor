@page "/warehouses"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject StockApiClient StockApi
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Armazéns</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Armazéns</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                O stock é gerido por armazém. O predefinido é o que os documentos assumem quando não
                indicam outro.
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(!Company.HasCompany)"
                   OnClick="@(() => Navigation.NavigateTo("warehouses/new"))">
            Novo armazém
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-2">
        <MudTable Items="_warehouses" Hover="true" Striped="true" Dense="true" Loading="_loading"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Código</MudTh>
                <MudTh>Nome</MudTh>
                <MudTh>Localidade</MudTh>
                <MudTh>Predefinido</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh Style="text-align: right;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.Code</MudText>
                </MudTd>
                <MudTd DataLabel="Nome">@context.Name</MudTd>
                <MudTd DataLabel="Localidade">@FormatCity(context)</MudTd>
                <MudTd DataLabel="Predefinido">
                    @if (context.IsDefault)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                            Predefinido
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? "Ativo" : "Inativo")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Ações" Style="text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   title="Editar armazém"
                                   OnClick="@(() => Navigation.NavigateTo($"warehouses/{context.Id}"))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Inventory" Size="Size.Small"
                                   title="Ver existências"
                                   OnClick="@(() => Navigation.NavigateTo($"stock?warehouseId={context.Id}"))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Ainda não há armazéns. Crie o primeiro para começar a movimentar stock.
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

@code {
    private bool _loading = true;
    private string? _error;
    private List<Warehouse> _warehouses = [];

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = Company.LoadError;

        if (!Company.HasCompany)
        {
            _warehouses = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            var (warehouses, error) = await StockApi.GetWarehousesAsync(Company.SelectedCompanyId);
            _warehouses = [.. warehouses];
            _error = error;
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar os armazéns: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private static string FormatCity(Warehouse warehouse) =>
        string.Join(" ", new[] { warehouse.PostalCode, warehouse.City }.Where(part => !string.IsNullOrWhiteSpace(part)));

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
