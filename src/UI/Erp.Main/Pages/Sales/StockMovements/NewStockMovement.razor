@page "/stock-movements/new"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.FiscalPT.Documents
@using Erp.Main.Components.Common
@using Erp.Main.Components.Sales
@using Erp.Main.Models
@using Erp.Main.Services
@using Microsoft.Extensions.Localization
@using Erp.Main.Resources
@inject SalesApiClient SalesApi
@inject SeriesApiClient SeriesApi
@inject CatalogApiClient Catalog
@inject StockApiClient StockApi
@inject CompanyState Company
@inject WarehouseState WarehouseState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["NewStockMovement_Title"]</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@L["NewStockMovement_HeaderTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["NewStockMovement_HeaderSubtitle"]
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("stock-movements"))">
            @L["NewStockMovement_BackButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_series.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">
            @L["NewStockMovement_NoSeriesWarning"]
            <MudLink Href="series/new" Class="ml-2">@L["NewStockMovement_CreateSeriesLink"]</MudLink>
        </MudAlert>
    }
    else
    {
        <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
            <MudText Typo="Typo.h6" Class="mb-3">@L["NewStockMovement_DocumentTitle"]</MudText>
            <MudGrid>
                <MudItem xs="12" md="5">
                    <MudSelect @bind-Value="_seriesId" Label="@L["NewStockMovement_SeriesLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                        @foreach (var series in _series)
                        {
                            <MudSelectItem T="Guid" Value="@series.Id">
                                @series.DocumentType @series.SeriesCode — @MovementTypes.Describe(series.DocumentType)
                                @L["NewStockMovement_NextNumberSuffix", series.CurrentSequence + 1]
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudDatePicker @bind-Date="_movementDate" Label="@L["NewStockMovement_DocumentDateLabel"]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudTextField @bind-Value="_vehiclePlate" Label="@L["NewStockMovement_VehiclePlateLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  HelperText="@L["NewStockMovement_VehiclePlateHelp"]" />
                </MudItem>
                @* The goods leave from a warehouse, and the selected one is the company's default. *@
                <MudItem xs="12" md="2">
                    <MudSelect T="Guid?" Value="_warehouseId" ValueChanged="OnWarehouseChanged"
                               Label="@L["NewStockMovement_WarehouseLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var warehouse in _warehouses)
                        {
                            <MudSelectItem T="Guid?" Value="@warehouse.Id">@warehouse.Code — @warehouse.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
            <MudText Typo="Typo.h6" Class="mb-3">@L["NewStockMovement_RecipientTitle"]</MudText>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <PartnerAutocomplete SelectedPartner="_selectedPartner" PartnerChanged="OnPartnerChanged"
                                         Kind="@(_partyIsSupplier ? PartnerKind.Supplier : PartnerKind.Customer)"
                                         Label="@(_partyIsSupplier ? L["NewStockMovement_SupplierLabel"] : L["NewStockMovement_CustomerLabel"])"
                                         Placeholder="@L["NewStockMovement_FreePlaceholder"]" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_partyTaxId" Label="@L["NewStockMovement_TaxIdLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  HelperText="@L["NewStockMovement_TaxIdHelp"]" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_partyName" Label="@L["NewStockMovement_NameLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-center">
                    <MudSwitch T="bool" Value="_partyIsSupplier" ValueChanged="OnPartyKindChanged"
                               Color="Color.Primary" Label="@L["NewStockMovement_IsSupplierLabel"]" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
            <MudText Typo="Typo.h6" Class="mb-3">@L["NewStockMovement_TransportTitle"]</MudText>
            <MudGrid>
                @* One grid for both points, so address, postal code and city line up across them. *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@L["NewStockMovement_LoadLocationLabel"]</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudTextField @bind-Value="_shipFromAddress" Label="@L["NewStockMovement_AddressLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" />
                </MudItem>
                <MudItem xs="6" sm="3" md="3">
                    <PostalCodeField @bind-Value="_shipFromPostalCode" StreetSelected="OnShipFromStreetSelected"
                                     Label="@L["NewStockMovement_PostalCodeLabel"]" />
                </MudItem>
                <MudItem xs="6" sm="3" md="3">
                    <MudTextField @bind-Value="_shipFromCity" Label="@L["NewStockMovement_CityLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@L["NewStockMovement_UnloadLocationLabel"]</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" md="6">
                    <MudTextField @bind-Value="_shipToAddress" Label="@L["NewStockMovement_AddressLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" />
                </MudItem>
                <MudItem xs="6" sm="3" md="3">
                    <PostalCodeField @bind-Value="_shipToPostalCode" StreetSelected="OnShipToStreetSelected"
                                     Label="@L["NewStockMovement_PostalCodeLabel"]" />
                </MudItem>
                <MudItem xs="6" sm="3" md="3">
                    <MudTextField @bind-Value="_shipToCity" Label="@L["NewStockMovement_CityLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_startDate" Label="@L["NewStockMovement_TransportStartDateLabel"]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudTimePicker @bind-Time="_startTime" Label="@L["NewStockMovement_TimeLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_comments" Label="@L["NewStockMovement_NotesLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">@L["NewStockMovement_GoodsTitle"]</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">
                    @L["NewStockMovement_AddLineButton"]
                </MudButton>
            </MudStack>

            <MudTable Items="_lines" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Style="width: 200px;">@L["NewStockMovement_ProductColumn"]</MudTh>
                    <MudTh>@L["NewStockMovement_DescriptionColumn"]</MudTh>
                    <MudTh Style="width: 110px;">@L["NewStockMovement_QuantityColumn"]</MudTh>
                    <MudTh Style="width: 110px;">@L["NewStockMovement_UnitPriceColumn"]</MudTh>
                    <MudTh Style="width: 80px;">@L["NewInvoice_DiscountColumn"]</MudTh>
                    <MudTh Style="width: 150px;">@L["NewStockMovement_TaxColumn"]</MudTh>
                    <MudTh Style="width: 110px; text-align: right;">@L["NewStockMovement_TotalColumn"]</MudTh>
                    <MudTh Style="width: 70px; text-align: right;">@L["NewStockMovement_ActionsColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["NewStockMovement_ProductColumn"]">
                        <ProductAutocomplete SelectedProduct="context.SelectedProduct"
                                              ProductChanged="@(product => OnProductChanged(context, product))" />
                    </MudTd>
                    <MudTd DataLabel="@L["NewStockMovement_DescriptionColumn"]">
                        <MudTextField @bind-Value="context.ProductDescription" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd DataLabel="@L["NewStockMovement_QuantityColumn"]">
                        <MudNumericField T="decimal" Value="context.Quantity" ValueChanged="@(quantity => OnQuantityChanged(context, quantity))"
                                         Margin="Margin.Dense" Min="0" Format="N2" />
                    </MudTd>
                    <MudTd DataLabel="@L["NewStockMovement_UnitPriceColumn"]">
                        <MudNumericField @bind-Value="context.UnitPrice" Margin="Margin.Dense" Min="0" Format="N2" />
                    </MudTd>
                    <MudTd DataLabel="@L["NewInvoice_DiscountColumn"]">
                        @* The eco-fee is collected in full for the managing entity: a discount on the article
                           it rides along with never carries over to it. *@
                        <MudNumericField @bind-Value="context.DiscountPercentage" Immediate="true" Margin="Margin.Dense" Min="0" Max="100"
                                         Format="0.##" HideSpinButtons="true" Adornment="Adornment.End" AdornmentText="%"
                                         Disabled="@context.IsEcoFee" />
                    </MudTd>
                    <MudTd DataLabel="@L["NewStockMovement_TaxColumn"]">
                        <MudSelect T="string" Value="context.TaxCode"
                                   ValueChanged="@(code => OnTaxCodeChanged(context, code))"
                                   ToStringFunc="@(code => TaxRateLabel(code))"
                                   Margin="Margin.Dense">
                            @foreach (var rate in _taxRates)
                            {
                                <MudSelectItem T="string" Value="@rate.Code">@rate.Label (@rate.Percentage.ToString("0.##")%)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd DataLabel="@L["NewStockMovement_TotalColumn"]" Style="text-align: right;">@LineTotal(context).ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["NewStockMovement_ActionsColumn"]" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       title="@L["NewStockMovement_RemoveLineTooltip"]"
                                       Disabled="@(_lines.Count == 1 || context.IsEcoFee)"
                                       OnClick="@(() => RemoveLine(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            @if (_lines.Any(line => line.TaxCode == ExemptCode))
            {
                <MudSelect T="string" @bind-Value="_exemptionCode" @bind-Value:after="StateHasChanged" Class="mt-4"
                           Label="@L["NewInvoice_ExemptionCodePlaceholder"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Required="true" Error="@string.IsNullOrWhiteSpace(_exemptionCode)">
                    @foreach (var reason in TaxExemptionReasons.All)
                    {
                        <MudSelectItem T="string" Value="@reason.Code">@reason.Code — @reason.Description</MudSelectItem>
                    }
                </MudSelect>
            }
        </MudPaper>

        <EditorCard Title="@L["NewInvoice_SummarySectionTitle"]" Icon="@Icons.Material.Filled.Calculate"
                    Description="@string.Format(L["NewStockMovement_TotalQuantityDescription"], TotalQuantity.ToString("N2"))">
            <DocumentTotalsSummary GrossLinesTotal="GrossLinesTotal"
                                   DiscountTotal="DiscountTotal"
                                   NetTotal="NetTotal"
                                   TaxTotal="TaxTotal"
                                   GrossTotal="GrossTotal"
                                   Taxes="TaxBreakdown" />
        </EditorCard>

        <MudPaper Elevation="0" Class="pa-3 erp-form-actions">
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("stock-movements"))">
                    @L["Common_CancelButton"]
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.LocalShipping"
                           Disabled="@(_issuing || !CanIssue)"
                           OnClick="IssueAsync">
                    @(_issuing ? L["NewStockMovement_IssuingButton"] : L["NewStockMovement_IssueButton"])
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    private const string ExemptCode = "ISE";

    private bool _loading = true;
    private bool _issuing;
    private string? _error;

    private Guid _seriesId;
    private DateTime? _movementDate = DateTime.Today;
    private DateTime? _startDate = DateTime.Today;
    private TimeSpan? _startTime = DateTime.Now.TimeOfDay;
    private string _vehiclePlate = string.Empty;
    private string _comments = string.Empty;
    private string? _exemptionCode;

    private Partner? _selectedPartner;
    private string _partyTaxId = string.Empty;
    private string _partyName = string.Empty;
    private bool _partyIsSupplier;

    private string _shipFromAddress = string.Empty;
    private string _shipFromCity = string.Empty;
    private string _shipFromPostalCode = string.Empty;
    private string _shipToAddress = string.Empty;
    private string _shipToCity = string.Empty;
    private string _shipToPostalCode = string.Empty;

    private void OnShipFromStreetSelected(string address) => _shipFromAddress = address;

    private void OnShipToStreetSelected(string address) => _shipToAddress = address;

    private List<SalesSeries> _series = [];
    private List<Warehouse> _warehouses = [];
    private Guid? _warehouseId;
    private List<VatRate> _taxRates = [];
    private List<EcoFeeType> _ecoFeeTypes = [];
    private readonly List<LineEditor> _lines = [new()];

    private decimal TotalQuantity => _lines.Sum(line => line.Quantity);

    private decimal GrossLinesTotal => _lines.Sum(GrossAmount);

    private decimal DiscountTotal => _lines.Sum(DiscountAmount);

    private decimal NetTotal => _lines.Sum(LineTotal);

    private decimal TaxTotal => _lines.Sum(TaxAmount);

    private decimal GrossTotal => NetTotal + TaxTotal;

    /// <summary>The VAT grouped by rate, the way the document itself will group it.</summary>
    private IReadOnlyList<DocumentTotalsSummary.TaxLine> TaxBreakdown =>
    [
        .. _lines
            // A line with no product chosen yet still carries the editor's default 23% — real for
            // no article at all, so it has no business in the breakdown until one is picked. Code,
            // not ProductId: an eco-fee companion line has a ProductCode but no catalog ProductId,
            // and a free-text code (empty catalog) never gets a ProductId either.
            .Where(line => !string.IsNullOrWhiteSpace(line.ProductCode))
            .GroupBy(line => (line.TaxCode, line.TaxPercentage))
            .OrderByDescending(group => group.Key.TaxPercentage)
            .Select(group => new DocumentTotalsSummary.TaxLine(
                _taxRates.FirstOrDefault(rate => rate.Code == group.Key.TaxCode)?.Label ?? group.Key.TaxCode,
                group.Key.TaxPercentage,
                group.Sum(LineTotal),
                group.Sum(TaxAmount)))
    ];

    /// <summary>And the tax box shows the rate, not the name of the rate.</summary>
    private string TaxRateLabel(string? taxCode)
    {
        var rate = _taxRates.FirstOrDefault(rate => rate.Code == taxCode);
        return rate is null ? taxCode ?? string.Empty : $"{rate.Percentage:0.##}%";
    }

    private bool CanIssue =>
        _seriesId != Guid.Empty
        && _movementDate is not null
        && _startDate is not null
        && !string.IsNullOrWhiteSpace(_partyName)
        && !string.IsNullOrWhiteSpace(_shipFromAddress)
        && !string.IsNullOrWhiteSpace(_shipToAddress)
        && _lines.All(line => line.Quantity > 0 && !string.IsNullOrWhiteSpace(line.ProductDescription))
        && (!_lines.Any(line => line.TaxCode == ExemptCode) || !string.IsNullOrWhiteSpace(_exemptionCode));

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        WarehouseState.Changed += OnWarehouseStateChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = Company.LoadError;

        if (!Company.HasCompany)
        {
            _series = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            // Only series of a movement type can issue these documents.
            var series = await SeriesApi.GetSeriesAsync(Company.SelectedCompanyId);
            _series = [.. series.Where(x => x.CanIssue && MovementTypes.All.Any(type => type.Code == x.DocumentType))];
            _seriesId = _series.FirstOrDefault()?.Id ?? Guid.Empty;

            // Mainland rates — this document has no fiscal-region selector of its own.
            var (rates, _) = await Catalog.GetVatRatesAsync();
            _taxRates = [.. rates.Where(x => x.FiscalRegion == "PT" && x.IsActive)];

            var (ecoFeeTypes, _) = await Catalog.GetEcoFeeTypesAsync(Company.SelectedCompanyId);
            _ecoFeeTypes = [.. ecoFeeTypes.Where(x => x.IsActive)];

            // The goods leave from a warehouse: the globally selected one, with its address as the
            // loading point, which is what a delivery note usually says.
            await WarehouseState.EnsureLoadedAsync();
            _warehouses = [.. WarehouseState.Warehouses];
            OnWarehouseChanged(WarehouseState.HasWarehouse ? WarehouseState.SelectedWarehouseId : null);
        }
        catch (Exception ex)
        {
            _error = L["NewStockMovement_LoadError", ex.Message];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>Switching between customer and supplier clears a selection that no longer applies.</summary>
    private void OnPartyKindChanged(bool isSupplier)
    {
        _partyIsSupplier = isSupplier;
        _selectedPartner = null;
    }

    private void OnPartnerChanged(Partner? partner)
    {
        _selectedPartner = partner;

        if (partner is null)
            return;

        _partyName = partner.Name;
        _partyTaxId = partner.TaxId;

        // The delivery point defaults to the address on file, which is what it is most of the time.
        if (string.IsNullOrWhiteSpace(_shipToAddress) && !string.IsNullOrWhiteSpace(partner.Address))
        {
            _shipToAddress = partner.Address;
            _shipToCity = partner.City ?? string.Empty;
            _shipToPostalCode = partner.PostalCode ?? string.Empty;
        }
    }

    private void AddLine() => _lines.Add(new LineEditor());

    private void RemoveLine(LineEditor line)
    {
        if (_lines.Count <= 1 || line.IsEcoFee)
            return;

        RemoveEcoFeeCompanion(line);
        _lines.Remove(line);
    }

    private void OnProductChanged(LineEditor line, ProductListItem? product)
    {
        RemoveEcoFeeCompanion(line);

        line.SelectedProduct = product;

        if (product is null)
            return;

        line.ProductCode = product.ProductCode;
        line.ProductDescription = product.Description;
        line.UnitPrice = product.UnitPrice;
        line.TaxCode = product.DefaultTaxCode;
        line.TaxPercentage = product.DefaultTaxPercentage;

        AddEcoFeeCompanionIfAny(line, product);
    }

    private void OnQuantityChanged(LineEditor line, decimal quantity)
    {
        line.Quantity = quantity;

        // The eco-fee always charges for as many units (or kilograms) as its article moved.
        var companion = _lines.FirstOrDefault(x => x.EcoFeeForLine == line);
        if (companion is not null)
            companion.Quantity = quantity;
    }

    /// <summary>
    /// Batteries, lubricating oils and similar: an article carrying an eco-fee gets it added right
    /// after it, on its own line, as the law requires — never folded into the article's own price.
    /// </summary>
    private void AddEcoFeeCompanionIfAny(LineEditor line, ProductListItem product)
    {
        if (product.EcoFeeTypeId is not { } ecoFeeTypeId)
            return;

        if (_ecoFeeTypes.FirstOrDefault(x => x.Id == ecoFeeTypeId) is not { } ecoFeeType)
            return;

        var isPerKg = ecoFeeType.CalculationBasis == EcoFeeCalculationBases.PerKg;

        var companion = new LineEditor
        {
            ProductCode = ecoFeeType.Code,
            ProductDescription = ecoFeeType.Description,
            Quantity = line.Quantity,
            UnitPrice = isPerKg ? ecoFeeType.Rate * (product.EcoFeeWeightKg ?? 0m) : ecoFeeType.Rate,
            TaxCode = TaxCodes.Normal,
            TaxPercentage = _taxRates.FirstOrDefault(x => x.Code == TaxCodes.Normal)?.Percentage ?? 23m,
            IsEcoFee = true,
            EcoFeeForLine = line
        };

        _lines.Insert(_lines.IndexOf(line) + 1, companion);
    }

    private void RemoveEcoFeeCompanion(LineEditor line) =>
        _lines.RemoveAll(x => x.EcoFeeForLine == line);

    private void OnTaxCodeChanged(LineEditor line, string taxCode)
    {
        line.TaxCode = taxCode;
        line.TaxPercentage = _taxRates.First(rate => rate.Code == taxCode).Percentage;
    }

    // Same arithmetic as the API: the discount comes off the rounded gross amount.
    private static decimal GrossAmount(LineEditor line) => Round(line.Quantity * line.UnitPrice);

    private static decimal DiscountAmount(LineEditor line) => Round(GrossAmount(line) * line.DiscountPercentage / 100m);

    private static decimal LineTotal(LineEditor line) => GrossAmount(line) - DiscountAmount(line);

    private static decimal TaxAmount(LineEditor line) => Round(LineTotal(line) * line.TaxPercentage / 100m);

    private static decimal Round(decimal value) => Math.Round(value, 2, MidpointRounding.AwayFromZero);

    private async Task IssueAsync()
    {
        _issuing = true;
        _error = null;

        try
        {
            var startAt = _startDate!.Value.Date.Add(_startTime ?? TimeSpan.Zero);

            var request = new CreateStockMovementRequest(
                Company.SelectedCompanyId,
                _seriesId,
                DateOnly.FromDateTime(_movementDate!.Value),
                new MovementPartyRequest(
                    string.IsNullOrWhiteSpace(_partyTaxId) ? null : _partyTaxId.Trim(),
                    _partyName.Trim(),
                    _partyIsSupplier),
                new MovementLocationRequest(
                    _shipFromAddress.Trim(),
                    Normalize(_shipFromCity),
                    Normalize(_shipFromPostalCode),
                    WarehouseId: _warehouseId?.ToString()),
                new MovementLocationRequest(
                    _shipToAddress.Trim(),
                    Normalize(_shipToCity),
                    Normalize(_shipToPostalCode)),
                startAt.ToUniversalTime(),
                [.. _lines.Select(line => new CreateStockMovementLineRequest(
                    string.IsNullOrWhiteSpace(line.ProductCode) ? L["NewStockMovement_GenericProductCode"] : line.ProductCode,
                    line.ProductDescription,
                    line.Quantity,
                    line.UnitPrice,
                    line.TaxCode,
                    line.TaxPercentage,
                    DiscountPercentage: line.DiscountPercentage,
                    TaxExemptionCode: line.TaxCode == ExemptCode ? _exemptionCode : null,
                    IsEcoFee: line.IsEcoFee,
                    EcoFeeForLineNumber: line.EcoFeeForLine is { } parent ? _lines.IndexOf(parent) + 1 : null))],
                VehiclePlate: Normalize(_vehiclePlate),
                Comments: Normalize(_comments),
                WarehouseId: _warehouseId);

            var (movement, error) = await SalesApi.IssueStockMovementAsync(request);

            if (movement is null)
            {
                _error = error ?? L["NewStockMovement_IssueFallbackError"];
                return;
            }

            Snackbar.Add(L["NewStockMovement_IssueSuccess", movement.DocumentNumber], Severity.Success);
            Navigation.NavigateTo($"stock-movements/{movement.Id}");
        }
        catch (Exception ex)
        {
            _error = L["NewStockMovement_IssueError", ex.Message];
        }
        finally
        {
            _issuing = false;
        }
    }

    /// <summary>
    /// Choosing the warehouse fills the loading point with its address, which is what the document
    /// says unless the goods leave from somewhere else.
    /// </summary>
    private void OnWarehouseChanged(Guid? warehouseId)
    {
        _warehouseId = warehouseId;

        if (_warehouses.FirstOrDefault(warehouse => warehouse.Id == warehouseId) is not { } warehouse)
            return;

        if (string.IsNullOrWhiteSpace(_shipFromAddress))
            _shipFromAddress = warehouse.Address ?? warehouse.Name;

        if (string.IsNullOrWhiteSpace(_shipFromCity))
            _shipFromCity = warehouse.City ?? string.Empty;

        if (string.IsNullOrWhiteSpace(_shipFromPostalCode))
            _shipFromPostalCode = warehouse.PostalCode ?? string.Empty;
    }

    private static string? Normalize(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();


    private sealed class LineEditor
    {
        /// <summary>The article behind the autocomplete's box, kept whole so the box can show its
        /// code without a lookup back into a catalogue that is never held in full.</summary>
        public ProductListItem? SelectedProduct { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductDescription { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal DiscountPercentage { get; set; }
        public string TaxCode { get; set; } = "NOR";
        public decimal TaxPercentage { get; set; } = 23m;

        /// <summary>True for an eco-fee ("Ecovalor") line generated alongside an article, not an article itself.</summary>
        public bool IsEcoFee { get; set; }

        /// <summary>The article line this eco-fee was generated for, when <see cref="IsEcoFee"/> is true.</summary>
        public LineEditor? EcoFeeForLine { get; set; }
    }

    public void Dispose()
    {
        Company.Changed -= OnCompanyChanged;
        WarehouseState.Changed -= OnWarehouseStateChanged;
    }

    private void OnWarehouseStateChanged() => InvokeAsync(() =>
        OnWarehouseChanged(WarehouseState.HasWarehouse ? WarehouseState.SelectedWarehouseId : null));
}
