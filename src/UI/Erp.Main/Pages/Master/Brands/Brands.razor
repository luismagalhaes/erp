@page "/brands"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Marcas</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Marcas</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Marcas atribuíveis aos artigos.</MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(!Company.HasCompany)"
                   OnClick="@(() => Navigation.NavigateTo("brands/new"))">
            Nova marca
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-2">
        <MudTable Items="_brands" Hover="true" Striped="true" Dense="true" Loading="_loading"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Código</MudTh>
                <MudTh>Nome</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh Style="text-align: right;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.Code</MudText>
                </MudTd>
                <MudTd DataLabel="Nome">@context.Name</MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? "Ativa" : "Inativa")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Ações" Style="text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   title="Editar marca"
                                   OnClick="@(() => Navigation.NavigateTo($"brands/{context.Id}"))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Ainda não há marcas criadas.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

@code {
    private bool _loading = true;
    private string? _error;
    private List<Brand> _brands = [];

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = Company.LoadError;

        if (!Company.HasCompany)
        {
            _brands = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            var (brands, error) = await Catalog.GetBrandsAsync(Company.SelectedCompanyId);
            _brands = [.. brands];
            _error = error;
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar as marcas: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
