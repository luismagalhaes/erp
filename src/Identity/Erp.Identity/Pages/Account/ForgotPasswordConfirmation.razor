@page "/Account/ForgotPasswordConfirmation"
@layout Layout.AuthLayout
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Erp.Identity.Resources
@attribute [AllowAnonymous]
@inject IStringLocalizer<IdentityResources> Localizer

<PageTitle>@Localizer["Account_ForgotPasswordConfirmation_PageTitle"]</PageTitle>

<div class="content-card mud-elevation-1">
    <h2>@Localizer["Account_ForgotPasswordConfirmation_Heading"]</h2>
    <p>@Localizer["Account_ForgotPasswordConfirmation_Message"]</p>
    <div class="auth-links mt-16">
        <a class="auth-link" href="/Account/SignIn">@Localizer["Account_ForgotPasswordConfirmation_BackToSignInLink"]</a>
    </div>
</div>
