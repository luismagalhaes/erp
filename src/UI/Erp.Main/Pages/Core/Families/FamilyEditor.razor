@page "/product-families/new"
@page "/product-families/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Models.Core
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@Title</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="@Title" Breadcrumbs="Breadcrumbs">
        <Actions>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("product-families"))">
                @L["FamilyEditor_BackButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <EditorCard Title="@Title" Icon="@Icons.Material.Filled.AccountTree">
            <HeaderActions>
                @if (!IsNew)
                {
                    <MudSwitch @bind-Value="_isActive" Color="Color.Primary" Size="Size.Small" Label="@L["FamilyEditor_ActiveLabel"]" />
                }
            </HeaderActions>
            <ChildContent>
                @* Name first, then the code: the code is numbered by the API and never typed here. *@
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="9">
                        <MudTextField @bind-Value="_name" Immediate="true" Label="@L["FamilyEditor_NameLabel"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField Value="_code" ReadOnly="true" Disabled="true" Label="@L["FamilyEditor_CodeLabel"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Placeholder="@L["PartnerForm_CodeAutomaticPlaceholder"]" />
                    </MudItem>
                </MudGrid>
            </ChildContent>
        </EditorCard>

        <FormActions Busy="_saving" Disabled="@(!CanSave)"
                     OnSubmit="SaveAsync"
                     OnCancel="@(() => Navigation.NavigateTo("product-families"))" />
    }
</MudStack>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNew => Id is null;

    private string Title => IsNew ? L["FamilyEditor_NewTitle"] : L["FamilyEditor_EditTitle"];

    private List<BreadcrumbItem> Breadcrumbs =>
    [
        new(L["Families_PageTitle"].Value, href: "product-families"),
        new(Title, href: null, disabled: true)
    ];

    private bool _loading;
    private bool _saving;
    private string? _error;

    private bool _loaded;
    private Guid? _loadedId;

    private string _code = string.Empty;
    private string _name = string.Empty;
    private bool _isActive = true;

    private bool CanSave =>
        Company.HasCompany && !string.IsNullOrWhiteSpace(_name);

    protected override async Task OnParametersSetAsync()
    {
        await Company.EnsureLoadedAsync();

        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loaded && _loadedId == Id)
            return;

        _loaded = true;
        _loadedId = Id;

        if (IsNew)
            return;

        _loading = true;

        try
        {
            var family = await Catalog.GetFamilyAsync(Id!.Value);

            if (family is null)
            {
                _error = L["FamilyEditor_NotFound"];
                return;
            }

            _code = family.Code;
            _name = family.Name;
            _isActive = family.IsActive;
        }
        catch (Exception ex)
        {
            _error = string.Format(L["FamilyEditor_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            // A blank code asks the API for the next number.
            var error = IsNew
                ? await Catalog.CreateFamilyAsync(new CreateProductFamilyRequest(
                    Company.SelectedCompanyId, string.Empty, _name.Trim()))
                : await Catalog.UpdateFamilyAsync(Id!.Value, new UpdateProductFamilyRequest(_name.Trim(), _isActive));

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(IsNew ? L["FamilyEditor_CreatedMessage"] : L["FamilyEditor_UpdatedMessage"], Severity.Success);
            Navigation.NavigateTo("product-families");
        }
        catch (Exception ex)
        {
            _error = string.Format(L["FamilyEditor_SaveError"], ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }
}
