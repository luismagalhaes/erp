    private static Color StatusColorFor(CompanySubscription subscription)
    {
        var now = DateTime.UtcNow;
        if (subscription.StartedAtUtc > now)
            return Color.Info;

        return subscription.IsExpired ? Color.Error : Color.Success;
    }

    private LocalizedString StatusLabelFor(CompanySubscription subscription)
    {
        var now = DateTime.UtcNow;
        if (subscription.StartedAtUtc > now)
            return Localizer["Subscriptions_ScheduledStatus"];

        return subscription.IsExpired ? Localizer["Subscriptions_ExpiredStatus"] : Localizer["Subscriptions_ActiveStatus"];
    }

    private async Task LoadSubscriptionAsync()
    {
        _workingSubscription = true;
        _subscriptionError = null;

        try
        {
            _subscription = await CoreApi.GetCompanySubscriptionAsync(Id!.Value);

            var (subscriptions, subscriptionsError) = await CoreApi.GetAllCompanySubscriptionsAsync(Id!.Value);
            // Newest first: the ones a SuperAdmin cares about looking at are the current and
            // scheduled ones, not the oldest expired row.
            _subscriptions = [.. subscriptions.OrderByDescending(x => x.StartedAtUtc)];

            if (subscriptionsError is not null)
                _subscriptionError = subscriptionsError;

            // Every package, not only the active ones: a company can legitimately still be on one
            // that is no longer offered, and the dropdown has to be able to show it.
            var (plans, error) = await CoreApi.GetSubscriptionPlansAsync();
            _subscriptionPlans = [.. plans];

            if (error is not null)
                _subscriptionError = error;

            _subscriptionPlanId = null;
            _subscriptionStartedAt = null;
            _subscriptionExpiresAt = null;
        }
        catch (Exception ex)
        {
            _subscriptionError = string.Format(Localizer["CompanyEditor_LoadSubscriptionError"], ex.Message);
        }
        finally
        {
            _workingSubscription = false;
        }
    }

    private async Task SaveSubscriptionAsync()
    {
        if (_subscriptionPlanId is null)
            return;

        _savingSubscription = true;
        _subscriptionError = null;

        try
        {
            var error = await CoreApi.AssignCompanySubscriptionAsync(
                Id!.Value,
                new AssignSubscriptionRequest(
                    _subscriptionPlanId.Value,
                    _subscriptionStartedAt?.ToUniversalTime(),
                    _subscriptionExpiresAt?.ToUniversalTime()));

            if (error is not null)
            {
                _subscriptionError = error;
                return;
            }

            Snackbar.Add(Localizer["Subscriptions_Changed"].Value, Severity.Success);
            await LoadSubscriptionAsync();
        }
        finally
        {
            _savingSubscription = false;
        }
    }

    private async Task RemoveSubscriptionAsync(CompanySubscription subscription)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Localizer["Subscriptions_DeleteHeading"].Value,
            string.Format(Localizer["Subscriptions_DeleteConfirm"], subscription.PlanName),
            yesText: Localizer["Common_DeleteButton"].Value,
            cancelText: Localizer["Common_CancelButton"].Value);

        if (confirmed != true)
            return;

        _subscriptionError = null;

        var error = await CoreApi.RemoveCompanySubscriptionAsync(Id!.Value, subscription.Id);
        if (error is not null)
        {
            _subscriptionError = error;
            return;
        }

        Snackbar.Add(Localizer["Subscriptions_Deleted"].Value, Severity.Success);
        await LoadSubscriptionAsync();
    }

