@page "/companies"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject CoreApiClient CoreApi
@inject NavigationManager Navigation

<PageTitle>Empresas</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Empresas</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Entidades emitentes. A empresa ativa escolhe-se no cabeçalho.
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("companies/new"))">
            Nova empresa
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-2">
        <MudTable Items="_companies" Hover="true" Striped="true" Dense="true" Loading="_loading"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Nome</MudTh>
                <MudTh>Designação legal</MudTh>
                <MudTh>NIF</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh Style="text-align: right;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nome">@context.Name</MudTd>
                <MudTd DataLabel="Designação legal">@context.LegalName</MudTd>
                <MudTd DataLabel="NIF">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.TaxId</MudText>
                </MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? "Ativa" : "Inativa")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Ações" Style="text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   title="Editar empresa"
                                   OnClick="@(() => Navigation.NavigateTo($"companies/{context.Id}"))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Ainda não há empresas criadas.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

@code {
    private bool _loading = true;
    private string? _error;
    private List<CompanyListItem> _companies = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _companies = [.. await CoreApi.GetCompaniesAsync()];
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar as empresas: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
