@page "/self-billed-invoices/{Id:guid}/print"
@attribute [Authorize]
@layout PrintLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Printing
@using Erp.Main.Layout
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject PurchasingApiClient Purchasing
@inject CoreApiClient CoreApi
@inject CompanyState Company
@inject IStringLocalizer<MainResources> L

<PageTitle>@(_invoice?.DocumentNumber ?? L["SelfBilledInvoicePrint_DefaultTitle"])</PageTitle>

<PrintToolbar Copy="_copy" CopyChanged="@(copy => _copy = copy)"
              BackUrl="@($"self-billed-invoices/{Id}")" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_invoice is null)
{
    <MudAlert Severity="Severity.Error">@(_error ?? L["SelfBilledInvoicePrint_DocumentNotFound"])</MudAlert>
}
else
{
    @* The designation the law requires on the paper: it says how the document came to exist. *@
    <PrintDocumentHeader Company="_company"
                         Designation="@L["SelfBilledInvoicePrint_Designation"]"
                         DocumentNumber="@_invoice.DocumentNumber"
                         DocumentDate="_invoice.IssueDate"
                         Copy="@_copy" />

    @if (_invoice.IsVoided)
    {
        <div class="print-voided">@L["SelfBilledInvoicePrint_VoidedNotice"]</div>
    }

    <div class="print-parties">
        <div class="print-box">
            @* On a self-billed invoice the roles are the other way round: the supplier sold. *@
            <div class="label">@L["SelfBilledInvoicePrint_SupplierLabel"]</div>
            <div><strong>@_invoice.Supplier.Name</strong></div>
            @if (!string.IsNullOrWhiteSpace(_invoice.Supplier.Address))
            {
                <div>@_invoice.Supplier.Address</div>
            }
            <div>@string.Format(L["SelfBilledInvoicePrint_TaxIdPrefix"], _invoice.Supplier.TaxId)</div>
        </div>

        @if (_company is not null)
        {
            <div class="print-box">
                <div class="label">@L["SelfBilledInvoicePrint_AcquirerLabel"]</div>
                <div><strong>@_company.Name</strong></div>
                <div>@string.Format(L["SelfBilledInvoicePrint_TaxIdPrefix"], _company.TaxId)</div>
            </div>
        }
    </div>

    <table class="print-table">
        <thead>
            <tr>
                <th style="width: 24px;">@L["SelfBilledInvoicePrint_NumberColumn"]</th>
                <th style="width: 70px;">@L["SelfBilledInvoicePrint_CodeColumn"]</th>
                <th>@L["SelfBilledInvoicePrint_DescriptionColumn"]</th>
                <th class="num" style="width: 60px;">@L["SelfBilledInvoicePrint_QuantityColumn"]</th>
                <th style="width: 34px;">@L["SelfBilledInvoicePrint_UnitColumn"]</th>
                <th class="num" style="width: 70px;">@L["SelfBilledInvoicePrint_PriceColumn"]</th>
                <th class="num" style="width: 44px;">@L["SelfBilledInvoicePrint_TaxColumn"]</th>
                <th class="num" style="width: 76px;">@L["SelfBilledInvoicePrint_ValueColumn"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in _invoice.Lines)
            {
                <tr>
                    <td>@line.LineNumber</td>
                    <td>@line.ProductCode</td>
                    <td>
                        @line.ProductDescription
                        @if (!string.IsNullOrWhiteSpace(line.TaxExemptionCode))
                        {
                            <span> (@line.TaxExemptionCode)</span>
                        }
                    </td>
                    <td class="num">@line.Quantity.ToString("N2")</td>
                    <td>@line.UnitOfMeasure</td>
                    <td class="num">@line.UnitPrice.ToString("N2")</td>
                    <td class="num">@line.TaxPercentage.ToString("N0")%</td>
                    <td class="num">@line.LineAmount.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="print-summary">
        <div>
            <table class="print-table" style="width: auto;">
                <thead>
                    <tr>
                        <th>@L["SelfBilledInvoicePrint_TaxSpaceColumn"]</th>
                        <th>@L["SelfBilledInvoicePrint_RateColumn"]</th>
                        <th class="num">@L["SelfBilledInvoicePrint_TaxableBaseColumn"]</th>
                        <th class="num">@L["SelfBilledInvoicePrint_TaxColumn"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tax in _invoice.TaxSummary)
                    {
                        <tr>
                            <td>@tax.TaxCountryRegion</td>
                            <td>@tax.TaxCode @tax.TaxPercentage.ToString("N0")%</td>
                            <td class="num">@tax.TaxableBase.ToString("N2")</td>
                            <td class="num">@tax.TaxAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="print-totals">
            <div class="row"><span>@L["SelfBilledInvoicePrint_NetTotalLabel"]</span><span>@_invoice.NetTotal.ToString("N2")</span></div>
            <div class="row"><span>@L["SelfBilledInvoicePrint_TaxLabel"]</span><span>@_invoice.TaxPayable.ToString("N2")</span></div>
            <div class="row grand"><span>@L["SelfBilledInvoicePrint_TotalLabel"]</span><span>@_invoice.GrossTotal.ToString("N2") EUR</span></div>
        </div>
    </div>

    @if (_exemptionReasons.Count > 0)
    {
        <div class="print-exemptions">
            @foreach (var reason in _exemptionReasons)
            {
                <div>@string.Format(L["SelfBilledInvoicePrint_ExemptionPrefix"], reason)</div>
            }
        </div>
    }

    <PrintFiscalFooter PrintableHash="@_invoice.PrintableHash"
                       Atcud="@_invoice.Atcud"
                       QrCodePayload="@_invoice.QrCodePayload">
        <div>@string.Format(L["SelfBilledInvoicePrint_IssuedOn"], _invoice.SystemEntryDateUtc.ToString("yyyy-MM-dd HH:mm:ss"))</div>
        <div>@L["SelfBilledInvoicePrint_LegalNotice"]</div>
    </PrintFiscalFooter>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private string? _error;
    private string _copy = "Original";
    private Guid? _loadedId;

    private SelfBilledInvoice? _invoice;
    private CompanyDetail? _company;
    private List<string> _exemptionReasons = [];

    protected override async Task OnParametersSetAsync()
    {
        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loadedId == Id)
            return;

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            await Company.EnsureLoadedAsync();

            _invoice = await Purchasing.GetSelfBilledInvoiceAsync(Id);

            if (_invoice is null)
            {
                _error = L["SelfBilledInvoicePrint_DocumentNotFound"];
                return;
            }

            // Each exemption reason is printed once, however many lines carry it.
            _exemptionReasons = [.. _invoice.Lines
                .Select(line => line.TaxExemptionReason)
                .Where(reason => !string.IsNullOrWhiteSpace(reason))
                .Select(reason => reason!)
                .Distinct(StringComparer.Ordinal)];

            if (Company.HasCompany)
                _company = await CoreApi.GetCompanyAsync(Company.SelectedCompanyId);
        }
        catch (Exception ex)
        {
            _error = string.Format(L["SelfBilledInvoicePrint_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
