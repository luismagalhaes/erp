@page "/Account/ForgotPassword"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Erp.Identity.Resources
@using Erp.Identity.Services
@inject UserManager<ApplicationUser> UserManager
@inject IEmailService EmailService
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IStringLocalizer<IdentityResources> Localizer

<PageTitle>@Localizer["Account_ForgotPassword_PageTitle"]</PageTitle>

<div class="auth-wrapper">
    <div class="auth-card mud-elevation-3">
        <div class="auth-logo">ERP</div>
        <h2>@Localizer["Account_ForgotPassword_Heading"]</h2>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="auth-error">@ErrorMessage</div>
        }

        <EditForm Model="Input" OnValidSubmit="HandleSubmitAsync" FormName="forgot-password-form">
            <DataAnnotationsValidator />
            <div class="auth-field">
                <label>@Localizer["Account_ForgotPassword_EmailLabel"]</label>
                <InputText @bind-Value="Input.Email" type="email" autocomplete="username" />
            </div>
            <button type="submit" class="auth-button">@Localizer["Account_ForgotPassword_SubmitButton"]</button>
        </EditForm>

        <div class="auth-links mt-16">
            <a class="auth-link" href="/Account/SignIn">@Localizer["Account_ForgotPassword_BackToSignInLink"]</a>
        </div>
    </div>
</div>

@code {
    private InputModel Input { get; set; } = new();
    private string? ErrorMessage { get; set; }

    private async Task HandleSubmitAsync()
    {
        ErrorMessage = null;
        var email = (Input.Email ?? string.Empty).Trim();

        var user = await UserManager.FindByEmailAsync(email);
        if (user is not null)
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var encodedToken = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
            var resetLink = EmailLinkBuilder.Build(
                Configuration,
                "/Account/ResetPassword",
                new Dictionary<string, string?> { ["email"] = email, ["token"] = encodedToken });

            var html = $"<p>{Localizer["Account_ForgotPassword_EmailGreeting", user.FullName]}</p><p>{Localizer["Account_ForgotPassword_EmailBody"]} <a href=\"{resetLink}\">link</a></p>";
            await EmailService.SendAsync(email, Localizer["Account_ForgotPassword_EmailSubject"], html);
        }

        Navigation.NavigateTo("/Account/ForgotPasswordConfirmation", forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required, EmailAddress]
        public string? Email { get; set; }
    }
}
