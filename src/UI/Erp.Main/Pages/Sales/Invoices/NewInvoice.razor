@page "/invoices/new"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Erp.Common
@using Erp.FiscalPT.Documents
@using Erp.Main.Components.Common
@using Erp.Main.Components.Sales
@using Erp.Main.Models
@using Erp.Main.Models.Core
@using Erp.Main.Resources
@using Erp.Main.Services
@inject SalesApiClient SalesApi
@inject SeriesApiClient SeriesApi
@inject CatalogApiClient Catalog
@inject StockApiClient StockApi
@inject LookupApiClient Lookups
@inject CompanyState Company
@inject WarehouseState WarehouseState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["NewInvoice_PageTitle"]</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="@L["NewInvoice_HeaderTitle"]" Breadcrumbs="Breadcrumbs">
        <Actions>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("invoices"))">
                @L["NewInvoice_BackButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_series.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">
            @L["NewInvoice_NoSeriesWarning"]
            <MudLink Href="series" Class="ml-2">@L["NewInvoice_ManageSeriesLink"]</MudLink>
        </MudAlert>
    }
    else
    {
        <EditorCard Title="@L["NewInvoice_DocumentSectionTitle"]" Icon="@Icons.Material.Filled.Receipt">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="Guid" Value="_seriesId" ValueChanged="OnSeriesChanged" Label="@L["NewInvoice_SeriesLabel"]"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                        @foreach (var series in _series)
                        {
                            <MudSelectItem T="Guid" Value="@series.Id">
                                @string.Format(L["NewInvoice_SeriesNextNumber"], series.DocumentType, series.SeriesCode, series.CurrentSequence + 1)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3" md="2">
                    <MudDatePicker Date="_documentDate" DateChanged="OnDocumentDateChanged" Label="@L["NewInvoice_DocumentDateLabel"]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="6" sm="3" md="2">
                    @* A fatura-recibo is paid on the day, so it is due on its own date. *@
                    <MudDatePicker @bind-Date="_dueDate" Label="@L["NewInvoice_DueDateLabel"]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd"
                                   MinDate="_documentDate" Disabled="IsInvoiceReceipt" />
                </MudItem>
                @if (MovesStock)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="Guid?" @bind-Value="_warehouseId" Label="@L["NewInvoice_WarehouseLabel"]"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                            @foreach (var warehouse in _warehouses)
                            {
                                <MudSelectItem T="Guid?" Value="@warehouse.Id">@warehouse.Code — @warehouse.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
            </MudGrid>
        </EditorCard>

        <EditorCard Title="@L["NewInvoice_CustomerSectionTitle"]" Icon="@Icons.Material.Filled.PersonOutline">
            <HeaderActions>
                <MudAutocomplete T="Partner" Value="_customer" ValueChanged="OnCustomerChosen"
                                 SearchFunc="SearchCustomersAsync" ToStringFunc="@(c => c is null ? string.Empty : $"{c.Name} ({c.TaxId})")"
                                 Placeholder="@L["NewInvoice_PickCustomerPlaceholder"]" Clearable="true" ResetValueOnEmptyText="true"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 280px;" />
            </HeaderActions>
            <ChildContent>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="4" md="3">
                        <MudTextField @bind-Value="_customerTaxId" Label="@L["NewInvoice_TaxIdLabel"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="@L["NewInvoice_TaxIdHelperText"]"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                                      OnAdornmentClick="LookupCustomerTaxIdAsync" AdornmentAriaLabel="@L["PartnerForm_TaxIdLookupTooltip"]" />
                    </MudItem>
                    <MudItem xs="12" sm="8" md="9">
                        <MudTextField @bind-Value="_customerName" Immediate="true" Label="@L["NewInvoice_NameLabel"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                    </MudItem>
                    @if (!string.IsNullOrWhiteSpace(_customerTaxIdLookupMessage))
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="@_customerTaxIdLookupSeverity" Dense="true">@_customerTaxIdLookupMessage</MudAlert>
                        </MudItem>
                    }
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_customerAddress" Label="@L["NewInvoice_AddressLabel"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <PostalCodeField @bind-Value="_customerPostalCode" Country="@_customerCountry"
                                         LookupResolved="OnCustomerPostalCodeResolvedAsync" StreetSelected="OnCustomerStreetSelectedAsync"
                                         Label="@L["PartnerForm_PostalCodeLabel"]" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudTextField @bind-Value="_customerCity" Label="@L["PartnerForm_CityLabel"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </ChildContent>
        </EditorCard>

        <EditorCard Title="@L["NewInvoice_LinesSectionTitle"]" Icon="@Icons.Material.Filled.List">
            <HeaderActions>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">
                    @L["NewInvoice_AddLineButton"]
                </MudButton>
            </HeaderActions>
            <ChildContent>
                <MudTable Items="_lines" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                    <HeaderContent>
                        <MudTh Style="width: 220px;">@L["NewInvoice_ProductColumn"]</MudTh>
                        <MudTh>@L["NewInvoice_DescriptionColumn"]</MudTh>
                        <MudTh Style="width: 90px;">@L["NewInvoice_QuantityColumn"]</MudTh>
                        <MudTh Style="width: 110px;">@L["NewInvoice_UnitPriceColumn"]</MudTh>
                        <MudTh Style="width: 80px;">@L["NewInvoice_DiscountColumn"]</MudTh>
                        <MudTh Style="width: 170px;">@L["NewInvoice_TaxColumn"]</MudTh>
                        <MudTh Style="width: 100px; text-align: right;">@L["NewInvoice_TotalColumn"]</MudTh>
                        <MudTh Style="width: 50px;"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["NewInvoice_ProductColumn"]">
                            @* Closed, the box shows only the code; typing searches the code and the description too. *@
                            <MudAutocomplete T="Guid?" Value="context.ProductId"
                                             ValueChanged="@(productId => OnProductChanged(context, productId))"
                                             SearchFunc="SearchProductsAsync" ToStringFunc="@(id => ProductCode(id))"
                                             ResetValueOnEmptyText="true" CoerceText="true"
                                             Variant="Variant.Text" Margin="Margin.Dense" Dense="true" Clearable="true"
                                             Placeholder="@L["NewInvoice_FreeProductPlaceholder"]">
                                <ItemTemplate Context="productId">
                                    <MudText>@ProductCode(productId) — @ProductDescription(productId)</MudText>
                                </ItemTemplate>
                            </MudAutocomplete>
                        </MudTd>
                        <MudTd DataLabel="@L["NewInvoice_DescriptionColumn"]">
                            <MudTextField @bind-Value="context.ProductDescription" Immediate="true" Margin="Margin.Dense" Variant="Variant.Text" />
                        </MudTd>
                        <MudTd DataLabel="@L["NewInvoice_QuantityColumn"]">
                            <MudNumericField T="decimal" Value="context.Quantity" ValueChanged="@(quantity => OnQuantityChanged(context, quantity))"
                                             Immediate="true" Margin="Margin.Dense" Variant="Variant.Text" Min="0" HideSpinButtons="true" />
                        </MudTd>
                        <MudTd DataLabel="@L["NewInvoice_UnitPriceColumn"]">
                            <MudNumericField @bind-Value="context.UnitPrice" Immediate="true" Margin="Margin.Dense" Variant="Variant.Text" Min="0" Format="N2" HideSpinButtons="true" />
                        </MudTd>
                        <MudTd DataLabel="@L["NewInvoice_DiscountColumn"]">
                            @* The eco-fee is collected in full for the managing entity: a discount on the article
                               it rides along with never carries over to it. *@
                            <MudNumericField @bind-Value="context.DiscountPercentage" Immediate="true" Margin="Margin.Dense" Variant="Variant.Text"
                                             Min="0" Max="100" Format="0.##" HideSpinButtons="true" Adornment="Adornment.End" AdornmentText="%"
                                             Disabled="@context.IsEcoFee" />
                        </MudTd>
                        <MudTd DataLabel="@L["NewInvoice_TaxColumn"]">
                            @* Box and list both show the rate alone — the four PT tiers are known by their percentage, not a name. *@
                            <MudSelect T="string" Value="context.TaxCode" ValueChanged="@(code => OnTaxCodeChanged(context, code))"
                                       ToStringFunc="@(code => TaxRateLabel(code))"
                                       Margin="Margin.Dense" Variant="Variant.Text">
                                @foreach (var rate in _taxRates)
                                {
                                    <MudSelectItem T="string" Value="@rate.Code">@rate.Percentage.ToString("0.##")%</MudSelectItem>
                                }
                            </MudSelect>
                            @if (context.TaxCode == TaxCodes.Exempt)
                            {
                                @* The AT's table: an exempt line has to cite one of these codes; the list keeps the
                                   description, since the codes alone (M01, M02...) mean nothing to look at. *@
                                <MudAutocomplete T="string" @bind-Value="context.ExemptionCode"
                                                 SearchFunc="SearchExemptionReasonsAsync" ToStringFunc="@(code => code ?? string.Empty)"
                                                 CoerceText="true" Variant="Variant.Text" Margin="Margin.Dense" Dense="true"
                                                 Class="mt-1" Placeholder="@L["NewInvoice_ExemptionCodePlaceholder"]" Required="true"
                                                 Error="@string.IsNullOrWhiteSpace(context.ExemptionCode)">
                                    <ItemTemplate Context="exemptionCode">
                                        <MudText>@exemptionCode — @ExemptionDescription(exemptionCode)</MudText>
                                    </ItemTemplate>
                                </MudAutocomplete>
                            }
                        </MudTd>
                        <MudTd DataLabel="@L["NewInvoice_TotalColumn"]" Style="text-align: right;">@LineAmount(context).ToString("N2")</MudTd>
                        <MudTd Style="text-align: right;">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           title="@L["NewInvoice_RemoveLineTooltip"]"
                                           Disabled="@(_lines.Count == 1 || context.IsEcoFee)"
                                           OnClick="@(() => RemoveLine(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </ChildContent>
        </EditorCard>

        @if (IsInvoiceReceipt)
        {
            <EditorCard Title="@L["NewInvoice_PaymentSectionTitle"]" Icon="@Icons.Material.Filled.Payments"
                        Description="@L["NewInvoice_PaymentSectionDescription"]">
                <PaymentMethodsEditor Methods="_payments" Total="GrossTotal" Changed="StateHasChanged" />
            </EditorCard>
        }

        <EditorCard Title="@L["NewInvoice_SummarySectionTitle"]" Icon="@Icons.Material.Filled.Calculate">
            <DocumentTotalsSummary GrossLinesTotal="GrossLinesTotal"
                                   DiscountTotal="DiscountTotal"
                                   NetTotal="NetTotal"
                                   TaxTotal="TaxTotal"
                                   GrossTotal="GrossTotal"
                                   Taxes="TaxBreakdown" />
        </EditorCard>

        <MudPaper Elevation="0" Class="pa-3 erp-form-actions">
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("invoices"))">
                    @L["Common_CancelButton"]
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Receipt"
                           Disabled="@(_issuing || !CanIssue)"
                           OnClick="IssueAsync">
                    @(_issuing ? L["NewInvoice_IssuingButton"] : L["NewInvoice_IssueButton"])
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    private bool _loading = true;
    private bool _issuing;
    private string? _error;

    private Guid _seriesId;
    private DateTime? _documentDate = DateTime.Today;
    private DateTime? _dueDate = DateTime.Today.AddDays(30);
    private Guid? _warehouseId;

    private Partner? _customer;
    private string _customerTaxId = string.Empty;
    private string _customerName = string.Empty;
    private string _customerAddress = string.Empty;
    private string? _customerPostalCode;
    private string _customerCity = string.Empty;
    private string _customerCountry = PostalCodes.PortugalCountryCode;

    private string? _customerTaxIdLookupMessage;
    private Severity _customerTaxIdLookupSeverity = Severity.Info;
    private bool _lookingUpCustomerTaxId;

    private List<SalesSeries> _series = [];
    private List<ProductListItem> _products = [];
    private List<VatRate> _taxRates = [];
    private List<Partner> _customers = [];
    private List<Warehouse> _warehouses = [];
    private List<EcoFeeType> _ecoFeeTypes = [];
    private readonly List<LineEditor> _lines = [new()];
    private readonly List<PaymentMethodsEditor.MethodLine> _payments = [];

    private List<BreadcrumbItem> Breadcrumbs =>
    [
        new(L["Invoices_PageTitle"].Value, href: "invoices"),
        new(L["NewInvoice_HeaderTitle"].Value, href: null, disabled: true)
    ];

    private SalesSeries? SelectedSeries => _series.FirstOrDefault(series => series.Id == _seriesId);

    private bool IsInvoiceReceipt => SelectedSeries is { } series && InvoiceTypes.IsInvoiceReceipt(series.DocumentType);

    private bool MovesStock => SelectedSeries is { } series && series.StockEffect != "None";

    private decimal GrossLinesTotal => _lines.Sum(GrossAmount);

    private decimal DiscountTotal => _lines.Sum(DiscountAmount);

    private decimal NetTotal => _lines.Sum(LineAmount);

    private decimal TaxTotal => _lines.Sum(TaxAmount);

    private decimal GrossTotal => NetTotal + TaxTotal;

    /// <summary>The VAT grouped by rate, the same way the API builds the document's tax summary.</summary>
    private IReadOnlyList<DocumentTotalsSummary.TaxLine> TaxBreakdown =>
    [
        .. _lines
            // A line with no product chosen yet still carries the editor's default 23% — real for
            // no article at all, so it has no business in the breakdown until one is picked. Code,
            // not ProductId: an eco-fee companion line has a ProductCode but no catalog ProductId,
            // and is just as real as the article it rides along with.
            .Where(line => !string.IsNullOrWhiteSpace(line.ProductCode))
            .GroupBy(line => (line.TaxCode, line.TaxPercentage))
            .OrderByDescending(group => group.Key.TaxPercentage)
            .Select(group => new DocumentTotalsSummary.TaxLine(
                _taxRates.FirstOrDefault(rate => rate.Code == group.Key.TaxCode)?.Label ?? group.Key.TaxCode,
                group.Key.TaxPercentage,
                group.Sum(LineAmount),
                group.Sum(TaxAmount)))
    ];

    private bool CanIssue =>
        _seriesId != Guid.Empty
        && _documentDate is not null
        && (IsInvoiceReceipt || _dueDate is null || _dueDate >= _documentDate)
        && !string.IsNullOrWhiteSpace(_customerName)
        && PostalCodes.IsValid(_customerPostalCode, _customerCountry)
        && (!MovesStock || _warehouseId is not null)
        && _lines.All(line => line.Quantity > 0
                              && !string.IsNullOrWhiteSpace(line.ProductDescription)
                              && line.DiscountPercentage is >= 0 and <= 100
                              && (line.TaxCode != TaxCodes.Exempt || !string.IsNullOrWhiteSpace(line.ExemptionCode)))
        && (!IsInvoiceReceipt || PaymentMethodsEditor.AreComplete(_payments, GrossTotal));

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        WarehouseState.Changed += OnWarehouseStateChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private void OnWarehouseStateChanged() => InvokeAsync(() =>
    {
        _warehouseId = WarehouseState.SelectedWarehouseId == Guid.Empty ? null : WarehouseState.SelectedWarehouseId;
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _loading = true;
        _error = Company.LoadError;

        if (!Company.HasCompany)
        {
            _series = [];
            _products = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            var companyId = Company.SelectedCompanyId;
            var series = await SeriesApi.GetSeriesAsync(companyId);

            // Only series that create a sale. Notas de crédito e de débito têm ecrã próprio, onde
            // partem da fatura em vez de se escreverem outra vez, e as guias e recibos também.
            _series = [.. series.Where(x => x.CanIssue && InvoiceTypes.IsSale(x.DocumentType))];
            _seriesId = _series.FirstOrDefault()?.Id ?? Guid.Empty;

            // The catalogue is master data served by the Core module, not by Sales.
            var (products, _) = await Catalog.GetProductsAsync(companyId);
            _products = [.. products.Where(x => x.IsActive)];

            var (customers, _) = await Catalog.GetCustomersAsync(companyId);
            _customers = [.. customers.Where(x => x.IsActive).OrderBy(x => x.Name)];

            // Mainland rates — this document has no fiscal-region selector of its own.
            var (rates, _) = await Catalog.GetVatRatesAsync();
            _taxRates = [.. rates.Where(x => x.FiscalRegion == "PT" && x.IsActive)];

            var (ecoFeeTypes, _) = await Catalog.GetEcoFeeTypesAsync(companyId);
            _ecoFeeTypes = [.. ecoFeeTypes.Where(x => x.IsActive)];

            // A series that moves stock needs a warehouse; the global selector drives the default.
            await WarehouseState.EnsureLoadedAsync();
            _warehouses = [.. WarehouseState.Warehouses];
            _warehouseId = WarehouseState.HasWarehouse ? WarehouseState.SelectedWarehouseId : null;
        }
        catch (Exception ex)
        {
            _error = string.Format(L["NewInvoice_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void OnSeriesChanged(Guid seriesId)
    {
        _seriesId = seriesId;

        if (IsInvoiceReceipt)
            _dueDate = _documentDate;
    }

    private void OnDocumentDateChanged(DateTime? date)
    {
        _documentDate = date;

        if (IsInvoiceReceipt || (_dueDate is not null && _dueDate < date))
            _dueDate = date;
    }

    private Task<IEnumerable<Partner>> SearchCustomersAsync(string? text, CancellationToken cancellationToken)
    {
        IEnumerable<Partner> matches = string.IsNullOrWhiteSpace(text)
            ? _customers
            : _customers.Where(c =>
                c.Name.Contains(text, StringComparison.OrdinalIgnoreCase)
                || c.TaxId.Contains(text, StringComparison.OrdinalIgnoreCase)
                || c.Code.Contains(text, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }

    /// <summary>Picking a customer fills the fields; they stay editable, as the document keeps its own copy.</summary>
    private void OnCustomerChosen(Partner? customer)
    {
        _customer = customer;

        if (customer is null)
            return;

        _customerTaxId = customer.TaxId;
        _customerName = customer.Name;
        _customerAddress = customer.Address ?? string.Empty;
        _customerPostalCode = customer.PostalCode;
        _customerCity = customer.City ?? string.Empty;
        _customerCountry = customer.Country;
    }

    /// <summary>Fills in the city when it is still blank; an existing value is never overwritten.</summary>
    private void OnCustomerPostalCodeResolvedAsync(PostalCodeLookupResult result)
    {
        if (string.IsNullOrWhiteSpace(_customerCity))
            _customerCity = result.Locality ?? result.Municipality ?? string.Empty;
    }

    private void OnCustomerStreetSelectedAsync(string address) => _customerAddress = address;

    /// <summary>
    /// Runs the module-11 check and, for a company NIF, queries VIES: fills the name when it is
    /// still blank and reports what came back, good or bad, instead of failing silently.
    /// </summary>
    private async Task LookupCustomerTaxIdAsync()
    {
        if (_lookingUpCustomerTaxId || string.IsNullOrWhiteSpace(_customerTaxId))
            return;

        _lookingUpCustomerTaxId = true;
        _customerTaxIdLookupMessage = null;

        try
        {
            var result = await Lookups.GetVatNumberAsync(_customerTaxId);

            if (result is null || !result.IsStructurallyValid)
            {
                _customerTaxIdLookupSeverity = Severity.Error;
                _customerTaxIdLookupMessage = L["PartnerForm_TaxIdInvalidMessage"];
                return;
            }

            if (result.Source != VatNumberValidationSource.Vies)
            {
                _customerTaxIdLookupSeverity = Severity.Success;
                _customerTaxIdLookupMessage = L["PartnerForm_TaxIdValidMessage"];
                return;
            }

            if (result.IsRegisteredInVies != true)
            {
                _customerTaxIdLookupSeverity = Severity.Warning;
                _customerTaxIdLookupMessage = L["PartnerForm_TaxIdNotRegisteredMessage"];
                return;
            }

            if (string.IsNullOrWhiteSpace(_customerName) && !string.IsNullOrWhiteSpace(result.RegisteredName))
                _customerName = result.RegisteredName;

            if (string.IsNullOrWhiteSpace(_customerAddress) && !string.IsNullOrWhiteSpace(result.RegisteredAddress))
                _customerAddress = result.RegisteredAddress;

            if (string.IsNullOrWhiteSpace(_customerPostalCode) && !string.IsNullOrWhiteSpace(result.RegisteredPostalCode))
                _customerPostalCode = result.RegisteredPostalCode;

            if (string.IsNullOrWhiteSpace(_customerCity) && !string.IsNullOrWhiteSpace(result.RegisteredCity))
                _customerCity = result.RegisteredCity;

            _customerTaxIdLookupSeverity = Severity.Success;
            _customerTaxIdLookupMessage = string.Format(L["PartnerForm_TaxIdFoundMessage"], result.RegisteredName);
        }
        finally
        {
            _lookingUpCustomerTaxId = false;
        }
    }

    private void AddLine() => _lines.Add(new LineEditor());

    private void RemoveLine(LineEditor line)
    {
        if (_lines.Count <= 1 || line.IsEcoFee)
            return;

        RemoveEcoFeeCompanion(line);
        _lines.Remove(line);
    }

    private void OnProductChanged(LineEditor line, Guid? productId)
    {
        RemoveEcoFeeCompanion(line);

        line.ProductId = productId;

        var product = _products.FirstOrDefault(x => x.Id == productId);
        if (product is null)
            return;

        line.ProductCode = product.ProductCode;
        line.ProductDescription = product.Description;
        line.UnitOfMeasure = product.UnitOfMeasure;
        line.UnitPrice = product.UnitPrice;
        line.TaxCode = product.DefaultTaxCode;
        line.TaxPercentage = product.DefaultTaxPercentage;
        line.ExemptionCode = product.DefaultTaxExemptionCode;

        AddEcoFeeCompanionIfAny(line, product);
    }

    private void OnQuantityChanged(LineEditor line, decimal quantity)
    {
        line.Quantity = quantity;

        // The eco-fee always charges for as many units (or kilograms) as its article sold.
        var companion = _lines.FirstOrDefault(x => x.EcoFeeForLine == line);
        if (companion is not null)
            companion.Quantity = quantity;
    }

    /// <summary>
    /// Batteries, lubricating oils and similar: an article carrying an eco-fee gets it added right
    /// after it, on its own line, as the law requires — never folded into the article's own price.
    /// </summary>
    private void AddEcoFeeCompanionIfAny(LineEditor line, ProductListItem product)
    {
        if (product.EcoFeeTypeId is not { } ecoFeeTypeId)
            return;

        if (_ecoFeeTypes.FirstOrDefault(x => x.Id == ecoFeeTypeId) is not { } ecoFeeType)
            return;

        var isPerKg = ecoFeeType.CalculationBasis == EcoFeeCalculationBases.PerKg;

        var companion = new LineEditor
        {
            ProductCode = ecoFeeType.Code,
            ProductDescription = ecoFeeType.Description,
            UnitOfMeasure = isPerKg ? "KG" : "UN",
            Quantity = line.Quantity,
            UnitPrice = isPerKg ? ecoFeeType.Rate * (product.EcoFeeWeightKg ?? 0m) : ecoFeeType.Rate,
            TaxCode = TaxCodes.Normal,
            TaxPercentage = _taxRates.FirstOrDefault(x => x.Code == TaxCodes.Normal)?.Percentage ?? 23m,
            IsEcoFee = true,
            EcoFeeForLine = line
        };

        _lines.Insert(_lines.IndexOf(line) + 1, companion);
    }

    private void RemoveEcoFeeCompanion(LineEditor line) =>
        _lines.RemoveAll(x => x.EcoFeeForLine == line);

    private void OnTaxCodeChanged(LineEditor line, string taxCode)
    {
        line.TaxCode = taxCode;
        line.TaxPercentage = _taxRates.First(rate => rate.Code == taxCode).Percentage;

        if (taxCode != TaxCodes.Exempt)
            line.ExemptionCode = null;
    }

    /// <summary>What the closed product box shows: the code alone keeps the line readable.</summary>
    private string ProductCode(Guid? productId) =>
        _products.FirstOrDefault(product => product.Id == productId)?.ProductCode ?? string.Empty;

    private string ProductDescription(Guid? productId) =>
        _products.FirstOrDefault(product => product.Id == productId)?.Description ?? string.Empty;

    /// <summary>Matches on code or description, so typing either finds the article.</summary>
    private Task<IEnumerable<Guid?>> SearchProductsAsync(string? text, CancellationToken cancellationToken)
    {
        IEnumerable<ProductListItem> matches = string.IsNullOrWhiteSpace(text)
            ? _products
            : _products.Where(product =>
                product.ProductCode.Contains(text, StringComparison.OrdinalIgnoreCase)
                || product.Description.Contains(text, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches.Select(product => (Guid?)product.Id));
    }

    /// <summary>And the tax box shows the rate, not the name of the rate.</summary>
    private string TaxRateLabel(string? taxCode)
    {
        var rate = _taxRates.FirstOrDefault(rate => rate.Code == taxCode);
        return rate is null ? taxCode ?? string.Empty : $"{rate.Percentage:0.##}%";
    }

    private string ExemptionDescription(string? code) =>
        TaxExemptionReasons.All.FirstOrDefault(reason => reason.Code == code)?.Description ?? string.Empty;

    /// <summary>Matches on the AT code or its description, since the codes alone mean nothing to look at.</summary>
    private Task<IEnumerable<string>> SearchExemptionReasonsAsync(string? text, CancellationToken cancellationToken)
    {
        var matches = string.IsNullOrWhiteSpace(text)
            ? TaxExemptionReasons.All
            : TaxExemptionReasons.All.Where(reason =>
                reason.Code.Contains(text, StringComparison.OrdinalIgnoreCase)
                || reason.Description.Contains(text, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches.Select(reason => reason.Code));
    }

    // Same arithmetic as the API: the discount is taken off the rounded gross amount.
    private static decimal GrossAmount(LineEditor line) => Round(line.Quantity * line.UnitPrice);

    private static decimal DiscountAmount(LineEditor line) => Round(GrossAmount(line) * line.DiscountPercentage / 100m);

    private static decimal LineAmount(LineEditor line) => GrossAmount(line) - DiscountAmount(line);

    private static decimal TaxAmount(LineEditor line) => Round(LineAmount(line) * line.TaxPercentage / 100m);

    private static decimal Round(decimal value) => Math.Round(value, 2, MidpointRounding.AwayFromZero);

    private async Task IssueAsync()
    {
        _issuing = true;
        _error = null;

        try
        {
            var request = new CreateInvoiceRequest(
                Company.SelectedCompanyId,
                _seriesId,
                DateOnly.FromDateTime(_documentDate!.Value),
                new CustomerRequest(
                    string.IsNullOrWhiteSpace(_customerTaxId) ? null : _customerTaxId.Trim(),
                    _customerName.Trim(),
                    string.IsNullOrWhiteSpace(_customerAddress) ? null : _customerAddress.Trim(),
                    _customerCountry,
                    string.IsNullOrWhiteSpace(_customerPostalCode) ? null : _customerPostalCode.Trim(),
                    string.IsNullOrWhiteSpace(_customerCity) ? null : _customerCity.Trim()),
                [.. _lines.Select((line, index) => new CreateInvoiceLineRequest(
                    string.IsNullOrWhiteSpace(line.ProductCode) ? "GEN" : line.ProductCode,
                    line.ProductDescription,
                    line.Quantity,
                    line.UnitPrice,
                    line.TaxCode,
                    line.TaxPercentage,
                    UnitOfMeasure: line.UnitOfMeasure,
                    TaxExemptionCode: line.TaxCode == TaxCodes.Exempt ? line.ExemptionCode : null,
                    DiscountPercentage: line.DiscountPercentage,
                    IsEcoFee: line.IsEcoFee,
                    EcoFeeForLineNumber: line.EcoFeeForLine is { } parent ? _lines.IndexOf(parent) + 1 : null))],
                WarehouseId: MovesStock ? _warehouseId : null,
                DueDate: IsInvoiceReceipt || _dueDate is null ? null : DateOnly.FromDateTime(_dueDate.Value),
                Payments: IsInvoiceReceipt
                    ? [.. _payments.Select(method => new CreatePaymentMethodRequest(
                        method.Mechanism, method.Amount, DateOnly.FromDateTime(method.PaymentDate!.Value)))]
                    : null);

            var (invoice, error) = await SalesApi.IssueInvoiceAsync(request);

            if (invoice is null)
            {
                _error = error ?? L["NewInvoice_IssueFailed"];
                return;
            }

            Snackbar.Add(string.Format(L["NewInvoice_IssuedSuccess"], InvoiceTypes.Describe(invoice.DocumentType), invoice.DocumentNumber), Severity.Success);
            Navigation.NavigateTo($"invoices/{invoice.Id}");
        }
        catch (Exception ex)
        {
            _error = string.Format(L["NewInvoice_IssueError"], ex.Message);
        }
        finally
        {
            _issuing = false;
        }
    }

    private sealed class LineEditor
    {
        public Guid? ProductId { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductDescription { get; set; } = string.Empty;
        public string UnitOfMeasure { get; set; } = "UN";
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal DiscountPercentage { get; set; }
        public string TaxCode { get; set; } = TaxCodes.Normal;
        public decimal TaxPercentage { get; set; } = 23m;
        public string? ExemptionCode { get; set; }

        /// <summary>True for an eco-fee ("Ecovalor") line generated alongside an article, not an article itself.</summary>
        public bool IsEcoFee { get; set; }

        /// <summary>The article line this eco-fee was generated for, when <see cref="IsEcoFee"/> is true.</summary>
        public LineEditor? EcoFeeForLine { get; set; }
    }

    public void Dispose()
    {
        Company.Changed -= OnCompanyChanged;
        WarehouseState.Changed -= OnWarehouseStateChanged;
    }
}
