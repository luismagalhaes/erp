@page "/payments"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@using Microsoft.Extensions.Localization
@using Erp.Main.Resources
@inject SalesApiClient SalesApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["Payments_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@L["Payments_PageTitle"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("payments/new"))">
                @L["Payments_NewButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="PaymentListItem"
              LoadAsync="@((companyId, query, ct) => SalesApi.QueryPaymentsAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="TransactionDate desc,PaymentRefNo desc"
              SearchPlaceholder="@L["Payments_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.Payments"
              EmptyTitle="@L["Payments_EmptyTitle"]"
              EmptyDescription="@L["Payments_EmptyDescription"]"
              ItemsLabel="@L["Payments_ItemsLabel"]"
              LoadErrorMessage="@L["Payments_LoadErrorMessage"]">
        <Columns>
            <PropertyColumn Property="x => x.PaymentRefNo" Title="@L["Payments_DocumentColumn"]" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.PaymentType" Title="@L["Payments_TypeColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.Item.PaymentType</MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Atcud" Title="ATCUD" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.TransactionDate" Title="@L["Payments_DateColumn"]" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.PartyName" Title="@L["Payments_CustomerColumn"]" />
            <PropertyColumn Property="x => x.PartyTaxId" Title="@L["Payments_TaxIdColumn"]" />
            <PropertyColumn Property="x => x.SettledInvoiceCount" Title="@L["Payments_InvoicesColumn"]"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.GrossTotal" Title="@L["Payments_TotalColumn"]" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.Status" Title="@L["Payments_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.Status == "A" ? Color.Error : Color.Success)">
                        @(context.Item.Status == "A" ? L["Payments_StatusVoided"] : L["Payments_StatusNormal"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"payments/{context.Item.Id}"))">
                            @L["Payments_ViewPayment"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["PaymentRefNo", "PartyName", "PartyTaxId"];
}
