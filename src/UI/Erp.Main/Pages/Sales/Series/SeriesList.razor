@page "/series"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject SalesApiClient SalesApi
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Séries de faturação</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Séries de faturação</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Uma série só emite documentos depois de comunicada à AT.
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(!Company.HasCompany)"
                   OnClick="@(() => Navigation.NavigateTo("series/new"))">
            Nova série
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-2">
        <MudTable Items="_series" Hover="true" Striped="true" Dense="true" Loading="_loading"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Tipo</MudTh>
                <MudTh>Série</MudTh>
                <MudTh>Código de validação</MudTh>
                <MudTh Style="text-align: right;">Último n.º</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh Style="text-align: right;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Tipo">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.DocumentType</MudChip>
                </MudTd>
                <MudTd DataLabel="Série">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.SeriesCode</MudText>
                        @if (context.SelfBilling)
                        {
                            <MudTooltip Text="Numera faturas emitidas em nome do fornecedor">
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                    Autofaturação
                                </MudChip>
                            </MudTooltip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Código de validação">
                    @if (string.IsNullOrWhiteSpace(context.ValidationCode))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Por comunicar</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.ValidationCode</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Último n.º" Style="text-align: right;">@context.CurrentSequence</MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.CanIssue ? Color.Success : Color.Warning)">
                        @DescribeStatus(context.Status)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Ações" Style="text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   title="Abrir série"
                                   OnClick="@(() => Navigation.NavigateTo($"series/{context.Id}"))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Ainda não há séries criadas.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

@code {
    private bool _loading = true;
    private string? _error;
    private List<SalesSeries> _series = [];

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = Company.LoadError;

        if (!Company.HasCompany)
        {
            _series = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            _series = [.. await SalesApi.GetSeriesAsync(Company.SelectedCompanyId)];
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar as séries: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private static string DescribeStatus(string status) => status switch
    {
        "Created" => "Criada",
        "Communicated" => "Comunicada",
        "Active" => "Ativa",
        "Finalized" => "Finalizada",
        _ => status
    };

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
