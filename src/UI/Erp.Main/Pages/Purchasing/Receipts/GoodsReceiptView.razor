@page "/goods-receipts/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject PurchasingApiClient Purchasing
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@(_receipt?.Number ?? L["GoodsReceiptView_DefaultTitle"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(_receipt?.Number ?? L["GoodsReceiptView_DefaultTitle"])</MudText>
            @if (_receipt is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_receipt.Supplier.Name · @_receipt.ReceiptDate.ToString("yyyy-MM-dd")
                </MudText>
            }
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("goods-receipts"))">
            @L["GoodsReceiptView_BackButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_receipt is null)
    {
        <MudAlert Severity="Severity.Warning">@L["GoodsReceiptView_NotFound"]</MudAlert>
    }
    else
    {
        @if (_receipt.IsVoided)
        {
            <MudAlert Severity="Severity.Error">
                @string.Format(L["GoodsReceiptView_VoidedAlert"], _receipt.VoidedAtUtc?.ToString("yyyy-MM-dd HH:mm"), _receipt.VoidReason)
            </MudAlert>
        }

        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GoodsReceiptView_TaxIdLabel"]</MudText>
                    <MudText Typo="Typo.body1">@_receipt.Supplier.TaxId</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GoodsReceiptView_SupplierDocumentLabel"]</MudText>
                    <MudText Typo="Typo.body1">
                        @(string.IsNullOrWhiteSpace(_receipt.SupplierDocumentNumber)
                            ? "—"
                            : _receipt.SupplierDocumentNumber)
                    </MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GoodsReceiptView_LinesLabel"]</MudText>
                    <MudText Typo="Typo.body1">@_receipt.Lines.Count</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GoodsReceiptView_TotalCostLabel"]</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">@_receipt.TotalCost.ToString("N2")</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-2">
            <MudTable Items="_receipt.Lines" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@L["GoodsReceiptView_ArrivedTitle"]</MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 50px;">@L["GoodsReceiptView_NumberColumn"]</MudTh>
                    <MudTh>@L["GoodsReceiptView_ProductColumn"]</MudTh>
                    <MudTh>@L["GoodsReceiptView_DescriptionColumn"]</MudTh>
                    <MudTh>@L["GoodsReceiptView_OriginColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["GoodsReceiptView_QuantityColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["GoodsReceiptView_UnitCostColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["GoodsReceiptView_TotalColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["GoodsReceiptView_NumberColumn"]">@context.LineNumber</MudTd>
                    <MudTd DataLabel="@L["GoodsReceiptView_ProductColumn"]">
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.ProductCode</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["GoodsReceiptView_DescriptionColumn"]">@context.ProductDescription</MudTd>
                    <MudTd DataLabel="@L["GoodsReceiptView_OriginColumn"]">
                        @if (context.OrderId is { } orderId)
                        {
                            <MudLink Href="@($"purchase-orders/{orderId}")">@L["GoodsReceiptView_OrderLink"]</MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GoodsReceiptView_NoOrder"]</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["GoodsReceiptView_QuantityColumn"]" Style="text-align: right;">
                        @context.Quantity.ToString("N3") @context.UnitOfMeasure
                    </MudTd>
                    <MudTd DataLabel="@L["GoodsReceiptView_UnitCostColumn"]" Style="text-align: right;">
                        @context.UnitCost.ToString("N2")
                    </MudTd>
                    <MudTd DataLabel="@L["GoodsReceiptView_TotalColumn"]" Style="text-align: right;">@context.LineAmount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        @if (!_receipt.IsVoided)
        {
            <MudExpansionPanels>
                <MudExpansionPanel Text="@L["GoodsReceiptView_VoidPanelTitle"]">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @L["GoodsReceiptView_VoidHelp"]
                    </MudText>

                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_reason" @bind-Value:after="StateHasChanged" Immediate="true"
                                      Label="@L["GoodsReceiptView_ReasonLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Style="max-width: 480px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Disabled="@(_working || string.IsNullOrWhiteSpace(_reason))"
                                   OnClick="VoidAsync">
                            @L["GoodsReceiptView_VoidButton"]
                        </MudButton>
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private bool _working;
    private string? _error;
    private string _reason = string.Empty;

    private GoodsReceipt? _receipt;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _receipt = await Purchasing.GetReceiptAsync(Id);
        }
        catch (Exception ex)
        {
            _error = string.Format(L["GoodsReceiptView_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task VoidAsync()
    {
        _working = true;
        _error = null;

        try
        {
            var (receipt, error) = await Purchasing.VoidReceiptAsync(Id, _reason.Trim());

            if (receipt is null)
            {
                _error = error ?? L["GoodsReceiptView_VoidFallbackError"];
                return;
            }

            _receipt = receipt;
            _reason = string.Empty;
            Snackbar.Add(L["GoodsReceiptView_VoidSuccess"], Severity.Success);
        }
        catch (Exception ex)
        {
            _error = string.Format(L["GoodsReceiptView_VoidError"], ex.Message);
        }
        finally
        {
            _working = false;
        }
    }
}
