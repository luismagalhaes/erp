@page "/suppliers"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Fornecedores</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Fornecedores</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Ficheiro de fornecedors, exportado na tabela Supplier do SAF-T.
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(!Company.HasCompany)"
                   OnClick="@(() => Navigation.NavigateTo("suppliers/new"))">
            Novo fornecedor
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    <MudTextField @bind-Value="_search" Label="Procurar" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Placeholder="Código, nome ou NIF" Style="max-width: 420px;" />

    <MudPaper Elevation="1" Class="pa-2">
        <MudTable Items="Filtered" Hover="true" Striped="true" Dense="true" Loading="_loading"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Código</MudTh>
                <MudTh>Nome</MudTh>
                <MudTh>NIF</MudTh>
                <MudTh>Localidade</MudTh>
                <MudTh>Contacto</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh Style="text-align: right;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.Code</MudText>
                </MudTd>
                <MudTd DataLabel="Nome">@context.Name</MudTd>
                <MudTd DataLabel="NIF">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.TaxId</MudText>
                </MudTd>
                <MudTd DataLabel="Localidade">@(context.City ?? "—")</MudTd>
                <MudTd DataLabel="Contacto">@(context.Email ?? context.Phone ?? "—")</MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? "Ativo" : "Inativo")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Ações" Style="text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   title="Editar fornecedor"
                                   OnClick="@(() => Navigation.NavigateTo($"suppliers/{context.Id}"))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Nenhum fornecedor corresponde ao filtro.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

@code {
    private bool _loading = true;
    private string? _error;
    private string _search = string.Empty;
    private List<Partner> _suppliers = [];

    private IEnumerable<Partner> Filtered =>
        _suppliers.Where(supplier =>
            string.IsNullOrWhiteSpace(_search)
            || supplier.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || supplier.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || supplier.TaxId.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = Company.LoadError;

        if (!Company.HasCompany)
        {
            _suppliers = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            var (customers, error) = await Catalog.GetSuppliersAsync(Company.SelectedCompanyId);
            _suppliers = [.. customers];
            _error = error;
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar os fornecedors: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
