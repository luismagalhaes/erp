@page "/product-families"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@Localizer["Families_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Families_PageTitle"]">
        <Actions>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AccountTree"
                       OnClick="@(() => Navigation.NavigateTo("product-subfamilies"))">
                @Localizer["Families_Subfamilies"]
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("product-families/new"))">
                @Localizer["Families_NewFamily"]
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="ProductFamily"
              LoadAsync="@((companyId, query, ct) => Catalog.QueryFamiliesAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="Code"
              SearchPlaceholder="@Localizer["Families_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.Category"
              EmptyTitle="@Localizer["Families_EmptyTitle"]"
              EmptyDescription="@Localizer["Families_EmptyDescription"]"
              ItemsLabel="@Localizer["Families_ItemsLabel"]"
              LoadErrorMessage="@Localizer["Families_LoadErrorMessage"]">
        <Columns>
            <PropertyColumn Property="x => x.Code" Title="@Localizer["Common_CodeColumn"]" />
            <PropertyColumn Property="x => x.Name" Title="@Localizer["Common_NameColumn"]" />
            <PropertyColumn Property="x => x.SubfamilyCount" Title="@Localizer["Families_SubfamilyCountColumn"]"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.IsActive" Title="@Localizer["Common_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                        @(context.Item.IsActive ? Localizer["Brands_Active"] : Localizer["Brands_Inactive"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                     OnClick="@(() => Navigation.NavigateTo($"product-families/{context.Item.Id}"))">
                            @Localizer["Common_EditAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    /// <summary>
    /// Maps the toolbar search to the DTO members the API exposes, so a renamed column never
    /// produces an invalid $filter.
    /// </summary>
    private static readonly string[] SearchFields = ["Code", "Name"];
}
