@page "/Account/ResetPasswordConfirmation"
@layout Layout.AuthLayout
@using Microsoft.AspNetCore.Components.Web
@attribute [AllowAnonymous]

<PageTitle>Reset Password — Confirmation</PageTitle>

<div class="content-card mud-elevation-1">
    <h2>Password updated</h2>
    <p>Your password has been reset successfully.</p>
    <div class="auth-links mt-16">
        <a class="auth-link" href="/Account/SignIn?reset=1">Continue to sign in</a>
    </div>
</div>
