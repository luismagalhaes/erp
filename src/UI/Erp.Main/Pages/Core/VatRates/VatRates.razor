@page "/vat-rates"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models.Core
@using Erp.Main.Resources
@using Erp.Main.Services
@inject CatalogApiClient Catalog
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@Localizer["VatRates_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["VatRates_PageTitle"]" Description="@Localizer["VatRates_PageDescription"]" />

    @* VAT rates are set by law, the same for every company, so this listing is not scoped to one. *@
    <DataGrid T="VatRate" CompanyScoped="false"
              LoadAsync="@((_, query, ct) => Catalog.QueryVatRatesAsync(query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="FiscalRegion"
              SearchPlaceholder="@Localizer["VatRates_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.Percent"
              EmptyTitle="@Localizer["VatRates_EmptyTitle"]"
              EmptyDescription="@Localizer["VatRates_EmptyDescription"]"
              ItemsLabel="@Localizer["VatRates_ItemsLabel"]"
              LoadErrorMessage="@Localizer["VatRates_LoadErrorMessage"]">
        <Columns>
            <PropertyColumn Property="x => x.FiscalRegion" Title="@Localizer["VatRates_RegionColumn"]">
                <CellTemplate>@FiscalRegions.Describe(context.Item.FiscalRegion)</CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Code" Title="@Localizer["Common_CodeColumn"]" />
            <PropertyColumn Property="x => x.Label" Title="@Localizer["VatRates_LabelColumn"]" />
            <PropertyColumn Property="x => x.Percentage" Title="@Localizer["VatRates_PercentageColumn"]"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>@context.Item.Percentage.ToString("N2")%</CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.IsActive" Title="@Localizer["Common_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                        @(context.Item.IsActive ? Localizer["Common_Active"] : Localizer["Common_Inactive"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => Navigation.NavigateTo($"vat-rates/{context.Item.Id}"))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    /// <summary>
    /// Maps the toolbar search to the DTO members the API exposes, so a renamed column never
    /// produces an invalid $filter.
    /// </summary>
    private static readonly string[] SearchFields = ["Code", "Label"];
}
