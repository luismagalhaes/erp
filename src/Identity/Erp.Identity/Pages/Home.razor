@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Erp.Identity.Resources
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<IdentityResources> Localizer

<MudStack Spacing="4">
    @if (_user is not null)
    {
        <MudCard Class="erp-card" Elevation="0">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@Localizer["Home_Info_Heading"]</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudStack Spacing="2">
                    <MudText><b>@Localizer["Home_Info_NameLabel"]:</b> @_user.FullName</MudText>
                    <MudText><b>@Localizer["Home_Info_EmailLabel"]:</b> @_user.Email</MudText>
                    <MudText><b>@Localizer["Home_Info_LanguageLabel"]:</b> @LanguageDisplayName(_user.PreferredLanguage)</MudText>
                </MudStack>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                           Href="/Profile">
                    @Localizer["Home_Info_EditButton"]
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
</MudStack>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private ApplicationUser? _user;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
            return;

        var authState = await AuthenticationStateTask;
        _user = await UserManager.GetUserAsync(authState.User);
    }

    private static string LanguageDisplayName(string culture) => culture switch
    {
        "pt-PT" => "Português",
        "en-US" => "English",
        _ => culture
    };
}
