@page "/product-subfamilies"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@Localizer["Subfamilies_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Subfamilies_PageTitle"]">
        <Actions>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Category"
                       OnClick="@(() => Navigation.NavigateTo("product-families"))">
                @Localizer["Subfamilies_FamiliesButton"]
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("product-subfamilies/new"))">
                @Localizer["Subfamilies_NewButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="ProductSubfamily"
              LoadAsync="@((companyId, query, ct) => Catalog.QuerySubfamiliesAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="Code"
              SearchPlaceholder="@Localizer["Subfamilies_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.AccountTree"
              EmptyTitle="@Localizer["Subfamilies_EmptyTitle"]"
              EmptyDescription="@Localizer["Subfamilies_EmptyDescription"]"
              ItemsLabel="@Localizer["Subfamilies_ItemsLabel"]"
              LoadErrorMessage="@Localizer["Subfamilies_LoadError"]">
        <Columns>
            <PropertyColumn Property="x => x.Code" Title="@Localizer["Subfamilies_CodeColumn"]" />
            <PropertyColumn Property="x => x.Name" Title="@Localizer["Subfamilies_NameColumn"]" />
            <PropertyColumn Property="x => x.FamilyName" Title="@Localizer["Subfamilies_FamilyColumn"]" />
            <PropertyColumn Property="x => x.IsActive" Title="@Localizer["Subfamilies_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                        @(context.Item.IsActive ? Localizer["Subfamilies_ActiveFeminine"] : Localizer["Subfamilies_InactiveFeminine"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                     OnClick="@(() => Navigation.NavigateTo($"product-subfamilies/{context.Item.Id}"))">
                            @Localizer["Subfamilies_EditAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    /// <summary>
    /// Maps the toolbar search to the DTO members the API exposes, so a renamed column never
    /// produces an invalid $filter.
    /// </summary>
    private static readonly string[] SearchFields = ["Code", "Name", "FamilyName"];
}
