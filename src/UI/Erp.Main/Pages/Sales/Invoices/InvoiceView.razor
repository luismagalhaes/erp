@page "/invoices/{Id:guid}"
@page "/credit-notes/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Erp.Main.Components.Common
@using Erp.Main.Components.Sales
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject SalesApiClient SalesApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@(_invoice?.DocumentNumber ?? L["InvoiceView_DefaultTitle"])</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="@(_invoice?.DocumentNumber ?? L["InvoiceView_DefaultTitle"])" Breadcrumbs="Breadcrumbs">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Print"
                       Disabled="@(_invoice is null)"
                       OnClick="@(() => Navigation.NavigateTo($"invoices/{Id}/print"))">
                @L["InvoiceView_PrintButton"]
            </MudButton>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo(ListRoute))">
                @L["InvoiceView_BackButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_invoice is not null)
    {
        @if (_invoice.Status == "A")
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @L["InvoiceView_CancelledNotice"]
            </MudAlert>
        }

        <EditorCard Title="@InvoiceTypes.Describe(_invoice.DocumentType)" Icon="@Icons.Material.Filled.Receipt"
                    Description="@string.Format(L["InvoiceView_AtcudLabel"], _invoice.Atcud)">
            <MudGrid Spacing="3">
                @* Customer: tax id and name, then address, postal code and city. *@
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InvoiceView_CustomerLabel"]</MudText>
                    <MudText><span class="erp-mono">@_invoice.CustomerTaxId</span> — @_invoice.CustomerName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@CustomerAddressLine</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InvoiceView_DocumentDateLabel"]</MudText>
                    <MudText>@_invoice.DocumentDate.ToString("yyyy-MM-dd")</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InvoiceView_DueDateLabel"]</MudText>
                    <MudText Color="@(IsOverdue ? Color.Error : Color.Default)">@(_invoice.DueDate?.ToString("yyyy-MM-dd") ?? "—")</MudText>
                </MudItem>

                @if (!string.IsNullOrWhiteSpace(_invoice.RectifiedDocumentNumber))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InvoiceView_RectifiedDocumentLabel"]</MudText>
                        <MudText>
                            <span class="erp-mono">@_invoice.RectifiedDocumentNumber</span>
                            — @_invoice.RectificationReason
                        </MudText>
                    </MudItem>
                }
            </MudGrid>
        </EditorCard>

        <EditorCard Title="@L["NewInvoice_LinesSectionTitle"]" Icon="@Icons.Material.Filled.List">
            <MudTable Items="_invoice.Lines" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                <HeaderContent>
                    <MudTh>@L["InvoiceView_LineNumberColumn"]</MudTh>
                    <MudTh>@L["InvoiceView_CodeColumn"]</MudTh>
                    <MudTh>@L["InvoiceView_DescriptionColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["InvoiceView_QuantityColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["InvoiceView_UnitPriceColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["NewInvoice_DiscountColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["InvoiceView_NetColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["InvoiceView_TaxColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["InvoiceView_TaxAmountColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["InvoiceView_LineNumberColumn"]">@context.LineNumber</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_CodeColumn"]">@context.ProductCode</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_DescriptionColumn"]">
                        @context.ProductDescription
                        @if (!string.IsNullOrWhiteSpace(context.TaxExemptionCode))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.TaxExemptionCode — @context.TaxExemptionReason</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["InvoiceView_QuantityColumn"]" Style="text-align: right;">@context.Quantity.ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_UnitPriceColumn"]" Style="text-align: right;">@context.UnitPrice.ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["NewInvoice_DiscountColumn"]" Style="text-align: right;">@DescribeDiscount(context.DiscountPercentage)</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_NetColumn"]" Style="text-align: right;">@context.LineAmount.ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_TaxColumn"]" Style="text-align: right;">@context.TaxPercentage.ToString("0.##")%</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_TaxAmountColumn"]" Style="text-align: right;">@context.TaxAmount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        </EditorCard>

        @if (_invoice.Payments is { Count: > 0 } payments)
        {
            <EditorCard Title="@L["NewInvoice_PaymentSectionTitle"]" Icon="@Icons.Material.Filled.Payments">
                <MudSimpleTable Dense="true" Hover="true" Class="erp-grid">
                    <thead>
                        <tr>
                            <th>@L["PaymentMethods_MethodColumn"]</th>
                            <th>@L["PaymentMethods_DateColumn"]</th>
                            <th style="text-align: right;">@L["PaymentMethods_AmountColumn"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in payments)
                        {
                            <tr>
                                <td>@PaymentMechanismOptions.Describe(payment.Mechanism)</td>
                                <td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                                <td style="text-align: right;">@payment.Amount.ToString("N2") €</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </EditorCard>
        }

        <EditorCard Title="@L["NewInvoice_SummarySectionTitle"]" Icon="@Icons.Material.Filled.Calculate">
            <DocumentTotalsSummary GrossLinesTotal="_invoice.GrossLinesTotal"
                                   DiscountTotal="_invoice.DiscountTotal"
                                   NetTotal="_invoice.NetTotal"
                                   TaxTotal="_invoice.TaxPayable"
                                   GrossTotal="_invoice.GrossTotal"
                                   Taxes="TaxBreakdown" />
        </EditorCard>

        @if (_invoice.Status != "A")
        {
            <MudExpansionPanels Elevation="1">
                <MudExpansionPanel Text="@L["InvoiceView_VoidDocumentTitle"]">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @L["InvoiceView_VoidHelpText"]
                    </MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_voidReason" Label="@L["InvoiceView_ReasonLabel"]" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Style="max-width: 480px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Disabled="@(_voiding || string.IsNullOrWhiteSpace(_voidReason))"
                                   OnClick="VoidAsync">
                            @L["InvoiceView_VoidButton"]
                        </MudButton>
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private bool _voiding;
    private string? _error;

    private Guid? _loadedId;
    private string _voidReason = string.Empty;
    private InvoiceDetail? _invoice;

    /// <summary>Credit and debit notes have their own listing, so that is where "back" goes.</summary>
    private string ListRoute =>
        _invoice is not null && InvoiceTypes.IsRectifying(_invoice.DocumentType) ? "credit-notes" : "invoices";

    private List<BreadcrumbItem> Breadcrumbs =>
    [
        new(L[ListRoute == "credit-notes" ? "CreditNotes_PageTitle" : "Invoices_PageTitle"].Value, href: ListRoute),
        new(_invoice?.DocumentNumber ?? L["InvoiceView_DefaultTitle"].Value, href: null, disabled: true)
    ];

    private string CustomerAddressLine =>
        string.Join(" · ", new[] { _invoice?.CustomerAddress, _invoice?.CustomerPostalCode, _invoice?.CustomerCity }
            .Where(part => !string.IsNullOrWhiteSpace(part)));

    /// <summary>A live document past its due date is worth pointing at; a voided one owes nothing.</summary>
    private bool IsOverdue =>
        _invoice is { Status: not "A", DueDate: { } due } && due < DateOnly.FromDateTime(DateTime.Today);

    private IReadOnlyList<DocumentTotalsSummary.TaxLine> TaxBreakdown =>
        _invoice is null
            ? []
            : [.. _invoice.Taxes
                .OrderByDescending(tax => tax.TaxPercentage)
                .Select(tax => new DocumentTotalsSummary.TaxLine(tax.TaxCode, tax.TaxPercentage, tax.TaxableBase, tax.TaxAmount))];

    private static string DescribeDiscount(decimal percentage) =>
        percentage == 0 ? "—" : $"{percentage:0.##}%";

    protected override async Task OnParametersSetAsync()
    {
        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loadedId == Id)
            return;

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _invoice = await SalesApi.GetInvoiceAsync(Id);
            if (_invoice is null)
                _error = L["InvoiceView_DocumentNotFound"];
        }
        catch (Exception ex)
        {
            _error = string.Format(L["InvoiceView_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task VoidAsync()
    {
        _voiding = true;
        _error = null;

        try
        {
            var error = await SalesApi.VoidInvoiceAsync(Id, _voidReason.Trim());

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(L["InvoiceView_VoidedSuccess"], Severity.Success);
            _voidReason = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["InvoiceView_VoidError"], ex.Message);
        }
        finally
        {
            _voiding = false;
        }
    }
}
