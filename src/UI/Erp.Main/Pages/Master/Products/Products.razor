@page "/products"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Artigos</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Artigos</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Ficheiro de artigos usado nas linhas dos documentos e no SAF-T.
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(!Company.HasCompany)"
                   OnClick="@(() => Navigation.NavigateTo("products/new"))">
            Novo artigo
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-4">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_search" Label="Procurar" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Placeholder="Código, descrição ou código de barras" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="Guid?" @bind-Value="_familyFilter" Label="Família" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true">
                    @foreach (var family in _families)
                    {
                        <MudSelectItem T="Guid?" Value="@family.Id">@family.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="Guid?" @bind-Value="_brandFilter" Label="Marca" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true">
                    @foreach (var brand in _brands)
                    {
                        <MudSelectItem T="Guid?" Value="@brand.Id">@brand.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-2">
        <MudTable Items="Filtered" Hover="true" Striped="true" Dense="true" Loading="_loading"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Código</MudTh>
                <MudTh>Descrição</MudTh>
                <MudTh>Família</MudTh>
                <MudTh>Subfamília</MudTh>
                <MudTh>Marca</MudTh>
                <MudTh Style="text-align: right;">Preço</MudTh>
                <MudTh>IVA</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh Style="text-align: right;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.ProductCode</MudText>
                </MudTd>
                <MudTd DataLabel="Descrição">@context.Description</MudTd>
                <MudTd DataLabel="Família">@(context.FamilyName ?? "—")</MudTd>
                <MudTd DataLabel="Subfamília">@(context.SubfamilyName ?? "—")</MudTd>
                <MudTd DataLabel="Marca">@(context.BrandName ?? "—")</MudTd>
                <MudTd DataLabel="Preço" Style="text-align: right;">@context.UnitPrice.ToString("N2")</MudTd>
                <MudTd DataLabel="IVA">@context.DefaultTaxCode (@context.DefaultTaxPercentage.ToString("N0")%)</MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? "Ativo" : "Inativo")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Ações" Style="text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   title="Editar artigo"
                                   OnClick="@(() => Navigation.NavigateTo($"products/{context.Id}"))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Nenhum artigo corresponde ao filtro.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

@code {
    private bool _loading = true;
    private string? _error;
    private string _search = string.Empty;
    private Guid? _familyFilter;
    private Guid? _brandFilter;

    private List<ProductListItem> _products = [];
    private List<ProductFamily> _families = [];
    private List<Brand> _brands = [];

    private IEnumerable<ProductListItem> Filtered =>
        _products.Where(product =>
            (_familyFilter is null || product.FamilyId == _familyFilter)
            && (_brandFilter is null || product.BrandId == _brandFilter)
            && (string.IsNullOrWhiteSpace(_search)
                || product.ProductCode.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || product.Description.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || (product.Barcode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)));

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = Company.LoadError;

        if (!Company.HasCompany)
        {
            _products = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            var (products, error) = await Catalog.GetProductsAsync(Company.SelectedCompanyId);
            _products = [.. products];

            var (families, _) = await Catalog.GetFamiliesAsync(Company.SelectedCompanyId);
            _families = [.. families];

            var (brands, _) = await Catalog.GetBrandsAsync(Company.SelectedCompanyId);
            _brands = [.. brands];

            _error = error;
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar os artigos: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
