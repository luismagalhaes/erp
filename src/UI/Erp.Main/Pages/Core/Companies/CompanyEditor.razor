    private bool _warehouseOpen;
    private Guid? _warehouseId;
    private string _warehouseCode = string.Empty;
    private string _warehouseName = string.Empty;
    private string _warehouseAddress = string.Empty;
    private string _warehouseCity = string.Empty;
    private string _warehousePostalCode = string.Empty;
    private string _warehouseCountry = "PT";
    private bool _warehouseIsDefault;
    private bool _warehouseIsActive = true;

    private bool CanSaveWarehouse =>
        !string.IsNullOrWhiteSpace(_warehouseCode)
        && !string.IsNullOrWhiteSpace(_warehouseName)
        && PostalCodes.IsValid(_warehousePostalCode, _warehouseCountry);

    private List<IdentityUser> _availableUsers =>
        [.. _users.Where(user => _memberships.All(m => m.UserId != user.Id))];

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_name)
        && !string.IsNullOrWhiteSpace(_taxId)
        && PostalCodes.IsValid(_postalCode, _country);

    protected override async Task OnParametersSetAsync()
    {
        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loaded && _loadedId == Id)
            return;

        _loaded = true;
        _loadedId = Id;

        if (IsNew)
            return;

        _loading = true;

        try
        {
            var company = await CoreApi.GetCompanyAsync(Id!.Value);

            if (company is null)
            {
                _error = Localizer["CompanyEditor_NotFound"];
                return;
            }

            _name = company.Name;
            _legalName = company.LegalName ?? string.Empty;
            _taxId = company.TaxId;
            _email = company.Email ?? string.Empty;
            _phone = company.Phone ?? string.Empty;
            _address = company.Address ?? string.Empty;
            _city = company.City ?? string.Empty;
            _postalCode = company.PostalCode ?? string.Empty;
            _country = string.IsNullOrWhiteSpace(company.Country) ? "PT" : company.Country;
            _isActive = company.IsActive;

            await LoadUsersAsync();
            await LoadWarehousesAsync();
            await LoadAtCredentialStatusAsync();
            await LoadSubscriptionAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CompanyEditor_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadUsersAsync()
    {
        _workingUsers = true;

        // Each source is loaded on its own: the Identity being down still leaves the
        // memberships readable, and the other way round.
        var problems = new List<string>();

        try
        {
            var (memberships, error) = await CoreApi.GetUserCompaniesAsync(Id!.Value);
            _memberships = [.. memberships];

            if (error is not null)
                problems.Add(error);
        }
        catch (Exception ex)
        {
            problems.Add(string.Format(Localizer["CompanyEditor_LoadAccessesError"], ex.Message));
        }

        try
        {
            var (users, error) = await IdentityApi.GetUsersAsync();
            _users = [.. users.Where(user => user.IsActive).OrderBy(user => user.Email)];

            if (error is not null)
                problems.Add(string.Format(Localizer["CompanyEditor_LoadUsersError"], error));
        }
        catch (Exception ex)
        {
            problems.Add(string.Format(Localizer["CompanyEditor_LoadUsersError"], ex.Message));
        }

        _newUserId = _availableUsers.FirstOrDefault()?.Id ?? string.Empty;
        _error = problems.Count == 0 ? null : string.Join(" ", problems);
        _workingUsers = false;
    }

    private async Task LoadWarehousesAsync()
    {
        _workingWarehouses = true;

        try
        {
            var (warehouses, error) = await StockApi.GetWarehousesAsync(Id!.Value);
            _warehouses = [.. warehouses];

            if (error is not null)
