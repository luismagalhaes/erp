@page "/Account/ResetPassword"
@layout Layout.AuthLayout
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Erp.Identity.Resources
@attribute [AllowAnonymous]
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject IStringLocalizer<IdentityResources> Localizer

<PageTitle>@Localizer["Account_ResetPassword_PageTitle"]</PageTitle>

<div class="auth-wrapper">
    <div class="auth-card mud-elevation-3">
        <div class="auth-logo">ERP</div>
        <h2>@Localizer["Account_ResetPassword_Heading"]</h2>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="auth-error">@ErrorMessage</div>
        }

        <EditForm Model="Input" OnValidSubmit="HandleSubmitAsync" FormName="reset-password-form">
            <DataAnnotationsValidator />
            <div class="auth-field">
                <label>@Localizer["Account_ResetPassword_EmailLabel"]</label>
                <InputText @bind-Value="Input.Email" type="email" autocomplete="username" />
            </div>
            <div class="auth-field">
                <label>@Localizer["Account_ResetPassword_NewPasswordLabel"]</label>
                <InputText @bind-Value="Input.Password" type="password" autocomplete="new-password" />
            </div>
            <div class="auth-field">
                <label>@Localizer["Account_ResetPassword_ConfirmPasswordLabel"]</label>
                <InputText @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" />
            </div>
            <button type="submit" class="auth-button">@Localizer["Account_ResetPassword_SubmitButton"]</button>
        </EditForm>

        <div class="auth-links mt-16">
            <a class="auth-link" href="/Account/SignIn">@Localizer["Account_ResetPassword_BackToSignInLink"]</a>
        </div>
    </div>
</div>

@code {
    private InputModel Input { get; set; } = new();
    private string? ErrorMessage { get; set; }

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            Navigation.NavigateTo("/Account/ForgotPassword", forceLoad: true);
            return;
        }

        Input.Email = Email;
        Input.Token = Token;
    }

    private async Task HandleSubmitAsync()
    {
        ErrorMessage = null;

        var email = (Input.Email ?? string.Empty).Trim();
        var user = await UserManager.FindByEmailAsync(email);
        if (user is null)
        {
            Navigation.NavigateTo("/Account/ResetPasswordConfirmation", forceLoad: true);
            return;
        }

        string token;
        try
        {
            token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Input.Token ?? string.Empty));
        }
        catch
        {
            ErrorMessage = Localizer["Account_ResetPassword_ErrorInvalidToken"];
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, token, Input.Password!);
        if (result.Succeeded)
        {
            Navigation.NavigateTo("/Account/ResetPasswordConfirmation", forceLoad: true);
            return;
        }

        ErrorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class InputModel
    {
        [Required, EmailAddress] public string? Email { get; set; }
        [Required] public string? Token { get; set; }
        [Required, DataType(DataType.Password)] public string? Password { get; set; }
        [Required, DataType(DataType.Password), Compare(nameof(Password))] public string? ConfirmPassword { get; set; }
    }
}
