@page "/Account/ForgotPasswordConfirmation"
@layout Layout.AuthLayout
@using Microsoft.AspNetCore.Components.Web
@attribute [AllowAnonymous]

<PageTitle>Forgot Password — Confirmation</PageTitle>

<div class="content-card mud-elevation-1">
    <h2>Check your inbox</h2>
    <p>If your account exists, a password reset link has been sent.</p>
    <div class="auth-links mt-16">
        <a class="auth-link" href="/Account/SignIn">Back to sign in</a>
    </div>
</div>
