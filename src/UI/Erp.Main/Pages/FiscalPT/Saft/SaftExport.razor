@page "/saft"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject SaftApiClient SaftApi
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["SaftExport_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">@L["SaftExport_PageTitleWithVersion"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["SaftExport_Subtitle", SaftVersion]
        </MudText>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (!Company.HasCompany)
    {
        <MudAlert Severity="Severity.Info">@L["SaftExport_ChooseCompanyNotice"]</MudAlert>
    }
    else
    {
        <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
            <MudText Typo="Typo.h6" Class="mb-3">@L["SaftExport_PeriodTitle"]</MudText>

            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudSelect T="SaftPeriodKind" Value="_periodKind" ValueChanged="OnPeriodKindChanged"
                               Label="@L["SaftExport_PeriodTypeLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="SaftPeriodKind" Value="SaftPeriodKind.Month">@L["SaftExport_MonthOption"]</MudSelectItem>
                        <MudSelectItem T="SaftPeriodKind" Value="SaftPeriodKind.Quarter">@L["SaftExport_QuarterOption"]</MudSelectItem>
                        <MudSelectItem T="SaftPeriodKind" Value="SaftPeriodKind.Year">@L["SaftExport_YearOption"]</MudSelectItem>
                        <MudSelectItem T="SaftPeriodKind" Value="SaftPeriodKind.Custom">@L["SaftExport_CustomOption"]</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="2">
                    <MudNumericField T="int" Value="_year" ValueChanged="OnYearChanged"
                                     Label="@L["SaftExport_YearLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="2000" Max="2100"
                                     Disabled="@(_periodKind == SaftPeriodKind.Custom)" />
                </MudItem>

                @if (_periodKind == SaftPeriodKind.Month)
                {
                    <MudItem xs="12" md="3">
                        <MudSelect T="int" Value="_month" ValueChanged="OnMonthChanged"
                                   Label="@L["SaftExport_MonthLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @for (var month = 1; month <= 12; month++)
                            {
                                var value = month;
                                <MudSelectItem T="int" Value="@value">@MonthName(value)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                else if (_periodKind == SaftPeriodKind.Quarter)
                {
                    <MudItem xs="12" md="3">
                        <MudSelect T="int" Value="_quarter" ValueChanged="OnQuarterChanged"
                                   Label="@L["SaftExport_QuarterLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @for (var quarter = 1; quarter <= 4; quarter++)
                            {
                                var value = quarter;
                                <MudSelectItem T="int" Value="@value">@L["SaftExport_QuarterNumberFormat", value]</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                else if (_periodKind == SaftPeriodKind.Custom)
                {
                    <MudItem xs="12" md="3">
                        <MudDatePicker Date="_startDate" DateChanged="OnStartDateChanged" Label="@L["SaftExport_StartDateLabel"]"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudDatePicker Date="_endDate" DateChanged="OnEndDateChanged" Label="@L["SaftExport_EndDateLabel"]"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
                    </MudItem>
                }

                <MudItem xs="12" md="4" Class="d-flex align-center">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @PeriodDescription
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">@L["SaftExport_ContentTitle"]</MudText>
                @if (_loadingSummary)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                }
            </MudStack>

            @if (_summary is null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["SaftExport_NoDataNotice"]</MudText>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SaftExport_InvoicesLabel"]</MudText>
                        <MudText Typo="Typo.h5">@_summary.InvoiceCount</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @_summary.InvoiceGrossTotal.ToString("C2")
                        </MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SaftExport_StockMovementsLabel"]</MudText>
                        <MudText Typo="Typo.h5">@_summary.StockMovementCount</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SaftExport_PaymentsLabel"]</MudText>
                        <MudText Typo="Typo.h5">@_summary.PaymentCount</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @_summary.PaymentGrossTotal.ToString("C2")
                        </MudText>
                    </MudItem>
                    <MudItem xs="6" md="3" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   Disabled="@(_exporting || TotalDocuments == 0)"
                                   OnClick="ExportAsync">
                            @(_exporting ? L["SaftExport_Generating"] : L["SaftExport_GenerateButton"])
                        </MudButton>
                    </MudItem>
                </MudGrid>

                @if (TotalDocuments == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                        @L["SaftExport_NoDocumentsNotice"]
                    </MudAlert>
                }
            }
        </MudPaper>

        @if (_validationErrors == 0)
        {
            <MudAlert Severity="Severity.Success" Dense="true">
                @L["SaftExport_ValidatedSuccess", SaftVersion]
            </MudAlert>
        }
        else if (_validationErrors > 0)
        {
            <MudAlert Severity="Severity.Warning">
                @L["SaftExport_ValidationWarning", _validationErrors,
                    (_validationErrors == 1 ? L["SaftExport_ValidationErrorSingular"] : L["SaftExport_ValidationErrorPlural"])]
            </MudAlert>
        }

        <MudAlert Severity="Severity.Normal" Dense="true">
            @L["SaftExport_VoidedDocumentsNotice"]
        </MudAlert>

        <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
            <MudStack Spacing="0" Class="mb-3">
                <MudText Typo="Typo.h6">@L["SaftExport_SelfBillingTitle"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @L["SaftExport_SelfBillingSubtitle", L["SaftExport_SelfBillingTypeS"], L["SaftExport_SelfBillingOnePerSupplier"]]
                </MudText>
            </MudStack>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="Guid?" @bind-Value="_selfBillingSupplierId" @bind-Value:after="StateHasChanged"
                               Label="@L["SaftExport_SelfBilledSupplierLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var supplier in _suppliers)
                        {
                            <MudSelectItem T="Guid?" Value="@supplier.Id">
                                @supplier.Code — @supplier.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Download"
                               Disabled="@(_exportingSelfBilling || _selfBillingSupplierId is null)"
                               OnClick="ExportSelfBillingAsync">
                        @(_exportingSelfBilling ? L["SaftExport_Generating"] : L["SaftExport_GenerateFileSButton"])
                    </MudButton>
                </MudItem>
            </MudGrid>

            @if (_suppliers.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    @L["SaftExport_NoActiveSuppliersNotice"]
                </MudAlert>
            }
        </MudPaper>
    }
</MudStack>

@code {
    private const string SaftVersion = "1.04_01";

    private enum SaftPeriodKind { Month, Quarter, Year, Custom }

    private bool _loadingSummary;
    private bool _exporting;
    private string? _error;

    private SaftPeriodKind _periodKind = SaftPeriodKind.Month;
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private int _quarter = (DateTime.Today.Month - 1) / 3 + 1;

    private DateTime? _startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _endDate = DateTime.Today;

    private SaftPeriodSummary? _summary;
    private int? _validationErrors;

    private bool _exportingSelfBilling;
    private Guid? _selfBillingSupplierId;
    private List<Partner> _suppliers = [];

    private int TotalDocuments =>
        _summary is null ? 0 : _summary.InvoiceCount + _summary.StockMovementCount + _summary.PaymentCount;

    private DateOnly StartDate => DateOnly.FromDateTime(_startDate ?? DateTime.Today);

    private DateOnly EndDate => DateOnly.FromDateTime(_endDate ?? DateTime.Today);

    private string PeriodDescription => $"{StartDate:yyyy-MM-dd} a {EndDate:yyyy-MM-dd}";

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        ApplyPeriod();
        await LoadSummaryAsync();
        await LoadSuppliersAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(async () =>
    {
        _selfBillingSupplierId = null;
        await LoadSummaryAsync();
        await LoadSuppliersAsync();
    });

    private async Task LoadSuppliersAsync()
    {
        if (!Company.HasCompany)
        {
            _suppliers = [];
            return;
        }

        try
        {
            var (suppliers, _) = await Catalog.GetSuppliersAsync(Company.SelectedCompanyId);
            _suppliers = [.. suppliers.Where(supplier => supplier.IsActive)];
        }
        catch (Exception ex)
        {
            _error = L["SaftExport_LoadSuppliersError", ex.Message];
        }
        finally
        {
            StateHasChanged();
        }
    }

    /// <summary>Turns the chosen kind of period into the actual dates. Custom ranges are left alone.</summary>
    private void ApplyPeriod()
    {
        switch (_periodKind)
        {
            case SaftPeriodKind.Month:
                _startDate = new DateTime(_year, _month, 1);
                _endDate = _startDate.Value.AddMonths(1).AddDays(-1);
                break;

            case SaftPeriodKind.Quarter:
                _startDate = new DateTime(_year, (_quarter - 1) * 3 + 1, 1);
                _endDate = _startDate.Value.AddMonths(3).AddDays(-1);
                break;

            case SaftPeriodKind.Year:
                _startDate = new DateTime(_year, 1, 1);
                _endDate = new DateTime(_year, 12, 31);
                break;
        }
    }

    private async Task OnPeriodKindChanged(SaftPeriodKind kind)
    {
        _periodKind = kind;
        ApplyPeriod();
        await LoadSummaryAsync();
    }

    private async Task OnYearChanged(int year)
    {
        _year = year;
        ApplyPeriod();
        await LoadSummaryAsync();
    }

    private async Task OnMonthChanged(int month)
    {
        _month = month;
        ApplyPeriod();
        await LoadSummaryAsync();
    }

    private async Task OnQuarterChanged(int quarter)
    {
        _quarter = quarter;
        ApplyPeriod();
        await LoadSummaryAsync();
    }

    private async Task OnStartDateChanged(DateTime? date)
    {
        _startDate = date;
        await LoadSummaryAsync();
    }

    private async Task OnEndDateChanged(DateTime? date)
    {
        _endDate = date;
        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        if (!Company.HasCompany)
        {
            _summary = null;
            _error = Company.LoadError;
            StateHasChanged();
            return;
        }

        _loadingSummary = true;
        _error = null;
        StateHasChanged();

        try
        {
            var (summary, error) = await SaftApi.GetSaftSummaryAsync(Company.SelectedCompanyId, StartDate, EndDate);
            _summary = summary;
            _error = error;
        }
        catch (Exception ex)
        {
            _error = L["SaftExport_LoadSummaryError", ex.Message];
        }
        finally
        {
            _loadingSummary = false;
            StateHasChanged();
        }
    }

    private async Task ExportAsync()
    {
        _exporting = true;
        _error = null;

        try
        {
            var (file, error) = await SaftApi.DownloadSaftAsync(Company.SelectedCompanyId, StartDate, EndDate);

            if (file is null)
            {
                _error = error ?? L["SaftExport_GenerateFailed"];
                return;
            }

            await JS.InvokeVoidAsync(
                "erpDownloadFile", file.FileName, "application/xml", Convert.ToBase64String(file.Content));

            _validationErrors = file.ValidationErrors;

            if (_validationErrors == 0)
            {
                Snackbar.Add(L["SaftExport_GeneratedAndValidated", file.FileName].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["SaftExport_GeneratedButFailsSchema", file.FileName].Value, Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            _error = L["SaftExport_GenerateError", ex.Message];
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task ExportSelfBillingAsync()
    {
        _exportingSelfBilling = true;
        _error = null;

        try
        {
            var (file, error) = await SaftApi.DownloadSelfBillingSaftAsync(
                Company.SelectedCompanyId, _selfBillingSupplierId!.Value, StartDate, EndDate);

            if (file is null)
            {
                _error = error ?? L["SaftExport_GenerateSelfBillingFailed"];
                return;
            }

            await JS.InvokeVoidAsync(
                "erpDownloadFile", file.FileName, "application/xml", Convert.ToBase64String(file.Content));

            if (file.ValidationErrors == 0)
            {
                Snackbar.Add(L["SaftExport_GeneratedAndValidated", file.FileName].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["SaftExport_GeneratedButFailsSchema", file.FileName].Value, Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            _error = L["SaftExport_GenerateSelfBillingError", ex.Message];
        }
        finally
        {
            _exportingSelfBilling = false;
        }
    }

    private static string MonthName(int month) =>
        System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month);

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
