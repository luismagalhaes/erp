@page "/companies/new"
@page "/companies/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using MudBlazor
@using Erp.Common
@using Erp.Main.Models
@using Erp.Main.Components.Common
@using Erp.Main.Models.Core
@using Erp.Main.Resources
@using Erp.Main.Services
@inject CoreApiClient CoreApi
@inject IdentityApiClient IdentityApi
@inject StockApiClient StockApi
@inject LookupApiClient Lookups
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@(IsNew ? Localizer["CompanyEditor_NewTitle"] : Localizer["CompanyEditor_EditTitle"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(IsNew ? Localizer["CompanyEditor_NewTitle"] : _name)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Localizer["CompanyEditor_TaxIdHelperText"]
            </MudText>
        </MudStack>

        <MudStack Row="true" Spacing="2">
            @if (!IsNew)
            {
                <AuthorizeView Roles="@Constants.Roles.SuperAdmin">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.AutoAwesome"
                               Disabled="@_applyingDemoData"
                               OnClick="ApplyDemoDataAsync">
                        @Localizer["CompanyEditor_ApplyDemoDataButton"]
                    </MudButton>
                </AuthorizeView>
            }
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("companies"))">
                @Localizer["Common_Back"]
            </MudButton>
        </MudStack>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="0" Class="erp-card erp-form">
            <MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pa-4">
                <MudTabPanel Text="@Localizer["CompanyEditor_DataTab"]" Icon="@Icons.Material.Filled.Domain">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6" md="6">
                            <MudTextField @bind-Value="_name" Label="@Localizer["Common_NameColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="6">
                            <MudTextField @bind-Value="_legalName" Label="@Localizer["CompanyEditor_LegalNameLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField @bind-Value="_taxId" Label="@Localizer["Companies_TaxIdColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick="LookupTaxIdAsync" AdornmentAriaLabel="@Localizer["PartnerForm_TaxIdLookupTooltip"]" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField @bind-Value="_email" Label="@Localizer["CompanyEditor_EmailColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Email" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudTextField @bind-Value="_phone" Label="@Localizer["PartnerForm_PhoneLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                                @Localizer["CompanyEditor_AddressSectionHint"]
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="6">
                            <MudTextField @bind-Value="_address" Label="@Localizer["PartnerForm_AddressLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="3" md="3">
                            <PostalCodeField @bind-Value="_postalCode" Country="@_country"
                                             LookupResolved="OnPostalCodeResolvedAsync" StreetSelected="OnStreetSelectedAsync"
                                             Label="@Localizer["PartnerForm_PostalCodeLabel"]" />
                        </MudItem>
                        <MudItem xs="12" sm="3" md="3">
                            <MudTextField @bind-Value="_city" Label="@Localizer["CompanyEditor_CityColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="4" md="3">
                            <MudSelect @bind-Value="_country" Label="@Localizer["PartnerForm_CountryLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var country in Countries.All)
                                {
                                    <MudSelectItem T="string" Value="@country.Code">@country.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        @if (!string.IsNullOrWhiteSpace(_taxIdLookupMessage))
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="@_taxIdLookupSeverity" Dense="true">@_taxIdLookupMessage</MudAlert>
                            </MudItem>
                        }

                        @if (!IsNew)
                        {
                            <MudItem xs="12">
                                <MudSwitch @bind-Value="_isActive" Color="Color.Primary" Label="@Localizer["CompanyEditor_ActiveLabel"]" />
                            </MudItem>
                        }
                    </MudGrid>

                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@(_saving || !CanSave)"
                                   OnClick="SaveAsync">
                            @Localizer["Common_SaveButton"]
                        </MudButton>
                    </MudStack>
                </MudTabPanel>

                <MudTabPanel Text="@Localizer["CompanyEditor_UsersTab"]" Icon="@Icons.Material.Filled.Group" Disabled="IsNew"
                             ToolTip="@(IsNew ? Localizer["CompanyEditor_UsersTabDisabledHint"].Value : null)">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        @Localizer["CompanyEditor_UsersTabDescription"]
                    </MudText>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 erp-form">
                        <MudGrid>
                            <MudItem xs="12" md="5">
                                <MudSelect @bind-Value="_newUserId" Label="@Localizer["CompanyEditor_UserLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Dense="true" Disabled="@(_availableUsers.Count == 0)">
                                    @foreach (var user in _availableUsers)
                                    {
                                        <MudSelectItem T="string" Value="@user.Id">
                                            @(string.IsNullOrWhiteSpace(user.FullName) ? user.Email : $"{user.FullName} ({user.Email})")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect @bind-Value="_newRole" Label="@Localizer["CompanyEditor_RoleLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                    @foreach (var role in CompanyRoles)
                                    {
                                        <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3" Class="d-flex align-center">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.PersonAdd"
                                           Disabled="@(_working || string.IsNullOrWhiteSpace(_newUserId))"
                                           OnClick="AssignAsync">
                                    @Localizer["CompanyEditor_AssignButton"]
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (_availableUsers.Count == 0 && _users.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @Localizer["CompanyEditor_AllUsersAssignedHint"]
                            </MudText>
                        }
                    </MudPaper>

                    <MudTable Items="_memberships" Hover="true" Striped="true" Dense="true" Loading="_workingUsers"
                              Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>@Localizer["CompanyEditor_UserColumn"]</MudTh>
                            <MudTh>@Localizer["CompanyEditor_EmailColumn"]</MudTh>
                            <MudTh Style="width: 200px;">@Localizer["CompanyEditor_RoleLabel"]</MudTh>
                            <MudTh Style="width: 140px;">@Localizer["Common_StatusColumn"]</MudTh>
                            <MudTh Style="text-align: right;">@Localizer["CompanyEditor_ActionsColumn"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@Localizer["CompanyEditor_UserColumn"]">@DescribeUser(context.UserId)</MudTd>
                            <MudTd DataLabel="@Localizer["CompanyEditor_EmailColumn"]">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@DescribeEmail(context.UserId)</MudText>
                            </MudTd>
                            <MudTd DataLabel="@Localizer["CompanyEditor_RoleLabel"]">
                                <MudSelect T="string" Value="context.Role" Dense="true" Margin="Margin.Dense"
                                           ValueChanged="@(role => ChangeRoleAsync(context, role))">
                                    @foreach (var role in CompanyRoles)
                                    {
                                        <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd DataLabel="@Localizer["Common_StatusColumn"]">
                                <MudSwitch T="bool" Value="context.IsActive" Color="Color.Primary" Size="Size.Small"
                                           ValueChanged="@(active => ChangeActiveAsync(context, active))" />
                            </MudTd>
                            <MudTd DataLabel="@Localizer["CompanyEditor_ActionsColumn"]" Style="text-align: right;">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               title="@Localizer["CompanyEditor_RemoveAccessTitle"]"
                                               Disabled="_working"
                                               OnClick="@(() => RemoveAsync(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @Localizer["CompanyEditor_NoUsersMessage"]
                            </MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudTabPanel>

                <MudTabPanel Text="@Localizer["CompanyEditor_WarehousesTab"]" Icon="@Icons.Material.Filled.Warehouse" Disabled="IsNew"
                             ToolTip="@(IsNew ? Localizer["CompanyEditor_WarehousesTabDisabledHint"].Value : null)">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @Localizer["CompanyEditor_WarehousesTabDescription"]
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(() => OpenWarehouse(null))">
                            @Localizer["CompanyEditor_NewWarehouse"]
                        </MudButton>
                    </MudStack>

                    <MudTable Items="_warehouses" Hover="true" Striped="true" Dense="true"
                              Loading="_workingWarehouses" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>@Localizer["Common_CodeColumn"]</MudTh>
                            <MudTh>@Localizer["Common_NameColumn"]</MudTh>
                            <MudTh>@Localizer["CompanyEditor_CityColumn"]</MudTh>
                            <MudTh Style="width: 140px;">@Localizer["CompanyEditor_DefaultColumn"]</MudTh>
                            <MudTh Style="width: 120px;">@Localizer["Common_StatusColumn"]</MudTh>
                            <MudTh Style="text-align: right;">@Localizer["CompanyEditor_ActionsColumn"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@Localizer["Common_CodeColumn"]">
                                <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.Code</MudText>
                            </MudTd>
                            <MudTd DataLabel="@Localizer["Common_NameColumn"]">@context.Name</MudTd>
                            <MudTd DataLabel="@Localizer["CompanyEditor_CityColumn"]">@DescribeCity(context)</MudTd>
                            <MudTd DataLabel="@Localizer["CompanyEditor_DefaultColumn"]">
                                @if (context.IsDefault)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                        @Localizer["CompanyEditor_DefaultChip"]
                                    </MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="@Localizer["Common_StatusColumn"]">
                                @if (context.IsActive)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                                        @Localizer["Common_Active"]
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                                        @Localizer["Common_Inactive"]
                                    </MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="@Localizer["CompanyEditor_ActionsColumn"]" Style="text-align: right;">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               title="@Localizer["CompanyEditor_EditWarehouseTitle"]"
                                               OnClick="@(() => OpenWarehouse(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @Localizer["CompanyEditor_NoWarehousesMessage"]
                            </MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudTabPanel>

                <MudTabPanel Text="@Localizer["CompanyEditor_AtTab"]" Icon="@Icons.Material.Filled.Https" Disabled="IsNew"
                             ToolTip="@(IsNew ? Localizer["CompanyEditor_AtTabDisabledHint"].Value : null)">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        @Localizer["CompanyEditor_AtTabDescription"]
                    </MudText>

                    @if (_atStatus is not null)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">
                            @string.Format(Localizer["CompanyEditor_AtCredentialsRegistered"],
                                _atStatus.SubUserId, _atStatus.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm")) UTC.
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                            @Localizer["CompanyEditor_AtCredentialsMissing"]
                        </MudAlert>
                    }

                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField @bind-Value="_atSubUserId" Label="@Localizer["CompanyEditor_AtSubUserIdLabel"]"
                                          HelperText="@Localizer["CompanyEditor_AtSubUserIdHelperText"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudTextField @bind-Value="_atPassword" Label="@Localizer["CompanyEditor_AtPasswordLabel"]"
                                          InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@(_workingAt || string.IsNullOrWhiteSpace(_atSubUserId) || string.IsNullOrWhiteSpace(_atPassword))"
                                   OnClick="SaveAtCredentialsAsync">
                            @Localizer["Common_SaveButton"]
                        </MudButton>
                    </MudStack>
                </MudTabPanel>

                <MudTabPanel Text="@Localizer["CompanyEditor_SubscriptionTab"]" Icon="@Icons.Material.Filled.CardMembership" Disabled="IsNew"
                             ToolTip="@(IsNew ? Localizer["CompanyEditor_SubscriptionTabDisabledHint"].Value : null)">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        @Localizer["CompanyEditor_SubscriptionTabDescription"]
                    </MudText>

                    @if (_subscriptionError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_subscriptionError</MudAlert>
                    }

                    @if (_workingSubscription)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else
                    {
                        @if (_subscriptions.Count == 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                                @Localizer["CompanyEditor_NoSubscriptionMessage"]
                            </MudAlert>
                        }
                        else
                        {
                            <MudTable T="CompanySubscription" Items="@_subscriptions" Dense="true" Hover="true" Class="mb-4 erp-card" Elevation="0" Outlined="true">
                                <HeaderContent>
                                    <MudTh>@Localizer["Subscriptions_PlanColumn"]</MudTh>
                                    <MudTh>@Localizer["Common_StatusColumn"]</MudTh>
                                    <MudTh>@Localizer["Subscriptions_StartedColumn"]</MudTh>
                                    <MudTh>@Localizer["Subscriptions_ExpiresColumn"]</MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="@Localizer["Subscriptions_PlanColumn"].Value">@context.PlanName</MudTd>
                                    <MudTd DataLabel="@Localizer["Common_StatusColumn"].Value">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@StatusColorFor(context)">
                                            @StatusLabelFor(context)
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="@Localizer["Subscriptions_StartedColumn"].Value">@context.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</MudTd>
                                    <MudTd DataLabel="@Localizer["Subscriptions_ExpiresColumn"].Value">@context.ExpiresAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</MudTd>
                                    <MudTd Class="erp-numeric">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       OnClick="@(() => RemoveSubscriptionAsync(context))" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }

                        <MudText Typo="Typo.subtitle2" Class="mb-2">@Localizer["Subscriptions_ChangeAction"]</MudText>

                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6" md="4">
                                <MudSelect T="Guid?" @bind-Value="_subscriptionPlanId" Label="@Localizer["Subscriptions_PlanColumn"]"
                                           Placeholder="@Localizer["Subscriptions_PlanPlaceholder"].Value"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var plan in _subscriptionPlans)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)plan.Id)">
                                            @plan.Name — @Localizer[$"BillingPeriod_{plan.BillingPeriod}"] (@plan.Price.ToString("N2") €)
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="3" md="3">
                                <MudDatePicker @bind-Date="_subscriptionStartedAt" Label="@Localizer["Subscriptions_StartedColumn"]"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" Clearable="true" />
                            </MudItem>
                            <MudItem xs="12" sm="3" md="3">
                                <MudDatePicker @bind-Date="_subscriptionExpiresAt" Label="@Localizer["Subscriptions_ExpiresColumn"]"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" Clearable="true" />
                            </MudItem>
                            <MudItem xs="12" md="2" Class="d-flex align-center">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           Disabled="@(_savingSubscription || _subscriptionPlanId is null)"
                                           OnClick="SaveSubscriptionAsync">
                                    @Localizer["Common_SaveButton"]
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                            @Localizer["Subscriptions_ChangeHint"]
                        </MudText>
                    }
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    }
</MudStack>

@* --- Armazém --- *@
<MudDialog @bind-Visible="_warehouseOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_warehouseId is null ? Localizer["CompanyEditor_NewWarehouseTitle"] : Localizer["CompanyEditor_EditWarehouseTitle"])</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="3" md="3">
                <MudTextField @bind-Value="_warehouseCode" @bind-Value:after="StateHasChanged" Immediate="true"
                              Label="@Localizer["Common_CodeColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                              Disabled="@(_warehouseId is not null)"
                              HelperText="@(_warehouseId is null ? Localizer["CompanyEditor_WarehouseCodeUniqueHint"].Value : Localizer["CompanyEditor_WarehouseCodeHelperText"].Value)" />
            </MudItem>
            <MudItem xs="12" sm="9" md="9">
                <MudTextField @bind-Value="_warehouseName" @bind-Value:after="StateHasChanged" Immediate="true"
                              Label="@Localizer["Common_NameColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="6">
                <MudTextField @bind-Value="_warehouseAddress" Label="@Localizer["PartnerForm_AddressLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3" md="3">
                <PostalCodeField @bind-Value="_warehousePostalCode" Country="@_warehouseCountry"
                                 LookupResolved="OnWarehousePostalCodeResolvedAsync" StreetSelected="OnWarehouseStreetSelectedAsync"
                                 Label="@Localizer["PartnerForm_PostalCodeLabel"]" />
            </MudItem>
            <MudItem xs="12" sm="3" md="3">
                <MudTextField @bind-Value="_warehouseCity" Label="@Localizer["CompanyEditor_CityColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudSelect @bind-Value="_warehouseCountry" Label="@Localizer["PartnerForm_CountryLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var country in Countries.All)
                    {
                        <MudSelectItem T="string" Value="@country.Code">@country.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="4" md="4">
                <MudSwitch @bind-Value="_warehouseIsDefault" Color="Color.Primary" Label="@Localizer["CompanyEditor_WarehouseIsDefaultLabel"]" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @Localizer["CompanyEditor_WarehouseIsDefaultHint"]
                </MudText>
            </MudItem>

            @if (_warehouseId is not null)
            {
                <MudItem xs="12" sm="4" md="4">
                    <MudSwitch @bind-Value="_warehouseIsActive" Color="Color.Primary" Label="@Localizer["CompanyEditor_WarehouseActiveLabel"]" />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _warehouseOpen = false)">@Localizer["Common_CancelButton"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@(_working || !CanSaveWarehouse)"
                   OnClick="SaveWarehouseAsync">
            @Localizer["Common_SaveButton"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>As mesmas roles que o Identity emite, para não haver duas listas a divergir.</summary>
    private static readonly string[] CompanyRoles = Constants.Roles.All;

    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNew => Id is null;

    private bool _loading;
    private bool _saving;
    private bool _working;
    private bool _workingUsers;
    private string? _error;

    private bool _loaded;
    private Guid? _loadedId;

    private string _name = string.Empty;
    private string _legalName = string.Empty;
    private string _taxId = string.Empty;
    private string _email = string.Empty;
    private string _phone = string.Empty;
    private string _address = string.Empty;
    private string _city = string.Empty;
    private string _postalCode = string.Empty;
    private string _country = "PT";
    private bool _isActive = true;

    private string? _taxIdLookupMessage;
    private Severity _taxIdLookupSeverity = Severity.Info;
    private bool _lookingUpTaxId;

    private string _newUserId = string.Empty;
    private string _newRole = Constants.Roles.User;

    private List<UserCompanyAdmin> _memberships = [];
    private List<IdentityUser> _users = [];

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private bool _workingWarehouses;
    private List<Warehouse> _warehouses = [];

    private bool _workingAt;
    private CompanyAtCredentialStatus? _atStatus;
