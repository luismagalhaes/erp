@page "/Account/SignIn"
@page "/Account/Login"
@layout Layout.AuthLayout
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Localization
@using Erp.Identity.Common.Constants
@using Erp.Identity.Resources
@using Erp.Identity.Services
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IStringLocalizer<IdentityResources> Localizer
@inject ILoginAuditService LoginAuditService
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Localizer["Account_SignIn_PageTitle"]</PageTitle>

<div class="auth-wrapper">
    <div class="auth-card mud-elevation-3">
        <div class="auth-logo">ERP</div>
        <h2>@Localizer["Account_SignIn_Heading"]</h2>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="auth-error">@ErrorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(SuccessMessage))
        {
            <div class="hint">@SuccessMessage</div>
        }

        @if (ShowResendLink)
        {
            <div class="auth-links">
                <a class="auth-link" href="@ResendConfirmationLink">@Localizer["Account_SignIn_ResendConfirmationLink"]</a>
            </div>
        }

        <form id="signin-form" method="post" action="/authentication/login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrlHelper.Sanitize(ReturnUrl)" />
            <div class="auth-field">
                <label>@Localizer["Account_SignIn_EmailLabel"]</label>
                <input type="email" name="email" autocomplete="username" value="@Input.Email" />
            </div>
            <div class="auth-field">
                <label>@Localizer["Account_SignIn_PasswordLabel"]</label>
                <input type="password" name="password" autocomplete="current-password" value="@Input.Password" />
            </div>
            @if (RequireCaptcha)
            {
                <input type="hidden" id="g-recaptcha-response" name="g-recaptcha-response" />
            }
            <button type="submit" class="auth-button">@Localizer["Account_SignIn_SubmitButton"]</button>
        </form>

        @if (RequireCaptcha)
        {
            <script src="/js/recaptcha.js"></script>
            <script src="https://www.google.com/recaptcha/api.js?render=@RecaptchaSiteKey"></script>
            <script>
                window.erpRecaptcha.guardSubmit('signin-form', 'g-recaptcha-response', '@RecaptchaSiteKey', '@Constants.Recaptcha.SignInAction');
            </script>
        }

        @if (GoogleEnabled || MicrosoftEnabled)
        {
            <div class="auth-divider"><span>@Localizer["Account_SignIn_OrDivider"]</span></div>
        }

        @if (GoogleEnabled)
        {
            <a class="auth-button-oauth" href="@GoogleLoginLink">
                <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                    <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.615z" />
                    <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z" />
                    <path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z" />
                    <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 6.29C4.672 4.163 6.656 3.58 9 3.58z" />
                </svg>
                @Localizer["Account_SignIn_GoogleButton"]
            </a>
        }

        @if (MicrosoftEnabled)
        {
            <a class="auth-button-oauth" href="@MicrosoftLoginLink">
                <svg width="18" height="18" viewBox="0 0 21 21" aria-hidden="true">
                    <rect x="1" y="1" width="9" height="9" fill="#f25022" />
                    <rect x="11" y="1" width="9" height="9" fill="#7fba00" />
                    <rect x="1" y="11" width="9" height="9" fill="#00a4ef" />
                    <rect x="11" y="11" width="9" height="9" fill="#ffb900" />
                </svg>
                @Localizer["Account_SignIn_MicrosoftButton"]
            </a>
        }

        <div class="auth-links mt-16">
            <a class="auth-link" href="/Account/ForgotPassword">@Localizer["Account_SignIn_ForgotPasswordLink"]</a>
            <a class="auth-link" href="@SignUpLink">@Localizer["Account_SignIn_SignUpLink"]</a>
        </div>
    </div>
</div>

@code {
    private InputModel Input { get; set; } = new();
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "registered")]
    public string? Registered { get; set; }

    [SupplyParameterFromQuery(Name = "reset")]
    public string? Reset { get; set; }

    [SupplyParameterFromQuery(Name = "confirmed")]
    public string? Confirmed { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    /// <summary>Only set for the "unconfirmed" error, so the resend link knows who to resend for.</summary>
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private bool ShowResendLink => string.Equals(Error, "unconfirmed", StringComparison.OrdinalIgnoreCase);

    private string SignUpLink => Navigation.GetUriWithQueryParameters(
        "/Account/SignUp", new Dictionary<string, object?> { ["returnUrl"] = ReturnUrl });

    // Google isn't wired up at all (no AddGoogle registration) when the app is started without
    // credentials — see Program.cs — so hiding the button in that case keeps this consistent
    // with what a click would actually be able to do.
    private bool GoogleEnabled => !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientId"])
        && !string.IsNullOrWhiteSpace(Configuration["Authentication:Google:ClientSecret"]);

    private string GoogleLoginLink => Navigation.GetUriWithQueryParameters(
        "/authentication/google-login", new Dictionary<string, object?> { ["returnUrl"] = ReturnUrl });

    private bool MicrosoftEnabled => !string.IsNullOrWhiteSpace(Configuration["Authentication:Microsoft:ClientId"])
        && !string.IsNullOrWhiteSpace(Configuration["Authentication:Microsoft:ClientSecret"]);

    private string MicrosoftLoginLink => Navigation.GetUriWithQueryParameters(
        "/authentication/microsoft-login", new Dictionary<string, object?> { ["returnUrl"] = ReturnUrl });

    private string ResendConfirmationLink => Navigation.GetUriWithQueryParameters(
        "/Account/ResendConfirmation",
        new Dictionary<string, object?> { ["email"] = Email, ["returnUrl"] = ReturnUrl });

    private int _recentFailures;

    private string? RecaptchaSiteKey => Configuration["Recaptcha:SiteKey"];

    // Only the first few attempts from an IP go through with no challenge at all — see
    // Constants.Recaptcha. AuthenticationEndpoints.LoginAsync re-checks this itself server-side
    // before trusting anything this page decided to render.
    private bool RequireCaptcha => _recentFailures >= Constants.Recaptcha.AttemptThreshold
        && !string.IsNullOrWhiteSpace(RecaptchaSiteKey);

    protected override async Task OnInitializedAsync()
    {
        var remoteIp = HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString();
        if (!string.IsNullOrWhiteSpace(remoteIp))
        {
            _recentFailures = await LoginAuditService.CountRecentFailuresAsync(remoteIp, Constants.Recaptcha.Window);
        }
    }

    protected override void OnParametersSet()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (!string.IsNullOrWhiteSpace(Email))
            Input.Email = Email;

        if (string.Equals(Registered, "1", StringComparison.Ordinal)
            || string.Equals(Reset, "1", StringComparison.Ordinal)
            || string.Equals(Confirmed, "1", StringComparison.Ordinal))
        {
            SuccessMessage = string.Equals(Registered, "1", StringComparison.Ordinal)
                ? Localizer["Account_SignIn_SuccessRegistered"]
                : string.Equals(Confirmed, "1", StringComparison.Ordinal)
                    ? Localizer["Account_SignIn_SuccessEmailConfirmed"]
                    : Localizer["Account_SignIn_SuccessPasswordReset"];
        }

        if (string.Equals(Error, "locked", StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage = Localizer["Account_SignIn_ErrorAccountLocked"];
        }
        else if (string.Equals(Error, "external", StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage = Localizer["Account_SignIn_ErrorExternalLogin"];
        }
        else if (string.Equals(Error, "captcha", StringComparison.OrdinalIgnoreCase))
        {
            ErrorMessage = Localizer["Account_SignIn_ErrorCaptcha"];
        }
        else if (ShowResendLink)
        {
            ErrorMessage = Localizer["Account_SignIn_ErrorEmailNotConfirmed"];
        }
        else if (!string.IsNullOrWhiteSpace(Error))
        {
            ErrorMessage = Localizer["Account_SignIn_ErrorInvalidCredentials"];
        }
    }

    private sealed class InputModel
    {
        public string? Email { get; set; }
        public string? Password { get; set; }
    }
}
