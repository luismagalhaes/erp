    private void OnWarehouseStreetSelectedAsync(string address) => _warehouseAddress = address;

    /// <summary>Opens the dialog on an existing warehouse, or empty for a new one.</summary>
    private void OpenWarehouse(Warehouse? warehouse)
    {
        _warehouseId = warehouse?.Id;
        _warehouseCode = warehouse?.Code ?? string.Empty;
        _warehouseName = warehouse?.Name ?? string.Empty;
        _warehouseAddress = warehouse?.Address ?? string.Empty;
        _warehouseCity = warehouse?.City ?? string.Empty;
        _warehousePostalCode = warehouse?.PostalCode ?? string.Empty;
        _warehouseCountry = string.IsNullOrWhiteSpace(warehouse?.Country) ? "PT" : warehouse.Country;
        _warehouseIsDefault = warehouse?.IsDefault ?? _warehouses.Count == 0;
        _warehouseIsActive = warehouse?.IsActive ?? true;
        _warehouseOpen = true;
    }

    private async Task SaveWarehouseAsync()
    {
        _working = true;
        _error = null;

        try
        {
            var address = Trimmed(_warehouseAddress);
            var city = Trimmed(_warehouseCity);
            var postalCode = Trimmed(_warehousePostalCode);
            var country = string.IsNullOrWhiteSpace(_warehouseCountry) ? "PT" : _warehouseCountry.Trim();

            var error = _warehouseId is { } id
                ? await StockApi.UpdateWarehouseAsync(id, new UpdateWarehouseRequest(
                    _warehouseName.Trim(), address, city, postalCode, country,
                    _warehouseIsDefault, _warehouseIsActive))
                : await StockApi.CreateWarehouseAsync(new CreateWarehouseRequest(
                    Id!.Value, _warehouseCode.Trim(), _warehouseName.Trim(), address, city, postalCode,
                    country, _warehouseIsDefault));

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(string.Format(Localizer["CompanyEditor_WarehouseSaved"], _warehouseCode), Severity.Success);
            _warehouseOpen = false;
            await LoadWarehousesAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CompanyEditor_SaveWarehouseError"], ex.Message);
        }
        finally
        {
            _working = false;
        }
    }

    private static string? Trimmed(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string DescribeCity(Warehouse warehouse) =>
        string.Join(" ", new[] { warehouse.PostalCode, warehouse.City }
            .Where(part => !string.IsNullOrWhiteSpace(part)));

    private string DescribeUser(string userId) =>
        _users.FirstOrDefault(user => user.Id == userId) is { FullName: { Length: > 0 } fullName }
            ? fullName
            : DescribeEmail(userId);

    private string DescribeEmail(string userId) =>
        _users.FirstOrDefault(user => user.Id == userId)?.Email ?? userId;

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            if (IsNew)
            {
                var request = new CreateCompanyRequest(
                    _name.Trim(), _taxId.Trim(), Normalize(_legalName), Normalize(_email), Normalize(_phone),
                    Normalize(_address), Normalize(_city), Normalize(_postalCode), NormalizeCountry(_country));

                var (created, error) = await CoreApi.CreateCompanyAsync(request);

                if (error is not null)
                {
                    _error = error;
                    return;
                }

                await Company.RefreshAsync();
                Snackbar.Add(Localizer["CompanyEditor_Created"].Value, Severity.Success);

                // Straight into the users tab of the company that was just created.
                Navigation.NavigateTo($"companies/{created!.Id}");
                return;
            }

            var updateRequest = new UpdateCompanyRequest(
                _name.Trim(), _taxId.Trim(), Normalize(_legalName), Normalize(_email), Normalize(_phone), _isActive,
                Normalize(_address), Normalize(_city), Normalize(_postalCode), NormalizeCountry(_country));

            var (_, updateError) = await CoreApi.UpdateCompanyAsync(Id!.Value, updateRequest);

            if (updateError is not null)
            {
                _error = updateError;
                return;
            }

            await Company.RefreshAsync();
            Snackbar.Add(Localizer["CompanyEditor_Updated"].Value, Severity.Success);
            Navigation.NavigateTo("companies");
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["CompanyEditor_SaveError"], ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AssignAsync()
    {
