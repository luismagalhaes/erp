@page "/Backoffice/Roles"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using IdentityResourcesType = Erp.Identity.Resources.IdentityResources
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IRoleService RoleService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<IdentityResourcesType> Localizer

<PageTitle>@Localizer["Backoffice_Roles_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Backoffice_Roles_PageTitle"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Navigation.NavigateTo("/Backoffice/Roles/new"))">
                @Localizer["Backoffice_Roles_CreateAction"]
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="RoleListItem" Items="@_roles" Loading="@_loading"
              SearchFields="@_searchFields"
              SearchPlaceholder="@Localizer["Backoffice_Common_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.Security"
              EmptyTitle="@Localizer["Backoffice_Common_NoRecords"]"
              ItemsLabel="@Localizer["Backoffice_Roles_ItemsLabel"]"
              OnRefresh="LoadAsync">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="@Localizer["Backoffice_Common_NameColumn"]" />
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true" CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                     OnClick="@(() => Navigation.NavigateTo($"/Backoffice/Roles/{Uri.EscapeDataString(context.Item.Name)}"))">
                            @Localizer["Backoffice_Common_EditAction"]
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                     OnClick="@(() => DeleteAsync(context.Item.Name))">
                            @Localizer["Backoffice_Common_DeleteAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly Func<RoleListItem, string?>[] _searchFields = [x => x.Name];

    private List<RoleListItem> _roles = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _roles = (await RoleService.GetRolesAsync()).ToList();
        _loading = false;
    }

    private async Task DeleteAsync(string roleName)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Localizer["Backoffice_Roles_DeleteHeading"].Value,
            string.Format(Localizer["Backoffice_Common_DeleteConfirm"], roleName),
            yesText: Localizer["Backoffice_Common_DeleteButton"].Value,
            cancelText: Localizer["Backoffice_Common_CancelButton"].Value);

        if (confirmed != true)
            return;

        await RoleService.DeleteRoleAsync(roleName);
        Snackbar.Add(Localizer["Backoffice_Roles_Deleted"].Value, Severity.Success);
        await LoadAsync();
    }
}
