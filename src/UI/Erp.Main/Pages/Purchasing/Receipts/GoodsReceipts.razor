@page "/goods-receipts"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@inject PurchasingApiClient Purchasing
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Receções de mercadoria</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="Receções">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.MoveToInbox"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("goods-receipts/new"))">
                Receber mercadoria
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="GoodsReceiptListItem"
              LoadAsync="@((companyId, query, ct) => Purchasing.QueryReceiptsAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="ReceiptDate desc,Number desc"
              SearchPlaceholder="Procurar número, fornecedor ou guia"
              EmptyIcon="@Icons.Material.Filled.MoveToInbox"
              EmptyTitle="Sem receções para mostrar"
              EmptyDescription="Ajuste os filtros ou registe a primeira receção."
              ItemsLabel="receções"
              LoadErrorMessage="Não foi possível carregar as receções">
        <Columns>
            <PropertyColumn Property="x => x.Number" Title="Número" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.ReceiptDate" Title="Data" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.SupplierName" Title="Fornecedor" />
            <PropertyColumn Property="x => x.SupplierDocumentNumber" Title="Documento do fornecedor">
                <CellTemplate>
                    @(string.IsNullOrWhiteSpace(context.Item.SupplierDocumentNumber)
                        ? "—"
                        : context.Item.SupplierDocumentNumber)
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.LineCount" Title="Linhas"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.TotalCost" Title="Custo" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.Status" Title="Estado">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsVoided ? Color.Error : Color.Success)">
                        @(context.Item.IsVoided ? "Anulada" : "Recebida")
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"goods-receipts/{context.Item.Id}"))">
                            Abrir receção
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["Number", "SupplierName", "SupplierDocumentNumber"];
}
