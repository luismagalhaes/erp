@page "/stock-movements"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@using Microsoft.Extensions.Localization
@using Erp.Main.Resources
@inject SalesApiClient SalesApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["StockMovements_Title"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@L["StockMovements_Title"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("stock-movements/new"))">
                @L["StockMovements_NewButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="StockMovementListItem"
              LoadAsync="@((companyId, query, ct) => SalesApi.QueryStockMovementsAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="MovementDate desc,DocumentNumber desc"
              SearchPlaceholder="@L["StockMovements_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.LocalShipping"
              EmptyTitle="@L["StockMovements_EmptyTitle"]"
              EmptyDescription="@L["StockMovements_EmptyDescription"]"
              ItemsLabel="@L["StockMovements_ItemsLabel"]"
              LoadErrorMessage="@L["StockMovements_LoadError"]">
        <Columns>
            <PropertyColumn Property="x => x.DocumentNumber" Title="@L["StockMovements_DocumentColumn"]" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.MovementType" Title="@L["StockMovements_TypeColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.Item.MovementType</MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Atcud" Title="@L["StockMovements_AtcudColumn"]" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.MovementDate" Title="@L["StockMovements_DateColumn"]" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.PartyName" Title="@L["StockMovements_RecipientColumn"]" />
            <PropertyColumn Property="x => x.PartyTaxId" Title="@L["StockMovements_TaxIdColumn"]" />
            <PropertyColumn Property="x => x.MovementStartAtUtc" Title="@L["StockMovements_TransportStartColumn"]" Format="yyyy-MM-dd HH:mm" />
            <PropertyColumn Property="x => x.TotalQuantity" Title="@L["StockMovements_QuantityColumn"]" Format="N3"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.AtDocCodeId" Title="@L["StockMovements_CommunicationColumn"]">
                <CellTemplate>
                    @if (string.IsNullOrWhiteSpace(context.Item.AtDocCodeId))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">
                            @L["StockMovements_ToCommunicate"]
                        </MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="erp-mono">@context.Item.AtDocCodeId</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Status" Title="@L["StockMovements_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.Status == "A" ? Color.Error : Color.Success)">
                        @(context.Item.Status == "A" ? L["StockMovements_StatusVoided"] : L["StockMovements_StatusNormal"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"stock-movements/{context.Item.Id}"))">
                            @L["StockMovements_ViewAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["DocumentNumber", "PartyName", "PartyTaxId"];
}
