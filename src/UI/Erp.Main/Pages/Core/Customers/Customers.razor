@page "/customers"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@Localizer["Customers_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Customers_PageTitle"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("customers/new"))">
                @Localizer["Customers_NewButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="Partner"
              LoadAsync="@((companyId, query, ct) => Catalog.QueryCustomersAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="Code"
              SearchPlaceholder="@Localizer["Customers_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.People"
              EmptyTitle="@Localizer["Customers_EmptyTitle"]"
              EmptyDescription="@Localizer["Customers_EmptyDescription"]"
              ItemsLabel="@Localizer["Customers_ItemsLabel"]"
              LoadErrorMessage="@Localizer["Customers_LoadError"]">
        <Columns>
            <PropertyColumn Property="x => x.Code" Title="@Localizer["Customers_CodeColumn"]" />
            <PropertyColumn Property="x => x.Name" Title="@Localizer["Customers_NameColumn"]" />
            <PropertyColumn Property="x => x.TaxId" Title="@Localizer["Customers_TaxIdColumn"]" />
            <PropertyColumn Property="x => x.City" Title="@Localizer["Customers_CityColumn"]" />
            <PropertyColumn Property="x => x.PostalCode" Title="@Localizer["Customers_PostalCodeColumn"]" Hidden="true" />
            <PropertyColumn Property="x => x.Country" Title="@Localizer["Customers_CountryColumn"]" Hidden="true" />
            <PropertyColumn Property="x => x.Email" Title="@Localizer["Customers_EmailColumn"]" />
            <PropertyColumn Property="x => x.Phone" Title="@Localizer["Customers_PhoneColumn"]" Hidden="true" />
            <PropertyColumn Property="x => x.IsActive" Title="@Localizer["Customers_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                        @(context.Item.IsActive ? Localizer["Common_Active"] : Localizer["Common_Inactive"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                     OnClick="@(() => Navigation.NavigateTo($"customers/{context.Item.Id}"))">
                            @Localizer["Customers_EditAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    /// <summary>
    /// Maps the toolbar search to the DTO members the API exposes, so a renamed column never
    /// produces an invalid $filter.
    /// </summary>
    private static readonly string[] SearchFields = ["Code", "Name", "TaxId"];
}
