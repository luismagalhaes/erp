@page "/Backoffice/Users"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using IdentityResourcesType = Erp.Identity.Resources.IdentityResources
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IUserService UserService
@inject NavigationManager Navigation
@inject IStringLocalizer<IdentityResourcesType> Localizer

<PageTitle>@Localizer["Backoffice_Users_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Backoffice_Users_PageTitle"]" />

    <DataGrid T="UserListItem" Items="@_users" Loading="@_loading"
              SearchFields="@_searchFields"
              SearchPlaceholder="@Localizer["Backoffice_Common_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.People"
              EmptyTitle="@Localizer["Backoffice_Common_NoRecords"]"
              ItemsLabel="@Localizer["Backoffice_Users_ItemsLabel"]"
              OnRefresh="LoadAsync">
        <Columns>
            <PropertyColumn Property="x => x.Email" Title="@Localizer["Backoffice_Users_EmailColumn"]" />
            <PropertyColumn Property="x => x.FullName" Title="@Localizer["Backoffice_Users_NameColumn"]" />
            <PropertyColumn Property="x => x.IsActive" Title="@Localizer["Backoffice_Users_ActiveColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                        @(context.Item.IsActive ? Localizer["Backoffice_Users_Yes"] : Localizer["Backoffice_Users_No"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.EmailConfirmed" Title="@Localizer["Backoffice_Users_EmailConfirmedColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.EmailConfirmed ? Color.Success : Color.Warning)">
                        @(context.Item.EmailConfirmed ? Localizer["Backoffice_Users_Yes"] : Localizer["Backoffice_Users_No"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.CreatedAt" Title="@Localizer["Backoffice_Users_CreatedAtColumn"]">
                <CellTemplate>
                    @context.Item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Roles" Title="@Localizer["Backoffice_Users_RolesLabel"]" Sortable="false" Filterable="false">
                <CellTemplate>
                    @if (context.Item.Roles.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                    }
                    else
                    {
                        @foreach (var role in context.Item.Roles)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">@role</MudChip>
                        }
                    }
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true" CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                     OnClick="@(() => Navigation.NavigateTo($"/Backoffice/Users/{Uri.EscapeDataString(context.Item.Id)}"))">
                            @Localizer["Backoffice_Users_EditAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly Func<UserListItem, string?>[] _searchFields = [x => x.Email, x => x.FullName];

    private List<UserListItem> _users = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _users = (await UserService.GetUsersAsync()).ToList();
        _loading = false;
    }
}
