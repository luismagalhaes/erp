@page "/warehouses/new"
@page "/warehouses/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject StockApiClient StockApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(IsNew ? "Novo armazém" : "Editar armazém")</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">@(IsNew ? "Novo armazém" : "Editar armazém")</MudText>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("warehouses"))">
            Voltar
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (!Company.HasCompany)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            Escolha uma empresa no cabeçalho antes de criar armazéns.
        </MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_code" @bind-Value:after="StateHasChanged" Immediate="true"
                                  Label="Código" Variant="Variant.Outlined" Required="true"
                                  Disabled="@(!IsNew)"
                                  HelperText="@(IsNew ? "Único na empresa" : "O código não pode ser alterado")" />
                </MudItem>
                <MudItem xs="12" md="9">
                    <MudTextField @bind-Value="_name" @bind-Value:after="StateHasChanged" Immediate="true"
                                  Label="Nome" Variant="Variant.Outlined" Required="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_address" Label="Morada" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudTextField @bind-Value="_postalCode" Label="Código postal" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudTextField @bind-Value="_city" Label="Localidade" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudTextField @bind-Value="_country" Label="País" Variant="Variant.Outlined"
                                  HelperText="Código de 2 letras" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSwitch @bind-Value="_isDefault" Color="Color.Primary"
                               Label="Armazém predefinido" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        É o que os documentos assumem quando não indicam outro. Só pode haver um por empresa.
                    </MudText>
                </MudItem>

                @if (!IsNew)
                {
                    <MudItem xs="12" md="6">
                        <MudSwitch @bind-Value="_isActive" Color="Color.Primary" Label="Armazém ativo" />
                    </MudItem>
                }
            </MudGrid>

            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_saving || !CanSave)"
                           OnClick="SaveAsync">
                    Guardar
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNew => Id is null;

    private bool _loading;
    private bool _saving;
    private string? _error;
    private bool _loaded;
    private Guid? _loadedId;

    private string _code = string.Empty;
    private string _name = string.Empty;
    private string _address = string.Empty;
    private string _city = string.Empty;
    private string _postalCode = string.Empty;
    private string _country = "PT";
    private bool _isDefault;
    private bool _isActive = true;

    private bool CanSave =>
        Company.HasCompany
        && !string.IsNullOrWhiteSpace(_code)
        && !string.IsNullOrWhiteSpace(_name);

    protected override async Task OnParametersSetAsync()
    {
        await Company.EnsureLoadedAsync();

        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loaded && _loadedId == Id)
            return;

        _loaded = true;
        _loadedId = Id;

        if (IsNew)
            return;

        _loading = true;

        try
        {
            var warehouse = await StockApi.GetWarehouseAsync(Id!.Value);

            if (warehouse is null)
            {
                _error = "Armazém não encontrado.";
                return;
            }

            _code = warehouse.Code;
            _name = warehouse.Name;
            _address = warehouse.Address ?? string.Empty;
            _city = warehouse.City ?? string.Empty;
            _postalCode = warehouse.PostalCode ?? string.Empty;
            _country = warehouse.Country;
            _isDefault = warehouse.IsDefault;
            _isActive = warehouse.IsActive;
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar o armazém: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var error = IsNew
                ? await StockApi.CreateWarehouseAsync(new CreateWarehouseRequest(
                    Company.SelectedCompanyId,
                    _code.Trim(),
                    _name.Trim(),
                    Normalize(_address),
                    Normalize(_city),
                    Normalize(_postalCode),
                    NormalizeCountry(_country),
                    _isDefault))
                : await StockApi.UpdateWarehouseAsync(Id!.Value, new UpdateWarehouseRequest(
                    _name.Trim(),
                    Normalize(_address),
                    Normalize(_city),
                    Normalize(_postalCode),
                    NormalizeCountry(_country),
                    _isDefault,
                    _isActive));

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(IsNew ? "Armazém criado." : "Armazém atualizado.", Severity.Success);
            Navigation.NavigateTo("warehouses");
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível guardar o armazém: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? Normalize(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string NormalizeCountry(string value) =>
        string.IsNullOrWhiteSpace(value) ? "PT" : value.Trim().ToUpperInvariant();
}
