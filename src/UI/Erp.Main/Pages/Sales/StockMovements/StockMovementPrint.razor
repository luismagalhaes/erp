@page "/stock-movements/{Id:guid}/print"
@attribute [Authorize]
@layout PrintLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Printing
@using Erp.Main.Layout
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject SalesApiClient SalesApi
@inject CoreApiClient CoreApi
@inject CompanyState Company
@inject IStringLocalizer<MainResources> L

<PageTitle>@(_movement?.DocumentNumber ?? L["StockMovementPrint_DefaultTitle"])</PageTitle>

<PrintToolbar Copy="_copy" CopyChanged="@(copy => _copy = copy)" BackUrl="@($"stock-movements/{Id}")" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_movement is null)
{
    <MudAlert Severity="Severity.Error">@(_error ?? L["StockMovementPrint_MovementNotFound"])</MudAlert>
}
else
{
    <PrintDocumentHeader Company="_company"
                         Designation="@MovementTypes.Describe(_movement.MovementType)"
                         DocumentNumber="@_movement.DocumentNumber"
                         DocumentDate="_movement.MovementDate"
                         Copy="@_copy" />

    @if (_movement.Status == "A")
    {
        <div class="print-voided">@L["StockMovementPrint_VoidedNotice"]</div>
    }
    else if (string.IsNullOrWhiteSpace(_movement.AtDocCodeId))
    {
        <div class="print-voided">@L["StockMovementPrint_ToCommunicateNotice"]</div>
    }

    <div class="print-parties">
        <div class="print-box">
            <div class="label">@(_movement.PartyIsSupplier ? L["StockMovementPrint_SupplierLabel"] : L["StockMovementPrint_CustomerLabel"])</div>
            <div><strong>@_movement.PartyName</strong></div>
            <div>@string.Format(L["StockMovementPrint_TaxIdPrefix"], _movement.PartyTaxId)</div>
        </div>

        <div class="print-box">
            <div class="label">@L["StockMovementPrint_LoadLocationLabel"]</div>
            <div>@_movement.ShipFrom.Address</div>
            <div>@FormatCity(_movement.ShipFrom)</div>
        </div>

        <div class="print-box">
            <div class="label">@L["StockMovementPrint_UnloadLocationLabel"]</div>
            <div>@_movement.ShipTo.Address</div>
            <div>@FormatCity(_movement.ShipTo)</div>
        </div>
    </div>

    <div class="print-parties">
        <div class="print-box">
            <div class="label">@L["StockMovementPrint_TransportStartLabel"]</div>
            <div>@_movement.MovementStartAtUtc.ToString("yyyy-MM-dd HH:mm")</div>
        </div>
        <div class="print-box">
            <div class="label">@L["StockMovementPrint_VehiclePlateLabel"]</div>
            <div>@(_movement.VehiclePlate ?? "—")</div>
        </div>
        <div class="print-box">
            <div class="label">@L["StockMovementPrint_AtCodeLabel"]</div>
            <div>@(_movement.AtDocCodeId ?? "—")</div>
        </div>
    </div>

    <table class="print-table">
        <thead>
            <tr>
                <th style="width: 24px;">@L["StockMovementPrint_NumberColumn"]</th>
                <th style="width: 70px;">@L["StockMovementPrint_CodeColumn"]</th>
                <th>@L["StockMovementPrint_DescriptionColumn"]</th>
                <th class="num" style="width: 60px;">@L["StockMovementPrint_QuantityColumn"]</th>
                <th style="width: 34px;">@L["StockMovementPrint_UnitColumn"]</th>
                <th class="num" style="width: 70px;">@L["StockMovementPrint_PriceColumn"]</th>
                <th class="num" style="width: 76px;">@L["StockMovementPrint_ValueColumn"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in _movement.Lines)
            {
                <tr>
                    <td>@line.LineNumber</td>
                    <td>@line.ProductCode</td>
                    <td>@line.ProductDescription</td>
                    <td class="num">@line.Quantity.ToString("N2")</td>
                    <td>@line.UnitOfMeasure</td>
                    <td class="num">@line.UnitPrice.ToString("N2")</td>
                    <td class="num">@line.LineAmount.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="print-summary">
        <div></div>
        <div class="print-totals">
            <div class="row"><span>@L["StockMovementPrint_TotalQuantityLabel"]</span><span>@_movement.TotalQuantity.ToString("N2")</span></div>
            <div class="row"><span>@L["StockMovementPrint_NetTotalLabel"]</span><span>@_movement.NetTotal.ToString("N2")</span></div>
            <div class="row"><span>@L["StockMovementPrint_TaxLabel"]</span><span>@_movement.TaxPayable.ToString("N2")</span></div>
            <div class="row grand"><span>@L["StockMovementPrint_TotalLabel"]</span><span>@_movement.GrossTotal.ToString("N2") EUR</span></div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_movement.Comments))
    {
        <div class="print-exemptions">@string.Format(L["StockMovementPrint_NotesPrefix"], _movement.Comments)</div>
    }

    <PrintFiscalFooter PrintableHash="@_movement.PrintableHash"
                       Atcud="@_movement.Atcud"
                       QrCodePayload="@_movement.QrCodePayload">
        <div>@string.Format(L["StockMovementPrint_IssuedOn"], _movement.SystemEntryDateUtc.ToString("yyyy-MM-dd HH:mm:ss"))</div>
    </PrintFiscalFooter>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private string? _error;
    private string _copy = "Original";
    private Guid? _loadedId;

    private StockMovementDetail? _movement;
    private CompanyDetail? _company;

    protected override async Task OnParametersSetAsync()
    {
        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loadedId == Id)
            return;

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            await Company.EnsureLoadedAsync();

            _movement = await SalesApi.GetStockMovementAsync(Id);

            if (_movement is null)
            {
                _error = L["StockMovementPrint_MovementNotFound"];
                return;
            }

            if (Company.HasCompany)
                _company = await CoreApi.GetCompanyAsync(Company.SelectedCompanyId);
        }
        catch (Exception ex)
        {
            _error = string.Format(L["StockMovementPrint_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatCity(MovementLocation location) =>
        string.Join(" ", new[] { location.PostalCode, location.City }.Where(part => !string.IsNullOrWhiteSpace(part)));
}
