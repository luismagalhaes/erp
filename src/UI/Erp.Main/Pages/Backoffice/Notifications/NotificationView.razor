@page "/notifications/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject NotificationApiClient NotificationApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(_notification?.Subject ?? "Notificação")</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(_notification?.Subject ?? "Notificação")</MudText>
            @if (_notification is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Para @_notification.ToEmail</MudText>
            }
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("notifications"))">
            Voltar
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_notification is not null)
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Estado</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@StatusColor(_notification.Status)">
                        @DescribeStatus(_notification.Status)
                    </MudChip>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Tentativas</MudText>
                    <MudText>@_notification.RetryCount</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Criado</MudText>
                    <MudText>@_notification.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Processado</MudText>
                    <MudText>@(_notification.ProcessedAtUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</MudText>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrWhiteSpace(_notification.LastError))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">
                    <strong>Último erro:</strong> @_notification.LastError
                </MudAlert>
            }
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">Corpo da mensagem</MudText>
                @if (_notification.Status == "Failed")
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Replay"
                               Disabled="_requeuing"
                               OnClick="RequeueAsync">
                        Voltar a enfileirar
                    </MudButton>
                }
            </MudStack>

            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                @((MarkupString)_notification.HtmlBody)
            </MudPaper>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private bool _requeuing;
    private string? _error;

    private Guid? _loadedId;
    private NotificationDetail? _notification;

    protected override async Task OnParametersSetAsync()
    {
        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loadedId == Id)
            return;

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _notification = await NotificationApi.GetNotificationAsync(Id);
            if (_notification is null)
                _error = "Notificação não encontrada.";
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar a notificação: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RequeueAsync()
    {
        _requeuing = true;
        _error = null;

        try
        {
            var error = await NotificationApi.RequeueAsync(Id);

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add("Notificação novamente na fila.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível voltar a enfileirar: {ex.Message}";
        }
        finally
        {
            _requeuing = false;
        }
    }

    private static string DescribeStatus(string status) => status switch
    {
        "Pending" => "Pendente",
        "Sent" => "Enviado",
        "Failed" => "Falhado",
        _ => status
    };

    private static Color StatusColor(string status) => status switch
    {
        "Sent" => Color.Success,
        "Failed" => Color.Error,
        _ => Color.Warning
    };
}
