@page "/supplier-invoices/new"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject PurchasingApiClient Purchasing
@inject CatalogApiClient Catalog
@inject StockApiClient StockApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Registar fatura de fornecedor</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Registar fatura de fornecedor</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Escriture o documento tal como veio. O número e a data são dele; nós não emitimos nada.
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("supplier-invoices"))">
            Voltar
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (!Company.HasCompany)
    {
        <MudAlert Severity="Severity.Info">Escolha uma empresa no cabeçalho.</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">O documento dele</MudText>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudSelect T="Guid?" Value="_supplierId" ValueChanged="OnSupplierChangedAsync"
                               Label="Fornecedor" Variant="Variant.Outlined" Required="true">
                        @foreach (var supplier in _suppliers)
                        {
                            <MudSelectItem T="Guid?" Value="@supplier.Id">
                                @supplier.Code — @supplier.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="string" Value="_documentType" ValueChanged="OnDocumentTypeChanged"
                               Label="Tipo" Variant="Variant.Outlined">
                        @foreach (var type in PurchaseDocumentTypes.All)
                        {
                            <MudSelectItem T="string" Value="@type.Code">@type.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_documentNumber" @bind-Value:after="StateHasChanged" Immediate="true"
                                  Label="Número do documento" Variant="Variant.Outlined" Required="true"
                                  HelperText="Como vem no papel" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_atcud" Label="ATCUD do fornecedor" Variant="Variant.Outlined"
                                  HelperText="Se o documento trouxer" />
                </MudItem>

                <MudItem xs="12" md="3">
                    <MudDatePicker @bind-Date="_documentDate" Label="Data do documento"
                                   Variant="Variant.Outlined" DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudDatePicker @bind-Date="_receivedDate" Label="Data de receção"
                                   Variant="Variant.Outlined" DateFormat="yyyy-MM-dd"
                                   HelperText="Quando chegou até nós" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudDatePicker @bind-Date="_dueDate" Label="Vencimento" Variant="Variant.Outlined"
                                   DateFormat="yyyy-MM-dd" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="3" Class="d-flex align-center">
                    <MudSwitch @bind-Value="_reverseCharge" @bind-Value:after="StateHasChanged"
                               Color="Color.Warning" Label="Autoliquidação" />
                </MudItem>

                @if (_reverseCharge)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true">
                            O documento vem sem IVA e somos nós a liquidá-lo e a deduzi-lo — aquisições
                            intracomunitárias e o artigo 2.º n.º 1 j).
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        @if (_supplierId is not null)
        {
            @if (IsCredit)
            {
                <MudAlert Severity="Severity.Info">
                    Uma nota de crédito <strong>nunca dá entrada em stock</strong>. Se houve devolução
                    de mercadoria, foi aí que o stock saiu — aqui acerta-se o dinheiro e o IVA.
                    <MudLink Href="supplier-returns" Class="ml-2">Ver devoluções</MudLink>
                </MudAlert>
            }
            else if (_uninvoiced.Count > 0)
            {
                <MudPaper Elevation="1" Class="pa-4">
                    <MudStack Spacing="0" Class="mb-3">
                        <MudText Typo="Typo.h6">Recebido por faturar</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Estas linhas já deram entrada em stock na receção, por isso a fatura
                            <strong>não volta a movimentar</strong>.
                        </MudText>
                    </MudStack>

                    <MudTable Items="_uninvoiced" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh Style="width: 60px;"></MudTh>
                            <MudTh>Receção</MudTh>
                            <MudTh>Artigo</MudTh>
                            <MudTh Style="text-align: right;">Por faturar</MudTh>
                            <MudTh Style="width: 140px;">A faturar</MudTh>
                            <MudTh Style="width: 140px;">Preço unit.</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudCheckBox T="bool" Value="@IsChosen(context)"
                                             ValueChanged="@(chosen => Toggle(context, chosen))"
                                             Color="Color.Primary" Dense="true" />
                            </MudTd>
                            <MudTd DataLabel="Receção">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2" Style="font-family: monospace;">
                                        @context.ReceiptNumber
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @context.ReceiptDate.ToString("yyyy-MM-dd")
                                    </MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="Artigo">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@context.ProductCode</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @context.ProductDescription
                                    </MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="Por faturar" Style="text-align: right;">
                                @context.PendingQuantity.ToString("N3") @context.UnitOfMeasure
                            </MudTd>
                            <MudTd DataLabel="A faturar">
                                @if (Chosen(context) is { } chosen)
                                {
                                    <MudNumericField T="decimal" Value="chosen.Quantity"
                                                     ValueChanged="@(quantity => SetQuantity(chosen, context, quantity))"
                                                     Margin="Margin.Dense" Min="0"
                                                     Max="@context.PendingQuantity" />
                                }
                            </MudTd>
                            <MudTd DataLabel="Preço unit.">
                                @if (Chosen(context) is { } chosen)
                                {
                                    <MudNumericField @bind-Value="chosen.UnitPrice" @bind-Value:after="StateHasChanged"
                                                     Margin="Margin.Dense" Min="0" Format="N2" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }

            <MudPaper Elevation="1" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">@(IsCredit ? "Linhas" : "Outras linhas")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @if (IsCredit)
                            {
                                <text>O que o fornecedor está a creditar.</text>
                            }
                            else
                            {
                                <text>
                                    Serviços, e mercadoria que veio com a fatura sem receção — essa
                                    <strong>dá entrada em stock aqui</strong>.
                                </text>
                            }
                        </MudText>
                    </MudStack>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">
                        Adicionar linha
                    </MudButton>
                </MudStack>

                @if (_lines.Count > 0)
                {
                    <MudTable Items="_lines" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh Style="width: 190px;">Artigo</MudTh>
                            <MudTh>Descrição</MudTh>
                            <MudTh Style="width: 180px;">Natureza</MudTh>
                            <MudTh Style="width: 100px;">Qtd.</MudTh>
                            <MudTh Style="width: 130px;">Preço unit.</MudTh>
                            <MudTh Style="width: 140px;">IVA</MudTh>
                            <MudTh Style="width: 70px; text-align: right;">Ações</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Artigo">
                                <MudSelect T="Guid?" Value="context.ProductId"
                                           ValueChanged="@(productId => OnProductChanged(context, productId))"
                                           Margin="Margin.Dense" Clearable="true" Placeholder="Livre">
                                    @foreach (var product in _products)
                                    {
                                        <MudSelectItem T="Guid?" Value="@product.Id">
                                            @product.ProductCode — @product.Description
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd DataLabel="Descrição">
                                <MudTextField @bind-Value="context.ProductDescription" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd DataLabel="Natureza">
                                <MudSelect T="string" @bind-Value="context.DeductionNature"
                                           @bind-Value:after="StateHasChanged" Margin="Margin.Dense">
                                    @foreach (var nature in DeductionNatures.All)
                                    {
                                        <MudSelectItem T="string" Value="@nature.Code">@nature.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd DataLabel="Qtd.">
                                <MudNumericField @bind-Value="context.Quantity" @bind-Value:after="StateHasChanged"
                                                 Margin="Margin.Dense" Min="0" />
                            </MudTd>
                            <MudTd DataLabel="Preço unit.">
                                <MudNumericField @bind-Value="context.UnitPrice" @bind-Value:after="StateHasChanged"
                                                 Margin="Margin.Dense" Min="0" Format="N2" />
                            </MudTd>
                            <MudTd DataLabel="IVA">
                                <MudSelect T="string" Value="context.TaxCode"
                                           ValueChanged="@(code => OnTaxCodeChanged(context, code))"
                                           Margin="Margin.Dense">
                                    @foreach (var rate in TaxRates)
                                    {
                                        <MudSelectItem T="string" Value="@rate.Code">@rate.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd DataLabel="Ações" Style="text-align: right;">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error" OnClick="@(() => _lines.Remove(context))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Nenhuma.</MudText>
                }

                @if (NeedsWarehouse)
                {
                    <MudGrid Class="mt-3">
                        <MudItem xs="12" md="4">
                            <MudSelect T="Guid?" @bind-Value="_warehouseId" Label="Armazém"
                                       Variant="Variant.Outlined" Required="true"
                                       HelperText="Onde entram as existências desta fatura">
                                @foreach (var warehouse in _warehouses)
                                {
                                    <MudSelectItem T="Guid?" Value="@warehouse.Id">
                                        @warehouse.Code — @warehouse.Name
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                }
            </MudPaper>

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Row="true" Spacing="6">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Base</MudText>
                        <MudText Typo="Typo.body1">@NetTotal.ToString("N2")</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">IVA</MudText>
                        <MudText Typo="Typo.body1">@TaxTotal.ToString("N2")</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Primary">@GrossTotal.ToString("N2")</MudText>
                    </MudStack>
                </MudStack>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               OnClick="@(() => Navigation.NavigateTo("supplier-invoices"))">
                        Cancelar
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@(_saving || !CanSave)"
                               OnClick="SaveAsync">
                        @(_saving ? "A registar..." : "Registar")
                    </MudButton>
                </MudStack>
            </MudStack>
        }
    }
</MudStack>

@code {
    private static readonly TaxRateOption[] TaxRates =
    [
        new("NOR", 23m, "Normal - 23%"),
        new("INT", 13m, "Intermédia - 13%"),
        new("RED", 6m, "Reduzida - 6%"),
        new("ISE", 0m, "Isento")
    ];

    private bool _saving;
    private string? _error;

    private Guid? _supplierId;
    private Guid? _warehouseId;
    private string _documentType = "FT";
    private string _documentNumber = string.Empty;
    private string _atcud = string.Empty;
    private DateTime? _documentDate = DateTime.Today;
    private DateTime? _receivedDate = DateTime.Today;
    private DateTime? _dueDate;
    private bool _reverseCharge;

    private List<Partner> _suppliers = [];
    private List<Warehouse> _warehouses = [];
    private List<ProductListItem> _products = [];
    private List<UninvoicedReceiptLine> _uninvoiced = [];

    private readonly List<ChosenLine> _chosen = [];
    private readonly List<FreeLine> _lines = [];

    private IEnumerable<FreeLine> ValidLines =>
        _lines.Where(line => line.Quantity > 0 && !string.IsNullOrWhiteSpace(line.ProductCode));

    private bool IsCredit => PurchaseDocumentTypes.IsCredit(_documentType);

    /// <summary>
    /// Goods with no receipt behind them come into stock here, so they need somewhere to go. Never
    /// on a credit note, which moves no stock at all.
    /// </summary>
    private bool NeedsWarehouse =>
        !IsCredit && ValidLines.Any(line => line.DeductionNature == "Inventory");

    private decimal NetTotal =>
        _chosen.Where(line => line.Quantity > 0).Sum(line => Round(line.Quantity * line.UnitPrice))
        + ValidLines.Sum(line => Round(line.Quantity * line.UnitPrice));

    private decimal TaxTotal =>
        _chosen.Where(line => line.Quantity > 0)
            .Sum(line => Round(Round(line.Quantity * line.UnitPrice) * line.TaxPercentage / 100m))
        + ValidLines.Sum(line => Round(Round(line.Quantity * line.UnitPrice) * line.TaxPercentage / 100m));

    private decimal GrossTotal => NetTotal + TaxTotal;

    private bool CanSave =>
        _supplierId is not null
        && !string.IsNullOrWhiteSpace(_documentNumber)
        && (_chosen.Any(line => line.Quantity > 0) || ValidLines.Any())
        && (!NeedsWarehouse || _warehouseId is not null);

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(async () =>
    {
        _supplierId = null;
        _chosen.Clear();
        _lines.Clear();
        _uninvoiced = [];
        await LoadAsync();
    });

    private async Task LoadAsync()
    {
        if (!Company.HasCompany)
        {
            _error = Company.LoadError;
            StateHasChanged();
            return;
        }

        try
        {
            var (suppliers, suppliersError) = await Catalog.GetSuppliersAsync(Company.SelectedCompanyId);
            _suppliers = [.. suppliers.Where(supplier => supplier.IsActive)];

            var (warehouses, warehousesError) = await StockApi.GetWarehousesAsync(Company.SelectedCompanyId);
            _warehouses = [.. warehouses.Where(warehouse => warehouse.IsActive)];

            var (products, productsError) = await Catalog.GetProductsAsync(Company.SelectedCompanyId);
            _products = [.. products.Where(product => product.IsActive)];

            _error = suppliersError ?? warehousesError ?? productsError;

            _warehouseId ??= _warehouses.FirstOrDefault(warehouse => warehouse.IsDefault)?.Id
                             ?? _warehouses.FirstOrDefault()?.Id;
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível preparar o registo: {ex.Message}";
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task OnSupplierChangedAsync(Guid? supplierId)
    {
        _supplierId = supplierId;
        _chosen.Clear();
        _uninvoiced = [];

        if (supplierId is null)
        {
            StateHasChanged();
            return;
        }

        try
        {
            var (pending, error) = await Purchasing.GetUninvoicedReceiptLinesAsync(
                Company.SelectedCompanyId, supplierId);

            _uninvoiced = [.. pending];
            _error = error;
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar o que está por faturar: {ex.Message}";
        }
        finally
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// Switching to a credit note drops anything picked from the receipts: a credit note is not
    /// invoicing what was received, so those lines would mean something else entirely.
    /// </summary>
    private void OnDocumentTypeChanged(string documentType)
    {
        _documentType = documentType;

        if (IsCredit)
            _chosen.Clear();

        StateHasChanged();
    }

    private ChosenLine? Chosen(UninvoicedReceiptLine line) =>
        _chosen.FirstOrDefault(chosen => chosen.ReceiptLineId == line.ReceiptLineId);

    private bool IsChosen(UninvoicedReceiptLine line) => Chosen(line) is not null;

    private void Toggle(UninvoicedReceiptLine line, bool chosen)
    {
        var existing = Chosen(line);

        if (chosen && existing is null)
        {
            _chosen.Add(new ChosenLine
            {
                ReceiptLineId = line.ReceiptLineId,
                ProductCode = line.ProductCode,
                ProductDescription = line.ProductDescription,
                UnitOfMeasure = line.UnitOfMeasure,
                Quantity = line.PendingQuantity,
                UnitPrice = line.UnitCost
            });
        }
        else if (!chosen && existing is not null)
        {
            _chosen.Remove(existing);
        }

        StateHasChanged();
    }

    private void SetQuantity(ChosenLine chosen, UninvoicedReceiptLine line, decimal quantity)
    {
        chosen.Quantity = Math.Clamp(quantity, 0m, line.PendingQuantity);
        StateHasChanged();
    }

    private void AddLine() => _lines.Add(new FreeLine());

    private void OnProductChanged(FreeLine line, Guid? productId)
    {
        line.ProductId = productId;

        var product = _products.FirstOrDefault(x => x.Id == productId);
        if (product is null)
            return;

        line.ProductCode = product.ProductCode;
        line.ProductDescription = product.Description;
        line.UnitOfMeasure = product.UnitOfMeasure;
        line.UnitPrice = product.UnitCost;
        OnTaxCodeChanged(line, product.DefaultTaxCode);
    }

    private void OnTaxCodeChanged(FreeLine line, string taxCode)
    {
        line.TaxCode = taxCode;
        line.TaxPercentage = TaxRates.FirstOrDefault(rate => rate.Code == taxCode)?.Percentage ?? 0m;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var lines = _chosen
                .Where(line => line.Quantity > 0)
                .Select(line => new PurchaseInvoiceLineRequest(
                    line.ProductCode,
                    line.ProductDescription,
                    line.Quantity,
                    line.UnitPrice,
                    line.UnitOfMeasure,
                    "PT",
                    line.TaxCode,
                    line.TaxPercentage,
                    "Inventory",
                    line.ReceiptLineId))
                .Concat(ValidLines.Select(line => new PurchaseInvoiceLineRequest(
                    line.ProductCode.Trim(),
                    string.IsNullOrWhiteSpace(line.ProductDescription)
                        ? line.ProductCode.Trim()
                        : line.ProductDescription.Trim(),
                    line.Quantity,
                    line.UnitPrice,
                    line.UnitOfMeasure,
                    "PT",
                    line.TaxCode,
                    line.TaxPercentage,
                    line.DeductionNature)))
                .ToList();

            var (invoice, error) = await Purchasing.RecordInvoiceAsync(new RecordPurchaseInvoiceRequest(
                Company.SelectedCompanyId,
                _supplierId!.Value,
                _documentType,
                _documentNumber.Trim(),
                DateOnly.FromDateTime(_documentDate ?? DateTime.Today),
                DateOnly.FromDateTime(_receivedDate ?? DateTime.Today),
                lines,
                NeedsWarehouse ? _warehouseId : null,
                string.IsNullOrWhiteSpace(_atcud) ? null : _atcud.Trim(),
                _dueDate is { } due ? DateOnly.FromDateTime(due) : null,
                _reverseCharge));

            if (invoice is null)
            {
                _error = error ?? "Não foi possível registar a fatura.";
                return;
            }

            Snackbar.Add($"Fatura {invoice.SupplierDocumentNumber} registada.", Severity.Success);
            Navigation.NavigateTo($"supplier-invoices/{invoice.Id}");
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível registar a fatura: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private static decimal Round(decimal value) => Math.Round(value, 2, MidpointRounding.AwayFromZero);

    private sealed record TaxRateOption(string Code, decimal Percentage, string Label);

    private sealed class ChosenLine
    {
        public Guid ReceiptLineId { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductDescription { get; set; } = string.Empty;
        public string UnitOfMeasure { get; set; } = "UN";
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public string TaxCode { get; set; } = "NOR";
        public decimal TaxPercentage { get; set; } = 23m;
    }

    private sealed class FreeLine
    {
        public Guid? ProductId { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductDescription { get; set; } = string.Empty;
        public string UnitOfMeasure { get; set; } = "UN";
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public string TaxCode { get; set; } = "NOR";
        public decimal TaxPercentage { get; set; } = 23m;
        public string DeductionNature { get; set; } = "Inventory";
    }

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
