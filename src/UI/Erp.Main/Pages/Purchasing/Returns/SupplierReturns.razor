@page "/supplier-returns"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject PurchasingApiClient Purchasing
@inject CompanyState Company
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["SupplierReturns_Title"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@L["SupplierReturns_Title"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Undo"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("supplier-returns/new"))">
                @L["SupplierReturns_NewButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    <MudAlert Severity="Severity.Info" Dense="true">
        @L["SupplierReturns_InfoAlertPrefix"] <strong>@L["SupplierReturns_InfoAlertMovement"]</strong>. @L["SupplierReturns_InfoAlertMiddle"]
        <strong>@L["SupplierReturns_InfoAlertEmphasis"]</strong> @L["SupplierReturns_InfoAlertSuffix"]
        <MudLink Href="stock-movements/new">@L["SupplierReturns_InfoAlertLink"]</MudLink>.
    </MudAlert>

    <DataGrid T="SupplierReturnListItem"
              LoadAsync="@((companyId, query, ct) => Purchasing.QueryReturnsAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="ReturnDate desc,Number desc"
              SearchPlaceholder="@L["SupplierReturns_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.Undo"
              EmptyTitle="@L["SupplierReturns_EmptyTitle"]"
              EmptyDescription="@L["SupplierReturns_EmptyDescription"]"
              ItemsLabel="@L["SupplierReturns_ItemsLabel"]"
              LoadErrorMessage="@L["SupplierReturns_LoadErrorMessage"]">
        <Columns>
            <PropertyColumn Property="x => x.Number" Title="@L["SupplierReturns_NumberColumn"]" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.ReturnDate" Title="@L["SupplierReturns_DateColumn"]" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.SupplierName" Title="@L["SupplierReturns_SupplierColumn"]" />
            <PropertyColumn Property="x => x.Reason" Title="@L["SupplierReturns_ReasonColumn"]" />
            <PropertyColumn Property="x => x.LineCount" Title="@L["SupplierReturns_LinesColumn"]"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.TotalCost" Title="@L["SupplierReturns_CostColumn"]" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.Status" Title="@L["SupplierReturns_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsVoided ? Color.Error : Color.Success)">
                        @(context.Item.IsVoided ? L["SupplierReturns_StatusVoided"] : L["SupplierReturns_StatusReturned"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"supplier-returns/{context.Item.Id}"))">
                            @L["SupplierReturns_OpenAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["Number", "SupplierName", "Reason"];
}
