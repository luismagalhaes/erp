@page "/Backoffice/Roles"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using IdentityResourcesType = Erp.Identity.Resources.IdentityResources
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IRoleService RoleService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<IdentityResourcesType> Localizer

<PageTitle>@Localizer["Backoffice_Roles_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Backoffice_Roles_PageTitle"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Navigation.NavigateTo("/Backoffice/Roles/new"))">
                @Localizer["Backoffice_Roles_CreateAction"]
            </MudButton>
        </Actions>
    </PageHeader>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="0" Class="erp-card">
            <MudTable Items="@_roles" Hover="true" Striped="true" Dense="true" Class="erp-grid" Elevation="0">
                <HeaderContent>
                    <MudTh>@Localizer["Backoffice_Common_NameColumn"]</MudTh>
                    <MudTh Class="erp-numeric">@Localizer["Backoffice_Common_ActionsColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Localizer["Backoffice_Common_NameColumn"]">@context.Name</MudTd>
                    <MudTd Class="erp-numeric">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       Href="@($"/Backoffice/Roles/{Uri.EscapeDataString(context.Name)}")"
                                       title="@Localizer["Backoffice_Common_EditAction"]" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context.Name))"
                                       title="@Localizer["Backoffice_Common_DeleteAction"]" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</MudStack>

@code {
    private List<RoleListItem> _roles = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _roles = (await RoleService.GetRolesAsync()).ToList();
        _loading = false;
    }

    private async Task DeleteAsync(string roleName)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Localizer["Backoffice_Roles_DeleteHeading"].Value,
            string.Format(Localizer["Backoffice_Common_DeleteConfirm"], roleName),
            yesText: Localizer["Backoffice_Common_DeleteButton"].Value,
            cancelText: Localizer["Backoffice_Common_CancelButton"].Value);

        if (confirmed != true)
            return;

        await RoleService.DeleteRoleAsync(roleName);
        Snackbar.Add(Localizer["Backoffice_Roles_Deleted"].Value, Severity.Success);
        await LoadAsync();
    }
}
