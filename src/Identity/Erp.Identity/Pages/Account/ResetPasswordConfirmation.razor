@page "/Account/ResetPasswordConfirmation"
@layout Layout.AuthLayout
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Erp.Identity.Resources
@attribute [AllowAnonymous]
@inject IStringLocalizer<IdentityResources> Localizer

<PageTitle>@Localizer["Account_ResetPasswordConfirmation_PageTitle"]</PageTitle>

<div class="content-card mud-elevation-1">
    <h2>@Localizer["Account_ResetPasswordConfirmation_Heading"]</h2>
    <p>@Localizer["Account_ResetPasswordConfirmation_Message"]</p>
    <div class="auth-links mt-16">
        <a class="auth-link" href="/Account/SignIn?reset=1">@Localizer["Account_ResetPasswordConfirmation_ContinueLink"]</a>
    </div>
</div>
