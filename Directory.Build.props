<Project>

  <!-- Base version for the app version shown by the "About" button in Erp.Main and Erp.Identity.
       The patch segment here is only what a local build shows: the CI "deploy" job (dotnet-ci.yml)
       overrides it with -p:Version=1.0.<run number> on publish, so a deployed build shows which
       pipeline run produced it. Bump the major/minor here for a real release; keep both in sync
       with the "1.0" hardcoded in the workflow's Publish step. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
