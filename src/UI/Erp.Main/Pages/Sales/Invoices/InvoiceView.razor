@page "/invoices/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject SalesApiClient SalesApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@(_invoice?.DocumentNumber ?? L["InvoiceView_DefaultTitle"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(_invoice?.DocumentNumber ?? L["InvoiceView_DefaultTitle"])</MudText>
            @if (_invoice is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-family: monospace;">
                    @string.Format(L["InvoiceView_AtcudLabel"], _invoice.Atcud)
                </MudText>
            }
        </MudStack>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Print"
                       Disabled="@(_invoice is null)"
                       OnClick="@(() => Navigation.NavigateTo($"invoices/{Id}/print"))">
                @L["InvoiceView_PrintButton"]
            </MudButton>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("invoices"))">
                @L["InvoiceView_BackButton"]
            </MudButton>
        </MudStack>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_invoice is not null)
    {
        @if (_invoice.Status == "A")
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @L["InvoiceView_CancelledNotice"]
            </MudAlert>
        }

        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InvoiceView_CustomerLabel"]</MudText>
                    <MudText>@_invoice.CustomerName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@string.Format(L["InvoiceView_TaxIdLabel"], _invoice.CustomerTaxId)</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InvoiceView_DocumentDateLabel"]</MudText>
                    <MudText>@_invoice.DocumentDate.ToString("yyyy-MM-dd")</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InvoiceView_SystemEntryLabel"]</MudText>
                    <MudText>@_invoice.SystemEntryDateUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InvoiceView_SignatureLabel"]</MudText>
                    <MudText Style="font-family: monospace;">@_invoice.PrintableHash</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["InvoiceView_CertifiedProgramNote"]</MudText>
                </MudItem>

                @if (!string.IsNullOrWhiteSpace(_invoice.RectifiedDocumentNumber))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InvoiceView_RectifiedDocumentLabel"]</MudText>
                        <MudText>
                            <span style="font-family: monospace;">@_invoice.RectifiedDocumentNumber</span>
                            — @_invoice.RectificationReason
                        </MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-2">
            <MudTable Items="_invoice.Lines" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>@L["InvoiceView_LineNumberColumn"]</MudTh>
                    <MudTh>@L["InvoiceView_CodeColumn"]</MudTh>
                    <MudTh>@L["InvoiceView_DescriptionColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["InvoiceView_QuantityColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["InvoiceView_UnitPriceColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["InvoiceView_NetColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["InvoiceView_TaxColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["InvoiceView_TaxAmountColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["InvoiceView_LineNumberColumn"]">@context.LineNumber</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_CodeColumn"]">@context.ProductCode</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_DescriptionColumn"]">@context.ProductDescription</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_QuantityColumn"]" Style="text-align: right;">@context.Quantity.ToString("N3")</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_UnitPriceColumn"]" Style="text-align: right;">@context.UnitPrice.ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_NetColumn"]" Style="text-align: right;">@context.LineAmount.ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_TaxColumn"]" Style="text-align: right;">@context.TaxPercentage.ToString("N0")%</MudTd>
                    <MudTd DataLabel="@L["InvoiceView_TaxAmountColumn"]" Style="text-align: right;">@context.TaxAmount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudStack Row="true" Spacing="4" Justify="Justify.FlexEnd">
            <MudPaper Elevation="1" Class="pa-4" Style="min-width: 280px;">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["InvoiceView_TaxableBaseLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_invoice.NetTotal.ToString("N2")</MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["InvoiceView_TaxLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_invoice.TaxPayable.ToString("N2")</MudText>
                    </MudStack>
                    <MudDivider />
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6">@L["InvoiceView_TotalLabel"]</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Primary">@_invoice.GrossTotal.ToString("N2")</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudStack>

        <MudExpansionPanels Elevation="1">
            <MudExpansionPanel Text="@L["InvoiceView_QrDataTitle"]">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    @L["InvoiceView_QrDataDescription"]
                </MudText>
                <MudPaper Elevation="0" Class="pa-3" Style="overflow-x: auto;">
                    <MudText Style="font-family: monospace; font-size: 0.8rem; white-space: nowrap;">
                        @_invoice.QrCodePayload
                    </MudText>
                </MudPaper>
            </MudExpansionPanel>

            @if (_invoice.Status != "A")
            {
                <MudExpansionPanel Text="@L["InvoiceView_VoidDocumentTitle"]">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @L["InvoiceView_VoidHelpText"]
                    </MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_voidReason" Label="@L["InvoiceView_ReasonLabel"]" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Style="max-width: 480px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Disabled="@(_voiding || string.IsNullOrWhiteSpace(_voidReason))"
                                   OnClick="VoidAsync">
                            @L["InvoiceView_VoidButton"]
                        </MudButton>
                    </MudStack>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private bool _voiding;
    private string? _error;

    private Guid? _loadedId;
    private string _voidReason = string.Empty;
    private InvoiceDetail? _invoice;

    protected override async Task OnParametersSetAsync()
    {
        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loadedId == Id)
            return;

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _invoice = await SalesApi.GetInvoiceAsync(Id);
            if (_invoice is null)
                _error = L["InvoiceView_DocumentNotFound"];
        }
        catch (Exception ex)
        {
            _error = string.Format(L["InvoiceView_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task VoidAsync()
    {
        _voiding = true;
        _error = null;

        try
        {
            var error = await SalesApi.VoidInvoiceAsync(Id, _voidReason.Trim());

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(L["InvoiceView_VoidedSuccess"], Severity.Success);
            _voidReason = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["InvoiceView_VoidError"], ex.Message);
        }
        finally
        {
            _voiding = false;
        }
    }
}
