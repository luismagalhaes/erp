@page "/inventory-file"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject StockApiClient StockApi
@inject CompanyState Company
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["InventoryFileExport_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">@L["InventoryFileExport_PageTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["InventoryFileExport_Subtitle", L["InventoryFileExport_WeightedCostTerm"]]
        </MudText>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (!Company.HasCompany)
    {
        <MudAlert Severity="Severity.Info">@L["InventoryFileExport_ChooseCompanyNotice"]</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudNumericField T="int" Value="_fiscalYear" ValueChanged="OnYearChangedAsync"
                                     Label="@L["InventoryFileExport_PeriodLabel"]" Variant="Variant.Outlined" Min="2000" Max="2100" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker Date="_endDate" DateChanged="OnEndDateChangedAsync"
                                   Label="@L["InventoryFileExport_ReferenceDateLabel"]" Variant="Variant.Outlined"
                                   DateFormat="yyyy-MM-dd"
                                   HelperText="@L["InventoryFileExport_ReferenceDateHelperText"]" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="bool" Value="_valued" ValueChanged="OnValuedChangedAsync"
                               Label="@L["InventoryFileExport_TypeLabel"]" Variant="Variant.Outlined">
                        <MudSelectItem T="bool" Value="true">@L["InventoryFileExport_ValuedOption"]</MudSelectItem>
                        <MudSelectItem T="bool" Value="false">@L["InventoryFileExport_QuantitiesOnlyOption"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="1" Class="d-flex align-center">
                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    }
                </MudItem>

                @if (!_valued && _fiscalYear >= 2021)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            @L["InventoryFileExport_OldFormatWarning", _fiscalYear]
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">@L["InventoryFileExport_FileContentTitle"]</MudText>

            @if (_summary is null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["InventoryFileExport_NoDataNotice"]</MudText>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InventoryFileExport_ProductsLabel"]</MudText>
                        <MudText Typo="Typo.h5">@_summary.LineCount</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["InventoryFileExport_TotalQuantityLabel"]</MudText>
                        <MudText Typo="Typo.h5">@_summary.TotalQuantity.ToString("N3")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["InventoryFileExport_TotalValueLabel"]@(_valued ? string.Empty : L["InventoryFileExport_TotalValueNotInFile"])
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["InventoryFileExport_WeightedCostLabel"]
                        </MudText>
                        <MudText Typo="Typo.h5" Color="@(_valued ? Color.Primary : Color.Secondary)">
                            @_summary.TotalValue.ToString("N2")
                        </MudText>
                    </MudItem>
                    <MudItem xs="6" md="3" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   Disabled="@(_downloading || _summary.LineCount == 0)"
                                   OnClick="DownloadAsync">
                            @(_downloading ? L["InventoryFileExport_Generating"] : L["InventoryFileExport_GenerateButton"])
                        </MudButton>
                    </MudItem>
                </MudGrid>

                @if (_summary.LineCount == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                        @L["InventoryFileExport_NoStockNotice"]
                    </MudAlert>
                }
                else
                {
                    @if (_summary.ValidationErrors > 0)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-3">
                            @L["InventoryFileExport_ValidationErrorsNotice", _summary.ValidationErrors,
                                (_summary.ValidationErrors == 1 ? L["InventoryFileExport_ValidationErrorSingular"] : L["InventoryFileExport_ValidationErrorPlural"])]
                        </MudAlert>
                    }

                    @if (_summary.ProductsWithNegativeStock > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-3">
                            @L["InventoryFileExport_NegativeStockNotice", _summary.ProductsWithNegativeStock,
                                (_summary.ProductsWithNegativeStock == 1 ? L["InventoryFileExport_NegativeStockSingular"] : L["InventoryFileExport_NegativeStockPlural"])]
                            <MudLink Href="stock/check" Class="mr-2">@L["InventoryFileExport_RunStockCheckLink"]</MudLink>
                            <MudLink Href="inventory-counts">@L["InventoryFileExport_DoCountLink"]</MudLink>
                        </MudAlert>
                    }

                    @if (_valued && _summary.ProductsWithoutCost > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-3">
                            @L["InventoryFileExport_WithoutCostNotice", _summary.ProductsWithoutCost, _summary.LineCount,
                                (_summary.ProductsWithoutCost == 1 ? L["InventoryFileExport_WithoutCostSingularVerb"] : L["InventoryFileExport_WithoutCostPluralVerb"])]
                            <MudLink Href="stock" Class="ml-2">@L["InventoryFileExport_ViewStockLink"]</MudLink>
                        </MudAlert>
                    }

                    @if (_valued && _summary.ProductsCostedFromFile > 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-3">
                            @L["InventoryFileExport_CostedFromFileNotice", _summary.ProductsCostedFromFile,
                                (_summary.ProductsCostedFromFile == 1 ? L["InventoryFileExport_CostedFromFileSingularVerb"] : L["InventoryFileExport_CostedFromFilePluralVerb"]),
                                L["InventoryFileExport_FileCostTerm"]]
                        </MudAlert>
                    }
                }
            }
        </MudPaper>

        <MudAlert Severity="Severity.Info">
            @L["InventoryFileExport_ValidationNotice"]
        </MudAlert>
    }
</MudStack>

@code {
    private bool _loading;
    private bool _downloading;
    private string? _error;

    private int _fiscalYear = DateTime.Today.Year - 1;
    private DateTime? _endDate = new DateTime(DateTime.Today.Year - 1, 12, 31);

    /// <summary>The valued file is what the tax authority takes from 2021, so it is the default.</summary>
    private bool _valued = true;

    private InventoryFileSummary? _summary;

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        if (!Company.HasCompany)
        {
            _summary = null;
            _error = Company.LoadError;
            StateHasChanged();
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var (summary, error) = await StockApi.GetInventoryFileSummaryAsync(
                Company.SelectedCompanyId, _fiscalYear, DateOnly.FromDateTime(_endDate!.Value), _valued);

            _summary = summary;
            _error = error;
        }
        catch (Exception ex)
        {
            _error = L["InventoryFileExport_LoadError", ex.Message];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>Changing the period moves the reference date with it, which is what is wanted.</summary>
    private async Task OnYearChangedAsync(int year)
    {
        _fiscalYear = year;
        _endDate = new DateTime(year, 12, 31);
        await LoadAsync();
    }

    private async Task OnEndDateChangedAsync(DateTime? date)
    {
        _endDate = date;

        if (date is { } value)
            _fiscalYear = value.Year;

        await LoadAsync();
    }

    private async Task OnValuedChangedAsync(bool valued)
    {
        _valued = valued;
        await LoadAsync();
    }

    private async Task DownloadAsync()
    {
        _downloading = true;
        _error = null;

        try
        {
            var (file, error) = await StockApi.DownloadInventoryFileAsync(
                Company.SelectedCompanyId, _fiscalYear, DateOnly.FromDateTime(_endDate!.Value), _valued);

            if (file is null)
            {
                _error = error ?? L["InventoryFileExport_GenerateFailed"];
                return;
            }

            await JS.InvokeVoidAsync(
                "erpDownloadFile", file.FileName, "application/xml", Convert.ToBase64String(file.Content));

            // The file is still handed over when it fails the schema — a broken file in hand beats a
            // silent refusal — but the message has to say so.
            if (file.ValidationErrors > 0)
            {
                Snackbar.Add(
                    L["InventoryFileExport_GeneratedWithErrors", file.FileName, file.ValidationErrors].Value,
                    Severity.Error);
            }
            else if (_valued && file.ProductsWithoutCost > 0)
            {
                Snackbar.Add(
                    L["InventoryFileExport_GeneratedWithoutCost", file.FileName, file.ProductsWithoutCost].Value,
                    Severity.Warning);
            }
            else
            {
                Snackbar.Add(L["InventoryFileExport_Generated", file.FileName].Value, Severity.Success);
            }
        }
        catch (Exception ex)
        {
            _error = L["InventoryFileExport_GenerateError", ex.Message];
        }
        finally
        {
            _downloading = false;
        }
    }

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
