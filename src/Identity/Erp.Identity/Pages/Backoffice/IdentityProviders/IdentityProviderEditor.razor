@page "/Backoffice/IdentityProviders/new"
@page "/Backoffice/IdentityProviders/{Scheme}"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using IdentityResourcesType = Erp.Identity.Resources.IdentityResources
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IIdentityProviderService IdentityProviderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<IdentityResourcesType> Localizer

<PageTitle>@(IsNew ? Localizer["Backoffice_IdentityProviders_CreateHeading"] : Localizer["Backoffice_IdentityProviders_EditHeading"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">@(IsNew ? Localizer["Backoffice_IdentityProviders_CreateHeading"] : Localizer["Backoffice_IdentityProviders_EditHeading"])</MudText>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("/Backoffice/IdentityProviders"))">
            @Localizer["Backoffice_Common_Back"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4 erp-form">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_scheme" Label="@Localizer["Backoffice_IdentityProviders_SchemeLabel"]" Variant="Variant.Outlined" Required="true" Disabled="@(!IsNew)" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_displayName" Label="@Localizer["Backoffice_Common_DisplayNameLabel"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_type" Label="@Localizer["Backoffice_IdentityProviders_TypeLabel"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch @bind-Value="_enabled" Color="Color.Primary" Label="@Localizer["Backoffice_Common_EnabledLabel"]" />
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_saving || string.IsNullOrWhiteSpace(_scheme) || string.IsNullOrWhiteSpace(_type))"
                           OnClick="SaveAsync">
                    @Localizer["Backoffice_Common_SaveButton"]
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter] public string? Scheme { get; set; }

    private bool IsNew => string.IsNullOrEmpty(Scheme);

    private bool _loading;
    private bool _saving;
    private string? _error;

    private string _scheme = string.Empty;
    private string? _displayName;
    private string _type = string.Empty;
    private bool _enabled = true;

    protected override async Task OnParametersSetAsync()
    {
        _error = null;

        if (IsNew)
            return;

        _loading = true;

        try
        {
            var item = await IdentityProviderService.GetIdentityProviderAsync(Scheme!);
            if (item is null)
            {
                _error = Localizer["Backoffice_IdentityProviders_ErrorSchemeTypeRequired"];
                return;
            }

            _scheme = item.Scheme;
            _displayName = item.DisplayName;
            _type = item.Type;
            _enabled = item.Enabled;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var request = new IdentityProviderUpsertRequest(
                _scheme.Trim(),
                (_displayName ?? string.Empty).Trim(),
                _type.Trim(),
                _enabled);

            if (IsNew)
            {
                await IdentityProviderService.CreateIdentityProviderAsync(request);
                Snackbar.Add(Localizer["Backoffice_IdentityProviders_Created"].Value, Severity.Success);
            }
            else
            {
                await IdentityProviderService.UpdateIdentityProviderAsync(Scheme!, request);
                Snackbar.Add(Localizer["Backoffice_IdentityProviders_Updated"].Value, Severity.Success);
            }

            Navigation.NavigateTo("/Backoffice/IdentityProviders");
        }
        finally
        {
            _saving = false;
        }
    }
}
