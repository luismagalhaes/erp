@page "/stock-movements/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@using Microsoft.Extensions.Localization
@using Erp.Main.Resources
@inject SalesApiClient SalesApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@(_movement?.DocumentNumber ?? L["StockMovementView_DefaultTitle"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(_movement?.DocumentNumber ?? L["StockMovementView_DefaultTitle"])</MudText>
            @if (_movement is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @MovementTypes.Describe(_movement.MovementType) ·
                    <span style="font-family: monospace;">ATCUD:@_movement.Atcud</span>
                </MudText>
            }
        </MudStack>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Print"
                       Disabled="@(_movement is null)"
                       OnClick="@(() => Navigation.NavigateTo($"stock-movements/{Id}/print"))">
                @L["StockMovementView_PrintButton"]
            </MudButton>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("stock-movements"))">
                @L["StockMovementView_BackButton"]
            </MudButton>
        </MudStack>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_movement is not null)
    {
        @if (_movement.Status == "A")
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @L["StockMovementView_VoidedNotice"]
            </MudAlert>
        }
        else if (string.IsNullOrWhiteSpace(_movement.AtDocCodeId))
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @L["StockMovementView_ToCommunicateNotice"]
            </MudAlert>
        }

        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(_movement.PartyIsSupplier ? L["StockMovementView_SupplierLabel"] : L["StockMovementView_CustomerLabel"])
                    </MudText>
                    <MudText>@_movement.PartyName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["StockMovementView_TaxIdPrefix", _movement.PartyTaxId]</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["StockMovementView_DocumentDateLabel"]</MudText>
                    <MudText>@_movement.MovementDate.ToString("yyyy-MM-dd")</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["StockMovementView_SystemEntryLabel"]</MudText>
                    <MudText>@_movement.SystemEntryDateUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["StockMovementView_SignatureLabel"]</MudText>
                    <MudText Style="font-family: monospace;">@_movement.PrintableHash</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["StockMovementView_CertifiedSoftwareNote"]</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">@L["StockMovementView_TransportTitle"]</MudText>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["StockMovementView_LoadLocationLabel"]</MudText>
                    <MudText>@_movement.ShipFrom.Address</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@FormatCity(_movement.ShipFrom)</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["StockMovementView_UnloadLocationLabel"]</MudText>
                    <MudText>@_movement.ShipTo.Address</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@FormatCity(_movement.ShipTo)</MudText>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["StockMovementView_TransportStartLabel"]</MudText>
                    <MudText>@_movement.MovementStartAtUtc.ToString("yyyy-MM-dd HH:mm")</MudText>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["StockMovementView_VehiclePlateLabel"]</MudText>
                    <MudText>@(_movement.VehiclePlate ?? "—")</MudText>
                </MudItem>

                @if (!string.IsNullOrWhiteSpace(_movement.Comments))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["StockMovementView_NotesLabel"]</MudText>
                        <MudText>@_movement.Comments</MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-2">
            <MudTable Items="_movement.Lines" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>@L["StockMovementView_NumberColumn"]</MudTh>
                    <MudTh>@L["StockMovementView_CodeColumn"]</MudTh>
                    <MudTh>@L["StockMovementView_DescriptionColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["StockMovementView_QuantityColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["StockMovementView_UnitPriceColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["StockMovementView_BaseColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["StockMovementView_TaxColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["StockMovementView_NumberColumn"]">@context.LineNumber</MudTd>
                    <MudTd DataLabel="@L["StockMovementView_CodeColumn"]">@context.ProductCode</MudTd>
                    <MudTd DataLabel="@L["StockMovementView_DescriptionColumn"]">@context.ProductDescription</MudTd>
                    <MudTd DataLabel="@L["StockMovementView_QuantityColumn"]" Style="text-align: right;">@context.Quantity.ToString("N3")</MudTd>
                    <MudTd DataLabel="@L["StockMovementView_UnitPriceColumn"]" Style="text-align: right;">@context.UnitPrice.ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["StockMovementView_BaseColumn"]" Style="text-align: right;">@context.LineAmount.ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["StockMovementView_TaxColumn"]" Style="text-align: right;">@context.TaxAmount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudStack Row="true" Spacing="4" Justify="Justify.FlexEnd">
            <MudPaper Elevation="1" Class="pa-4" Style="min-width: 300px;">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["StockMovementView_TotalQuantityLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_movement.TotalQuantity.ToString("N3")</MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["StockMovementView_NetTotalLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_movement.NetTotal.ToString("N2")</MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["StockMovementView_TaxLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_movement.TaxPayable.ToString("N2")</MudText>
                    </MudStack>
                    <MudDivider />
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6">@L["StockMovementView_TotalLabel"]</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Primary">@_movement.GrossTotal.ToString("N2")</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudStack>

        <MudExpansionPanels Elevation="1">
            <MudExpansionPanel Text="@L["StockMovementView_CommunicationTitle"]" Expanded="@string.IsNullOrWhiteSpace(_movement.AtDocCodeId)">
                @if (string.IsNullOrWhiteSpace(_movement.AtDocCodeId))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @L["StockMovementView_CommunicationHelp"]
                    </MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_atDocCodeId" Label="@L["StockMovementView_AtCodeLabel"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 360px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudDone"
                                   Disabled="@(_working || string.IsNullOrWhiteSpace(_atDocCodeId))"
                                   OnClick="CommunicateAsync">
                            @L["StockMovementView_RegisterCodeButton"]
                        </MudButton>
                    </MudStack>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Dense="true">
                        @L["StockMovementView_CommunicatedNotice", _movement.CommunicatedAtUtc?.ToString("yyyy-MM-dd HH:mm")]
                        <strong>@_movement.AtDocCodeId</strong>.
                    </MudAlert>
                }
            </MudExpansionPanel>

            <MudExpansionPanel Text="@L["StockMovementView_QrDataTitle"]">
                <MudPaper Elevation="0" Class="pa-3" Style="overflow-x: auto;">
                    <MudText Style="font-family: monospace; font-size: 0.8rem; white-space: nowrap;">
                        @_movement.QrCodePayload
                    </MudText>
                </MudPaper>
            </MudExpansionPanel>

            @if (_movement.Status != "A")
            {
                <MudExpansionPanel Text="@L["StockMovementView_VoidMovementTitle"]">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @L["StockMovementView_VoidHelp"]
                    </MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_voidReason" Label="@L["StockMovementView_ReasonLabel"]" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Style="max-width: 480px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Disabled="@(_working || string.IsNullOrWhiteSpace(_voidReason))"
                                   OnClick="VoidAsync">
                            @L["StockMovementView_VoidButton"]
                        </MudButton>
                    </MudStack>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private bool _working;
    private string? _error;
    private string _voidReason = string.Empty;
    private string _atDocCodeId = string.Empty;
    private Guid? _loadedId;

    private StockMovementDetail? _movement;

    protected override async Task OnParametersSetAsync()
    {
        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loadedId == Id)
            return;

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _movement = await SalesApi.GetStockMovementAsync(Id);
            if (_movement is null)
                _error = L["StockMovementView_MovementNotFound"];
        }
        catch (Exception ex)
        {
            _error = L["StockMovementView_LoadError", ex.Message];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CommunicateAsync()
    {
        _working = true;
        _error = null;

        try
        {
            var error = await SalesApi.CommunicateStockMovementAsync(Id, _atDocCodeId.Trim());

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(L["StockMovementView_CommunicateSuccess"], Severity.Success);
            _atDocCodeId = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = L["StockMovementView_CommunicateError", ex.Message];
        }
        finally
        {
            _working = false;
        }
    }

    private async Task VoidAsync()
    {
        _working = true;
        _error = null;

        try
        {
            var error = await SalesApi.VoidStockMovementAsync(Id, _voidReason.Trim());

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(L["StockMovementView_VoidedSuccess"], Severity.Success);
            _voidReason = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = L["StockMovementView_VoidError", ex.Message];
        }
        finally
        {
            _working = false;
        }
    }

    private static string FormatCity(MovementLocation location) =>
        string.Join(" ", new[] { location.PostalCode, location.City }.Where(part => !string.IsNullOrWhiteSpace(part)));
}
