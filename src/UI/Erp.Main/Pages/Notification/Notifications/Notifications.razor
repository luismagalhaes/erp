@page "/notifications"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject NotificationApiClient NotificationApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["Notifications_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@L["Notifications_PageTitle"]">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ReloadAsync">
                @L["Notifications_RefreshButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    @* The email queue is shared by every company, so this listing is not scoped to one of them. *@
    <DataGrid @ref="_grid" T="NotificationListItem" CompanyScoped="false"
              LoadAsync="@((_, query, ct) => NotificationApi.QueryNotificationsAsync(query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="CreatedAtUtc desc"
              SearchPlaceholder="@L["Notifications_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.MarkEmailRead"
              EmptyTitle="@L["Notifications_EmptyTitle"]"
              EmptyDescription="@L["Notifications_EmptyDescription"]"
              ItemsLabel="@L["Notifications_ItemsLabel"]"
              LoadErrorMessage="@L["Notifications_LoadErrorMessage"]">
        <Columns>
            <PropertyColumn Property="x => x.ToEmail" Title="@L["Notifications_RecipientColumn"]" />
            <PropertyColumn Property="x => x.Subject" Title="@L["Notifications_SubjectColumn"]" />
            <PropertyColumn Property="x => x.Status" Title="@L["Notifications_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@StatusColor(context.Item.Status)">
                        @DescribeStatus(context.Item.Status)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.RetryCount" Title="@L["Notifications_RetryCountColumn"]"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.CreatedAtUtc" Title="@L["Notifications_CreatedColumn"]" Format="yyyy-MM-dd HH:mm" />
            <PropertyColumn Property="x => x.ProcessedAtUtc" Title="@L["Notifications_ProcessedColumn"]" Format="yyyy-MM-dd HH:mm" />
            <PropertyColumn Property="x => x.LastError" Title="@L["Notifications_LastErrorColumn"]" Hidden="true" />
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"notifications/{context.Item.Id}"))">
                            @L["Notifications_ViewAction"]
                        </MudMenuItem>
                        @if (context.Item.Status == "Failed")
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Replay"
                                         OnClick="@(() => RequeueAsync(context.Item.Id))">
                                @L["Notifications_RequeueAction"]
                            </MudMenuItem>
                        }
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    /// <summary>
    /// Maps the toolbar search to the DTO members the API exposes, so a renamed column never
    /// produces an invalid $filter.
    /// </summary>
    private static readonly string[] SearchFields = ["ToEmail", "Subject"];

    private DataGrid<NotificationListItem>? _grid;

    private Task ReloadAsync() => _grid?.ReloadAsync() ?? Task.CompletedTask;

    private async Task RequeueAsync(Guid id)
    {
        var error = await NotificationApi.RequeueAsync(id);

        if (error is not null)
        {
            Snackbar.Add(error, Severity.Error);
            return;
        }

        Snackbar.Add(L["Notifications_RequeuedSuccess"].Value, Severity.Success);
        await ReloadAsync();
    }

    private string DescribeStatus(string status) => status switch
    {
        "Pending" => L["Notifications_StatusPending"],
        "Sent" => L["Notifications_StatusSent"],
        "Failed" => L["Notifications_StatusFailed"],
        _ => status
    };

    private static Color StatusColor(string status) => status switch
    {
        "Sent" => Color.Success,
        "Failed" => Color.Error,
        "Pending" => Color.Warning,
        _ => Color.Default
    };
}
