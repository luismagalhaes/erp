@page "/inventory-file"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject StockApiClient StockApi
@inject CompanyState Company
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Comunicação de inventários</PageTitle>

<MudStack Spacing="4">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">Comunicação de inventários</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Ficheiro das existências à data de referência, para comunicar à AT, valorizadas ao
            <strong>custo médio ponderado das compras</strong> à mesma data. Para períodos de 2021 em
            diante o formato é o valorizado (2_01); o anterior, só com quantidades (1_02), fica
            disponível para períodos mais antigos.
        </MudText>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (!Company.HasCompany)
    {
        <MudAlert Severity="Severity.Info">Escolha uma empresa no cabeçalho para gerar o ficheiro.</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudNumericField T="int" Value="_fiscalYear" ValueChanged="OnYearChangedAsync"
                                     Label="Período" Variant="Variant.Outlined" Min="2000" Max="2100" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker Date="_endDate" DateChanged="OnEndDateChangedAsync"
                                   Label="Data de referência" Variant="Variant.Outlined"
                                   DateFormat="yyyy-MM-dd"
                                   HelperText="Último dia do período; as existências são as desse dia" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="bool" Value="_valued" ValueChanged="OnValuedChangedAsync"
                               Label="Tipo de comunicação" Variant="Variant.Outlined">
                        <MudSelectItem T="bool" Value="true">Valorizado (2_01)</MudSelectItem>
                        <MudSelectItem T="bool" Value="false">Só quantidades (1_02)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="1" Class="d-flex align-center">
                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                    }
                </MudItem>

                @if (!_valued && _fiscalYear >= 2021)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            O formato só com quantidades é anterior a 2021. Para o período @_fiscalYear a AT
                            exige a comunicação valorizada.
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Conteúdo do ficheiro</MudText>

            @if (_summary is null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Sem dados para a data escolhida.</MudText>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Artigos</MudText>
                        <MudText Typo="Typo.h5">@_summary.LineCount</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Quantidade total</MudText>
                        <MudText Typo="Typo.h5">@_summary.TotalQuantity.ToString("N3")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Valor total@(_valued ? string.Empty : " (não vai no ficheiro)")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Custo médio ponderado
                        </MudText>
                        <MudText Typo="Typo.h5" Color="@(_valued ? Color.Primary : Color.Secondary)">
                            @_summary.TotalValue.ToString("N2")
                        </MudText>
                    </MudItem>
                    <MudItem xs="6" md="3" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   Disabled="@(_downloading || _summary.LineCount == 0)"
                                   OnClick="DownloadAsync">
                            @(_downloading ? "A gerar..." : "Gerar ficheiro")
                        </MudButton>
                    </MudItem>
                </MudGrid>

                @if (_summary.LineCount == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                        Não havia existências nesta data. A comunicação continua a ser devida — nesse caso
                        é feita como "sem existências" no Portal das Finanças, não por este ficheiro.
                    </MudAlert>
                }
                else
                {
                    @if (_summary.ValidationErrors > 0)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-3">
                            O ficheiro não cumpre o esquema oficial em @_summary.ValidationErrors
                            @(_summary.ValidationErrors == 1 ? "ponto" : "pontos"). Os detalhes ficam no
                            log do servidor — não submeta assim.
                        </MudAlert>
                    }

                    @if (_summary.ProductsWithNegativeStock > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-3">
                            @_summary.ProductsWithNegativeStock
                            @(_summary.ProductsWithNegativeStock == 1 ? "artigo tem" : "artigos têm")
                            existências negativas nesta data. O esquema não aceita quantidades abaixo de
                            zero, por isso o ficheiro não passa enquanto isso não for corrigido — há
                            saídas registadas sem a entrada correspondente.
                            <MudLink Href="stock/check" Class="mr-2">Correr o teste de stocks</MudLink>
                            <MudLink Href="inventory-counts">Fazer uma contagem</MudLink>
                        </MudAlert>
                    }

                    @if (_valued && _summary.ProductsWithoutCost > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-3">
                            @_summary.ProductsWithoutCost de @_summary.LineCount
                            @(_summary.ProductsWithoutCost == 1 ? "artigo vai" : "artigos vão") com valor zero:
                            nem as compras lhes deram um custo, nem a ficha o tem. A comunicação valorizada
                            exige a valorização — registe a compra, declare o custo num acerto de abertura,
                            ou preencha o custo na ficha.
                            <MudLink Href="stock" Class="ml-2">Ver existências</MudLink>
                        </MudAlert>
                    }

                    @if (_valued && _summary.ProductsCostedFromFile > 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-3">
                            @_summary.ProductsCostedFromFile
                            @(_summary.ProductsCostedFromFile == 1 ? "artigo foi valorizado" : "artigos foram valorizados")
                            ao <strong>custo da ficha</strong>, por o razão nunca ter observado o que
                            custaram. É o esperado em stock de abertura; fora disso, indica compras que não
                            chegaram a ser registadas.
                        </MudAlert>
                    }
                }
            }
        </MudPaper>

        <MudAlert Severity="Severity.Info">
            O ficheiro é validado contra o XSD oficial da versão escolhida antes de ser entregue. Passar
            na validação diz que a estrutura está certa, não que os valores estão — a conferência das
            existências continua a ser sua.
        </MudAlert>
    }
</MudStack>

@code {
    private bool _loading;
    private bool _downloading;
    private string? _error;

    private int _fiscalYear = DateTime.Today.Year - 1;
    private DateTime? _endDate = new DateTime(DateTime.Today.Year - 1, 12, 31);

    /// <summary>The valued file is what the tax authority takes from 2021, so it is the default.</summary>
    private bool _valued = true;

    private InventoryFileSummary? _summary;

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        if (!Company.HasCompany)
        {
            _summary = null;
            _error = Company.LoadError;
            StateHasChanged();
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var (summary, error) = await StockApi.GetInventoryFileSummaryAsync(
                Company.SelectedCompanyId, _fiscalYear, DateOnly.FromDateTime(_endDate!.Value), _valued);

            _summary = summary;
            _error = error;
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível ler as existências: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>Changing the period moves the reference date with it, which is what is wanted.</summary>
    private async Task OnYearChangedAsync(int year)
    {
        _fiscalYear = year;
        _endDate = new DateTime(year, 12, 31);
        await LoadAsync();
    }

    private async Task OnEndDateChangedAsync(DateTime? date)
    {
        _endDate = date;

        if (date is { } value)
            _fiscalYear = value.Year;

        await LoadAsync();
    }

    private async Task OnValuedChangedAsync(bool valued)
    {
        _valued = valued;
        await LoadAsync();
    }

    private async Task DownloadAsync()
    {
        _downloading = true;
        _error = null;

        try
        {
            var (file, error) = await StockApi.DownloadInventoryFileAsync(
                Company.SelectedCompanyId, _fiscalYear, DateOnly.FromDateTime(_endDate!.Value), _valued);

            if (file is null)
            {
                _error = error ?? "Não foi possível gerar o ficheiro.";
                return;
            }

            await JS.InvokeVoidAsync(
                "erpDownloadFile", file.FileName, "application/xml", Convert.ToBase64String(file.Content));

            // The file is still handed over when it fails the schema — a broken file in hand beats a
            // silent refusal — but the message has to say so.
            if (file.ValidationErrors > 0)
            {
                Snackbar.Add(
                    $"{file.FileName} gerado, mas com {file.ValidationErrors} erros face ao esquema oficial. Não submeta assim.",
                    Severity.Error);
            }
            else if (_valued && file.ProductsWithoutCost > 0)
            {
                Snackbar.Add(
                    $"{file.FileName} gerado, mas com {file.ProductsWithoutCost} artigos sem custo.",
                    Severity.Warning);
            }
            else
            {
                Snackbar.Add($"{file.FileName} gerado.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível gerar o ficheiro: {ex.Message}";
        }
        finally
        {
            _downloading = false;
        }
    }

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
