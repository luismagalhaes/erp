@page "/Backoffice/Clients"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using IdentityResourcesType = Erp.Identity.Resources.IdentityResources
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IClientService ClientService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<IdentityResourcesType> Localizer

<PageTitle>@Localizer["Backoffice_Clients_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Backoffice_Clients_PageTitle"]" />

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="0" Class="erp-card">
            <MudTable Items="@_clients" Hover="true" Striped="true" Dense="true" Class="erp-grid" Elevation="0">
                <HeaderContent>
                    <MudTh>@Localizer["Backoffice_Clients_ClientIdColumn"]</MudTh>
                    <MudTh>@Localizer["Backoffice_Common_NameColumn"]</MudTh>
                    <MudTh>@Localizer["Backoffice_Clients_ActiveColumn"]</MudTh>
                    <MudTh>@Localizer["Backoffice_Clients_RedirectUrisColumn"]</MudTh>
                    <MudTh>@Localizer["Backoffice_Clients_ScopesColumn"]</MudTh>
                    <MudTh Class="erp-numeric">@Localizer["Backoffice_Common_ActionsColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Localizer["Backoffice_Clients_ClientIdColumn"]">@context.ClientId</MudTd>
                    <MudTd DataLabel="@Localizer["Backoffice_Common_NameColumn"]">@context.ClientName</MudTd>
                    <MudTd DataLabel="@Localizer["Backoffice_Clients_ActiveColumn"]">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(context.Enabled ? Color.Success : Color.Default)">
                            @(context.Enabled ? Localizer["Backoffice_Common_Yes"] : Localizer["Backoffice_Common_No"])
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="@Localizer["Backoffice_Clients_RedirectUrisColumn"]">@string.Join(", ", context.RedirectUris)</MudTd>
                    <MudTd DataLabel="@Localizer["Backoffice_Clients_ScopesColumn"]">@string.Join(", ", context.AllowedScopes)</MudTd>
                    <MudTd Class="erp-numeric">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       Href="@($"/Backoffice/Clients/{Uri.EscapeDataString(context.ClientId)}")"
                                       title="@Localizer["Backoffice_Common_EditAction"]" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context.ClientId))"
                                       title="@Localizer["Backoffice_Common_DeleteAction"]" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</MudStack>

@code {
    private List<ClientListItem> _clients = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _clients = (await ClientService.GetClientsAsync()).ToList();
        _loading = false;
    }

    private async Task DeleteAsync(string clientId)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Localizer["Backoffice_Clients_DeleteHeading"].Value,
            string.Format(Localizer["Backoffice_Clients_DeleteConfirm"], clientId),
            yesText: Localizer["Backoffice_Common_DeleteButton"].Value,
            cancelText: Localizer["Backoffice_Common_CancelButton"].Value);

        if (confirmed != true)
            return;

        await ClientService.DeleteClientAsync(clientId);
        Snackbar.Add(Localizer["Backoffice_Clients_Deleted"].Value, Severity.Success);
        await LoadAsync();
    }
}
