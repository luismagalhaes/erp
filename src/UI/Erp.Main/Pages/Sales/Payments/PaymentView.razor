@page "/payments/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@using Microsoft.Extensions.Localization
@using Erp.Main.Resources
@inject SalesApiClient SalesApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@(_payment?.PaymentRefNo ?? L["PaymentView_DefaultTitle"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(_payment?.PaymentRefNo ?? L["PaymentView_DefaultTitle"])</MudText>
            @if (_payment is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @PaymentTypes.Describe(_payment.PaymentType) ·
                    <span style="font-family: monospace;">ATCUD:@_payment.Atcud</span>
                </MudText>
            }
        </MudStack>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Print"
                       Disabled="@(_payment is null)"
                       OnClick="@(() => Navigation.NavigateTo($"payments/{Id}/print"))">
                @L["PaymentView_PrintButton"]
            </MudButton>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("payments"))">
                @L["PaymentView_BackButton"]
            </MudButton>
        </MudStack>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_payment is not null)
    {
        @if (_payment.Status == "A")
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @L["PaymentView_VoidedNotice"]
            </MudAlert>
        }

        <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["PaymentView_CustomerLabel"]</MudText>
                    <MudText>@_payment.PartyName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["PaymentView_TaxIdPrefix", _payment.PartyTaxId]</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["PaymentView_DateLabel"]</MudText>
                    <MudText>@_payment.TransactionDate.ToString("yyyy-MM-dd")</MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["PaymentView_SystemEntryLabel"]</MudText>
                    <MudText>@_payment.SystemEntryDateUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</MudText>
                </MudItem>

                @if (!string.IsNullOrWhiteSpace(_payment.Description))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["PaymentView_NotesLabel"]</MudText>
                        <MudText>@_payment.Description</MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="0" Class="pa-2 erp-card erp-form">
            <MudText Typo="Typo.h6" Class="pa-2">@L["PaymentView_SettledInvoicesTitle"]</MudText>
            <MudTable Items="_payment.Lines" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>@L["PaymentView_NumberColumn"]</MudTh>
                    <MudTh>@L["PaymentView_InvoiceColumn"]</MudTh>
                    <MudTh>@L["PaymentView_InvoiceDateColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["PaymentView_SettledAmountColumn"]</MudTh>
                    <MudTh Style="width: 70px; text-align: right;">@L["PaymentView_ActionsColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["PaymentView_NumberColumn"]">@context.LineNumber</MudTd>
                    <MudTd DataLabel="@L["PaymentView_InvoiceColumn"]">
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.OriginatingNumber</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["PaymentView_InvoiceDateColumn"]">@context.OriginatingDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="@L["PaymentView_SettledAmountColumn"]" Style="text-align: right;">@context.AppliedAmount.ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["PaymentView_ActionsColumn"]" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                       title="@L["PaymentView_ViewInvoiceTitle"]"
                                       OnClick="@(() => Navigation.NavigateTo($"invoices/{context.OriginatingDocumentId}"))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudPaper Elevation="0" Class="pa-2 erp-card erp-form">
            <MudText Typo="Typo.h6" Class="pa-2">@L["PaymentView_MethodsTitle"]</MudText>
            <MudTable Items="_payment.Methods" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>@L["PaymentView_MethodColumn"]</MudTh>
                    <MudTh>@L["PaymentView_DateColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["PaymentView_ValueColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["PaymentView_MethodColumn"]">@PaymentMechanismOptions.Describe(context.Mechanism)</MudTd>
                    <MudTd DataLabel="@L["PaymentView_DateColumn"]">@context.PaymentDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="@L["PaymentView_ValueColumn"]" Style="text-align: right;">@context.Amount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudStack Row="true" Spacing="4" Justify="Justify.FlexEnd">
            <MudPaper Elevation="0" Class="pa-4 erp-card erp-form" Style="min-width: 300px;">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["PaymentView_SettledAmountLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_payment.NetTotal.ToString("N2")</MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.body2">@L["PaymentView_TaxLabel"]</MudText>
                        <MudText Typo="Typo.body2">@_payment.TaxPayable.ToString("N2")</MudText>
                    </MudStack>
                    <MudDivider />
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6">@L["PaymentView_TotalReceivedLabel"]</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Primary">@_payment.GrossTotal.ToString("N2")</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudStack>

        @if (_payment.Status != "A")
        {
            <MudExpansionPanels Elevation="1">
                <MudExpansionPanel Text="@L["PaymentView_VoidPaymentTitle"]">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @L["PaymentView_VoidHelpText"]
                    </MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_voidReason" Label="@L["PaymentView_ReasonLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Style="max-width: 480px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Disabled="@(_working || string.IsNullOrWhiteSpace(_voidReason))"
                                   OnClick="VoidAsync">
                            @L["PaymentView_VoidButton"]
                        </MudButton>
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private bool _working;
    private string? _error;
    private string _voidReason = string.Empty;
    private Guid? _loadedId;

    private PaymentDetail? _payment;

    protected override async Task OnParametersSetAsync()
    {
        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loadedId == Id)
            return;

        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _payment = await SalesApi.GetPaymentAsync(Id);
            if (_payment is null)
                _error = L["PaymentView_PaymentNotFound"];
        }
        catch (Exception ex)
        {
            _error = L["PaymentView_LoadError", ex.Message];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task VoidAsync()
    {
        _working = true;
        _error = null;

        try
        {
            var error = await SalesApi.VoidPaymentAsync(Id, _voidReason.Trim());

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(L["PaymentView_VoidedSuccess"].Value, Severity.Success);
            _voidReason = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = L["PaymentView_VoidError", ex.Message];
        }
        finally
        {
            _working = false;
        }
    }
}
