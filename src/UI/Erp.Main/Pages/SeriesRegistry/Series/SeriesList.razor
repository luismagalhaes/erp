@page "/series"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject SeriesApiClient SalesApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["SeriesList_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@L["SeriesList_PageTitle"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("series/new"))">
                @L["SeriesList_NewSeriesButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="SalesSeries"
              LoadAsync="@((companyId, query, ct) => SalesApi.QuerySeriesAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="DocumentType,SeriesCode"
              SearchPlaceholder="@L["SeriesList_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.Numbers"
              EmptyTitle="@L["SeriesList_EmptyTitle"]"
              EmptyDescription="@L["SeriesList_EmptyDescription"]"
              ItemsLabel="@L["SeriesList_ItemsLabel"]"
              LoadErrorMessage="@L["SeriesList_LoadErrorMessage"]">
        <Columns>
            <PropertyColumn Property="x => x.DocumentType" Title="@L["SeriesList_TypeColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.Item.DocumentType</MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.SeriesCode" Title="@L["SeriesList_SeriesColumn"]" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.SelfBilling" Title="@L["SeriesList_SelfBillingColumn"]">
                <CellTemplate>
                    @if (context.Item.SelfBilling)
                    {
                        <MudTooltip Text="@L["SeriesList_SelfBillingTooltip"]">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                @L["SeriesList_SelfBillingChip"]
                            </MudChip>
                        </MudTooltip>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.ValidationCode" Title="@L["SeriesList_ValidationCodeColumn"]">
                <CellTemplate>
                    @if (string.IsNullOrWhiteSpace(context.Item.ValidationCode))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SeriesList_NotCommunicated"]</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="erp-mono">@context.Item.ValidationCode</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.CurrentSequence" Title="@L["SeriesList_LastNumberColumn"]"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.Status" Title="@L["SeriesList_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.CanIssue ? Color.Success : Color.Warning)">
                        @DescribeStatus(context.Item.Status)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                     OnClick="@(() => Navigation.NavigateTo($"series/{context.Item.Id}"))">
                            @L["SeriesList_OpenSeriesAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["DocumentType", "SeriesCode"];

    private string DescribeStatus(string status) => status switch
    {
        "Created" => L["SeriesList_StatusCreated"],
        "Communicated" => L["SeriesList_StatusCommunicated"],
        "Active" => L["SeriesList_StatusActive"],
        "Finalized" => L["SeriesList_StatusFinalized"],
        _ => status
    };
}
