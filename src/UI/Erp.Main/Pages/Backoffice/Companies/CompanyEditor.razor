@page "/companies/new"
@page "/companies/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Common
@using Erp.Main.Models
@using Erp.Main.Services
@inject CoreApiClient CoreApi
@inject IdentityApiClient IdentityApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(IsNew ? "Nova empresa" : "Editar empresa")</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(IsNew ? "Nova empresa" : _name)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                O NIF identifica a empresa perante a AT e não pode repetir-se.
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("companies"))">
            Voltar
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="1">
            <MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pa-4">
                <MudTabPanel Text="Dados" Icon="@Icons.Material.Filled.Domain">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_name" Label="Nome" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_legalName" Label="Designação legal" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_taxId" Label="NIF" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_email" Label="Email" Variant="Variant.Outlined" InputType="InputType.Email" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_phone" Label="Telefone" Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                                Sede — o cabeçalho do SAF-T exige a morada, por isso sem ela o ficheiro sai incompleto.
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_address" Label="Morada" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField @bind-Value="_postalCode" Label="Código postal" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField @bind-Value="_city" Label="Localidade" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudTextField @bind-Value="_country" Label="País" Variant="Variant.Outlined"
                                          HelperText="Código de 2 letras" />
                        </MudItem>

                        @if (!IsNew)
                        {
                            <MudItem xs="12">
                                <MudSwitch @bind-Value="_isActive" Color="Color.Primary" Label="Empresa ativa" />
                            </MudItem>
                        }
                    </MudGrid>

                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@(_saving || !CanSave)"
                                   OnClick="SaveAsync">
                            Guardar
                        </MudButton>
                    </MudStack>
                </MudTabPanel>

                <MudTabPanel Text="Utilizadores" Icon="@Icons.Material.Filled.Group" Disabled="IsNew"
                             ToolTip="@(IsNew ? "Guarde a empresa antes de associar utilizadores" : null)">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                        Quem tem acesso a esta empresa. É esta lista que alimenta o seletor de empresa no cabeçalho.
                    </MudText>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
                        <MudGrid>
                            <MudItem xs="12" md="5">
                                <MudSelect @bind-Value="_newUserId" Label="Utilizador" Variant="Variant.Outlined"
                                           Dense="true" Disabled="@(_availableUsers.Count == 0)">
                                    @foreach (var user in _availableUsers)
                                    {
                                        <MudSelectItem T="string" Value="@user.Id">
                                            @(string.IsNullOrWhiteSpace(user.FullName) ? user.Email : $"{user.FullName} ({user.Email})")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect @bind-Value="_newRole" Label="Papel na empresa" Variant="Variant.Outlined" Dense="true">
                                    @foreach (var role in CompanyRoles)
                                    {
                                        <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3" Class="d-flex align-center">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.PersonAdd"
                                           Disabled="@(_working || string.IsNullOrWhiteSpace(_newUserId))"
                                           OnClick="AssignAsync">
                                    Associar
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (_availableUsers.Count == 0 && _users.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Todos os utilizadores ativos já estão associados a esta empresa.
                            </MudText>
                        }
                    </MudPaper>

                    <MudTable Items="_memberships" Hover="true" Striped="true" Dense="true" Loading="_workingUsers"
                              Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Utilizador</MudTh>
                            <MudTh>Email</MudTh>
                            <MudTh Style="width: 200px;">Papel na empresa</MudTh>
                            <MudTh Style="width: 140px;">Estado</MudTh>
                            <MudTh Style="text-align: right;">Ações</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Utilizador">@DescribeUser(context.UserId)</MudTd>
                            <MudTd DataLabel="Email">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@DescribeEmail(context.UserId)</MudText>
                            </MudTd>
                            <MudTd DataLabel="Papel na empresa">
                                <MudSelect T="string" Value="context.Role" Dense="true" Margin="Margin.Dense"
                                           ValueChanged="@(role => ChangeRoleAsync(context, role))">
                                    @foreach (var role in CompanyRoles)
                                    {
                                        <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd DataLabel="Estado">
                                <MudSwitch T="bool" Value="context.IsActive" Color="Color.Primary" Size="Size.Small"
                                           ValueChanged="@(active => ChangeActiveAsync(context, active))" />
                            </MudTd>
                            <MudTd DataLabel="Ações" Style="text-align: right;">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               title="Remover acesso"
                                               Disabled="_working"
                                               OnClick="@(() => RemoveAsync(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Nenhum utilizador tem acesso a esta empresa.
                            </MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    }
</MudStack>

@code {
    /// <summary>As mesmas roles que o Identity emite, para não haver duas listas a divergir.</summary>
    private static readonly string[] CompanyRoles = Constants.Roles.All;

    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNew => Id is null;

    private bool _loading;
    private bool _saving;
    private bool _working;
    private bool _workingUsers;
    private string? _error;

    private bool _loaded;
    private Guid? _loadedId;

    private string _name = string.Empty;
    private string _legalName = string.Empty;
    private string _taxId = string.Empty;
    private string _email = string.Empty;
    private string _phone = string.Empty;
    private string _address = string.Empty;
    private string _city = string.Empty;
    private string _postalCode = string.Empty;
    private string _country = "PT";
    private bool _isActive = true;

    private string _newUserId = string.Empty;
    private string _newRole = Constants.Roles.User;

    private List<UserCompanyAdmin> _memberships = [];
    private List<IdentityUser> _users = [];

    private List<IdentityUser> _availableUsers =>
        [.. _users.Where(user => _memberships.All(m => m.UserId != user.Id))];

    private bool CanSave => !string.IsNullOrWhiteSpace(_name) && !string.IsNullOrWhiteSpace(_taxId);

    protected override async Task OnParametersSetAsync()
    {
        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loaded && _loadedId == Id)
            return;

        _loaded = true;
        _loadedId = Id;

        if (IsNew)
            return;

        _loading = true;

        try
        {
            var company = await CoreApi.GetCompanyAsync(Id!.Value);

            if (company is null)
            {
                _error = "Empresa não encontrada.";
                return;
            }

            _name = company.Name;
            _legalName = company.LegalName ?? string.Empty;
            _taxId = company.TaxId;
            _email = company.Email ?? string.Empty;
            _phone = company.Phone ?? string.Empty;
            _address = company.Address ?? string.Empty;
            _city = company.City ?? string.Empty;
            _postalCode = company.PostalCode ?? string.Empty;
            _country = string.IsNullOrWhiteSpace(company.Country) ? "PT" : company.Country;
            _isActive = company.IsActive;

            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar a empresa: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadUsersAsync()
    {
        _workingUsers = true;

        // Each source is loaded on its own: the Identity being down still leaves the
        // memberships readable, and the other way round.
        var problems = new List<string>();

        try
        {
            var (memberships, error) = await CoreApi.GetUserCompaniesAsync(Id!.Value);
            _memberships = [.. memberships];

            if (error is not null)
                problems.Add(error);
        }
        catch (Exception ex)
        {
            problems.Add($"Não foi possível carregar os acessos: {ex.Message}");
        }

        try
        {
            var (users, error) = await IdentityApi.GetUsersAsync();
            _users = [.. users.Where(user => user.IsActive).OrderBy(user => user.Email)];

            if (error is not null)
                problems.Add($"Não foi possível carregar os utilizadores: {error}");
        }
        catch (Exception ex)
        {
            problems.Add($"Não foi possível carregar os utilizadores: {ex.Message}");
        }

        _newUserId = _availableUsers.FirstOrDefault()?.Id ?? string.Empty;
        _error = problems.Count == 0 ? null : string.Join(" ", problems);
        _workingUsers = false;
    }

    private string DescribeUser(string userId) =>
        _users.FirstOrDefault(user => user.Id == userId) is { FullName: { Length: > 0 } fullName }
            ? fullName
            : DescribeEmail(userId);

    private string DescribeEmail(string userId) =>
        _users.FirstOrDefault(user => user.Id == userId)?.Email ?? userId;

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            if (IsNew)
            {
                var request = new CreateCompanyRequest(
                    _name.Trim(), _taxId.Trim(), Normalize(_legalName), Normalize(_email), Normalize(_phone),
                    Normalize(_address), Normalize(_city), Normalize(_postalCode), NormalizeCountry(_country));

                var (created, error) = await CoreApi.CreateCompanyAsync(request);

                if (error is not null)
                {
                    _error = error;
                    return;
                }

                await Company.RefreshAsync();
                Snackbar.Add("Empresa criada. Associe agora os utilizadores.", Severity.Success);

                // Straight into the users tab of the company that was just created.
                Navigation.NavigateTo($"companies/{created!.Id}");
                return;
            }

            var updateRequest = new UpdateCompanyRequest(
                _name.Trim(), _taxId.Trim(), Normalize(_legalName), Normalize(_email), Normalize(_phone), _isActive,
                Normalize(_address), Normalize(_city), Normalize(_postalCode), NormalizeCountry(_country));

            var (_, updateError) = await CoreApi.UpdateCompanyAsync(Id!.Value, updateRequest);

            if (updateError is not null)
            {
                _error = updateError;
                return;
            }

            await Company.RefreshAsync();
            Snackbar.Add("Empresa atualizada.", Severity.Success);
            Navigation.NavigateTo("companies");
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível guardar a empresa: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AssignAsync()
    {
        await RunAsync(
            () => CoreApi.CreateUserCompanyAsync(new CreateUserCompanyRequest(_newUserId, Id!.Value, _newRole)),
            $"{DescribeEmail(_newUserId)} passou a ter acesso a esta empresa.");
    }

    private async Task ChangeRoleAsync(UserCompanyAdmin membership, string role)
    {
        await RunAsync(
            () => CoreApi.UpdateUserCompanyAsync(membership.Id, new UpdateUserCompanyRequest(role, membership.IsActive)),
            "Papel atualizado.");
    }

    private async Task ChangeActiveAsync(UserCompanyAdmin membership, bool isActive)
    {
        await RunAsync(
            () => CoreApi.UpdateUserCompanyAsync(membership.Id, new UpdateUserCompanyRequest(membership.Role, isActive)),
            isActive ? "Acesso reativado." : "Acesso desativado.");
    }

    private async Task RemoveAsync(UserCompanyAdmin membership)
    {
        await RunAsync(
            () => CoreApi.DeleteUserCompanyAsync(membership.Id),
            $"{DescribeUser(membership.UserId)} deixou de ter acesso a esta empresa.");
    }

    /// <summary>Runs an operation on the memberships and refreshes what depends on them.</summary>
    private async Task RunAsync(Func<Task<string?>> operation, string successMessage)
    {
        _working = true;
        _error = null;

        try
        {
            var error = await operation();

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(successMessage, Severity.Success);

            // The header picker lists the companies of the signed in user.
            await Company.RefreshAsync();
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível concluir a operação: {ex.Message}";
        }
        finally
        {
            _working = false;
        }
    }

    private static string? Normalize(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string NormalizeCountry(string value) =>
        string.IsNullOrWhiteSpace(value) ? "PT" : value.Trim().ToUpperInvariant();
}
