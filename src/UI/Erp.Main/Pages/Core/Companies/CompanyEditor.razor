            _city = result.Locality ?? result.Municipality ?? string.Empty;
    }

    private void OnStreetSelectedAsync(string address) => _address = address;

    /// <summary>
    /// Runs the module-11 check and, for a company NIF, queries VIES: fills the name and address
    /// when they are still blank and reports what came back, good or bad, instead of failing silently.
    /// </summary>
    private async Task LookupTaxIdAsync()
    {
        if (_lookingUpTaxId || string.IsNullOrWhiteSpace(_taxId))
            return;

        _lookingUpTaxId = true;
        _taxIdLookupMessage = null;

        try
        {
            var result = await Lookups.GetVatNumberAsync(_taxId);

            if (result is null || !result.IsStructurallyValid)
            {
                _taxIdLookupSeverity = Severity.Error;
                _taxIdLookupMessage = Localizer["PartnerForm_TaxIdInvalidMessage"];
                return;
            }

            if (result.Source != VatNumberValidationSource.Vies)
            {
                _taxIdLookupSeverity = Severity.Success;
                _taxIdLookupMessage = Localizer["PartnerForm_TaxIdValidMessage"];
                return;
            }

            if (result.IsRegisteredInVies != true)
            {
                _taxIdLookupSeverity = Severity.Warning;
                _taxIdLookupMessage = Localizer["PartnerForm_TaxIdNotRegisteredMessage"];
                return;
            }

            if (string.IsNullOrWhiteSpace(_name) && !string.IsNullOrWhiteSpace(result.RegisteredName))
                _name = result.RegisteredName;

            if (string.IsNullOrWhiteSpace(_address) && !string.IsNullOrWhiteSpace(result.RegisteredAddress))
                _address = result.RegisteredAddress;

            if (string.IsNullOrWhiteSpace(_postalCode) && !string.IsNullOrWhiteSpace(result.RegisteredPostalCode))
                _postalCode = result.RegisteredPostalCode;

            if (string.IsNullOrWhiteSpace(_city) && !string.IsNullOrWhiteSpace(result.RegisteredCity))
                _city = result.RegisteredCity;

            // Prefer the postal code table's own locality name over VIES's, when it has one — it is
            // occasionally more specific or more consistently cased than what VIES's free-text
            // address gives. moradas.dev has no freguesia (parish) data, though, so this can no
            // longer sharpen a municipality-level VIES result down to parish level the way the
            // previous provider (geoapi.pt) could.
            if (PostalCodes.IsValid(_postalCode, _country))
            {
                var postalCodeResult = await Lookups.GetPostalCodeAsync(_postalCode);
                var locality = postalCodeResult?.Locality ?? postalCodeResult?.Municipality;

                if (!string.IsNullOrWhiteSpace(locality))
                    _city = locality;
            }

            _taxIdLookupSeverity = Severity.Success;
            _taxIdLookupMessage = string.Format(Localizer["PartnerForm_TaxIdFoundMessage"], result.RegisteredName);
        }
        finally
        {
            _lookingUpTaxId = false;
        }
    }
