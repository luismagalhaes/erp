@page "/series/new"
@page "/series/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject SeriesApiClient SalesApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@(IsNew ? L["SeriesEditor_NewSeriesTitle"] : L["SeriesEditor_SeriesTitle"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(IsNew ? L["SeriesEditor_NewSeriesTitle"] : L["SeriesEditor_SeriesTitleWithCode", _series?.SeriesCode ?? string.Empty])</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["SeriesEditor_Subtitle"]
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("series"))">
            @L["SeriesEditor_BackButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (IsNew)
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudSelect @bind-Value="_documentType" Label="@L["SeriesEditor_DocumentTypeLabel"]" Variant="Variant.Outlined">
                        @foreach (var type in DocumentTypes)
                        {
                            <MudSelectItem T="string" Value="@type.Code">@type.Code — @type.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_seriesCode" Label="@L["SeriesEditor_SeriesCodeLabel"]"
                                  Variant="Variant.Outlined" Required="true" Placeholder="A2026" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudNumericField @bind-Value="_initialSequence" Label="@L["SeriesEditor_InitialSequenceLabel"]"
                                     Variant="Variant.Outlined" Min="1" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_establishmentCode" Label="@L["SeriesEditor_EstablishmentLabel"]"
                                  Variant="Variant.Outlined" HelperText="@L["SeriesEditor_OptionalHelperText"]" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect @bind-Value="_stockEffect" Label="@L["SeriesEditor_StockEffectLabel"]" Variant="Variant.Outlined"
                               HelperText="@L["SeriesEditor_DefaultStockEffectHelperText", _documentType, StockEffects.Describe(DefaultStockEffectFor(_documentType))]">
                        @foreach (var effect in StockEffects.All)
                        {
                            <MudSelectItem T="string" Value="@effect.Code">@effect.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="8" Class="d-flex align-center">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @L["SeriesEditor_StockEffectNotice"]
                    </MudText>
                </MudItem>

                @if (CanSelfBill)
                {
                    <MudItem xs="12" md="4" Class="d-flex align-center">
                        <MudSwitch @bind-Value="_selfBilling" @bind-Value:after="StateHasChanged"
                                   Color="Color.Warning" Label="@L["SeriesEditor_SelfBillingSwitchLabel"]" />
                    </MudItem>
                    <MudItem xs="12" md="8" Class="d-flex align-center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["SeriesEditor_SelfBillingNotice", L["SeriesEditor_SelfBillingNoticeEmphasis"], L["SeriesEditor_SelfBillingNoticeTypeS"]]
                        </MudText>
                    </MudItem>
                }
            </MudGrid>

            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_saving || string.IsNullOrWhiteSpace(_seriesCode) || !Company.HasCompany)"
                           OnClick="CreateAsync">
                    @L["SeriesEditor_CreateSeriesButton"]
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else if (_series is not null)
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SeriesEditor_DocumentTypeColumn"]</MudText>
                    <MudText>@_series.DocumentType</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SeriesEditor_IdentifierLabel"]</MudText>
                    <MudText Style="font-family: monospace;">@_series.SeriesCode</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SeriesEditor_LastNumberIssuedLabel"]</MudText>
                    <MudText>@_series.CurrentSequence</MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SeriesEditor_StatusLabel"]</MudText>
                    <MudText>@_series.Status</MudText>
                </MudItem>
                @if (_series.SelfBilling)
                {
                    <MudItem xs="12" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SeriesEditor_UsageLabel"]</MudText>
                        <MudText>@L["SeriesEditor_SelfBillingUsage"]</MudText>
                    </MudItem>
                }
            </MudGrid>

            <MudAlert Severity="Severity.Normal" Dense="true" Class="mt-4">
                @L["SeriesEditor_ImmutableNotice", L["SeriesEditor_ImmutableNoticeEmphasis"]]
            </MudAlert>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-2">@L["SeriesEditor_StockEffectSectionTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                O que os <strong>@L["SeriesEditor_StockEffectSectionNoticeEmphasis"]</strong> @L["SeriesEditor_StockEffectSectionNoticeText"]
            </MudText>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudSelect T="string" @bind-Value="_stockEffect" @bind-Value:after="StateHasChanged"
                           Label="@L["SeriesEditor_StockEffectLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Style="max-width: 320px;">
                    @foreach (var effect in StockEffects.All)
                    {
                        <MudSelectItem T="string" Value="@effect.Code">@effect.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_saving || _stockEffect == _series.StockEffect)"
                           OnClick="UpdateStockEffectAsync">
                    @L["SeriesEditor_SaveButton"]
                </MudButton>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-2">@L["SeriesEditor_CommunicationSectionTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                @L["SeriesEditor_CommunicationSectionNotice"]
            </MudText>

            @if (!string.IsNullOrWhiteSpace(_series.ValidationCode))
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                    @L["SeriesEditor_CommunicatedNotice", _series.ValidationCode]
                </MudAlert>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.CloudDone"
                           Disabled="_saving"
                           OnClick="CommunicateAsync">
                    @L["SeriesEditor_CommunicateButton"]
                </MudButton>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    @L["SeriesEditor_ManualCommunicationNotice"]
                </MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTextField @bind-Value="_manualValidationCode" Immediate="true"
                                  Label="@L["SeriesEditor_ValidationCodeLabel"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 320px;" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.EditNote"
                               Disabled="@(_saving || string.IsNullOrWhiteSpace(_manualValidationCode))"
                               OnClick="CommunicateManuallyAsync">
                        @L["SeriesEditor_RegisterCodeButton"]
                    </MudButton>
                </MudStack>
            }
        </MudPaper>

        @if (_series.Status == "Communicated")
        {
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">@L["SeriesEditor_CancelSectionTitle"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    @L["SeriesEditor_CancelSectionNotice"]
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Cancel"
                           Disabled="_saving"
                           OnClick="CancelAsync">
                    @L["SeriesEditor_CancelButton"]
                </MudButton>
            </MudPaper>
        }

        @if (_series.Status is "Communicated" or "Active")
        {
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">@L["SeriesEditor_FinalizeSectionTitle"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    @L["SeriesEditor_FinalizeSectionNotice"]
                </MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTextField @bind-Value="_justificacao" Label="@L["SeriesEditor_JustificationLabel"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 480px;" />
                    <MudButton Variant="Variant.Filled" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Flag"
                               Disabled="_saving"
                               OnClick="FinalizeAsync">
                        @L["SeriesEditor_FinalizeButton"]
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
    }
</MudStack>

@code {
    /// <summary>
    /// Every document family that is numbered from a series: faturação, movimentação de
    /// mercadorias e recibos. The API validates against the same list.
    /// </summary>
    private DocumentTypeOption[] DocumentTypes =>
    [
        new("FT", L["SeriesEditor_DocType_FT"]),
        new("FS", L["SeriesEditor_DocType_FS"]),
        new("FR", L["SeriesEditor_DocType_FR"]),
        new("NC", L["SeriesEditor_DocType_NC"]),
        new("ND", L["SeriesEditor_DocType_ND"]),
        new("GR", L["SeriesEditor_DocType_GR"]),
        new("GT", L["SeriesEditor_DocType_GT"]),
        new("GA", L["SeriesEditor_DocType_GA"]),
        new("GC", L["SeriesEditor_DocType_GC"]),
        new("GD", L["SeriesEditor_DocType_GD"]),
        new("RC", L["SeriesEditor_DocType_RC"]),
        new("RG", L["SeriesEditor_DocType_RG"])
    ];

    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNew => Id is null;

    private bool _loading;
    private bool _saving;
    private string? _error;

    private bool _loaded;
    private Guid? _loadedId;

    private string _documentType = "FT";
    private string _seriesCode = string.Empty;
    private int _initialSequence = 1;
    private string _establishmentCode = string.Empty;
    private string _justificacao = string.Empty;
    private string _manualValidationCode = string.Empty;
    private string _stockEffect = DefaultStockEffectFor("FT");
    private bool _selfBilling;

    /// <summary>
    /// Self-billing is a way of invoicing, so only invoicing types offer it. The API refuses the
    /// rest; the switch simply does not appear.
    /// </summary>
    private bool CanSelfBill => _documentType is "FT" or "FS" or "FR" or "NC" or "ND";

    /// <summary>
    /// Mirrors the API's defaults, so the screen shows what the server would choose. The server
    /// decides; this is only so the user is not surprised.
    /// </summary>
    private static string DefaultStockEffectFor(string documentType) => documentType switch
    {
        "GR" or "GT" or "GC" or "FT" or "FS" or "FR" => "Out",
        "GD" or "NC" => "In",
        _ => "None"
    };

    private SalesSeries? _series;

    protected override async Task OnParametersSetAsync()
    {
        await Company.EnsureLoadedAsync();

        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loaded && _loadedId == Id)
            return;

        _loaded = true;
        _loadedId = Id;

        if (IsNew)
            return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            var series = await SalesApi.GetSeriesAsync(Company.SelectedCompanyId);
            _series = series.FirstOrDefault(x => x.Id == Id);

            if (_series is null)
                _error = L["SeriesEditor_SeriesNotFoundNotice"];
            else
                _stockEffect = _series.StockEffect;
        }
        catch (Exception ex)
        {
            _error = L["SeriesEditor_LoadError", ex.Message];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var request = new CreateSeriesRequest(
                Company.SelectedCompanyId,
                _documentType,
                _seriesCode.Trim(),
                _initialSequence,
                string.IsNullOrWhiteSpace(_establishmentCode) ? null : _establishmentCode.Trim(),
                _stockEffect,
                CanSelfBill && _selfBilling);

            var (series, error) = await SalesApi.CreateSeriesAsync(request);

            if (series is null)
            {
                _error = error ?? L["SeriesEditor_CreateFailed"];
                return;
            }

            Snackbar.Add(L["SeriesEditor_CreatedSuccess", series.SeriesCode].Value, Severity.Success);
            Navigation.NavigateTo($"series/{series.Id}");
        }
        catch (Exception ex)
        {
            _error = L["SeriesEditor_CreateError", ex.Message];
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UpdateStockEffectAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var (series, error) = await SalesApi.UpdateSeriesAsync(Id!.Value, _stockEffect);

            if (series is null)
            {
                _error = error ?? L["SeriesEditor_UpdateStockEffectFailed"];
                return;
            }

            _series = series;
            _stockEffect = series.StockEffect;
            Snackbar.Add(L["SeriesEditor_StockEffectUpdatedSuccess"].Value, Severity.Success);
        }
        catch (Exception ex)
        {
            _error = L["SeriesEditor_UpdateStockEffectError", ex.Message];
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CommunicateAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var error = await SalesApi.CommunicateSeriesAsync(Id!.Value);

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(L["SeriesEditor_ValidationCodeRegisteredSuccess"].Value, Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = L["SeriesEditor_RegisterCodeError", ex.Message];
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Fallback for when the AT webservice itself is not reachable or not yet configured.</summary>
    private async Task CommunicateManuallyAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var error = await SalesApi.CommunicateSeriesManuallyAsync(Id!.Value, _manualValidationCode.Trim());

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(L["SeriesEditor_ValidationCodeRegisteredSuccess"].Value, Severity.Success);
            _manualValidationCode = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = L["SeriesEditor_RegisterCodeError", ex.Message];
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CancelAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var error = await SalesApi.CancelSeriesAsync(Id!.Value);

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(L["SeriesEditor_CancelSuccess"].Value, Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = L["SeriesEditor_CancelError", ex.Message];
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task FinalizeAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var error = await SalesApi.FinalizeSeriesAsync(
                Id!.Value, string.IsNullOrWhiteSpace(_justificacao) ? null : _justificacao.Trim());

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(L["SeriesEditor_FinalizeSuccess"].Value, Severity.Success);
            _justificacao = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = L["SeriesEditor_FinalizeError", ex.Message];
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed record DocumentTypeOption(string Code, string Label);
}
