@page "/credit-notes"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@inject SalesApiClient SalesApi
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Notas de crédito</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="Notas de crédito e de débito">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("credit-notes/new"))">
                Nova nota
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="InvoiceListItem"
              LoadAsync="LoadAsync"
              SearchFields="SearchFields" DefaultOrderBy="DocumentDate desc,DocumentNumber desc"
              SearchPlaceholder="Procurar por documento, cliente ou NIF"
              EmptyIcon="@Icons.Material.Filled.ReceiptLong"
              EmptyTitle="Sem notas para mostrar"
              EmptyDescription="Ajuste os filtros ou emita a primeira nota."
              ItemsLabel="notas"
              LoadErrorMessage="Não foi possível carregar as notas">
        <Columns>
            <PropertyColumn Property="x => x.DocumentNumber" Title="Documento" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.DocumentType" Title="Tipo">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                        @InvoiceTypes.Describe(context.Item.DocumentType)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.DocumentDate" Title="Data" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.CustomerName" Title="Cliente" />
            <PropertyColumn Property="x => x.CustomerTaxId" Title="NIF" />
            <PropertyColumn Property="x => x.GrossTotal" Title="Total" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.Status" Title="Estado">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.Status == "A" ? Color.Error : Color.Success)">
                        @(context.Item.Status == "A" ? "Anulada" : "Normal")
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"invoices/{context.Item.Id}"))">
                            Ver documento
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["DocumentNumber", "CustomerName", "CustomerTaxId"];

    /// <summary>
    /// Rectifying documents live in the same table as the invoices they correct, so the listing is
    /// narrowed to those types. The restriction is added to the query rather than applied to the
    /// page, so the count and the paging the grid receives are already the ones of the notes.
    /// </summary>
    private Task<(IReadOnlyList<InvoiceListItem> Items, int Count, string? Error)> LoadAsync(
        Guid companyId, ODataQuery query, CancellationToken cancellationToken)
    {
        query.Filter(string.Join(
            " or ",
            InvoiceTypes.Rectifying.Select(type => $"DocumentType eq {ODataQuery.Literal(type)}")));

        return SalesApi.QueryInvoicesAsync(companyId, query, cancellationToken);
    }
}
