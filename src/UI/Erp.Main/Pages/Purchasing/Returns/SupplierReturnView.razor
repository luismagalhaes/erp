@page "/supplier-returns/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject PurchasingApiClient Purchasing
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(_return?.Number ?? "Devolução")</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(_return?.Number ?? "Devolução")</MudText>
            @if (_return is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_return.Supplier.Name · @_return.ReturnDate.ToString("yyyy-MM-dd")
                </MudText>
            }
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("supplier-returns"))">
            Voltar
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_return is null)
    {
        <MudAlert Severity="Severity.Warning">Devolução não encontrada.</MudAlert>
    }
    else
    {
        @if (_return.IsVoided)
        {
            <MudAlert Severity="Severity.Error">
                Anulada em @_return.VoidedAtUtc?.ToString("yyyy-MM-dd HH:mm"): @_return.VoidReason.
                O stock voltou a entrar.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                Se a mercadoria viajou, o documento de transporte é <strong>nosso e é fiscal</strong> —
                uma guia de devolução (GD) em
                <MudLink Href="stock-movements">Guias de transporte</MudLink>.
            </MudAlert>
        }

        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Contribuinte</MudText>
                    <MudText Typo="Typo.body1">@_return.Supplier.TaxId</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Motivo</MudText>
                    <MudText Typo="Typo.body1">@_return.Reason</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Custo total</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">@_return.TotalCost.ToString("N2")</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-2">
            <MudTable Items="_return.Lines" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">O que voltou</MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 50px;">#</MudTh>
                    <MudTh>Artigo</MudTh>
                    <MudTh>Descrição</MudTh>
                    <MudTh>Receção</MudTh>
                    <MudTh Style="text-align: right;">Quantidade</MudTh>
                    <MudTh Style="text-align: right;">Custo unit.</MudTh>
                    <MudTh Style="text-align: right;">Total</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#">@context.LineNumber</MudTd>
                    <MudTd DataLabel="Artigo">
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.ProductCode</MudText>
                    </MudTd>
                    <MudTd DataLabel="Descrição">@context.ProductDescription</MudTd>
                    <MudTd DataLabel="Receção">
                        <MudLink Href="@($"goods-receipts/{context.ReceiptId}")">Ver</MudLink>
                    </MudTd>
                    <MudTd DataLabel="Quantidade" Style="text-align: right;">
                        @context.Quantity.ToString("N3") @context.UnitOfMeasure
                    </MudTd>
                    <MudTd DataLabel="Custo unit." Style="text-align: right;">
                        @context.UnitCost.ToString("N2")
                    </MudTd>
                    <MudTd DataLabel="Total" Style="text-align: right;">@context.LineAmount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        @if (!_return.IsVoided)
        {
            <MudExpansionPanels>
                <MudExpansionPanel Text="Anular devolução">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Anular volta a dar entrada do stock que saiu: a mercadoria passa a ser nossa
                        outra vez e pode ser devolvida de novo. Nada é apagado — o movimento contrário
                        fica no razão ao lado do original.
                    </MudText>

                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_reason" @bind-Value:after="StateHasChanged" Immediate="true"
                                      Label="Motivo" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Style="max-width: 480px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Disabled="@(_working || string.IsNullOrWhiteSpace(_reason))"
                                   OnClick="VoidAsync">
                            Anular
                        </MudButton>
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private bool _working;
    private string? _error;
    private string _reason = string.Empty;

    private SupplierReturn? _return;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _return = await Purchasing.GetReturnAsync(Id);
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar a devolução: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task VoidAsync()
    {
        _working = true;
        _error = null;

        try
        {
            var (result, error) = await Purchasing.VoidReturnAsync(Id, _reason.Trim());

            if (result is null)
            {
                _error = error ?? "Não foi possível anular a devolução.";
                return;
            }

            _return = result;
            _reason = string.Empty;
            Snackbar.Add("Devolução anulada. O stock voltou a entrar.", Severity.Success);
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível anular a devolução: {ex.Message}";
        }
        finally
        {
            _working = false;
        }
    }
}
