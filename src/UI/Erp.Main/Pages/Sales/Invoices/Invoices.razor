@page "/invoices"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@inject SalesApiClient SalesApi
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Faturas</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="Faturas">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.LocalShipping"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("invoices/from-movements"))">
                Faturar guias
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("invoices/new"))">
                Nova fatura
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="InvoiceListItem"
              LoadAsync="@((companyId, query, ct) => SalesApi.QueryInvoicesAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="DocumentDate desc,DocumentNumber desc"
              SearchPlaceholder="Procurar por documento, cliente ou NIF"
              EmptyIcon="@Icons.Material.Filled.ReceiptLong"
              EmptyTitle="Sem faturas para mostrar"
              EmptyDescription="Ajuste os filtros ou emita a primeira fatura."
              ItemsLabel="faturas"
              LoadErrorMessage="Não foi possível carregar as faturas">
        <Columns>
            <PropertyColumn Property="x => x.DocumentNumber" Title="Documento" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.DocumentType" Title="Tipo">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.Item.DocumentType</MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Atcud" Title="ATCUD" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.DocumentDate" Title="Data" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.CustomerName" Title="Cliente" />
            <PropertyColumn Property="x => x.CustomerTaxId" Title="NIF" />
            <PropertyColumn Property="x => x.NetTotal" Title="Base" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.TaxPayable" Title="IVA" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.GrossTotal" Title="Total" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.Status" Title="Estado">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.Status == "A" ? Color.Error : Color.Success)">
                        @DescribeStatus(context.Item.Status)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"invoices/{context.Item.Id}"))">
                            Ver documento
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    /// <summary>
    /// Maps the toolbar search to the DTO members the API exposes, so a renamed column never
    /// produces an invalid $filter.
    /// </summary>
    private static readonly string[] SearchFields = ["DocumentNumber", "CustomerName", "CustomerTaxId"];

    private static string DescribeStatus(string status) => status switch
    {
        "A" => "Anulado",
        "F" => "Faturado",
        "S" => "Autofaturado",
        _ => "Normal"
    };
}
