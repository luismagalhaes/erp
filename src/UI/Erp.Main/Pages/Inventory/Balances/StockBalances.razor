@page "/stock"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject StockApiClient StockApi
@inject CompanyState Company
@inject WarehouseState WarehouseState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@Localizer["StockBalances_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@Localizer["StockBalances_PageTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Localizer["StockBalances_Subtitle"]
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.FactCheck"
                   Disabled="@(!Company.HasCompany)"
                   OnClick="@(() => Navigation.NavigateTo("stock/check"))">
            @Localizer["StockBalances_CheckButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (Company.HasCompany && _warehouses.Count == 0 && !_loading)
    {
        <MudAlert Severity="Severity.Warning">
            @Localizer["StockBalances_NoWarehousesWarning", Localizer["StockBalances_WarehousesTabName"]]
        </MudAlert>
    }

    <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudSelect T="Guid?" Value="_warehouseId" ValueChanged="OnWarehouseChangedAsync"
                           Label="@Localizer["StockBalances_WarehouseLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                           Placeholder="@Localizer["StockBalances_AllPlaceholder"]">
                    @foreach (var warehouse in _warehouses)
                    {
                        <MudSelectItem T="Guid?" Value="@warehouse.Id">
                            @warehouse.Code — @warehouse.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <ProductAutocomplete SelectedProduct="_selectedProduct" ProductChanged="OnProductFilterChangedAsync"
                                     Label="@Localizer["StockBalances_FilterLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center">
                <MudSwitch @bind-Value="_onlyWithStock" @bind-Value:after="StateHasChanged"
                           Color="Color.Primary" Label="@Localizer["StockBalances_OnlyWithStockLabel"]" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="0" Class="pa-2 erp-card erp-form">
        <MudTable Items="Visible" Hover="true" Striped="true" Dense="true" Loading="_loading"
                  Breakpoint="Breakpoint.Sm" T="StockBalance"
                  OnRowClick="OnRowClickAsync">
            <HeaderContent>
                <MudTh>@Localizer["StockBalances_ProductColumn"]</MudTh>
                <MudTh>@Localizer["StockBalances_DescriptionColumn"]</MudTh>
                <MudTh>@Localizer["StockBalances_WarehouseColumn"]</MudTh>
                <MudTh Style="text-align: right;">@Localizer["StockBalances_QuantityColumn"]</MudTh>
                <MudTh Style="text-align: right;">@Localizer["StockBalances_AverageCostColumn"]</MudTh>
                <MudTh Style="text-align: right;">@Localizer["StockBalances_ValueColumn"]</MudTh>
                <MudTh>@Localizer["StockBalances_LastMovementColumn"]</MudTh>
                <MudTh Style="width: 50px; text-align: right;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Localizer["StockBalances_ProductColumn"]">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.ProductCode</MudText>
                </MudTd>
                <MudTd DataLabel="@Localizer["StockBalances_DescriptionColumn"]">@context.ProductDescription</MudTd>
                <MudTd DataLabel="@Localizer["StockBalances_WarehouseColumn"]">@WarehouseName(context.WarehouseId)</MudTd>
                <MudTd DataLabel="@Localizer["StockBalances_QuantityColumn"]" Style="text-align: right;">
                    <MudText Typo="Typo.body2"
                             Color="@(context.Quantity < 0 ? Color.Error : Color.Default)">
                        <strong>@context.Quantity.ToString("N2")</strong>
                    </MudText>
                </MudTd>
                <MudTd DataLabel="@Localizer["StockBalances_AverageCostColumn"]" Style="text-align: right;">
                    @if (context.AverageCost == 0)
                    {
                        <MudTooltip Text="@Localizer["StockBalances_NoCostTooltip"]">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@context.AverageCost.ToString("N4")</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="@Localizer["StockBalances_ValueColumn"]" Style="text-align: right;">
                    <MudText Typo="Typo.body2">@context.StockValue.ToString("N2")</MudText>
                </MudTd>
                <MudTd DataLabel="@Localizer["StockBalances_LastMovementColumn"]">
                    @context.LastMovementUtc.ToString("yyyy-MM-dd HH:mm")
                </MudTd>
                <MudTd Style="text-align: right;" @onclick:stopPropagation="true">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => ShowLedgerAsync(context))">
                            @Localizer["StockBalances_DetailsAction"]
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Tune"
                                     OnClick="@(() => OpenAdjustment(context))">
                            @Localizer["StockBalances_AdjustTooltip"]
                        </MudMenuItem>
                    </MudMenu>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["StockBalances_NoRecords"]</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>

    @if (_balances.Count > 0)
    {
        <MudStack Row="true" Spacing="6" Justify="Justify.FlexEnd">
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["StockBalances_TotalValueLabel"]</MudText>
                <MudText Typo="Typo.h6" Color="Color.Primary">@TotalValue.ToString("N2")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @Localizer["StockBalances_TotalValueCaption"]
                </MudText>
            </MudStack>
        </MudStack>
    }

    @if (_withoutCostCount > 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true">
            @string.Format(Localizer["StockBalances_WithoutCostNotice"], _withoutCostCount,
                     _withoutCostCount == 1 ? Localizer["StockBalances_WithoutCostSingular"] : Localizer["StockBalances_WithoutCostPlural"])
        </MudAlert>
    }

    @if (_negativeCount > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            @string.Format(Localizer["StockBalances_NegativeNotice"], _negativeCount,
                     _negativeCount == 1 ? Localizer["StockBalances_NegativeSingular"] : Localizer["StockBalances_NegativePlural"])
        </MudAlert>
    }
</MudStack>

@* --- Movimentos do artigo --- *@
<MudDialog @bind-Visible="_ledgerOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @string.Format(Localizer["StockBalances_LedgerTitle"], _ledgerProductCode)
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_ledgerLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudTable Items="_ledger" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>@Localizer["StockBalances_DateColumn"]</MudTh>
                    <MudTh>@Localizer["StockBalances_DocumentColumn"]</MudTh>
                    <MudTh>@Localizer["StockBalances_ReasonColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["StockBalances_MovementColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["StockBalances_BalanceColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Localizer["StockBalances_DateColumn"]">@context.MovementDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="@Localizer["StockBalances_DocumentColumn"]">
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">
                            @(context.SourceDocumentNumber ?? "—")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="@Localizer["StockBalances_ReasonColumn"]">@(context.Reason ?? "—")</MudTd>
                    <MudTd DataLabel="@Localizer["StockBalances_MovementColumn"]" Style="text-align: right;">
                        <MudText Typo="Typo.body2"
                                 Color="@(context.Quantity < 0 ? Color.Error : Color.Success)">
                            @(context.Quantity > 0 ? "+" : string.Empty)@context.Quantity.ToString("N2")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="@Localizer["StockBalances_BalanceColumn"]" Style="text-align: right;">
                        <strong>@context.RunningBalance.ToString("N2")</strong>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["StockBalances_NoMovements"]</MudText>
                </NoRecordsContent>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _ledgerOpen = false)">@Localizer["StockBalances_CloseButton"]</MudButton>
    </DialogActions>
</MudDialog>

@* --- Acerto manual --- *@
<MudDialog @bind-Visible="_adjustOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@Localizer["StockBalances_AdjustTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            @Localizer["StockBalances_AdjustDescription"]
        </MudText>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField Value="@_adjustProductCode" Label="@Localizer["StockBalances_ProductColumn"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                              ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="decimal" Value="_adjustCurrent" Label="@Localizer["StockBalances_CurrentStockLabel"]"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Format="N2" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="decimal" Value="_adjustCounted" ValueChanged="OnCountedChanged"
                                 Label="@Localizer["StockBalances_CountedQuantityLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="decimal" Value="AdjustDifference" Label="@Localizer["StockBalances_DifferenceLabel"]"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Format="N2" />
            </MudItem>
            @if (AdjustDifference > 0)
            {
                <MudItem xs="12" md="6">
                    <MudNumericField T="decimal?" @bind-Value="_adjustUnitCost"
                                     Label="@Localizer["StockBalances_UnitCostLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N4"
                                     Clearable="true"
                                     HelperText="@Localizer["StockBalances_UnitCostHelperText"]" />
                </MudItem>
                <MudItem xs="12" md="6" Class="d-flex align-center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @Localizer["StockBalances_UnitCostNotice"]
                    </MudText>
                </MudItem>
            }
            <MudItem xs="12">
                <MudTextField @bind-Value="_adjustReason" @bind-Value:after="StateHasChanged" Immediate="true"
                              Label="@Localizer["StockBalances_ReasonLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                              HelperText="@Localizer["StockBalances_ReasonHelperText"]" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _adjustOpen = false)">@Localizer["StockBalances_CancelButton"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_adjusting || AdjustDifference == 0 || string.IsNullOrWhiteSpace(_adjustReason))"
                   OnClick="AdjustAsync">
            @Localizer["StockBalances_AdjustButton"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private bool _loading = true;
    private string? _error;

    private Guid? _warehouseId;
    private ProductListItem? _selectedProduct;
    private bool _onlyWithStock;

    private List<Warehouse> _warehouses = [];
    private List<StockBalance> _balances = [];
    private int _negativeCount;
    private int _withoutCostCount;

    private decimal TotalValue => _balances.Sum(x => x.StockValue);

    private bool _ledgerOpen;
    private bool _ledgerLoading;
    private string _ledgerProductCode = string.Empty;
    private List<StockLedgerEntry> _ledger = [];

    private bool _adjustOpen;
    private bool _adjusting;
    private Guid _adjustWarehouseId;
    private string _adjustProductCode = string.Empty;
    private string _adjustProductDescription = string.Empty;
    private decimal _adjustCurrent;
    private decimal _adjustCounted;
    private decimal? _adjustUnitCost;
    private string _adjustReason = string.Empty;

    private decimal AdjustDifference => _adjustCounted - _adjustCurrent;

    private IEnumerable<StockBalance> Visible =>
        _balances
            .Where(x => !_onlyWithStock || x.Quantity != 0)
            .Where(x => _selectedProduct is null
                        || string.Equals(x.ProductCode, _selectedProduct.ProductCode, StringComparison.OrdinalIgnoreCase));

    private Task OnProductFilterChangedAsync(ProductListItem? product)
    {
        _selectedProduct = product;
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await WarehouseState.EnsureLoadedAsync();

        // Coming from the warehouse list, the warehouse to show is on the query string.
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("warehouseId", out var value) && Guid.TryParse(value, out var warehouseId))
            _warehouseId = warehouseId;
        else if (WarehouseState.HasWarehouse)
            _warehouseId = WarehouseState.SelectedWarehouseId;

        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = Company.LoadError;

        if (!Company.HasCompany)
        {
            _warehouses = [];
            _balances = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            var (warehouses, warehouseError) = await StockApi.GetWarehousesAsync(Company.SelectedCompanyId);
            _warehouses = [.. warehouses];
            _error ??= warehouseError;

            var (balances, error) = await StockApi.GetBalancesAsync(Company.SelectedCompanyId, _warehouseId);
            _balances = [.. balances];
            _error ??= error;
            _negativeCount = _balances.Count(x => x.Quantity < 0);
            _withoutCostCount = _balances.Count(x => x.Quantity != 0 && x.AverageCost == 0);
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["StockBalances_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OnWarehouseChangedAsync(Guid? warehouseId)
    {
        _warehouseId = warehouseId;
        await LoadAsync();
    }

    private string WarehouseName(Guid warehouseId) =>
        _warehouses.FirstOrDefault(x => x.Id == warehouseId)?.Code ?? "—";

    /// <summary>The clicked row can be null when the click lands outside a row.</summary>
    private async Task OnRowClickAsync(TableRowClickEventArgs<StockBalance> args)
    {
        if (args.Item is { } balance)
            await ShowLedgerAsync(balance);
    }

    private async Task ShowLedgerAsync(StockBalance balance)
    {
        _ledgerProductCode = balance.ProductCode;
        _ledger = [];
        _ledgerOpen = true;
        _ledgerLoading = true;

        try
        {
            var (entries, error) = await StockApi.GetLedgerAsync(
                Company.SelectedCompanyId, balance.WarehouseId, balance.ProductCode);

            _ledger = [.. entries];

            if (error is not null)
                _error = error;
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["StockBalances_LoadLedgerError"], ex.Message);
        }
        finally
        {
            _ledgerLoading = false;
        }
    }

    private void OpenAdjustment(StockBalance balance)
    {
        _adjustWarehouseId = balance.WarehouseId;
        _adjustProductCode = balance.ProductCode;
        _adjustProductDescription = balance.ProductDescription;
        _adjustCurrent = balance.Quantity;
        _adjustCounted = balance.Quantity;
        _adjustUnitCost = null;
        _adjustReason = string.Empty;
        _adjustOpen = true;
    }

    private void OnCountedChanged(decimal counted) => _adjustCounted = counted;

    private async Task AdjustAsync()
    {
        _adjusting = true;
        _error = null;

        try
        {
            var error = await StockApi.AdjustAsync(new AdjustStockRequest(
                Company.SelectedCompanyId,
                _adjustWarehouseId,
                _adjustProductCode,
                _adjustProductDescription,
                AdjustDifference,
                DateOnly.FromDateTime(DateTime.Today),
                _adjustReason.Trim(),
                // Only meaningful on a find: what leaves, leaves at the average.
                AdjustDifference > 0 ? _adjustUnitCost : null));

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(string.Format(Localizer["StockBalances_Adjusted"], _adjustProductCode), Severity.Success);
            _adjustOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["StockBalances_AdjustError"], ex.Message);
        }
        finally
        {
            _adjusting = false;
        }
    }

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
