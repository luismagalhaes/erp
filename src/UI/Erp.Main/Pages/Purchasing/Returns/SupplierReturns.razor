@page "/supplier-returns"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@inject PurchasingApiClient Purchasing
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Devoluções a fornecedores</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="Devoluções a fornecedores">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Undo"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("supplier-returns/new"))">
                Devolver mercadoria
            </MudButton>
        </Actions>
    </PageHeader>

    <MudAlert Severity="Severity.Info" Dense="true">
        Isto regista o <strong>movimento</strong>. Se a mercadoria viaja, o documento de transporte é
        <strong>nosso e é fiscal</strong> — emita uma guia de devolução (GD) em
        <MudLink Href="stock-movements/new">Guias de transporte</MudLink>.
    </MudAlert>

    <DataGrid T="SupplierReturnListItem"
              LoadAsync="@((companyId, query, ct) => Purchasing.QueryReturnsAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="ReturnDate desc,Number desc"
              SearchPlaceholder="Procurar número, fornecedor ou motivo"
              EmptyIcon="@Icons.Material.Filled.Undo"
              EmptyTitle="Sem devoluções para mostrar"
              EmptyDescription="Ajuste os filtros ou registe a primeira devolução."
              ItemsLabel="devoluções"
              LoadErrorMessage="Não foi possível carregar as devoluções">
        <Columns>
            <PropertyColumn Property="x => x.Number" Title="Número" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.ReturnDate" Title="Data" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.SupplierName" Title="Fornecedor" />
            <PropertyColumn Property="x => x.Reason" Title="Motivo" />
            <PropertyColumn Property="x => x.LineCount" Title="Linhas"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.TotalCost" Title="Custo" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.Status" Title="Estado">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsVoided ? Color.Error : Color.Success)">
                        @(context.Item.IsVoided ? "Anulada" : "Devolvida")
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"supplier-returns/{context.Item.Id}"))">
                            Abrir devolução
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["Number", "SupplierName", "Reason"];
}
