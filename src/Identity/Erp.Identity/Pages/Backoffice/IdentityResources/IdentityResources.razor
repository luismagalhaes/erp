@page "/Backoffice/IdentityResources"
@page "/Backoffice/IdentityResources/{Mode}"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using IdentityResourcesType = Erp.Identity.Resources.IdentityResources
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IIdentityResourceService IdentityResourceService
@inject NavigationManager Navigation
@inject IStringLocalizer<IdentityResourcesType> Localizer

<PageTitle>@Localizer["Backoffice_IdentityResourcesPage_PageTitle"]</PageTitle>

@if (IsCreateMode || IsEditMode)
{
    <div class="content-card mud-elevation-1">
        <h2>@(IsCreateMode ? Localizer["Backoffice_IdentityResourcesPage_CreateHeading"] : Localizer["Backoffice_IdentityResourcesPage_EditHeading"])</h2>
        @if (!string.IsNullOrWhiteSpace(ErrorMessage)) { <div class="auth-error">@ErrorMessage</div> }

        <EditForm Model="Form" OnSubmit="SaveAsync" FormName="identity-resources-form">
            <div class="tab-strip">
                <button type="button" class="tab-btn @(ActiveTab == "MainInfo" ? "active" : null)" @onclick='() => SelectTab("MainInfo")'>@Localizer["Backoffice_ApiScopes_Tab_MainInfo"]</button>
                <button type="button" class="tab-btn @(ActiveTab == "UserClaims" ? "active" : null)" @onclick='() => SelectTab("UserClaims")'>@Localizer["Backoffice_ApiScopes_Tab_UserClaims"]</button>
            </div>

            <div class="tab-panel @(ActiveTab == "MainInfo" ? "active" : null)">
                <div class="auth-field"><label>@Localizer["Backoffice_Common_NameLabel"]</label><InputText @bind-Value="Form.Name" /></div>
                <div class="auth-field"><label>@Localizer["Backoffice_Common_DisplayNameLabel"]</label><InputText @bind-Value="Form.DisplayName" /></div>
                <div class="auth-field"><label>@Localizer["Backoffice_Common_DescriptionLabel"]</label><InputTextArea @bind-Value="Form.Description" /></div>
                <div class="auth-field"><label><InputCheckbox @bind-Value="Form.Enabled" /> @Localizer["Backoffice_Common_EnabledLabel"]</label></div>
                <div class="auth-field"><label><InputCheckbox @bind-Value="Form.Required" /> @Localizer["Backoffice_Common_RequiredLabel"]</label></div>
                <div class="auth-field"><label><InputCheckbox @bind-Value="Form.Emphasize" /> @Localizer["Backoffice_Common_EmphasizeLabel"]</label></div>
                <div class="auth-field"><label><InputCheckbox @bind-Value="Form.ShowInDiscoveryDocument" /> @Localizer["Backoffice_Common_ShowInDiscoveryDocumentLabel"]</label></div>
            </div>

            <div class="tab-panel @(ActiveTab == "UserClaims" ? "active" : null)">
                <div class="auth-field">
                    <label>@Localizer["Backoffice_ApiScopes_UserClaimsLabel"]</label>
                    <table class="backoffice-table">
                        <thead><tr><th>@Localizer["Backoffice_ApiScopes_ClaimColumn"]</th><th class="actions-col">@Localizer["Backoffice_Common_ActionsColumn"]</th></tr></thead>
                        <tbody>
                        @for (var i = 0; i < Form.UserClaims.Count; i++)
                        {
                            var index = i;
                            <tr>
                                <td><InputText @bind-Value="Form.UserClaims[index]" /></td>
                                <td class="actions-col"><button type="button" class="action-btn danger" @onclick="() => RemoveListItem(Form.UserClaims, index)">@Localizer["Backoffice_Common_RemoveButton"]</button></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <button type="button" class="action-btn" @onclick="() => AddListItem(Form.UserClaims)">@Localizer["Backoffice_ApiScopes_AddClaimButton"]</button>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="action-btn primary">@Localizer["Backoffice_Common_SaveButton"]</button>
                <a class="action-btn" href="/Backoffice/IdentityResources">@Localizer["Backoffice_Common_CancelButton"]</a>
            </div>
        </EditForm>
    </div>
}
else if (IsDeleteMode)
{
    <div class="content-card mud-elevation-1">
        <h2>@Localizer["Backoffice_IdentityResourcesPage_DeleteHeading"]</h2>
        <p>@Localizer["Backoffice_Common_DeleteConfirm", Name]</p>
        <div class="form-actions">
            <button class="action-btn danger" @onclick="DeleteAsync">@Localizer["Backoffice_Common_DeleteButton"]</button>
            <a class="action-btn" href="/Backoffice/IdentityResources">@Localizer["Backoffice_Common_CancelButton"]</a>
        </div>
    </div>
}
else
{
    <div class="content-card mud-elevation-1">
        <div class="list-header">
            <h2>@Localizer["Backoffice_IdentityResourcesPage_ListHeading", Items.Count]</h2>
            <div class="list-actions">
                <MudIconButton Icon="@Icons.Material.Filled.AddCircle" Href="/Backoffice/IdentityResources/Create" Color="Color.Primary" Size="Size.Small" title="@Localizer["Backoffice_IdentityResourcesPage_CreateAction"]" aria-label="@Localizer["Backoffice_IdentityResourcesPage_CreateAction"]" />
            </div>
        </div>
        <table class="backoffice-table">
            <thead><tr><th>@Localizer["Backoffice_Common_NameColumn"]</th><th>@Localizer["Backoffice_Common_DisplayNameColumn"]</th><th>@Localizer["Backoffice_Common_EnabledColumn"]</th><th>@Localizer["Backoffice_ApiScopes_ClaimsColumn"]</th><th class="actions-col">@Localizer["Backoffice_Common_ActionsColumn"]</th></tr></thead>
            <tbody>
            @foreach (var item in Items)
            {
                <tr>
                    <td>@item.Name</td><td>@item.DisplayName</td>
                    <td><span class="@(item.Enabled ? "ok" : "off")">@(item.Enabled ? Localizer["Backoffice_Common_Yes"] : Localizer["Backoffice_Common_No"])</span></td>
                    <td>@string.Join(", ", item.UserClaims)</td>
                    <td class="actions-col">
                        <div class="table-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Href="@($"/Backoffice/IdentityResources/Edit?name={Uri.EscapeDataString(item.Name)}")" Color="Color.Primary" Size="Size.Small" title="@Localizer["Backoffice_Common_EditAction"]" aria-label="@Localizer["Backoffice_Common_EditAction"]" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Href="@($"/Backoffice/IdentityResources/Delete?name={Uri.EscapeDataString(item.Name)}")" Color="Color.Error" Size="Size.Small" title="@Localizer["Backoffice_Common_DeleteAction"]" aria-label="@Localizer["Backoffice_Common_DeleteAction"]" />
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public string? Mode { get; set; }
    [SupplyParameterFromQuery] public string? Name { get; set; }

    private bool IsCreateMode => string.Equals(Mode, "Create", StringComparison.OrdinalIgnoreCase);
    private bool IsEditMode => string.Equals(Mode, "Edit", StringComparison.OrdinalIgnoreCase);
    private bool IsDeleteMode => string.Equals(Mode, "Delete", StringComparison.OrdinalIgnoreCase);

    private List<IdentityResourceListItem> Items { get; set; } = [];
    private IdentityResourceInput Form { get; set; } = new() { Enabled = true, ShowInDiscoveryDocument = true };
    private string? ErrorMessage { get; set; }
    private string ActiveTab { get; set; } = "MainInfo";

    protected override async Task OnParametersSetAsync()
    {
        ErrorMessage = null;

        if (IsEditMode)
        {
            if (string.IsNullOrWhiteSpace(Name)) { Navigation.NavigateTo("/Backoffice/IdentityResources"); return; }
            var item = await IdentityResourceService.GetIdentityResourceAsync(Name);
            if (item is null) { Navigation.NavigateTo("/Backoffice/IdentityResources"); return; }
            Form = IdentityResourceInput.From(item);
            return;
        }

        if (!IsCreateMode && !IsDeleteMode)
            Items = (await IdentityResourceService.GetIdentityResourcesAsync()).ToList();
    }

    private async Task SaveAsync(EditContext _)
    {
        if (string.IsNullOrWhiteSpace(Form.Name)) { ErrorMessage = Localizer["Backoffice_Common_ErrorNameRequired"]; return; }

        var request = new IdentityResourceUpsertRequest(
            Form.Name.Trim(),
            (Form.DisplayName ?? string.Empty).Trim(),
            (Form.Description ?? string.Empty).Trim(),
            Form.Enabled,
            Form.Required,
            Form.Emphasize,
            Form.ShowInDiscoveryDocument,
            SanitizeList(Form.UserClaims));

        if (IsCreateMode) await IdentityResourceService.CreateIdentityResourceAsync(request);
        else
        {
            if (string.IsNullOrWhiteSpace(Name)) { Navigation.NavigateTo("/Backoffice/IdentityResources"); return; }
            await IdentityResourceService.UpdateIdentityResourceAsync(Name, request);
        }

        Navigation.NavigateTo("/Backoffice/IdentityResources");
    }

    private async Task DeleteAsync()
    {
        if (!string.IsNullOrWhiteSpace(Name))
            await IdentityResourceService.DeleteIdentityResourceAsync(Name);
        Navigation.NavigateTo("/Backoffice/IdentityResources");
    }

    private static List<string> SanitizeList(IEnumerable<string> values)
        => values
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private void SelectTab(string tabKey) => ActiveTab = tabKey;

    private static void AddListItem(List<string> list) => list.Add(string.Empty);

    private static void RemoveListItem(List<string> list, int index)
    {
        if (index >= 0 && index < list.Count)
            list.RemoveAt(index);
    }

    private sealed class IdentityResourceInput
    {
        public string Name { get; set; } = string.Empty;
        public string? DisplayName { get; set; }
        public string? Description { get; set; }
        public bool Enabled { get; set; }
        public bool Required { get; set; }
        public bool Emphasize { get; set; }
        public bool ShowInDiscoveryDocument { get; set; }
        public List<string> UserClaims { get; set; } = [];

        public static IdentityResourceInput From(IdentityResourceEditItem item) => new()
        {
            Name = item.Name,
            DisplayName = item.DisplayName,
            Description = item.Description,
            Enabled = item.Enabled,
            Required = item.Required,
            Emphasize = item.Emphasize,
            ShowInDiscoveryDocument = item.ShowInDiscoveryDocument,
            UserClaims = item.UserClaims
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Select(x => x.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList()
        };
    }
}
