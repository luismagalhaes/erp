@page "/notifications"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject NotificationApiClient NotificationApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Notificações</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Notificações</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Emails enfileirados pelos serviços do ERP e processados pelo worker.
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="_loading"
                   OnClick="LoadAsync">
            Atualizar
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_notifications.Count > 0)
    {
        <MudStack Row="true" Spacing="4">
            @foreach (var group in _notifications.GroupBy(x => x.Status).OrderBy(x => x.Key))
            {
                <MudPaper Elevation="1" Class="pa-3" Style="min-width: 140px;">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@DescribeStatus(group.Key)</MudText>
                    <MudText Typo="Typo.h5">@group.Count()</MudText>
                </MudPaper>
            }
        </MudStack>
    }

    <MudPaper Elevation="1" Class="pa-2">
        <MudTable Items="_notifications" Hover="true" Striped="true" Dense="true" Loading="_loading"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Destinatário</MudTh>
                <MudTh>Assunto</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh Style="text-align: right;">Tentativas</MudTh>
                <MudTh>Criado</MudTh>
                <MudTh>Processado</MudTh>
                <MudTh Style="text-align: right;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Destinatário">@context.ToEmail</MudTd>
                <MudTd DataLabel="Assunto">@context.Subject</MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StatusColor(context.Status)">
                        @DescribeStatus(context.Status)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Tentativas" Style="text-align: right;">@context.RetryCount</MudTd>
                <MudTd DataLabel="Criado">@context.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd DataLabel="Processado">
                    @(context.ProcessedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                </MudTd>
                <MudTd DataLabel="Ações" Style="text-align: right;">
                    @if (context.Status == "Failed")
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" Color="Color.Warning"
                                       title="Voltar a enfileirar"
                                       Disabled="_requeuing"
                                       OnClick="@(() => RequeueAsync(context.Id))" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                   title="Ver notificação"
                                   OnClick="@(() => Navigation.NavigateTo($"notifications/{context.Id}"))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Ainda não foi enviada nenhuma notificação.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

@code {
    private bool _loading = true;
    private bool _requeuing;
    private string? _error;
    private List<NotificationListItem> _notifications = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _notifications = [.. await NotificationApi.GetNotificationsAsync()];
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar as notificações: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RequeueAsync(Guid id)
    {
        _requeuing = true;

        try
        {
            var error = await NotificationApi.RequeueAsync(id);

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add("Notificação novamente na fila.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível voltar a enfileirar: {ex.Message}";
        }
        finally
        {
            _requeuing = false;
        }
    }

    private static string DescribeStatus(string status) => status switch
    {
        "Pending" => "Pendente",
        "Sent" => "Enviado",
        "Failed" => "Falhado",
        _ => status
    };

    private static Color StatusColor(string status) => status switch
    {
        "Sent" => Color.Success,
        "Failed" => Color.Error,
        _ => Color.Warning
    };
}
