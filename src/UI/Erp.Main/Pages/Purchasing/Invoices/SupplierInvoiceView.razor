@page "/supplier-invoices/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject PurchasingApiClient Purchasing
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@(_invoice?.SupplierDocumentNumber ?? L["SupplierInvoiceView_DefaultTitle"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(_invoice?.SupplierDocumentNumber ?? L["SupplierInvoiceView_DefaultTitle"])</MudText>
            @if (_invoice is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @PurchaseDocumentTypes.Describe(_invoice.DocumentType) ·
                    @_invoice.Supplier.Name · @_invoice.SupplierDocumentDate.ToString("yyyy-MM-dd")
                </MudText>
            }
        </MudStack>

        <MudStack Row="true" Spacing="2">
            @if (_invoice is not null && !_invoice.IsVoided
                  && (PurchaseDocumentTypes.IsSettledByPayment(_invoice.DocumentType) || PurchaseDocumentTypes.IsCredit(_invoice.DocumentType)))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Payments"
                           OnClick="@(() => Navigation.NavigateTo($"supplier-payments/new?supplierId={_invoice.SupplierId}"))">
                    @L["SupplierInvoiceView_PayButton"]
                </MudButton>
            }
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("supplier-invoices"))">
                @L["SupplierInvoiceView_BackButton"]
            </MudButton>
        </MudStack>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_invoice is null)
    {
        <MudAlert Severity="Severity.Warning">@L["SupplierInvoiceView_NotFound"]</MudAlert>
    }
    else
    {
        @if (_invoice.IsVoided)
        {
            <MudAlert Severity="Severity.Error">
                @string.Format(L["SupplierInvoiceView_VoidedAlert"], _invoice.VoidedAtUtc?.ToString("yyyy-MM-dd HH:mm"), _invoice.VoidReason)
            </MudAlert>
        }

        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SupplierInvoiceView_TaxIdLabel"]</MudText>
                    <MudText Typo="Typo.body1">@_invoice.Supplier.TaxId</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SupplierInvoiceView_AtcudLabel"]</MudText>
                    <MudText Typo="Typo.body1">
                        @(string.IsNullOrWhiteSpace(_invoice.SupplierAtcud) ? "—" : _invoice.SupplierAtcud)
                    </MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SupplierInvoiceView_ReceivedLabel"]</MudText>
                    <MudText Typo="Typo.body1">@_invoice.ReceivedDate.ToString("yyyy-MM-dd")</MudText>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["SupplierInvoiceView_DueDateLabel"]</MudText>
                    <MudText Typo="Typo.body1">@(_invoice.DueDate?.ToString("yyyy-MM-dd") ?? "—")</MudText>
                </MudItem>
            </MudGrid>

            @if (_invoice.ReverseCharge)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    <strong>@L["SupplierInvoiceView_ReverseChargeStrong"]</strong> @L["SupplierInvoiceView_ReverseChargeInfo"]
                </MudAlert>
            }

            @if (_invoice.MovedStock)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    @L["SupplierInvoiceView_MovedStockPrefix"] <strong>@L["SupplierInvoiceView_MovedStockStrong"]</strong>@L["SupplierInvoiceView_MovedStockSuffix"]
                </MudAlert>
            }
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-2">
            <MudTable Items="_invoice.Lines" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@L["SupplierInvoiceView_LinesTitle"]</MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh Style="width: 50px;">@L["SupplierInvoiceView_NumberColumn"]</MudTh>
                    <MudTh>@L["SupplierInvoiceView_ProductColumn"]</MudTh>
                    <MudTh>@L["SupplierInvoiceView_DescriptionColumn"]</MudTh>
                    <MudTh>@L["SupplierInvoiceView_NatureColumn"]</MudTh>
                    <MudTh>@L["SupplierInvoiceView_StockColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["SupplierInvoiceView_QuantityColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["SupplierInvoiceView_UnitPriceColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["SupplierInvoiceView_TaxColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@L["SupplierInvoiceView_TotalColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["SupplierInvoiceView_NumberColumn"]">@context.LineNumber</MudTd>
                    <MudTd DataLabel="@L["SupplierInvoiceView_ProductColumn"]">
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.ProductCode</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["SupplierInvoiceView_DescriptionColumn"]">@context.ProductDescription</MudTd>
                    <MudTd DataLabel="@L["SupplierInvoiceView_NatureColumn"]">
                        <MudText Typo="Typo.caption">@DeductionNatures.Describe(context.DeductionNature)</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["SupplierInvoiceView_StockColumn"]">
                        @if (context.ReceiptId is { } receiptId)
                        {
                            <MudTooltip Text="@L["SupplierInvoiceView_ReceiptTooltip"]">
                                <MudLink Href="@($"goods-receipts/{receiptId}")">@L["SupplierInvoiceView_FromReceiptLink"]</MudLink>
                            </MudTooltip>
                        }
                        else if (context.MovesStock)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                                @L["SupplierInvoiceView_EnteredChip"]
                            </MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="@L["SupplierInvoiceView_QuantityColumn"]" Style="text-align: right;">
                        @context.Quantity.ToString("N2") @context.UnitOfMeasure
                    </MudTd>
                    <MudTd DataLabel="@L["SupplierInvoiceView_UnitPriceColumn"]" Style="text-align: right;">
                        @context.UnitPrice.ToString("N2")
                    </MudTd>
                    <MudTd DataLabel="@L["SupplierInvoiceView_TaxColumn"]" Style="text-align: right;">
                        @context.TaxPercentage.ToString("N0")%
                    </MudTd>
                    <MudTd DataLabel="@L["SupplierInvoiceView_TotalColumn"]" Style="text-align: right;">@context.LineAmount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">@L["SupplierInvoiceView_TaxSummaryTitle"]</MudText>
            <MudSimpleTable Dense="true" Hover="true" Style="max-width: 620px;">
                <thead>
                    <tr>
                        <th>@L["SupplierInvoiceView_RateColumn"]</th>
                        <th style="text-align: right;">@L["SupplierInvoiceView_TaxableBaseColumn"]</th>
                        <th style="text-align: right;">@L["SupplierInvoiceView_TaxAmountColumn"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var summary in _invoice.TaxSummary)
                    {
                        <tr>
                            <td>@summary.TaxCode — @summary.TaxPercentage.ToString("N0")%</td>
                            <td style="text-align: right;">@summary.TaxableBase.ToString("N2")</td>
                            <td style="text-align: right;">@summary.TaxAmount.ToString("N2")</td>
                        </tr>
                    }
                    <tr>
                        <td><strong>@L["SupplierInvoiceView_TotalRowLabel"]</strong></td>
                        <td style="text-align: right;"><strong>@_invoice.NetTotal.ToString("N2")</strong></td>
                        <td style="text-align: right;"><strong>@_invoice.TaxTotal.ToString("N2")</strong></td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            <MudText Typo="Typo.h5" Color="Color.Primary" Class="mt-4">
                @string.Format(L["SupplierInvoiceView_GrandTotalLabel"], _invoice.GrossTotal.ToString("N2"))
            </MudText>
        </MudPaper>

        @if (!_invoice.IsVoided)
        {
            <MudExpansionPanels>
                <MudExpansionPanel Text="@L["SupplierInvoiceView_VoidPanelTitle"]">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        @L["SupplierInvoiceView_VoidHelpPrefix"] <strong>@L["SupplierInvoiceView_VoidHelpStrong"]</strong>@L["SupplierInvoiceView_VoidHelpSuffix"]
                    </MudText>

                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudTextField @bind-Value="_reason" @bind-Value:after="StateHasChanged" Immediate="true"
                                      Label="@L["SupplierInvoiceView_ReasonLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Style="max-width: 480px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Disabled="@(_working || string.IsNullOrWhiteSpace(_reason))"
                                   OnClick="VoidAsync">
                            @L["SupplierInvoiceView_VoidButton"]
                        </MudButton>
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private bool _working;
    private string? _error;
    private string _reason = string.Empty;

    private PurchaseInvoice? _invoice;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _invoice = await Purchasing.GetInvoiceAsync(Id);
        }
        catch (Exception ex)
        {
            _error = string.Format(L["SupplierInvoiceView_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task VoidAsync()
    {
        _working = true;
        _error = null;

        try
        {
            var (invoice, error) = await Purchasing.VoidInvoiceAsync(Id, _reason.Trim());

            if (invoice is null)
            {
                _error = error ?? L["SupplierInvoiceView_VoidFallbackError"];
                return;
            }

            _invoice = invoice;
            _reason = string.Empty;
            Snackbar.Add(L["SupplierInvoiceView_VoidSuccess"], Severity.Success);
        }
        catch (Exception ex)
        {
            _error = string.Format(L["SupplierInvoiceView_VoidError"], ex.Message);
        }
        finally
        {
            _working = false;
        }
    }
}
