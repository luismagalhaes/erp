@page "/self-billed-invoices"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@inject PurchasingApiClient Purchasing
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Autofaturação</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="Autofaturação">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("self-billed-invoices/new"))">
                Emitir autofatura
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="SelfBilledInvoiceListItem"
              LoadAsync="@((companyId, query, ct) => Purchasing.QuerySelfBilledInvoicesAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="IssueDate desc,DocumentNumber desc"
              SearchPlaceholder="Procurar número, fornecedor ou NIF"
              EmptyIcon="@Icons.Material.Filled.ReceiptLong"
              EmptyTitle="Sem autofaturas para mostrar"
              EmptyDescription="Ajuste os filtros ou emita a primeira autofatura."
              ItemsLabel="autofaturas"
              LoadErrorMessage="Não foi possível carregar as autofaturas">
        <Columns>
            <PropertyColumn Property="x => x.DocumentNumber" Title="Número" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.Atcud" Title="ATCUD" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.IssueDate" Title="Data" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.SupplierName" Title="Fornecedor" />
            <PropertyColumn Property="x => x.SupplierTaxId" Title="NIF" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.IsAccepted" Title="Aceitação">
                <CellTemplate>
                    @if (context.Item.IsVoided)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                    }
                    else if (context.Item.IsAccepted)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                            Aceite
                        </MudChip>
                    }
                    else
                    {
                        <MudTooltip Text="O artigo 36.º n.º 11 exige a aceitação de cada documento">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                Por aceitar
                            </MudChip>
                        </MudTooltip>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.NetTotal" Title="Base" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.TaxPayable" Title="IVA" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.GrossTotal" Title="Total" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.Status" Title="Estado">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsVoided ? Color.Error : Color.Success)">
                        @(context.Item.IsVoided ? "Anulada" : "Emitida")
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"self-billed-invoices/{context.Item.Id}"))">
                            Abrir autofatura
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Print"
                                     OnClick="@(() => Navigation.NavigateTo($"self-billed-invoices/{context.Item.Id}/print"))">
                            Imprimir
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["DocumentNumber", "SupplierName", "SupplierTaxId"];
}
