@page "/self-billed-invoices/new"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.FiscalPT.Documents
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject PurchasingApiClient Purchasing
@inject CatalogApiClient Catalog
@inject SalesApiClient Sales
@inject SeriesApiClient SeriesApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["NewSelfBilledInvoice_Title"]</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@L["NewSelfBilledInvoice_Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["NewSelfBilledInvoice_Subtitle"]
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("self-billed-invoices"))">
            @L["NewSelfBilledInvoice_BackButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (!Company.HasCompany)
    {
        <MudAlert Severity="Severity.Info">@L["NewSelfBilledInvoice_NoCompanyWarning"]</MudAlert>
    }
    else if (_series.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">
            @L["NewSelfBilledInvoice_NoSeriesWarningPrefix"]
            <MudLink Href="series" Class="ml-1">@L["NewSelfBilledInvoice_SeriesLinkText"]</MudLink>@L["NewSelfBilledInvoice_NoSeriesWarningSuffix"]
        </MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">@L["NewSelfBilledInvoice_DocumentTitle"]</MudText>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <PartnerAutocomplete SelectedPartner="_selectedSupplier" PartnerChanged="OnSupplierChangedAsync"
                                         Kind="PartnerKind.Supplier" Label="@L["NewSelfBilledInvoice_SupplierLabel"]" Required="true"
                                         HelperText="@L["NewSelfBilledInvoice_SupplierHelp"]" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="Guid?" @bind-Value="_seriesId" @bind-Value:after="StateHasChanged"
                               Label="@L["NewSelfBilledInvoice_SeriesLabel"]" Variant="Variant.Outlined" Required="true"
                               HelperText="@L["NewSelfBilledInvoice_SeriesHelp"]">
                        @foreach (var series in _series)
                        {
                            <MudSelectItem T="Guid?" Value="@series.Id">
                                @series.DocumentType @series.SeriesCode
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudDatePicker @bind-Date="_issueDate" Label="@L["NewSelfBilledInvoice_DateLabel"]" Variant="Variant.Outlined"
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_agreementReference" Label="@L["NewSelfBilledInvoice_AgreementLabel"]"
                                  Variant="Variant.Outlined"
                                  HelperText="@L["NewSelfBilledInvoice_AgreementHelp"]" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_supplierId is not null)
        {
            @if (_unbilled.Count > 0)
            {
                <MudPaper Elevation="1" Class="pa-4">
                    <MudStack Spacing="0" Class="mb-3">
                        <MudText Typo="Typo.h6">@L["NewSelfBilledInvoice_UnbilledTitle"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["NewSelfBilledInvoice_UnbilledHelpPrefix"]
                            <strong>@L["NewSelfBilledInvoice_UnbilledHelpStrong"]</strong>@L["NewSelfBilledInvoice_UnbilledHelpSuffix"]
                        </MudText>
                    </MudStack>

                    <MudTable Items="_unbilled" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh Style="width: 60px;"></MudTh>
                            <MudTh>@L["NewSelfBilledInvoice_ReceiptColumn"]</MudTh>
                            <MudTh>@L["NewSelfBilledInvoice_ProductColumn"]</MudTh>
                            <MudTh Style="text-align: right;">@L["NewSelfBilledInvoice_PendingColumn"]</MudTh>
                            <MudTh Style="width: 140px;">@L["NewSelfBilledInvoice_ToInvoiceColumn"]</MudTh>
                            <MudTh Style="width: 140px;">@L["NewSelfBilledInvoice_UnitPriceColumn"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudCheckBox T="bool" Value="@IsChosen(context)"
                                             ValueChanged="@(chosen => Toggle(context, chosen))"
                                             Color="Color.Primary" Dense="true" />
                            </MudTd>
                            <MudTd DataLabel="@L["NewSelfBilledInvoice_ReceiptColumn"]">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2" Style="font-family: monospace;">
                                        @context.ReceiptNumber
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @context.ReceiptDate.ToString("yyyy-MM-dd")
                                    </MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="@L["NewSelfBilledInvoice_ProductColumn"]">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@context.ProductCode</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @context.ProductDescription
                                    </MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="@L["NewSelfBilledInvoice_PendingColumn"]" Style="text-align: right;">
                                @context.PendingQuantity.ToString("N3") @context.UnitOfMeasure
                            </MudTd>
                            <MudTd DataLabel="@L["NewSelfBilledInvoice_ToInvoiceColumn"]">
                                @if (Chosen(context) is { } chosen)
                                {
                                    <MudNumericField T="decimal" Value="chosen.Quantity"
                                                     ValueChanged="@(quantity => SetQuantity(chosen, context, quantity))"
                                                     Margin="Margin.Dense" Min="0"
                                                     Max="@context.PendingQuantity" />
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["NewSelfBilledInvoice_UnitPriceColumn"]">
                                @if (Chosen(context) is { } chosen)
                                {
                                    <MudNumericField @bind-Value="chosen.UnitPrice" @bind-Value:after="StateHasChanged"
                                                     Margin="Margin.Dense" Min="0" Format="N2" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }

            <MudPaper Elevation="1" Class="pa-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">@L["NewSelfBilledInvoice_OtherLinesTitle"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["NewSelfBilledInvoice_OtherLinesHelp"]
                        </MudText>
                    </MudStack>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">
                        @L["NewSelfBilledInvoice_AddLineButton"]
                    </MudButton>
                </MudStack>

                @if (_lines.Count > 0)
                {
                    <MudTable Items="_lines" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh Style="width: 190px;">@L["NewSelfBilledInvoice_ProductColumn"]</MudTh>
                            <MudTh>@L["NewSelfBilledInvoice_DescriptionColumn"]</MudTh>
                            <MudTh Style="width: 100px;">@L["NewSelfBilledInvoice_QuantityColumn"]</MudTh>
                            <MudTh Style="width: 130px;">@L["NewSelfBilledInvoice_UnitPriceColumn"]</MudTh>
                            <MudTh Style="width: 140px;">@L["NewSelfBilledInvoice_TaxColumn"]</MudTh>
                            <MudTh Style="width: 70px; text-align: right;">@L["NewSelfBilledInvoice_ActionsColumn"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["NewSelfBilledInvoice_ProductColumn"]">
                                <ProductAutocomplete SelectedProduct="context.SelectedProduct"
                                                      ProductChanged="@(product => OnProductChanged(context, product))" />
                            </MudTd>
                            <MudTd DataLabel="@L["NewSelfBilledInvoice_DescriptionColumn"]">
                                <MudTextField @bind-Value="context.ProductDescription" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd DataLabel="@L["NewSelfBilledInvoice_QuantityColumn"]">
                                <MudNumericField @bind-Value="context.Quantity" @bind-Value:after="StateHasChanged"
                                                 Margin="Margin.Dense" Min="0" />
                            </MudTd>
                            <MudTd DataLabel="@L["NewSelfBilledInvoice_UnitPriceColumn"]">
                                <MudNumericField @bind-Value="context.UnitPrice" @bind-Value:after="StateHasChanged"
                                                 Margin="Margin.Dense" Min="0" Format="N2" />
                            </MudTd>
                            <MudTd DataLabel="@L["NewSelfBilledInvoice_TaxColumn"]">
                                <MudSelect T="string" Value="context.TaxCode"
                                           ValueChanged="@(code => OnTaxCodeChanged(context, code))"
                                           Margin="Margin.Dense">
                                    @foreach (var rate in _taxRates)
                                    {
                                        <MudSelectItem T="string" Value="@rate.Code">@rate.Label (@rate.Percentage.ToString("0.##")%)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd DataLabel="@L["NewSelfBilledInvoice_ActionsColumn"]" Style="text-align: right;">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error" OnClick="@(() => _lines.Remove(context))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["NewSelfBilledInvoice_NoLines"]</MudText>
                }

                @if (_lines.Any(line => line.TaxCode == "ISE"))
                {
                    <MudGrid Class="mt-3">
                        <MudItem xs="12" md="6">
                            <MudSelect T="string" @bind-Value="_exemptionCode" @bind-Value:after="StateHasChanged"
                                       Label="@L["NewInvoice_ExemptionCodePlaceholder"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       Required="true" Error="@string.IsNullOrWhiteSpace(_exemptionCode)">
                                @foreach (var reason in TaxExemptionReasons.All)
                                {
                                    <MudSelectItem T="string" Value="@reason.Code">@reason.Code — @reason.Description</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                }
            </MudPaper>

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Row="true" Spacing="6">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NewSelfBilledInvoice_NetTotalLabel"]</MudText>
                        <MudText Typo="Typo.body1">@NetTotal.ToString("N2")</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NewSelfBilledInvoice_TaxTotalLabel"]</MudText>
                        <MudText Typo="Typo.body1">@TaxTotal.ToString("N2")</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["NewSelfBilledInvoice_TotalLabel"]</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Primary">@GrossTotal.ToString("N2")</MudText>
                    </MudStack>
                </MudStack>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               OnClick="@(() => Navigation.NavigateTo("self-billed-invoices"))">
                        @L["NewSelfBilledInvoice_CancelButton"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Receipt"
                               Disabled="@(_saving || !CanIssue)"
                               OnClick="IssueAsync">
                        @(_saving ? L["NewSelfBilledInvoice_IssuingButton"] : L["NewSelfBilledInvoice_IssueButton"])
                    </MudButton>
                </MudStack>
            </MudStack>
        }
    }
</MudStack>

@code {
    private bool _saving;
    private string? _error;

    private Partner? _selectedSupplier;
    private Guid? _supplierId;
    private Guid? _seriesId;
    private DateTime? _issueDate = DateTime.Today;
    private string _agreementReference = string.Empty;
    private string? _exemptionCode;

    private List<SalesSeries> _series = [];
    private List<UnbilledReceiptLine> _unbilled = [];
    private List<VatRate> _taxRates = [];

    private readonly List<ChosenLine> _chosen = [];
    private readonly List<FreeLine> _lines = [];

    private IEnumerable<FreeLine> ValidLines =>
        _lines.Where(line => line.Quantity > 0 && !string.IsNullOrWhiteSpace(line.ProductCode));

    private decimal NetTotal =>
        _chosen.Where(line => line.Quantity > 0).Sum(line => Round(line.Quantity * line.UnitPrice))
        + ValidLines.Sum(line => Round(line.Quantity * line.UnitPrice));

    private decimal TaxTotal =>
        _chosen.Where(line => line.Quantity > 0)
            .Sum(line => Round(Round(line.Quantity * line.UnitPrice) * line.TaxPercentage / 100m))
        + ValidLines.Sum(line => Round(Round(line.Quantity * line.UnitPrice) * line.TaxPercentage / 100m));

    private decimal GrossTotal => NetTotal + TaxTotal;

    private bool NeedsExemptionReason => ValidLines.Any(line => line.TaxCode == "ISE");

    private bool CanIssue =>
        _supplierId is not null
        && _seriesId is not null
        && (_chosen.Any(line => line.Quantity > 0) || ValidLines.Any())
        && (!NeedsExemptionReason || !string.IsNullOrWhiteSpace(_exemptionCode));

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(async () =>
    {
        _selectedSupplier = null;
        _supplierId = null;
        _seriesId = null;
        _chosen.Clear();
        _lines.Clear();
        _unbilled = [];
        await LoadAsync();
    });

    private async Task LoadAsync()
    {
        if (!Company.HasCompany)
        {
            _error = Company.LoadError;
            StateHasChanged();
            return;
        }

        try
        {
            _error = null;

            // Mainland rates — this document has no fiscal-region selector of its own.
            var (rates, _) = await Catalog.GetVatRatesAsync();
            _taxRates = [.. rates.Where(x => x.FiscalRegion == "PT" && x.IsActive)];

            // Only series marked for self-billing, and only those the tax authority has validated:
            // anything else would put these documents in the wrong chain and the wrong file.
            var series = await SeriesApi.GetSeriesAsync(Company.SelectedCompanyId);
            _series = [.. series.Where(x => x.SelfBilling && x.CanIssue)];
            _seriesId ??= _series.FirstOrDefault()?.Id;
        }
        catch (Exception ex)
        {
            _error = string.Format(L["NewSelfBilledInvoice_LoadError"], ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task OnSupplierChangedAsync(Partner? supplier)
    {
        _selectedSupplier = supplier;
        _supplierId = supplier?.Id;
        _chosen.Clear();
        _unbilled = [];

        if (_supplierId is null)
        {
            StateHasChanged();
            return;
        }

        try
        {
            var (pending, error) = await Purchasing.GetUnbilledReceiptLinesAsync(
                Company.SelectedCompanyId, _supplierId);

            _unbilled = [.. pending];
            _error = error;
        }
        catch (Exception ex)
        {
            _error = string.Format(L["NewSelfBilledInvoice_UnbilledLoadError"], ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private ChosenLine? Chosen(UnbilledReceiptLine line) =>
        _chosen.FirstOrDefault(chosen => chosen.ReceiptLineId == line.ReceiptLineId);

    private bool IsChosen(UnbilledReceiptLine line) => Chosen(line) is not null;

    private void Toggle(UnbilledReceiptLine line, bool chosen)
    {
        var existing = Chosen(line);

        if (chosen && existing is null)
        {
            _chosen.Add(new ChosenLine
            {
                ReceiptLineId = line.ReceiptLineId,
                ReceiptId = line.ReceiptId,
                ProductCode = line.ProductCode,
                ProductDescription = line.ProductDescription,
                UnitOfMeasure = line.UnitOfMeasure,
                Quantity = line.PendingQuantity,
                UnitPrice = line.UnitCost
            });
        }
        else if (!chosen && existing is not null)
        {
            _chosen.Remove(existing);
        }

        StateHasChanged();
    }

    private void SetQuantity(ChosenLine chosen, UnbilledReceiptLine line, decimal quantity)
    {
        chosen.Quantity = Math.Clamp(quantity, 0m, line.PendingQuantity);
        StateHasChanged();
    }

    private void AddLine() => _lines.Add(new FreeLine());

    private void OnProductChanged(FreeLine line, ProductListItem? product)
    {
        line.SelectedProduct = product;

        if (product is null)
            return;

        line.ProductCode = product.ProductCode;
        line.ProductDescription = product.Description;
        line.UnitOfMeasure = product.UnitOfMeasure;
        line.UnitPrice = product.UnitCost;
        OnTaxCodeChanged(line, product.DefaultTaxCode);
    }

    private void OnTaxCodeChanged(FreeLine line, string taxCode)
    {
        line.TaxCode = taxCode;
        line.TaxPercentage = _taxRates.FirstOrDefault(rate => rate.Code == taxCode)?.Percentage ?? 0m;
        StateHasChanged();
    }

    private async Task IssueAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var lines = _chosen
                .Where(line => line.Quantity > 0)
                .Select(line => new SelfBilledInvoiceLineRequest(
                    line.ProductCode,
                    line.ProductDescription,
                    line.Quantity,
                    line.UnitPrice,
                    line.TaxPercentage,
                    line.TaxCode,
                    "PT",
                    line.UnitOfMeasure,
                    line.ReceiptLineId,
                    line.ReceiptId))
                .Concat(ValidLines.Select(line => new SelfBilledInvoiceLineRequest(
                    line.ProductCode.Trim(),
                    string.IsNullOrWhiteSpace(line.ProductDescription)
                        ? line.ProductCode.Trim()
                        : line.ProductDescription.Trim(),
                    line.Quantity,
                    line.UnitPrice,
                    line.TaxPercentage,
                    line.TaxCode,
                    "PT",
                    line.UnitOfMeasure,
                    TaxExemptionCode: line.TaxCode == "ISE" ? _exemptionCode : null)))
                .ToList();

            var (invoice, error) = await Purchasing.IssueSelfBilledInvoiceAsync(
                new IssueSelfBilledInvoiceRequest(
                    Company.SelectedCompanyId,
                    _supplierId!.Value,
                    _seriesId!.Value,
                    DateOnly.FromDateTime(_issueDate ?? DateTime.Today),
                    lines,
                    string.IsNullOrWhiteSpace(_agreementReference) ? null : _agreementReference.Trim()));

            if (invoice is null)
            {
                _error = error ?? L["NewSelfBilledInvoice_IssueFallbackError"];
                return;
            }

            Snackbar.Add(string.Format(L["NewSelfBilledInvoice_IssueSuccess"], invoice.DocumentNumber), Severity.Success);
            Navigation.NavigateTo($"self-billed-invoices/{invoice.Id}");
        }
        catch (Exception ex)
        {
            _error = string.Format(L["NewSelfBilledInvoice_IssueError"], ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private static decimal Round(decimal value) => Math.Round(value, 2, MidpointRounding.AwayFromZero);


    private sealed class ChosenLine
    {
        public Guid ReceiptLineId { get; set; }
        public Guid ReceiptId { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductDescription { get; set; } = string.Empty;
        public string UnitOfMeasure { get; set; } = "UN";
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public string TaxCode { get; set; } = "NOR";
        public decimal TaxPercentage { get; set; } = 23m;
    }

    private sealed class FreeLine
    {
        /// <summary>The article behind the autocomplete's box, kept whole so the box can show its
        /// code without a lookup back into a catalogue that is never held in full.</summary>
        public ProductListItem? SelectedProduct { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductDescription { get; set; } = string.Empty;
        public string UnitOfMeasure { get; set; } = "UN";
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public string TaxCode { get; set; } = "NOR";
        public decimal TaxPercentage { get; set; } = 23m;
    }

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
