@page "/inventory-counts/new"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject StockApiClient StockApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@Localizer["InventoryCountOpen_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@Localizer["InventoryCountOpen_PageTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Localizer["InventoryCountOpen_Subtitle"]
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("inventory-counts"))">
            @Localizer["InventoryCountOpen_BackButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (!Company.HasCompany)
    {
        <MudAlert Severity="Severity.Info">@Localizer["InventoryCountOpen_ChooseCompanyNotice"]</MudAlert>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_reference" @bind-Value:after="StateHasChanged" Immediate="true"
                                  Label="@Localizer["InventoryCountOpen_ReferenceLabel"]" Variant="Variant.Outlined" Required="true"
                                  HelperText="@Localizer["InventoryCountOpen_ReferenceHelperText"]" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_countDate" Label="@Localizer["InventoryCountOpen_CountDateLabel"]"
                                   Variant="Variant.Outlined" DateFormat="yyyy-MM-dd"
                                   HelperText="@Localizer["InventoryCountOpen_CountDateHelperText"]" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="Guid?" @bind-Value="_warehouseId" Label="@Localizer["InventoryCountOpen_WarehouseLabel"]"
                               Variant="Variant.Outlined" Clearable="true"
                               HelperText="@Localizer["InventoryCountOpen_WarehouseHelperText"]">
                        @foreach (var warehouse in _warehouses)
                        {
                            <MudSelectItem T="Guid?" Value="@warehouse.Id">
                                @warehouse.Code — @warehouse.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_productCodes" Label="@Localizer["InventoryCountOpen_ProductsLabel"]"
                                  Variant="Variant.Outlined" Lines="2"
                                  HelperText="@Localizer["InventoryCountOpen_ProductsHelperText"]" />
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch @bind-Value="_startAtZero" @bind-Value:after="StateHasChanged"
                               Color="Color.Warning" Label="@Localizer["InventoryCountOpen_StartAtZeroLabel"]" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @Localizer["InventoryCountOpen_StartAtZeroHelperText"]
                    </MudText>
                </MudItem>

                @if (_startAtZero)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            @Localizer["InventoryCountOpen_StartAtZeroWarning"]
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text"
                       OnClick="@(() => Navigation.NavigateTo("inventory-counts"))">
                @Localizer["InventoryCountOpen_CancelButton"]
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                       Disabled="@(_saving || string.IsNullOrWhiteSpace(_reference))"
                       OnClick="OpenAsync">
                @(_saving ? Localizer["InventoryCountOpen_Opening"] : Localizer["InventoryCountOpen_OpenButton"])
            </MudButton>
        </MudStack>
    }
</MudStack>

@code {
    private bool _saving;
    private string? _error;

    private string _reference = $"INV{DateTime.Today:yyyyMMdd}";
    private DateTime? _countDate = DateTime.Today;
    private Guid? _warehouseId;
    private string _productCodes = string.Empty;
    private bool _startAtZero;

    private List<Warehouse> _warehouses = [];

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadWarehousesAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadWarehousesAsync);

    private async Task LoadWarehousesAsync()
    {
        if (!Company.HasCompany)
        {
            _warehouses = [];
            _error = Company.LoadError;
            StateHasChanged();
            return;
        }

        try
        {
            var (warehouses, error) = await StockApi.GetWarehousesAsync(Company.SelectedCompanyId);
            _warehouses = [.. warehouses.Where(warehouse => warehouse.IsActive)];
            _error = error;
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["InventoryCountOpen_LoadWarehousesError"], ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task OpenAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var request = new OpenInventoryCountRequest(
                Company.SelectedCompanyId,
                _reference.Trim(),
                DateOnly.FromDateTime(_countDate ?? DateTime.Today),
                _warehouseId,
                ParseProductCodes(),
                _startAtZero);

            var (count, error) = await StockApi.OpenInventoryCountAsync(request);

            if (count is null)
            {
                _error = error ?? Localizer["InventoryCountOpen_OpenFailed"];
                return;
            }

            Snackbar.Add(string.Format(Localizer["InventoryCountOpen_Opened"], count.Reference, count.LineCount), Severity.Success);
            Navigation.NavigateTo($"inventory-counts/{count.Id}");
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["InventoryCountOpen_OpenError"], ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// The codes are typed by hand, so both a comma-separated line and one code per line have to
    /// work. An empty list means the whole scope, which the API reads as null.
    /// </summary>
    private IReadOnlyList<string>? ParseProductCodes()
    {
        var codes = _productCodes
            .Split([',', ';', '\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.Ordinal)
            .ToList();

        return codes.Count == 0 ? null : codes;
    }

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
