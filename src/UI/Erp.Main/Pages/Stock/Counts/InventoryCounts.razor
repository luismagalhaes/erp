@page "/inventory-counts"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject StockApiClient StockApi
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Inventários</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Inventários</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Contagens às existências, totais ou parciais. Ao fechar, a diferença entre o contado e
                o sistema entra como movimento de acerto.
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(!Company.HasCompany || _openCount is not null)"
                   OnClick="@(() => Navigation.NavigateTo("inventory-counts/new"))">
            Abrir contagem
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (!Company.HasCompany)
    {
        <MudAlert Severity="Severity.Info">Escolha uma empresa no cabeçalho.</MudAlert>
    }
    else
    {
        @if (_openCount is not null)
        {
            <MudAlert Severity="Severity.Info">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="width-full">
                    <div>
                        A contagem <strong>@_openCount.Reference</strong> está aberta, com
                        @_openCount.LineCount @(_openCount.LineCount == 1 ? "artigo" : "artigos").
                        Enquanto estiver aberta não é possível abrir outra.
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => Open(_openCount.Id))">
                        Continuar
                    </MudButton>
                </MudStack>
            </MudAlert>
        }

        <MudPaper Elevation="1" Class="pa-2">
            <MudTable Items="_counts" Hover="true" Striped="true" Dense="true" Loading="_loading"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Referência</MudTh>
                    <MudTh>Data</MudTh>
                    <MudTh>Âmbito</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh Style="text-align: right;">Artigos</MudTh>
                    <MudTh Style="text-align: right;">Com diferença</MudTh>
                    <MudTh>Fechada em</MudTh>
                    <MudTh Style="text-align: right;">Ações</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Referência">
                        <MudText Typo="Typo.body2"><strong>@context.Reference</strong></MudText>
                    </MudTd>
                    <MudTd DataLabel="Data">@context.CountDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Âmbito">
                        <MudText Typo="Typo.body2">@ScopeLabel(context)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Estado">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(context.IsOpen ? Color.Warning : Color.Success)">
                            @(context.IsOpen ? "Aberta" : "Fechada")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Artigos" Style="text-align: right;">@context.LineCount</MudTd>
                    <MudTd DataLabel="Com diferença" Style="text-align: right;">
                        <MudText Typo="Typo.body2"
                                 Color="@(context.LinesWithDifference == 0 ? Color.Default : Color.Warning)">
                            @context.LinesWithDifference
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Fechada em">
                        @(context.ClosedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                    </MudTd>
                    <MudTd DataLabel="Ações" Style="text-align: right;">
                        <MudTooltip Text="@(context.IsOpen ? "Continuar a contagem" : "Ver a contagem")">
                            <MudIconButton Size="Size.Small"
                                           Icon="@(context.IsOpen ? Icons.Material.Filled.Edit : Icons.Material.Filled.Visibility)"
                                           OnClick="@(() => Open(context.Id))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Ainda não há contagens.
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    }
</MudStack>

@code {
    private bool _loading;
    private string? _error;
    private List<InventoryCount> _counts = [];

    /// <summary>Only one count may be open at a time, so it is worth surfacing on its own.</summary>
    private InventoryCount? _openCount => _counts.FirstOrDefault(count => count.IsOpen);

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        if (!Company.HasCompany)
        {
            _counts = [];
            _error = Company.LoadError;
            StateHasChanged();
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var (items, error) = await StockApi.GetInventoryCountsAsync(Company.SelectedCompanyId);
            _counts = [.. items.OrderByDescending(count => count.CreatedAtUtc)];
            _error = error;
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar as contagens: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void Open(Guid id) => Navigation.NavigateTo($"inventory-counts/{id}");

    private static string ScopeLabel(InventoryCount count) => count.Scope switch
    {
        "Total" => "Empresa inteira",
        "Warehouse" => "Um armazém",
        "Products" => "Artigos escolhidos",
        _ => count.Scope
    };

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
