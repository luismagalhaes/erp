{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "OidcConfiguration": {
    "Authority": "https://localhost:7081",
    "ClientId": "blazor-wasm",
    "ResponseType": "code",
    "DefaultScopes": [
      "openid",
      "profile",
      "email",
      "offline_access"
    ],
    "PostLogoutRedirectUri": "https://localhost:7019/authentication/logout-callback",
    "RedirectUri": "https://localhost:7019/authentication/login-callback"
  },
  "Services": {
    "CoreApi": "https://localhost:7072",
    "SalesApi": "https://localhost:7163",
    "InventoryApi": "https://localhost:7283",
    "PurchasingApi": "https://localhost:7245",
    "AccountingApi": "https://localhost:7212",
    "ReportingApi": "https://localhost:7156",
    "NotificationApi": "https://localhost:7117",
    "IdentityApi": "https://localhost:7081"
  }
}
