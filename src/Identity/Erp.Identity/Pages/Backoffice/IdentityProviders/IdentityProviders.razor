@page "/Backoffice/IdentityProviders"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using IdentityResourcesType = Erp.Identity.Resources.IdentityResources
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IIdentityProviderService IdentityProviderService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<IdentityResourcesType> Localizer

<PageTitle>@Localizer["Backoffice_IdentityProviders_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Backoffice_IdentityProviders_PageTitle"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Navigation.NavigateTo("/Backoffice/IdentityProviders/new"))">
                @Localizer["Backoffice_IdentityProviders_CreateAction"]
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="IdentityProviderListItem" Items="@_items" Loading="@_loading"
              SearchFields="@_searchFields"
              SearchPlaceholder="@Localizer["Backoffice_Common_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.AccountTree"
              EmptyTitle="@Localizer["Backoffice_Common_NoRecords"]"
              ItemsLabel="@Localizer["Backoffice_IdentityProviders_ItemsLabel"]"
              OnRefresh="LoadAsync">
        <Columns>
            <PropertyColumn Property="x => x.Scheme" Title="@Localizer["Backoffice_IdentityProviders_SchemeColumn"]" />
            <PropertyColumn Property="x => x.DisplayName" Title="@Localizer["Backoffice_Common_DisplayNameColumn"]" />
            <PropertyColumn Property="x => x.Type" Title="@Localizer["Backoffice_IdentityProviders_TypeColumn"]" />
            <PropertyColumn Property="x => x.Enabled" Title="@Localizer["Backoffice_Common_EnabledColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.Enabled ? Color.Success : Color.Default)">
                        @(context.Item.Enabled ? Localizer["Backoffice_Common_Yes"] : Localizer["Backoffice_Common_No"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true" CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                     OnClick="@(() => Navigation.NavigateTo($"/Backoffice/IdentityProviders/{Uri.EscapeDataString(context.Item.Scheme)}"))">
                            @Localizer["Backoffice_Common_EditAction"]
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                     OnClick="@(() => DeleteAsync(context.Item.Scheme))">
                            @Localizer["Backoffice_Common_DeleteAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly Func<IdentityProviderListItem, string?>[] _searchFields = [x => x.Scheme, x => x.DisplayName];

    private List<IdentityProviderListItem> _items = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _items = (await IdentityProviderService.GetIdentityProvidersAsync()).ToList();
        _loading = false;
    }

    private async Task DeleteAsync(string scheme)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Localizer["Backoffice_IdentityProviders_DeleteHeading"].Value,
            string.Format(Localizer["Backoffice_Common_DeleteConfirm"], scheme),
            yesText: Localizer["Backoffice_Common_DeleteButton"].Value,
            cancelText: Localizer["Backoffice_Common_CancelButton"].Value);

        if (confirmed != true)
            return;

        await IdentityProviderService.DeleteIdentityProviderAsync(scheme);
        Snackbar.Add(Localizer["Backoffice_IdentityProviders_Deleted"].Value, Severity.Success);
        await LoadAsync();
    }
}
