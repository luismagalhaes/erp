@page "/supplier-invoices"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject PurchasingApiClient Purchasing
@inject CompanyState Company
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["SupplierInvoices_Title"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@L["SupplierInvoices_Title"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("supplier-invoices/new"))">
                @L["SupplierInvoices_NewAction"]
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="PurchaseInvoiceListItem"
              LoadAsync="@((companyId, query, ct) => Purchasing.QueryInvoicesAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="SupplierDocumentDate desc,SupplierDocumentNumber desc"
              SearchPlaceholder="@L["SupplierInvoices_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.ReceiptLong"
              EmptyTitle="@L["SupplierInvoices_EmptyTitle"]"
              EmptyDescription="@L["SupplierInvoices_EmptyDescription"]"
              ItemsLabel="@L["SupplierInvoices_ItemsLabel"]"
              LoadErrorMessage="@L["SupplierInvoices_LoadErrorMessage"]">
        <Columns>
            <PropertyColumn Property="x => x.DocumentType" Title="@L["SupplierInvoices_TypeColumn"]" />
            <PropertyColumn Property="x => x.SupplierDocumentNumber" Title="@L["SupplierInvoices_NumberColumn"]" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.SupplierDocumentDate" Title="@L["SupplierInvoices_DateColumn"]" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.DueDate" Title="@L["SupplierInvoices_DueDateColumn"]">
                <CellTemplate>
                    <MudText Typo="Typo.body2" Color="@DueColor(context.Item)">
                        @(context.Item.DueDate?.ToString("yyyy-MM-dd") ?? "—")
                    </MudText>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.SupplierName" Title="@L["SupplierInvoices_SupplierColumn"]" />
            <PropertyColumn Property="x => x.SupplierTaxId" Title="@L["SupplierInvoices_TaxIdColumn"]" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.NetTotal" Title="@L["SupplierInvoices_NetTotalColumn"]" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.TaxTotal" Title="@L["SupplierInvoices_TaxTotalColumn"]" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.GrossTotal" Title="@L["SupplierInvoices_GrossTotalColumn"]" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.ReverseCharge" Title="@L["SupplierInvoices_ReverseChargeColumn"]">
                <CellTemplate>
                    @if (context.Item.ReverseCharge)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                            @L["SupplierInvoices_ReverseChargeChip"]
                        </MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">—</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Status" Title="@L["SupplierInvoices_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.IsVoided ? Color.Error : Color.Success)">
                        @(context.Item.IsVoided ? L["SupplierInvoices_VoidedStatus"] : L["SupplierInvoices_BookedStatus"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"supplier-invoices/{context.Item.Id}"))">
                            @L["SupplierInvoices_OpenAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["SupplierDocumentNumber", "SupplierName", "SupplierTaxId"];

    /// <summary>An unpaid invoice past its date is worth pointing at; a voided one is owed nothing.</summary>
    private static Color DueColor(PurchaseInvoiceListItem invoice) =>
        !invoice.IsVoided && invoice.DueDate is { } due && due < DateOnly.FromDateTime(DateTime.Today)
            ? Color.Error
            : Color.Default;
}
