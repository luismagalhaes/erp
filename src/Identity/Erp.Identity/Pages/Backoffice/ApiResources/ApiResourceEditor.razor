@page "/Backoffice/ApiResources/new"
@page "/Backoffice/ApiResources/{Name}"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using IdentityResourcesType = Erp.Identity.Resources.IdentityResources
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IApiResourceService ApiResourceService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<IdentityResourcesType> Localizer

<PageTitle>@(IsNew ? Localizer["Backoffice_ApiResources_CreateHeading"] : Localizer["Backoffice_ApiResources_EditHeading"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">@(IsNew ? Localizer["Backoffice_ApiResources_CreateHeading"] : Localizer["Backoffice_ApiResources_EditHeading"])</MudText>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("/Backoffice/ApiResources"))">
            @Localizer["Backoffice_Common_Back"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="1">
            <MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pa-4 erp-form">
                <MudTabPanel Text="@Localizer["Backoffice_ApiResources_Tab_MainInfo"].Value" Icon="@Icons.Material.Filled.Info">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_name" Label="@Localizer["Backoffice_Common_NameLabel"]" Variant="Variant.Outlined" Required="true" Disabled="@(!IsNew)" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_displayName" Label="@Localizer["Backoffice_Common_DisplayNameLabel"]" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_description" Label="@Localizer["Backoffice_Common_DescriptionLabel"]" Variant="Variant.Outlined" Lines="2" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="_enabled" Color="Color.Primary" Label="@Localizer["Backoffice_Common_EnabledLabel"]" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="_showInDiscoveryDocument" Color="Color.Primary" Label="@Localizer["Backoffice_Common_ShowInDiscoveryDocumentLabel"]" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="_requireResourceIndicator" Color="Color.Primary" Label="@Localizer["Backoffice_ApiResources_RequireResourceIndicatorLabel"]" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="@Localizer["Backoffice_ApiResources_Tab_Scopes"].Value" Icon="@Icons.Material.Filled.Security">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pb-2">@Localizer["Backoffice_ApiResources_ScopesLabel"]</MudText>
                    <StringListEditor Items="_scopes" AddLabel="@Localizer["Backoffice_ApiResources_AddScopeButton"].Value" />
                </MudTabPanel>

                <MudTabPanel Text="@Localizer["Backoffice_ApiResources_Tab_UserClaims"].Value" Icon="@Icons.Material.Filled.Badge">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pb-2">@Localizer["Backoffice_ApiResources_UserClaimsLabel"]</MudText>
                    <StringListEditor Items="_userClaims" AddLabel="@Localizer["Backoffice_ApiResources_AddClaimButton"].Value" />
                </MudTabPanel>
            </MudTabs>

            <MudStack Row="true" Justify="Justify.FlexEnd" Class="pa-4 pt-0">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_saving || string.IsNullOrWhiteSpace(_name))"
                           OnClick="SaveAsync">
                    @Localizer["Backoffice_Common_SaveButton"]
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter] public string? Name { get; set; }

    private bool IsNew => string.IsNullOrEmpty(Name);

    private bool _loading;
    private bool _saving;
    private string? _error;

    private string _name = string.Empty;
    private string? _displayName;
    private string? _description;
    private bool _enabled = true;
    private bool _showInDiscoveryDocument = true;
    private bool _requireResourceIndicator;
    private List<string> _scopes = [];
    private List<string> _userClaims = [];

    protected override async Task OnParametersSetAsync()
    {
        _error = null;

        if (IsNew)
            return;

        _loading = true;

        try
        {
            var item = await ApiResourceService.GetApiResourceAsync(Name!);
            if (item is null)
            {
                _error = Localizer["Backoffice_Common_ErrorNameRequired"];
                return;
            }

            _name = item.Name;
            _displayName = item.DisplayName;
            _description = item.Description;
            _enabled = item.Enabled;
            _showInDiscoveryDocument = item.ShowInDiscoveryDocument;
            _requireResourceIndicator = item.RequireResourceIndicator;
            _scopes = SanitizeList(item.Scopes);
            _userClaims = SanitizeList(item.UserClaims);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var request = new ApiResourceUpsertRequest(
                _name.Trim(),
                (_displayName ?? string.Empty).Trim(),
                (_description ?? string.Empty).Trim(),
                _enabled,
                _showInDiscoveryDocument,
                _requireResourceIndicator,
                SanitizeList(_scopes),
                SanitizeList(_userClaims));

            if (IsNew)
            {
                await ApiResourceService.CreateApiResourceAsync(request);
                Snackbar.Add(Localizer["Backoffice_ApiResources_Created"].Value, Severity.Success);
            }
            else
            {
                await ApiResourceService.UpdateApiResourceAsync(Name!, request);
                Snackbar.Add(Localizer["Backoffice_ApiResources_Updated"].Value, Severity.Success);
            }

            Navigation.NavigateTo("/Backoffice/ApiResources");
        }
        finally
        {
            _saving = false;
        }
    }

    private static List<string> SanitizeList(IEnumerable<string> values)
        => values
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
}
