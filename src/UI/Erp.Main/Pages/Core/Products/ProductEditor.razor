@page "/products/new"
@page "/products/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>@(IsNew ? "Novo artigo" : "Editar artigo")</PageTitle>

<MudStack Spacing="3">
    <PageHeader Title="@(IsNew ? "Novo artigo" : "Editar artigo")"
                Breadcrumbs="Breadcrumbs">
        <Actions>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("products"))">
                Voltar
            </MudButton>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <EditorCard Title="Artigo" Icon="@Icons.Material.Filled.Inventory2">
            <HeaderActions>
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Category"
                           OnClick="@(() => Navigation.NavigateTo("product-families"))">Famílias</MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Sell"
                           OnClick="@(() => Navigation.NavigateTo("brands"))">Marcas</MudButton>
                @if (!IsNew)
                {
                    <MudSwitch @bind-Value="_isActive" Color="Color.Primary" Size="Size.Small" Label="Ativo" />
                }
            </HeaderActions>
            <ChildContent>
                <MudGrid>
                    <MudItem xs="12" sm="3" md="2">
                        <MudTextField @bind-Value="_productCode" Label="Código" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Required="true" Disabled="@(!IsNew)" />
                    </MudItem>
                    <MudItem xs="12" sm="9" md="6">
                        <MudTextField @bind-Value="_description" Label="Descrição" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudTextField @bind-Value="_barcode" Label="Código de barras" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect @bind-Value="_productType" Label="Tipo" Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@("P")">Produto</MudSelectItem>
                            <MudSelectItem T="string" Value="@("S")">Serviço</MudSelectItem>
                            <MudSelectItem T="string" Value="@("O")">Outro</MudSelectItem>
                            <MudSelectItem T="string" Value="@("I")">Impostos e taxas</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="4" md="4">
                        <MudSelect T="Guid?" Value="_familyId" ValueChanged="OnFamilyChanged"
                                   Label="Família" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var family in _families)
                            {
                                <MudSelectItem T="Guid?" Value="@family.Id">@family.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="4">
                        <MudSelect T="Guid?" @bind-Value="_subfamilyId" Label="Subfamília" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Clearable="true" Disabled="@(_familyId is null)">
                            @foreach (var subfamily in AvailableSubfamilies)
                            {
                                <MudSelectItem T="Guid?" Value="@subfamily.Id">@subfamily.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="4">
                        <MudSelect T="Guid?" @bind-Value="_brandId" Label="Marca" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Clearable="true">
                            @foreach (var brand in _brands)
                            {
                                <MudSelectItem T="Guid?" Value="@brand.Id">@brand.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="6" sm="3" md="2">
                        <MudNumericField @bind-Value="_unitPrice" Label="Preço unitário" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Min="0" Format="N2" />
                    </MudItem>
                    <MudItem xs="6" sm="3" md="2">
                        <MudNumericField @bind-Value="_unitCost" Label="Custo unitário" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Min="0" Format="N2" />
                    </MudItem>
                    <MudItem xs="6" sm="2" md="2">
                        <MudTextField @bind-Value="_unitOfMeasure" Label="Unidade" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="2" md="2">
                        <MudSelect T="string" Value="_taxCode" ValueChanged="OnTaxCodeChanged"
                                   Label="IVA" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var rate in TaxRates)
                            {
                                <MudSelectItem T="string" Value="@rate.Code">@rate.Label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="2" md="2">
                        <MudSelect @bind-Value="_taxCountryRegion" Label="Espaço fiscal" Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@("PT")">Continente</MudSelectItem>
                            <MudSelectItem T="string" Value="@("PT-AC")">Açores</MudSelectItem>
                            <MudSelectItem T="string" Value="@("PT-MA")">Madeira</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="12" md="2">
                        <MudSelect @bind-Value="_inventoryCategory" Label="Cat. inventário"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var category in InventoryCategories.All)
                            {
                                <MudSelectItem T="string" Value="@category.Code">
                                    @category.Code — @category.Label
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    @if (_inventoryCategory == "B")
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Ativos biológicos só existem no formato valorizado (2_01). Numa comunicação
                                só com quantidades, este artigo vai como mercadoria.
                            </MudAlert>
                        </MudItem>
                    }
                </MudGrid>
            </ChildContent>
        </EditorCard>

        <FormActions Busy="_saving" Disabled="@(!CanSave)"
                     Hint="@(CanSave ? null : "Preencha o código e a descrição para poder guardar.")"
                     OnSubmit="SaveAsync"
                     OnCancel="@(() => Navigation.NavigateTo("products"))" />
    }
</MudStack>

@code {
    private List<BreadcrumbItem> Breadcrumbs =>
    [
        new("Artigos", href: "products"),
        new(IsNew ? "Novo artigo" : "Editar artigo", href: null, disabled: true)
    ];

    private static readonly TaxRateOption[] TaxRates =
    [
        new("NOR", 23m, "Normal - 23%"),
        new("INT", 13m, "Intermédia - 13%"),
        new("RED", 6m, "Reduzida - 6%"),
        new("ISE", 0m, "Isento")
    ];

    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNew => Id is null;

    private bool _loading;
    private bool _saving;
    private string? _error;

    private bool _loaded;
    private Guid? _loadedId;

    private string _productCode = string.Empty;
    private string _description = string.Empty;
    private string _barcode = string.Empty;
    private string _productType = "P";
    private string _inventoryCategory = "M";
    private string _unitOfMeasure = "UN";
    private decimal _unitPrice;
    private decimal _unitCost;
    private string _taxCode = "NOR";
    private decimal _taxPercentage = 23m;
    private string _taxCountryRegion = "PT";
    private bool _isActive = true;

    private Guid? _familyId;
    private Guid? _subfamilyId;
    private Guid? _brandId;

    private List<ProductFamily> _families = [];
    private List<ProductSubfamily> _subfamilies = [];
    private List<Brand> _brands = [];

    private IEnumerable<ProductSubfamily> AvailableSubfamilies =>
        _subfamilies.Where(subfamily => subfamily.FamilyId == _familyId);

    private bool CanSave =>
        Company.HasCompany
        && !string.IsNullOrWhiteSpace(_productCode)
        && !string.IsNullOrWhiteSpace(_description);

    protected override async Task OnParametersSetAsync()
    {
        await Company.EnsureLoadedAsync();

        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loaded && _loadedId == Id)
            return;

        _loaded = true;
        _loadedId = Id;
        _loading = true;

        try
        {
            await LoadClassificationAsync();

            if (IsNew)
                return;

            var product = await Catalog.GetProductAsync(Id!.Value);

            if (product is null)
            {
                _error = "Artigo não encontrado.";
                return;
            }

            _productCode = product.ProductCode;
            _description = product.Description;
            _barcode = product.Barcode ?? string.Empty;
            _productType = product.ProductType;
            _inventoryCategory = product.InventoryCategory;
            _unitOfMeasure = product.UnitOfMeasure;
            _unitPrice = product.UnitPrice;
            _unitCost = product.UnitCost;
            _taxCode = product.DefaultTaxCode;
            _taxPercentage = product.DefaultTaxPercentage;
            _familyId = product.FamilyId;
            _subfamilyId = product.SubfamilyId;
            _brandId = product.BrandId;
            _isActive = product.IsActive;
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar o artigo: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadClassificationAsync()
    {
        if (!Company.HasCompany)
            return;

        var (families, familiesError) = await Catalog.GetFamiliesAsync(Company.SelectedCompanyId);
        _families = [.. families.Where(family => family.IsActive)];

        var (subfamilies, _) = await Catalog.GetSubfamiliesAsync(Company.SelectedCompanyId);
        _subfamilies = [.. subfamilies.Where(subfamily => subfamily.IsActive)];

        var (brands, _) = await Catalog.GetBrandsAsync(Company.SelectedCompanyId);
        _brands = [.. brands.Where(brand => brand.IsActive)];

        _error = familiesError;
    }

    /// <summary>Changing the family clears a subfamily that no longer belongs to it.</summary>
    private void OnFamilyChanged(Guid? familyId)
    {
        _familyId = familyId;

        if (_subfamilyId is not null && !AvailableSubfamilies.Any(subfamily => subfamily.Id == _subfamilyId))
            _subfamilyId = null;
    }

    private void OnTaxCodeChanged(string taxCode)
    {
        _taxCode = taxCode;
        _taxPercentage = TaxRates.First(rate => rate.Code == taxCode).Percentage;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var barcode = string.IsNullOrWhiteSpace(_barcode) ? null : _barcode.Trim();

            var error = IsNew
                ? await Catalog.CreateProductAsync(new CreateProductRequest(
                    Company.SelectedCompanyId,
                    _productCode.Trim(),
                    _description.Trim(),
                    _unitPrice,
                    _productType,
                    _unitOfMeasure,
                    _taxCountryRegion,
                    _taxCode,
                    _taxPercentage,
                    barcode,
                    _familyId,
                    _subfamilyId,
                    _brandId,
                    _unitCost,
                    _inventoryCategory))
                : await Catalog.UpdateProductAsync(Id!.Value, new UpdateProductRequest(
                    _description.Trim(),
                    _unitPrice,
                    _productType,
                    _unitOfMeasure,
                    _taxCountryRegion,
                    _taxCode,
                    _taxPercentage,
                    barcode,
                    _familyId,
                    _subfamilyId,
                    _brandId,
                    _isActive,
                    _unitCost,
                    _inventoryCategory));

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(IsNew ? "Artigo criado." : "Artigo atualizado.", Severity.Success);
            Navigation.NavigateTo("products");
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível guardar o artigo: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed record TaxRateOption(string Code, decimal Percentage, string Label);
}
