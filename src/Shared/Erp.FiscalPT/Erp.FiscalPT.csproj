<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Erp.FiscalPT</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="9.32.0.97167" PrivateAssets="all" />
    <PackageReference Include="QRCoder" Version="1.*" />
    <!-- Only for the signing key provider and AddFiscalPT: abstractions, no hosting baggage. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.*" />
    <!-- For the AT transport-documents SOAP client's typed HttpClient. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official schema travels with the library, so validation never depends on the network. -->
    <EmbeddedResource Include="Saft\Schemas\SAFTPT1.04_01.xsd" />
    <EmbeddedResource Include="Inventory\Schemas\Stock_1_2.xsd" />
    <EmbeddedResource Include="Inventory\Schemas\Inventario_2_01.xsd" />
  </ItemGroup>

</Project>
