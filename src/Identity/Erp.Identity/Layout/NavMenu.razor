@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Erp.Identity.Resources
@inject IStringLocalizer<IdentityResources> Localizer

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">@Localizer["NavMenu_Home"]</MudNavLink>

    @if (_isSuperAdmin)
    {
        <MudNavLink Href="/Backoffice/SessionLogs" Icon="@Icons.Material.Filled.History">@Localizer["NavMenu_SessionLogs"]</MudNavLink>
    }

    @if (_isSuperAdmin)
    {
        <MudNavGroup Title="@Localizer["NavMenu_Backoffice"]"
                     Icon="@Icons.Material.Filled.AdminPanelSettings"
                     @bind-Expanded="_backofficeExpanded">
            <MudNavLink Href="/Backoffice/Users" Icon="@Icons.Material.Filled.People">@Localizer["NavMenu_Users"]</MudNavLink>
            <MudNavLink Href="/Backoffice/OnboardingRequests" Icon="@Icons.Material.Filled.MarkEmailUnread">@Localizer["NavMenu_OnboardingRequests"]</MudNavLink>
            <MudNavLink Href="/Backoffice/Roles"Icon="@Icons.Material.Filled.Security">@Localizer["NavMenu_Roles"]</MudNavLink>
            <MudNavLink Href="/Backoffice/Clients" Icon="@Icons.Material.Filled.Devices">@Localizer["NavMenu_Clients"]</MudNavLink>
            <MudNavLink Href="/Backoffice/ApiScopes" Icon="@Icons.Material.Filled.Key">@Localizer["NavMenu_ApiScopes"]</MudNavLink>
            <MudNavLink Href="/Backoffice/ApiResources" Icon="@Icons.Material.Filled.Api">@Localizer["NavMenu_ApiResources"]</MudNavLink>
            <MudNavLink Href="/Backoffice/IdentityResources" Icon="@Icons.Material.Filled.Badge">@Localizer["NavMenu_IdentityResources"]</MudNavLink>
            <MudNavLink Href="/Backoffice/IdentityProviders" Icon="@Icons.Material.Filled.AccountTree">@Localizer["NavMenu_IdentityProviders"]</MudNavLink>
        </MudNavGroup>
    }

</MudNavMenu>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _backofficeExpanded;
    private bool _isSuperAdmin;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationStateTask is null)
        {
            _isSuperAdmin = false;
            return;
        }

        var authState = await AuthenticationStateTask;
        _isSuperAdmin = authState.User.Identity?.IsAuthenticated == true && authState.User.IsInRole("SuperAdmin");
    }
}
