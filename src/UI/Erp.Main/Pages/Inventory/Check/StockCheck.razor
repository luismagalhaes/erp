@page "/stock/check"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject StockApiClient StockApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> Localizer

<PageTitle>@Localizer["StockCheck_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@Localizer["StockCheck_PageTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Localizer["StockCheck_Subtitle"]
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("stock"))">
            @Localizer["StockCheck_BackButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    <MudPaper Elevation="0" Class="pa-4 erp-card erp-form">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_productCode" @bind-Value:after="StateHasChanged" Immediate="true"
                              Label="@Localizer["StockCheck_ProductLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="@Localizer["StockCheck_ProductHelperText"]" />
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.FactCheck"
                           Disabled="@(_running || !Company.HasCompany)"
                           OnClick="RunAsync">
                    @(_running ? Localizer["StockCheck_Running"] : Localizer["StockCheck_RunButton"])
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_result is not null)
    {
        @if (_result.ProductsWithDifference == 0 && _result.ProductsWithValueDifference == 0)
        {
            <MudAlert Severity="Severity.Success">
                @string.Format(Localizer["StockCheck_SuccessMessage"], _result.ProductsChecked,
                         _result.ProductsChecked == 1 ? Localizer["StockCheck_ProductCheckedSingular"] : Localizer["StockCheck_ProductCheckedPlural"],
                         "", "")
            </MudAlert>
        }
        else
        {
            @if (_result.ProductsWithDifference > 0)
            {
                <MudAlert Severity="Severity.Error">
                    @string.Format(Localizer["StockCheck_QuantityDifferenceMessage"], _result.ProductsWithDifference,
                             _result.ProductsChecked,
                             _result.ProductsWithDifference == 1 ? Localizer["StockCheck_DifferenceSingular"] : Localizer["StockCheck_DifferencePlural"])
                </MudAlert>
            }

            @if (_result.ProductsWithValueDifference > 0)
            {
                <MudAlert Severity="Severity.Warning">
                    @string.Format(Localizer["StockCheck_ValueDifferenceMessage"], _result.ProductsWithValueDifference,
                             _result.ProductsWithValueDifference == 1 ? Localizer["StockCheck_DifferenceSingular"] : Localizer["StockCheck_DifferencePlural"],
                             "", "", "", "")
                </MudAlert>
            }
        }

        <MudPaper Elevation="0" Class="pa-2 erp-card erp-form">
            <MudTable Items="Visible" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@Localizer["StockCheck_ResultTitle"]</MudText>
                    <MudSpacer />
                    <MudSwitch @bind-Value="_onlyDifferences" @bind-Value:after="StateHasChanged"
                               Color="Color.Primary" Label="@Localizer["StockCheck_OnlyDifferencesLabel"]" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>@Localizer["StockCheck_ProductColumn"]</MudTh>
                    <MudTh>@Localizer["StockCheck_DescriptionColumn"]</MudTh>
                    <MudTh>@Localizer["StockCheck_WarehouseColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["StockCheck_RecordedBalanceColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["StockCheck_LedgerSumColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["StockCheck_DifferenceColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["StockCheck_RecordedValueColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["StockCheck_RecalculatedValueColumn"]</MudTh>
                    <MudTh Style="text-align: right;">@Localizer["StockCheck_MovementsColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Localizer["StockCheck_ProductColumn"]">
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.ProductCode</MudText>
                    </MudTd>
                    <MudTd DataLabel="@Localizer["StockCheck_DescriptionColumn"]">
                        @(string.IsNullOrWhiteSpace(context.ProductDescription) ? "—" : context.ProductDescription)
                    </MudTd>
                    <MudTd DataLabel="@Localizer["StockCheck_WarehouseColumn"]">@WarehouseName(context.WarehouseId)</MudTd>
                    <MudTd DataLabel="@Localizer["StockCheck_RecordedBalanceColumn"]" Style="text-align: right;">
                        @context.RecordedQuantity.ToString("N3")
                    </MudTd>
                    <MudTd DataLabel="@Localizer["StockCheck_LedgerSumColumn"]" Style="text-align: right;">
                        @context.LedgerQuantity.ToString("N3")
                    </MudTd>
                    <MudTd DataLabel="@Localizer["StockCheck_DifferenceColumn"]" Style="text-align: right;">
                        <MudText Typo="Typo.body2" Color="@(context.Difference == 0 ? Color.Success : Color.Error)">
                            <strong>@context.Difference.ToString("N3")</strong>
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="@Localizer["StockCheck_RecordedValueColumn"]" Style="text-align: right;">
                        @context.RecordedValue.ToString("N2")
                    </MudTd>
                    <MudTd DataLabel="@Localizer["StockCheck_RecalculatedValueColumn"]" Style="text-align: right;">
                        <MudText Typo="Typo.body2"
                                 Color="@(context.ValueDifference == 0 ? Color.Default : Color.Error)">
                            @context.LedgerValue.ToString("N2")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="@Localizer["StockCheck_MovementsColumn"]" Style="text-align: right;">@context.EntryCount</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["StockCheck_NoRecords"]</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @string.Format(Localizer["StockCheck_CheckedAt"], _result.CheckedAtUtc.ToString("yyyy-MM-dd HH:mm:ss"))
        </MudText>
    }
</MudStack>

@code {
    private bool _running;
    private bool _onlyDifferences = true;
    private string? _error;
    private string _productCode = string.Empty;

    private StockCheckResult? _result;
    private List<Warehouse> _warehouses = [];

    private IEnumerable<StockCheckLine> Visible =>
        _result is null
            ? []
            : _result.Lines.Where(line =>
                !_onlyDifferences || line.Difference != 0 || line.ValueDifference != 0);

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadWarehousesAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(async () =>
    {
        _result = null;
        await LoadWarehousesAsync();
    });

    private async Task LoadWarehousesAsync()
    {
        if (!Company.HasCompany)
        {
            _warehouses = [];
            _error = Company.LoadError;
            StateHasChanged();
            return;
        }

        try
        {
            var (warehouses, error) = await StockApi.GetWarehousesAsync(Company.SelectedCompanyId);
            _warehouses = [.. warehouses];
            _error = error;
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["StockCheck_LoadWarehousesError"], ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task RunAsync()
    {
        _running = true;
        _error = null;

        try
        {
            var (result, error) = await StockApi.CheckAsync(
                Company.SelectedCompanyId,
                string.IsNullOrWhiteSpace(_productCode) ? null : _productCode.Trim());

            _result = result;
            _error = error;

            // With nothing wrong there is nothing to filter, so show everything that was checked.
            if (result is not null && result.ProductsWithDifference == 0)
                _onlyDifferences = false;
        }
        catch (Exception ex)
        {
            _error = string.Format(Localizer["StockCheck_RunError"], ex.Message);
        }
        finally
        {
            _running = false;
        }
    }

    private string WarehouseName(Guid warehouseId) =>
        _warehouses.FirstOrDefault(x => x.Id == warehouseId)?.Code ?? "—";

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
