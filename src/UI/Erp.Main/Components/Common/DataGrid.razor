@typeparam T
@* The columns are written by the page but rendered inside MudDataGrid<T>. MudBlazor infers the
   column type from the cascaded type parameter, which is matched by name, so the parameter has to
   be called T exactly as in MudDataGrid. *@
@attribute [CascadingTypeParameter(nameof(T))]
@implements IDisposable
@using MudBlazor
@using Erp.Main.Services
@using Microsoft.Extensions.Localization
@using Erp.Main.Resources
@inject CompanyState Company
@inject IStringLocalizer<MainResources> Localizer

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
}

<MudPaper Elevation="0" Class="erp-card">
    <MudDataGrid @ref="_grid" T="T" VirtualizeServerData="LoadServerDataAsync" Loading="_loading"
                 Class="erp-grid"
                 Filterable="true" Hideable="true" ShowColumnOptions="false"
                 ShowFilterIcons="true"
                 FilterMode="DataGridFilterMode.ColumnFilterMenu"
                 SortMode="SortMode.Multiple" Dense="true" Hover="true" Striped="true"
                 DragDropColumnReordering="true" ColumnsPanelReordering="true"
                 ColumnResizeMode="ResizeMode.Column" ShowMenuIcon="false"
                 FixedHeader="true" Height="@Height"
                 Virtualize="true" ItemSize="36" OverscanCount="12"
                 RowClick="OnRowClickedAsync"
                 RowClass="@(RowClick.HasDelegate ? "cursor-pointer" : null)">
        <ToolBarContent>
            @if (SearchFields.Count > 0)
            {
                <MudTextField Value="_search" ValueChanged="@((string value) => OnSearchChangedAsync(value))"
                              T="string" Placeholder="@(SearchPlaceholder ?? Localizer["Common_Search"])"
                              Variant="Variant.Text" Margin="Margin.Dense" Immediate="true" Clearable="true"
                              DebounceInterval="400"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Underline="false" Class="mt-0 erp-grid-search" />
            }
            @Filters
            <MudSpacer />
        </ToolBarContent>

        <Columns>
            @Columns
        </Columns>

        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Spacing="1" Class="pa-8">
                <MudIcon Icon="@EmptyIcon" Size="Size.Large" Class="mud-text-secondary" />
                <MudText Typo="Typo.subtitle1">@(EmptyTitle ?? Localizer["DataGrid_EmptyTitle"])</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@(EmptyDescription ?? Localizer["DataGrid_EmptyDescription"])</MudText>
            </MudStack>
        </NoRecordsContent>

        <PagerContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween"
                      Class="erp-grid-footer px-4 py-2">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@_totalItems @(ItemsLabel ?? Localizer["DataGrid_ItemsLabel"])</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                   Color="Color.Primary" title="@Localizer["DataGrid_RefreshAction"]" OnClick="ReloadAsync" />
                </MudStack>
            </MudStack>
        </PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
    /// <summary>The column definitions of the listing.</summary>
    [Parameter, EditorRequired]
    public RenderFragment Columns { get; set; } = default!;

    /// <summary>
    /// Fetches one window of rows. The component owns the OData translation, so the page only has
    /// to call its API client with the query it receives.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<Guid, ODataQuery, CancellationToken, Task<(IReadOnlyList<T> Items, int Count, string? Error)>> LoadAsync { get; set; } = default!;

    /// <summary>The members the toolbar search is matched against. Empty hides the search box.</summary>
    [Parameter]
    public IReadOnlyList<string> SearchFields { get; set; } = [];

    /// <summary>
    /// The member used to order when the user has not sorted. The order has to be stable, otherwise
    /// the same row could come back in two different windows as the user scrolls.
    /// </summary>
    [Parameter, EditorRequired]
    public string DefaultOrderBy { get; set; } = default!;

    [Parameter] public string? SearchPlaceholder { get; set; }

    /// <summary>Extra filter controls rendered in the toolbar next to the search box.</summary>
    [Parameter] public RenderFragment? Filters { get; set; }

    [Parameter] public string EmptyIcon { get; set; } = Icons.Material.Filled.Inbox;

    [Parameter] public string? EmptyTitle { get; set; }

    [Parameter] public string? EmptyDescription { get; set; }

    /// <summary>The noun shown next to the record count in the footer.</summary>
    [Parameter] public string? ItemsLabel { get; set; }

    /// <summary>The message shown when the load fails. The record noun is appended by the page.</summary>
    [Parameter] public string? LoadErrorMessage { get; set; }

    /// <summary>
    /// Whether the listing belongs to a company. Backoffice listings such as companies or the email
    /// queue are global, so they must not be blanked out while no company is selected and must not
    /// wait for the company state to load.
    /// </summary>
    [Parameter] public bool CompanyScoped { get; set; } = true;

    /// <summary>
    /// Raised when a row is clicked, with the row's item. Left unset, the grid behaves as a plain
    /// listing; a page that sets it (a picker dialog) gets a pointer cursor over the rows too.
    /// </summary>
    [Parameter] public EventCallback<T> RowClick { get; set; }

    /// <summary>
    /// The scrollable body's CSS height. The default fills a full page under its header chrome; a
    /// grid embedded in a dialog needs a shorter, dialog-relative height instead.
    /// </summary>
    [Parameter] public string Height { get; set; } = "var(--erp-grid-height)";

    private MudDataGrid<T>? _grid;
    private bool _loading = true;
    private string? _error;
    private string _search = string.Empty;
    private int _totalItems;

    protected override async Task OnInitializedAsync()
    {
        if (!CompanyScoped)
            return;

        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        _error = Company.LoadError;
    }

    /// <summary>Reloads the current window, for example after a record is created or deleted.</summary>
    public Task ReloadAsync() => _grid is null ? Task.CompletedTask : _grid.ReloadServerData();

    private async void OnCompanyChanged()
    {
        await InvokeAsync(async () =>
        {
            _error = Company.LoadError;
            await ReloadAsync();
        });
    }

    private async Task OnSearchChangedAsync(string value)
    {
        _search = value;
        await ReloadAsync();
    }

    private Task OnRowClickedAsync(DataGridRowClickEventArgs<T> args) =>
        RowClick.HasDelegate ? RowClick.InvokeAsync(args.Item) : Task.CompletedTask;

    /// <summary>
    /// Translates the grid state into an OData query and hands it to the page. The grid asks for the
    /// window it is about to paint, so the browser only ever holds the rows around the scroll
    /// position while filtering, sorting and paging stay in the database.
    /// </summary>
    private async Task<GridData<T>> LoadServerDataAsync(
        GridStateVirtualize<T> state, CancellationToken cancellationToken)
    {
        _error = CompanyScoped ? Company.LoadError : null;

        if (CompanyScoped && !Company.HasCompany)
        {
            _totalItems = 0;
            return new GridData<T> { Items = [], TotalItems = 0 };
        }

        _loading = true;

        try
        {
            var query = ODataGridState.Build(state, _search, SearchFields, DefaultOrderBy);

            var companyId = CompanyScoped ? Company.SelectedCompanyId : Guid.Empty;

            var (items, count, error) = await LoadAsync(companyId, query, cancellationToken);

            _error = error;
            _totalItems = count;

            return new GridData<T> { Items = items, TotalItems = count };
        }
        catch (OperationCanceledException)
        {
            // The grid cancels the window it no longer needs while the user scrolls. Letting it
            // bubble up is what tells the virtualizer to discard this result instead of painting
            // an empty window over the rows it already has.
            throw;
        }
        catch (Exception ex)
        {
            _error = $"{LoadErrorMessage ?? Localizer["DataGrid_LoadErrorMessage"]}: {ex.Message}";
            _totalItems = 0;
            return new GridData<T> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        if (CompanyScoped)
            Company.Changed -= OnCompanyChanged;
    }
}
