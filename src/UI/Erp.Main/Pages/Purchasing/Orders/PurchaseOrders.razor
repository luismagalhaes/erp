@page "/purchase-orders"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject PurchasingApiClient Purchasing
@inject CompanyState Company
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["PurchaseOrders_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@L["PurchaseOrders_HeaderTitle"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("purchase-orders/new"))">
                @L["PurchaseOrders_NewOrderButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="PurchaseOrderListItem"
              LoadAsync="@((companyId, query, ct) => Purchasing.QueryOrdersAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="OrderDate desc,Number desc"
              SearchPlaceholder="@L["PurchaseOrders_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.ShoppingCart"
              EmptyTitle="@L["PurchaseOrders_EmptyTitle"]"
              EmptyDescription="@L["PurchaseOrders_EmptyDescription"]"
              ItemsLabel="@L["PurchaseOrders_ItemsLabel"]"
              LoadErrorMessage="@L["PurchaseOrders_LoadErrorMessage"]">
        <Columns>
            <PropertyColumn Property="x => x.Number" Title="@L["PurchaseOrders_NumberColumn"]" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.OrderDate" Title="@L["PurchaseOrders_DateColumn"]" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.ExpectedDate" Title="@L["PurchaseOrders_ExpectedColumn"]">
                <CellTemplate>
                    <MudText Typo="Typo.body2" Color="@ExpectedColor(context.Item)">
                        @(context.Item.ExpectedDate?.ToString("yyyy-MM-dd") ?? "—")
                    </MudText>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.SupplierName" Title="@L["PurchaseOrders_SupplierColumn"]" />
            <PropertyColumn Property="x => x.SupplierTaxId" Title="@L["PurchaseOrders_TaxIdColumn"]" />
            <PropertyColumn Property="x => x.Status" Title="@L["PurchaseOrders_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@StatusColor(context.Item.Status)">
                        @PurchaseOrderStatuses.Describe(context.Item.Status)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.GrossTotal" Title="@L["PurchaseOrders_TotalColumn"]" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"purchase-orders/{context.Item.Id}"))">
                            @L["PurchaseOrders_OpenOrderAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["Number", "SupplierName", "SupplierTaxId"];

    private static Color StatusColor(string status) => status switch
    {
        "Received" => Color.Success,
        "PartiallyReceived" => Color.Info,
        "Cancelled" => Color.Error,
        "Closed" => Color.Secondary,
        _ => Color.Default
    };

    /// <summary>An order that is still owed and past its date is worth pointing out.</summary>
    private static Color ExpectedColor(PurchaseOrderListItem order) =>
        order.IsOpen && order.ExpectedDate is { } expected && expected < DateOnly.FromDateTime(DateTime.Today)
            ? Color.Warning
            : Color.Default;
}
