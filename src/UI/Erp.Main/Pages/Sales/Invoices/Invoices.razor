@page "/invoices"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject SalesApiClient SalesApi
@inject CompanyState Company
@inject NavigationManager Navigation
@inject IStringLocalizer<MainResources> L

<PageTitle>@L["Invoices_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@L["Invoices_HeaderTitle"]">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.LocalShipping"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("invoices/from-movements"))">
                @L["Invoices_FromMovementsButton"]
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("invoices/new"))">
                @L["Invoices_NewInvoiceButton"]
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="InvoiceListItem"
              LoadAsync="LoadAsync"
              SearchFields="SearchFields" DefaultOrderBy="DocumentDate desc,DocumentNumber desc"
              SearchPlaceholder="@L["Invoices_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.ReceiptLong"
              EmptyTitle="@L["Invoices_EmptyTitle"]"
              EmptyDescription="@L["Invoices_EmptyDescription"]"
              ItemsLabel="@L["Invoices_ItemsLabel"]"
              LoadErrorMessage="@L["Invoices_LoadErrorMessage"]">
        <Columns>
            <PropertyColumn Property="x => x.DocumentNumber" Title="@L["Invoices_DocumentColumn"]" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.DocumentDate" Title="@L["Invoices_DateColumn"]" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.DueDate" Title="@L["Invoices_DueDateColumn"]" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.CustomerName" Title="@L["Invoices_CustomerColumn"]" />
            <PropertyColumn Property="x => x.CustomerTaxId" Title="@L["Invoices_TaxIdColumn"]" />
            <PropertyColumn Property="x => x.NetTotal" Title="@L["Invoices_NetTotalColumn"]" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.TaxPayable" Title="@L["Invoices_TaxColumn"]" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.GrossTotal" Title="@L["Invoices_TotalColumn"]" Format="N2"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.Status" Title="@L["Invoices_StatusColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.Status == "A" ? Color.Error : Color.Success)">
                        @DescribeStatus(context.Item.Status)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"invoices/{context.Item.Id}"))">
                            @L["Invoices_ViewDocumentAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    /// <summary>
    /// Maps the toolbar search to the DTO members the API exposes, so a renamed column never
    /// produces an invalid $filter.
    /// </summary>
    private static readonly string[] SearchFields = ["DocumentNumber", "CustomerName", "CustomerTaxId"];

    /// <summary>
    /// Credit and debit notes live in the same table as the invoices they correct and have their own
    /// listing, so they are kept out of this one. The restriction goes into the query, so the count
    /// and the paging the grid receives are already the invoices'.
    /// </summary>
    private Task<(IReadOnlyList<InvoiceListItem> Items, int Count, string? Error)> LoadAsync(
        Guid companyId, ODataQuery query, CancellationToken cancellationToken)
    {
        query.Filter(string.Join(
            " or ",
            InvoiceTypes.Sale.Select(type => $"DocumentType eq {ODataQuery.Literal(type)}")));

        return SalesApi.QueryInvoicesAsync(companyId, query, cancellationToken);
    }

    private string DescribeStatus(string status) => status switch
    {
        "A" => L["Invoices_StatusCancelled"],
        "F" => L["Invoices_StatusInvoiced"],
        "S" => L["Invoices_StatusSelfBilled"],
        _ => L["Invoices_StatusNormal"]
    };
}
