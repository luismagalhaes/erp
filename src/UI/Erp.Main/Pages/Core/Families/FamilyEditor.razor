@page "/product-families/new"
@page "/product-families/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@using Erp.Main.Resources
@using Microsoft.Extensions.Localization
@inject CatalogApiClient Catalog
@inject CompanyState Company
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@(IsNew ? L["FamilyEditor_NewTitle"] : L["FamilyEditor_EditTitle"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">@(IsNew ? L["FamilyEditor_NewTitle"] : L["FamilyEditor_EditTitle"])</MudText>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo("product-families"))">
            @L["FamilyEditor_BackButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_code" Label="@L["FamilyEditor_CodeLabel"]" Variant="Variant.Outlined"
                                  Required="true" Disabled="@(!IsNew)"
                                  HelperText="@(IsNew ? null : (string?)L["FamilyEditor_CodeHelperText"])" />
                </MudItem>
                <MudItem xs="12" md="9">
                    <MudTextField @bind-Value="_name" Label="@L["FamilyEditor_NameLabel"]" Variant="Variant.Outlined" Required="true" />
                </MudItem>

                @if (!IsNew)
                {
                    <MudItem xs="12">
                        <MudSwitch @bind-Value="_isActive" Color="Color.Primary" Label="@L["FamilyEditor_ActiveLabel"]" />
                    </MudItem>
                }
            </MudGrid>

            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(_saving || !CanSave)"
                           OnClick="SaveAsync">
                    @L["FamilyEditor_SaveButton"]
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNew => Id is null;

    private bool _loading;
    private bool _saving;
    private string? _error;

    private bool _loaded;
    private Guid? _loadedId;

    private string _code = string.Empty;
    private string _name = string.Empty;
    private bool _isActive = true;

    private bool CanSave =>
        Company.HasCompany && !string.IsNullOrWhiteSpace(_code) && !string.IsNullOrWhiteSpace(_name);

    protected override async Task OnParametersSetAsync()
    {
        await Company.EnsureLoadedAsync();

        // A layout re-render sets the parameters again; only reload when the route changed.
        if (_loaded && _loadedId == Id)
            return;

        _loaded = true;
        _loadedId = Id;

        if (IsNew)
            return;

        _loading = true;

        try
        {
            var family = await Catalog.GetFamilyAsync(Id!.Value);

            if (family is null)
            {
                _error = L["FamilyEditor_NotFound"];
                return;
            }

            _code = family.Code;
            _name = family.Name;
            _isActive = family.IsActive;
        }
        catch (Exception ex)
        {
            _error = string.Format(L["FamilyEditor_LoadError"], ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var error = IsNew
                ? await Catalog.CreateFamilyAsync(new CreateProductFamilyRequest(
                    Company.SelectedCompanyId, _code.Trim(), _name.Trim()))
                : await Catalog.UpdateFamilyAsync(Id!.Value, new UpdateProductFamilyRequest(_name.Trim(), _isActive));

            if (error is not null)
            {
                _error = error;
                return;
            }

            Snackbar.Add(IsNew ? L["FamilyEditor_CreatedMessage"] : L["FamilyEditor_UpdatedMessage"], Severity.Success);
            Navigation.NavigateTo("product-families");
        }
        catch (Exception ex)
        {
            _error = string.Format(L["FamilyEditor_SaveError"], ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }
}
