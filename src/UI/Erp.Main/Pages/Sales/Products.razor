@page "/products"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Models
@using Erp.Main.Services
@inject SalesApiClient SalesApi
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Artigos</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Artigos</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Ficheiro de artigos usado nas linhas dos documentos e no SAF-T.
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(!Company.HasCompany)"
                   OnClick="@(() => Navigation.NavigateTo("products/new"))">
            Novo artigo
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-2">
        <MudTable Items="_products" Hover="true" Striped="true" Dense="true" Loading="_loading"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Código</MudTh>
                <MudTh>Descrição</MudTh>
                <MudTh>Tipo</MudTh>
                <MudTh>Unidade</MudTh>
                <MudTh Style="text-align: right;">Preço</MudTh>
                <MudTh>IVA</MudTh>
                <MudTh>Estado</MudTh>
                <MudTh Style="text-align: right;">Ações</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Código">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@context.ProductCode</MudText>
                </MudTd>
                <MudTd DataLabel="Descrição">@context.Description</MudTd>
                <MudTd DataLabel="Tipo">@DescribeType(context.ProductType)</MudTd>
                <MudTd DataLabel="Unidade">@context.UnitOfMeasure</MudTd>
                <MudTd DataLabel="Preço" Style="text-align: right;">@context.UnitPrice.ToString("N2")</MudTd>
                <MudTd DataLabel="IVA">@context.DefaultTaxCode (@context.DefaultTaxPercentage.ToString("N0")%)</MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? "Ativo" : "Inativo")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Ações" Style="text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   title="Editar artigo"
                                   OnClick="@(() => Navigation.NavigateTo($"products/{context.Id}"))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Ainda não há artigos criados.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

@code {
    private bool _loading = true;
    private string? _error;
    private List<ProductListItem> _products = [];

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        await Company.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = Company.LoadError;

        if (!Company.HasCompany)
        {
            _products = [];
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            _products = [.. await SalesApi.GetProductsAsync(Company.SelectedCompanyId)];
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível carregar os artigos: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private static string DescribeType(string productType) => productType switch
    {
        "S" => "Serviço",
        "O" => "Outro",
        "I" => "Impostos",
        _ => "Produto"
    };

    public void Dispose() => Company.Changed -= OnCompanyChanged;
}
