@page "/purchase-orders/new"
@page "/purchase-orders/{Id:guid}/edit"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Microsoft.Extensions.Localization
@using Erp.Main.Models
@using Erp.Main.Resources
@using Erp.Main.Services
@inject PurchasingApiClient Purchasing
@inject CatalogApiClient Catalog
@inject StockApiClient StockApi
@inject CompanyState Company
@inject WarehouseState WarehouseState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IStringLocalizer<MainResources> L

<PageTitle>@(IsNew ? L["PurchaseOrderEditor_PageTitleNew"] : L["PurchaseOrderEditor_PageTitleEdit"])</PageTitle>

<MudStack Spacing="4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">@(IsNew ? L["PurchaseOrderEditor_HeaderNew"] : (string)L["PurchaseOrderEditor_HeaderEdit", _number])</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["PurchaseOrderEditor_Description"]
            </MudText>
        </MudStack>

        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="GoBack">
            @L["PurchaseOrderEditor_BackButton"]
        </MudButton>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }

    @if (!Company.HasCompany)
    {
        <MudAlert Severity="Severity.Info">@L["PurchaseOrderEditor_NoCompanySelected"]</MudAlert>
    }
    else if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">@L["PurchaseOrderEditor_SupplierDeliverySectionTitle"]</MudText>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <PartnerAutocomplete SelectedPartner="_selectedSupplier" PartnerChanged="OnSupplierChanged"
                                         Kind="PartnerKind.Supplier" Label="@L["PurchaseOrderEditor_SupplierLabel"]" Required="true"
                                         Disabled="@(!IsNew)"
                                         HelperText="@(IsNew ? null : (string?)L["PurchaseOrderEditor_SupplierHelperText"])" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="Guid?" @bind-Value="_warehouseId" Label="@L["PurchaseOrderEditor_WarehouseLabel"]"
                               Variant="Variant.Outlined" Required="true">
                        @foreach (var warehouse in _warehouses)
                        {
                            <MudSelectItem T="Guid?" Value="@warehouse.Id">
                                @warehouse.Code — @warehouse.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudDatePicker @bind-Date="_orderDate" Label="@L["PurchaseOrderEditor_OrderDateLabel"]" Variant="Variant.Outlined"
                                   DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudDatePicker @bind-Date="_expectedDate" Label="@L["PurchaseOrderEditor_ExpectedDateLabel"]"
                                   Variant="Variant.Outlined" DateFormat="yyyy-MM-dd" Clearable="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_notes" Label="@L["PurchaseOrderEditor_NotesLabel"]" Variant="Variant.Outlined" Lines="2" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">@L["PurchaseOrderEditor_LinesSectionTitle"]</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">
                    @L["PurchaseOrderEditor_AddLineButton"]
                </MudButton>
            </MudStack>

            <MudTable Items="_lines" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Style="width: 220px;">@L["PurchaseOrderEditor_ProductColumn"]</MudTh>
                    <MudTh>@L["PurchaseOrderEditor_DescriptionColumn"]</MudTh>
                    <MudTh Style="width: 100px;">@L["PurchaseOrderEditor_QuantityColumn"]</MudTh>
                    <MudTh Style="width: 90px;">@L["PurchaseOrderEditor_UnitColumn"]</MudTh>
                    <MudTh Style="width: 130px;">@L["PurchaseOrderEditor_UnitCostColumn"]</MudTh>
                    <MudTh Style="width: 100px;">@L["PurchaseOrderEditor_DiscountColumn"]</MudTh>
                    <MudTh Style="width: 150px;">@L["PurchaseOrderEditor_TaxColumn"]</MudTh>
                    <MudTh Style="width: 110px; text-align: right;">@L["PurchaseOrderEditor_TotalColumn"]</MudTh>
                    <MudTh Style="width: 70px; text-align: right;">@L["PurchaseOrderEditor_ActionsColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["PurchaseOrderEditor_ProductColumn"]">
                        <ProductAutocomplete SelectedProduct="context.SelectedProduct"
                                              ProductChanged="@(product => OnProductChanged(context, product))" />
                    </MudTd>
                    <MudTd DataLabel="@L["PurchaseOrderEditor_DescriptionColumn"]">
                        <MudTextField @bind-Value="context.ProductDescription" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd DataLabel="@L["PurchaseOrderEditor_QuantityColumn"]">
                        <MudNumericField @bind-Value="context.Quantity" @bind-Value:after="StateHasChanged"
                                         Margin="Margin.Dense" Min="0" />
                    </MudTd>
                    <MudTd DataLabel="@L["PurchaseOrderEditor_UnitColumn"]">
                        <MudTextField @bind-Value="context.UnitOfMeasure" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd DataLabel="@L["PurchaseOrderEditor_UnitCostColumn"]">
                        <MudNumericField @bind-Value="context.UnitPrice" @bind-Value:after="StateHasChanged"
                                         Margin="Margin.Dense" Min="0" Format="N2" />
                    </MudTd>
                    <MudTd DataLabel="@L["PurchaseOrderEditor_DiscountColumn"]">
                        <MudNumericField @bind-Value="context.DiscountPercentage" @bind-Value:after="StateHasChanged"
                                         Margin="Margin.Dense" Min="0" Max="100" Format="N2" Adornment="Adornment.End" AdornmentText="%" />
                    </MudTd>
                    <MudTd DataLabel="@L["PurchaseOrderEditor_TaxColumn"]">
                        <MudSelect T="string" Value="context.TaxCode"
                                   ValueChanged="@(code => OnTaxCodeChanged(context, code))"
                                   Margin="Margin.Dense">
                            @foreach (var rate in _taxRates)
                            {
                                <MudSelectItem T="string" Value="@rate.Code">@rate.Label (@rate.Percentage.ToString("0.##")%)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd DataLabel="@L["PurchaseOrderEditor_TotalColumn"]" Style="text-align: right;">@LineTotal(context).ToString("N2")</MudTd>
                    <MudTd DataLabel="@L["PurchaseOrderEditor_ActionsColumn"]" Style="text-align: right;">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error" Disabled="@(_lines.Count == 1)"
                                       OnClick="@(() => RemoveLine(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudDivider Class="my-4" />

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="6">
                <MudStack Spacing="0" AlignItems="AlignItems.End">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["PurchaseOrderEditor_NetTotalLabel"]</MudText>
                    <MudText Typo="Typo.body1">@NetTotal.ToString("N2")</MudText>
                </MudStack>
                <MudStack Spacing="0" AlignItems="AlignItems.End">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["PurchaseOrderEditor_TaxTotalLabel"]</MudText>
                    <MudText Typo="Typo.body1">@TaxTotal.ToString("N2")</MudText>
                </MudStack>
                <MudStack Spacing="0" AlignItems="AlignItems.End">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["PurchaseOrderEditor_GrossTotalLabel"]</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">@GrossTotal.ToString("N2")</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="GoBack">@L["PurchaseOrderEditor_CancelButton"]</MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="@(_saving || !CanSave)"
                       OnClick="@(() => SaveAsync(place: false))">
                @(IsNew ? L["PurchaseOrderEditor_SaveDraftButton"] : L["PurchaseOrderEditor_SaveButton"])
            </MudButton>

            @if (IsNew)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Send"
                           Disabled="@(_saving || !CanSave)"
                           OnClick="@(() => SaveAsync(place: true))">
                    @L["PurchaseOrderEditor_SaveAndPlaceButton"]
                </MudButton>
            }
        </MudStack>
    }
</MudStack>

@code {
    private List<VatRate> _taxRates = [];

    [Parameter]
    public Guid? Id { get; set; }

    private bool IsNew => Id is null;

    private bool _loading;
    private bool _saving;
    private bool _loaded;
    private string? _error;
    private string _number = string.Empty;

    private Partner? _selectedSupplier;
    private Guid? _supplierId;
    private Guid? _warehouseId;
    private DateTime? _orderDate = DateTime.Today;
    private DateTime? _expectedDate;
    private string _notes = string.Empty;

    private readonly List<LineEditor> _lines = [new()];

    private List<Warehouse> _warehouses = [];

    private bool CanSave =>
        _supplierId is not null
        && _warehouseId is not null
        && _orderDate is not null
        && _lines.Any(line => line.Quantity > 0 && !string.IsNullOrWhiteSpace(line.ProductCode));

    private decimal NetTotal => _lines.Sum(LineTotal);

    private decimal TaxTotal => _lines.Sum(line => Round(LineTotal(line) * line.TaxPercentage / 100m));

    private decimal GrossTotal => NetTotal + TaxTotal;

    protected override async Task OnInitializedAsync()
    {
        Company.Changed += OnCompanyChanged;
        WarehouseState.Changed += OnWarehouseStateChanged;
        await Company.EnsureLoadedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded)
            return;

        _loaded = true;
        await LoadAsync();
    }

    private async void OnCompanyChanged() => await InvokeAsync(async () =>
    {
        // The catalogue belongs to the company, so switching it invalidates an order in progress.
        if (IsNew)
            await LoadAsync();
        else
            Navigation.NavigateTo("purchase-orders");
    });

    private async Task LoadAsync()
    {
        if (!Company.HasCompany)
        {
            _error = Company.LoadError;
            StateHasChanged();
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            await WarehouseState.EnsureLoadedAsync();
            _warehouses = [.. WarehouseState.Warehouses];

            // Mainland rates — this document has no fiscal-region selector of its own.
            var (rates, _) = await Catalog.GetVatRatesAsync();
            _taxRates = [.. rates.Where(x => x.FiscalRegion == "PT" && x.IsActive)];

            _error = WarehouseState.LoadError;

            if (IsNew)
                _warehouseId = WarehouseState.HasWarehouse ? WarehouseState.SelectedWarehouseId : null;

            if (!IsNew)
                await LoadOrderAsync();
        }
        catch (Exception ex)
        {
            _error = string.Format(L["PurchaseOrderEditor_LoadDataError"], ex.Message);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadOrderAsync()
    {
        var order = await Purchasing.GetOrderAsync(Id!.Value);

        if (order is null)
        {
            _error = L["PurchaseOrderEditor_OrderNotFound"];
            return;
        }

        if (!order.CanEditLines)
        {
            // Editing is refused by the API too; sending the user back is friendlier than letting
            // them fill a form that will be rejected.
            Navigation.NavigateTo($"purchase-orders/{order.Id}");
            return;
        }

        _number = order.Number;
        _supplierId = order.SupplierId;
        _selectedSupplier = await Catalog.GetSupplierAsync(order.SupplierId);
        _warehouseId = order.WarehouseId;
        _orderDate = order.OrderDate.ToDateTime(TimeOnly.MinValue);
        _expectedDate = order.ExpectedDate?.ToDateTime(TimeOnly.MinValue);
        _notes = order.Notes ?? string.Empty;

        _lines.Clear();

        foreach (var line in order.Lines)
        {
            _lines.Add(new LineEditor
            {
                // The catalogue is never preloaded, so a saved line's article is resolved by its own
                // code, one exact lookup at a time, only when there is an existing order to redraw.
                SelectedProduct = await FindProductByCodeAsync(line.ProductCode),
                ProductCode = line.ProductCode,
                ProductDescription = line.ProductDescription,
                Quantity = line.Quantity,
                UnitOfMeasure = line.UnitOfMeasure,
                UnitPrice = line.UnitPrice,
                TaxCode = line.TaxCode,
                TaxPercentage = line.TaxPercentage,
                DiscountPercentage = line.DiscountPercentage
            });
        }

        if (_lines.Count == 0)
            _lines.Add(new LineEditor());
    }

    private async Task<ProductListItem?> FindProductByCodeAsync(string productCode)
    {
        if (string.IsNullOrWhiteSpace(productCode))
            return null;

        var query = new ODataQuery { Top = 1, Count = false };
        query.Filter($"ProductCode eq {ODataQuery.Literal(productCode)}");

        var (items, _, _) = await Catalog.QueryProductsAsync(Company.SelectedCompanyId, query);
        return items.FirstOrDefault();
    }

    private void OnSupplierChanged(Partner? supplier)
    {
        _selectedSupplier = supplier;
        _supplierId = supplier?.Id;
    }

    private void AddLine() => _lines.Add(new LineEditor());

    private void RemoveLine(LineEditor line)
    {
        if (_lines.Count > 1)
            _lines.Remove(line);
    }

    /// <summary>
    /// Picking an article fills the line from the product file. The unit cost is what values the
    /// stock, so it is the sensible default for what we expect to pay.
    /// </summary>
    private void OnProductChanged(LineEditor line, ProductListItem? product)
    {
        line.SelectedProduct = product;

        if (product is null)
            return;

        line.ProductCode = product.ProductCode;
        line.ProductDescription = product.Description;
        line.UnitOfMeasure = product.UnitOfMeasure;
        line.UnitPrice = product.UnitCost;
        OnTaxCodeChanged(line, product.DefaultTaxCode);
    }

    private void OnTaxCodeChanged(LineEditor line, string taxCode)
    {
        line.TaxCode = taxCode;
        line.TaxPercentage = _taxRates.FirstOrDefault(rate => rate.Code == taxCode)?.Percentage ?? 0m;
    }

    private async Task SaveAsync(bool place)
    {
        _saving = true;
        _error = null;

        try
        {
            var lines = _lines
                .Where(line => line.Quantity > 0 && !string.IsNullOrWhiteSpace(line.ProductCode))
                .Select(line => new PurchaseOrderLineRequest(
                    line.ProductCode.Trim(),
                    string.IsNullOrWhiteSpace(line.ProductDescription)
                        ? line.ProductCode.Trim()
                        : line.ProductDescription.Trim(),
                    line.Quantity,
                    line.UnitPrice,
                    line.UnitOfMeasure,
                    "PT",
                    line.TaxCode,
                    line.TaxPercentage,
                    line.DiscountPercentage))
                .ToList();

            var orderDate = DateOnly.FromDateTime(_orderDate!.Value);
            var expectedDate = _expectedDate is { } expected ? DateOnly.FromDateTime(expected) : (DateOnly?)null;
            var notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim();

            var (order, error) = IsNew
                ? await Purchasing.CreateOrderAsync(new CreatePurchaseOrderRequest(
                    Company.SelectedCompanyId,
                    _supplierId!.Value,
                    orderDate,
                    _warehouseId!.Value,
                    lines,
                    expectedDate,
                    notes,
                    place))
                : await Purchasing.UpdateOrderAsync(Id!.Value, new UpdatePurchaseOrderRequest(
                    orderDate,
                    _warehouseId!.Value,
                    lines,
                    expectedDate,
                    notes));

            if (order is null)
            {
                _error = error ?? L["PurchaseOrderEditor_SaveFailed"];
                return;
            }

            Snackbar.Add(string.Format(L["PurchaseOrderEditor_SavedSuccess"], order.Number), Severity.Success);
            Navigation.NavigateTo($"purchase-orders/{order.Id}");
        }
        catch (Exception ex)
        {
            _error = string.Format(L["PurchaseOrderEditor_SaveError"], ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private void GoBack() =>
        Navigation.NavigateTo(IsNew ? "purchase-orders" : $"purchase-orders/{Id}");

    private static decimal LineTotal(LineEditor line) =>
        Round(Round(line.Quantity * line.UnitPrice) * (1 - line.DiscountPercentage / 100m));

    private static decimal Round(decimal value) => Math.Round(value, 2, MidpointRounding.AwayFromZero);


    private sealed class LineEditor
    {
        /// <summary>The article behind the autocomplete's box, kept whole so the box can show its
        /// code without a lookup back into a catalogue that is never held in full.</summary>
        public ProductListItem? SelectedProduct { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductDescription { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public string UnitOfMeasure { get; set; } = "UN";
        public decimal UnitPrice { get; set; }
        public string TaxCode { get; set; } = "NOR";
        public decimal TaxPercentage { get; set; } = 23m;
        public decimal DiscountPercentage { get; set; }
    }

    public void Dispose()
    {
        Company.Changed -= OnCompanyChanged;
        WarehouseState.Changed -= OnWarehouseStateChanged;
    }

    private void OnWarehouseStateChanged() => InvokeAsync(() =>
    {
        if (IsNew)
            _warehouseId = WarehouseState.HasWarehouse ? WarehouseState.SelectedWarehouseId : null;
        StateHasChanged();
    });
}
