@page "/stock-movements"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Erp.Main.Components.Common
@using Erp.Main.Models
@using Erp.Main.Services
@inject SalesApiClient SalesApi
@inject CompanyState Company
@inject NavigationManager Navigation

<PageTitle>Movimentação de mercadorias</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="Movimentação de mercadorias">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(!Company.HasCompany)"
                       OnClick="@(() => Navigation.NavigateTo("stock-movements/new"))">
                Nova guia
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="StockMovementListItem"
              LoadAsync="@((companyId, query, ct) => SalesApi.QueryStockMovementsAsync(companyId, query, ct))"
              SearchFields="SearchFields" DefaultOrderBy="MovementDate desc,DocumentNumber desc"
              SearchPlaceholder="Procurar por documento, destinatário ou NIF"
              EmptyIcon="@Icons.Material.Filled.LocalShipping"
              EmptyTitle="Sem guias para mostrar"
              EmptyDescription="Ajuste os filtros ou emita a primeira guia."
              ItemsLabel="guias"
              LoadErrorMessage="Não foi possível carregar as guias">
        <Columns>
            <PropertyColumn Property="x => x.DocumentNumber" Title="Documento" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.MovementType" Title="Tipo">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.Item.MovementType</MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Atcud" Title="ATCUD" CellClass="erp-mono" />
            <PropertyColumn Property="x => x.MovementDate" Title="Data" Format="yyyy-MM-dd" />
            <PropertyColumn Property="x => x.PartyName" Title="Destinatário" />
            <PropertyColumn Property="x => x.PartyTaxId" Title="NIF" />
            <PropertyColumn Property="x => x.MovementStartAtUtc" Title="Início do transporte" Format="yyyy-MM-dd HH:mm" />
            <PropertyColumn Property="x => x.TotalQuantity" Title="Quantidade" Format="N3"
                            CellClass="erp-numeric" HeaderClass="erp-numeric" />
            <PropertyColumn Property="x => x.AtDocCodeId" Title="Comunicação">
                <CellTemplate>
                    @if (string.IsNullOrWhiteSpace(context.Item.AtDocCodeId))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">
                            Por comunicar
                        </MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="erp-mono">@context.Item.AtDocCodeId</MudText>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Status" Title="Estado">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.Status == "A" ? Color.Error : Color.Success)">
                        @(context.Item.Status == "A" ? "Anulada" : "Normal")
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true"
                            CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => Navigation.NavigateTo($"stock-movements/{context.Item.Id}"))">
                            Ver guia
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly string[] SearchFields = ["DocumentNumber", "PartyName", "PartyTaxId"];
}
