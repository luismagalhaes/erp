@using MudBlazor
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Erp.Common
@using Erp.Main.Resources
@inject IStringLocalizer<MainResources> Localizer

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">@Localizer["NavMenu_Dashboard"]</MudNavLink>

    <MudNavGroup Title="@Localizer["NavMenu_PartnersGroup"]" Icon="@Icons.Material.Filled.People" Expanded="false">
        <MudNavLink Href="customers" Icon="@Icons.Material.Filled.PersonOutline">@Localizer["NavMenu_Customers"]</MudNavLink>
        <MudNavLink Href="suppliers" Icon="@Icons.Material.Filled.Business">@Localizer["NavMenu_Suppliers"]</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@Localizer["NavMenu_InvoicingGroup"]" Icon="@Icons.Material.Filled.Receipt" Expanded="false">
        <MudNavLink Href="invoices" Icon="@Icons.Material.Filled.ReceiptLong">@Localizer["NavMenu_Invoices"]</MudNavLink>
        <MudNavLink Href="credit-notes" Icon="@Icons.Material.Filled.CreditCard">@Localizer["NavMenu_CreditNotes"]</MudNavLink>
        <MudNavLink Href="payments" Icon="@Icons.Material.Filled.Payments">@Localizer["NavMenu_Payments"]</MudNavLink>
        <MudNavLink Href="customer-statements" Icon="@Icons.Material.Filled.AccountBalanceWallet">@Localizer["NavMenu_CustomerStatements"]</MudNavLink>
        @* GR, GT, GA, GC e GD: documentos fiscais emitidos pelo módulo de vendas, não movimentos de existências. *@
        <MudNavLink Href="stock-movements" Icon="@Icons.Material.Filled.LocalShipping">@Localizer["NavMenu_StockMovements"]</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@Localizer["NavMenu_ProductsGroup"]" Icon="@Icons.Material.Filled.Inventory" Expanded="false">
        <MudNavLink Href="products" Icon="@Icons.Material.Filled.Category">@Localizer["NavMenu_Products"]</MudNavLink>
        <MudNavLink Href="product-families" Icon="@Icons.Material.Filled.AccountTree">@Localizer["NavMenu_Families"]</MudNavLink>
        <MudNavLink Href="product-subfamilies" Icon="@Icons.Material.Filled.Segment">@Localizer["NavMenu_Subfamilies"]</MudNavLink>
        <MudNavLink Href="brands" Icon="@Icons.Material.Filled.Sell">@Localizer["NavMenu_Brands"]</MudNavLink>
        <MudNavLink Href="eco-fee-types" Icon="@Icons.Material.Filled.Recycling">@Localizer["NavMenu_EcoFeeTypes"]</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@Localizer["NavMenu_StockGroup"]" Icon="@Icons.Material.Filled.Warehouse" Expanded="false">
        @* Armazéns vivem na ficha da empresa, como os utilizadores: são a estrutura dela. *@
        <MudNavLink Href="stock" Icon="@Icons.Material.Filled.Inventory2">@Localizer["NavMenu_StockBalances"]</MudNavLink>
        <MudNavLink Href="inventory-counts" Icon="@Icons.Material.Filled.PlaylistAddCheck">@Localizer["NavMenu_InventoryCounts"]</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@Localizer["NavMenu_PurchasingGroup"]" Icon="@Icons.Material.Filled.ShoppingCart" Expanded="false">
        <MudNavLink Href="purchase-orders" Icon="@Icons.Material.Filled.ShoppingBag">@Localizer["NavMenu_PurchaseOrders"]</MudNavLink>
        <MudNavLink Href="goods-receipts" Icon="@Icons.Material.Filled.MoveToInbox">@Localizer["NavMenu_GoodsReceipts"]</MudNavLink>
        <MudNavLink Href="supplier-returns" Icon="@Icons.Material.Filled.Undo">@Localizer["NavMenu_SupplierReturns"]</MudNavLink>
        <MudNavLink Href="supplier-invoices" Icon="@Icons.Material.Filled.RequestPage">@Localizer["NavMenu_SupplierInvoices"]</MudNavLink>
        <MudNavLink Href="self-billed-invoices" Icon="@Icons.Material.Filled.Gavel">@Localizer["NavMenu_SelfBilledInvoices"]</MudNavLink>
        <MudNavLink Href="supplier-payments" Icon="@Icons.Material.Filled.Payments">@Localizer["NavMenu_SupplierPayments"]</MudNavLink>
        <MudNavLink Href="supplier-statements" Icon="@Icons.Material.Filled.AccountBalanceWallet">@Localizer["NavMenu_SupplierStatements"]</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@Localizer["NavMenu_ReportsGroup"]" Icon="@Icons.Material.Filled.Assessment" Expanded="false">
        <MudNavLink Href="saft" Icon="@Icons.Material.Filled.FileDownload">@Localizer["NavMenu_Saft"]</MudNavLink>
        <MudNavLink Href="inventory-file" Icon="@Icons.Material.Filled.Inventory">@Localizer["NavMenu_InventoryFile"]</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@Localizer["NavMenu_SettingsGroup"]" Icon="@Icons.Material.Filled.Settings" Expanded="false">
        <MudNavLink Href="series" Icon="@Icons.Material.Filled.FormatListNumbered">@Localizer["NavMenu_Series"]</MudNavLink>
    </MudNavGroup>

    @* VAT rates are set by law, the same for every tenant — editing them is a backoffice-only
       concern, not a per-company setting. *@
    <AuthorizeView Roles="@Constants.Roles.SuperAdmin">
        <MudNavGroup Title="@Localizer["NavMenu_BackofficeGroup"]" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
            <MudNavLink Href="companies" Icon="@Icons.Material.Filled.Domain">@Localizer["NavMenu_Companies"]</MudNavLink>
            <MudNavLink Href="vat-rates" Icon="@Icons.Material.Filled.TableView">@Localizer["NavMenu_VatRates"]</MudNavLink>
            <MudNavLink Href="notifications" Icon="@Icons.Material.Filled.Email">@Localizer["NavMenu_Notifications"]</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>
</MudNavMenu>
