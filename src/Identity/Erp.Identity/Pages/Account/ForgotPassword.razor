@page "/Account/ForgotPassword"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Web
@inject UserManager<ApplicationUser> UserManager
@inject IEmailService EmailService
@inject NavigationManager Navigation

<PageTitle>Forgot Password — ERP</PageTitle>

<div class="auth-wrapper">
    <div class="auth-card mud-elevation-3">
        <div class="auth-logo">ERP</div>
        <h2>Forgot password</h2>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="auth-error">@ErrorMessage</div>
        }

        <EditForm Model="Input" OnValidSubmit="HandleSubmitAsync" FormName="forgot-password-form">
            <DataAnnotationsValidator />
            <div class="auth-field">
                <label>Email</label>
                <InputText @bind-Value="Input.Email" type="email" autocomplete="username" />
            </div>
            <button type="submit" class="auth-button">Send reset link</button>
        </EditForm>

        <div class="auth-links mt-16">
            <a class="auth-link" href="/Account/SignIn">Back to Sign In</a>
        </div>
    </div>
</div>

@code {
    private InputModel Input { get; set; } = new();
    private string? ErrorMessage { get; set; }

    private async Task HandleSubmitAsync()
    {
        ErrorMessage = null;
        var email = (Input.Email ?? string.Empty).Trim();

        var user = await UserManager.FindByEmailAsync(email);
        if (user is not null)
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var encodedToken = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
            var resetLink = Navigation.GetUriWithQueryParameters(
                "/Account/ResetPassword",
                new Dictionary<string, object?> { ["email"] = email, ["token"] = encodedToken });

            var html = $"<p>Hello {user.FullName},</p><p>Click <a href=\"{resetLink}\">here</a> to reset your password.</p>";
            await EmailService.SendAsync(email, "Reset your ERP password", html);
        }

        Navigation.NavigateTo("/Account/ForgotPasswordConfirmation", forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required, EmailAddress]
        public string? Email { get; set; }
    }
}
