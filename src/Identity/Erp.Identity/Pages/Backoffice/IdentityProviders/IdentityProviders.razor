@page "/Backoffice/IdentityProviders"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using IdentityResourcesType = Erp.Identity.Resources.IdentityResources
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IIdentityProviderService IdentityProviderService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<IdentityResourcesType> Localizer

<PageTitle>@Localizer["Backoffice_IdentityProviders_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Backoffice_IdentityProviders_PageTitle"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Navigation.NavigateTo("/Backoffice/IdentityProviders/new"))">
                @Localizer["Backoffice_IdentityProviders_CreateAction"]
            </MudButton>
        </Actions>
    </PageHeader>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="0" Class="erp-card">
            <MudTable Items="@_items" Hover="true" Striped="true" Dense="true" Class="erp-grid" Elevation="0">
                <HeaderContent>
                    <MudTh>@Localizer["Backoffice_IdentityProviders_SchemeColumn"]</MudTh>
                    <MudTh>@Localizer["Backoffice_Common_DisplayNameColumn"]</MudTh>
                    <MudTh>@Localizer["Backoffice_IdentityProviders_TypeColumn"]</MudTh>
                    <MudTh>@Localizer["Backoffice_Common_EnabledColumn"]</MudTh>
                    <MudTh Class="erp-numeric">@Localizer["Backoffice_Common_ActionsColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Localizer["Backoffice_IdentityProviders_SchemeColumn"]">@context.Scheme</MudTd>
                    <MudTd DataLabel="@Localizer["Backoffice_Common_DisplayNameColumn"]">@context.DisplayName</MudTd>
                    <MudTd DataLabel="@Localizer["Backoffice_IdentityProviders_TypeColumn"]">@context.Type</MudTd>
                    <MudTd DataLabel="@Localizer["Backoffice_Common_EnabledColumn"]">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(context.Enabled ? Color.Success : Color.Default)">
                            @(context.Enabled ? Localizer["Backoffice_Common_Yes"] : Localizer["Backoffice_Common_No"])
                        </MudChip>
                    </MudTd>
                    <MudTd Class="erp-numeric">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       Href="@($"/Backoffice/IdentityProviders/{Uri.EscapeDataString(context.Scheme)}")"
                                       title="@Localizer["Backoffice_Common_EditAction"]" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context.Scheme))"
                                       title="@Localizer["Backoffice_Common_DeleteAction"]" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</MudStack>

@code {
    private List<IdentityProviderListItem> _items = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _items = (await IdentityProviderService.GetIdentityProvidersAsync()).ToList();
        _loading = false;
    }

    private async Task DeleteAsync(string scheme)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Localizer["Backoffice_IdentityProviders_DeleteHeading"].Value,
            string.Format(Localizer["Backoffice_Common_DeleteConfirm"], scheme),
            yesText: Localizer["Backoffice_Common_DeleteButton"].Value,
            cancelText: Localizer["Backoffice_Common_CancelButton"].Value);

        if (confirmed != true)
            return;

        await IdentityProviderService.DeleteIdentityProviderAsync(scheme);
        Snackbar.Add(Localizer["Backoffice_IdentityProviders_Deleted"].Value, Severity.Success);
        await LoadAsync();
    }
}
