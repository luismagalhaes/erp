@page "/Backoffice/Users"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using IdentityResourcesType = Erp.Identity.Resources.IdentityResources
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IUserService UserService
@inject NavigationManager Navigation
@inject IStringLocalizer<IdentityResourcesType> Localizer

<PageTitle>@Localizer["Backoffice_Users_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Backoffice_Users_PageTitle"]" />

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudPaper Elevation="0" Class="erp-card">
            <MudTable Items="@_users" Hover="true" Striped="true" Dense="true" Class="erp-grid" Elevation="0"
                      Filter="@FilterFunc">
                <ToolBarContent>
                    <MudTextField T="string" Placeholder="@Localizer["Backoffice_Common_SearchPlaceholder"]"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true" Class="erp-grid-search" ValueChanged="@((string s) => _search = s)" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>@Localizer["Backoffice_Users_EmailColumn"]</MudTh>
                    <MudTh>@Localizer["Backoffice_Users_NameColumn"]</MudTh>
                    <MudTh>@Localizer["Backoffice_Users_ActiveColumn"]</MudTh>
                    <MudTh>@Localizer["Backoffice_Users_CreatedAtColumn"]</MudTh>
                    <MudTh>@Localizer["Backoffice_Users_RolesLabel"]</MudTh>
                    <MudTh Class="erp-numeric">@Localizer["Backoffice_Users_ActionsColumn"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Localizer["Backoffice_Users_EmailColumn"]">@context.Email</MudTd>
                    <MudTd DataLabel="@Localizer["Backoffice_Users_NameColumn"]">@context.FullName</MudTd>
                    <MudTd DataLabel="@Localizer["Backoffice_Users_ActiveColumn"]">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(context.IsActive ? Color.Success : Color.Default)">
                            @(context.IsActive ? Localizer["Backoffice_Users_Yes"] : Localizer["Backoffice_Users_No"])
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="@Localizer["Backoffice_Users_CreatedAtColumn"]">@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd DataLabel="@Localizer["Backoffice_Users_RolesLabel"]">
                        @if (context.Roles.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                        }
                        else
                        {
                            @foreach (var role in context.Roles)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">@role</MudChip>
                            }
                        }
                    </MudTd>
                    <MudTd Class="erp-numeric">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       Href="@($"/Backoffice/Users/{Uri.EscapeDataString(context.Id)}")"
                                       title="@Localizer["Backoffice_Users_EditAction"]" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</MudStack>

@code {
    private List<UserListItem> _users = [];
    private bool _loading = true;
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _users = (await UserService.GetUsersAsync()).ToList();
        _loading = false;
    }

    private bool FilterFunc(UserListItem user) =>
        string.IsNullOrWhiteSpace(_search)
        || user.Email.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || user.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase);
}
