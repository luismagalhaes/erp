@page "/Backoffice/ApiResources"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using IdentityResourcesType = Erp.Identity.Resources.IdentityResources
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IApiResourceService ApiResourceService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<IdentityResourcesType> Localizer

<PageTitle>@Localizer["Backoffice_ApiResources_PageTitle"]</PageTitle>

<MudStack Spacing="4">
    <PageHeader Title="@Localizer["Backoffice_ApiResources_PageTitle"]">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => Navigation.NavigateTo("/Backoffice/ApiResources/new"))">
                @Localizer["Backoffice_ApiResources_CreateAction"]
            </MudButton>
        </Actions>
    </PageHeader>

    <DataGrid T="ApiResourceListItem" Items="@_items" Loading="@_loading"
              SearchFields="@_searchFields"
              SearchPlaceholder="@Localizer["Backoffice_Common_SearchPlaceholder"]"
              EmptyIcon="@Icons.Material.Filled.Api"
              EmptyTitle="@Localizer["Backoffice_Common_NoRecords"]"
              ItemsLabel="@Localizer["Backoffice_ApiResources_ItemsLabel"]"
              OnRefresh="LoadAsync">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="@Localizer["Backoffice_Common_NameColumn"]" />
            <PropertyColumn Property="x => x.DisplayName" Title="@Localizer["Backoffice_Common_DisplayNameColumn"]" />
            <PropertyColumn Property="x => x.Enabled" Title="@Localizer["Backoffice_Common_EnabledColumn"]">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Item.Enabled ? Color.Success : Color.Default)">
                        @(context.Item.Enabled ? Localizer["Backoffice_Common_Yes"] : Localizer["Backoffice_Common_No"])
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Scopes" Title="@Localizer["Backoffice_ApiResources_ScopesColumn"]" Sortable="false" Filterable="false">
                <CellTemplate>@string.Join(", ", context.Item.Scopes)</CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="" Sortable="false" Filterable="false" Hideable="false"
                            StickyRight="true" CellClass="erp-numeric" HeaderClass="erp-numeric">
                <CellTemplate>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                     OnClick="@(() => Navigation.NavigateTo($"/Backoffice/ApiResources/{Uri.EscapeDataString(context.Item.Name)}"))">
                            @Localizer["Backoffice_Common_EditAction"]
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                     OnClick="@(() => DeleteAsync(context.Item.Name))">
                            @Localizer["Backoffice_Common_DeleteAction"]
                        </MudMenuItem>
                    </MudMenu>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </DataGrid>
</MudStack>

@code {
    private static readonly Func<ApiResourceListItem, string?>[] _searchFields = [x => x.Name, x => x.DisplayName];

    private List<ApiResourceListItem> _items = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _items = (await ApiResourceService.GetApiResourcesAsync()).ToList();
        _loading = false;
    }

    private async Task DeleteAsync(string name)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Localizer["Backoffice_ApiResources_DeleteHeading"].Value,
            string.Format(Localizer["Backoffice_Common_DeleteConfirm"], name),
            yesText: Localizer["Backoffice_Common_DeleteButton"].Value,
            cancelText: Localizer["Backoffice_Common_CancelButton"].Value);

        if (confirmed != true)
            return;

        await ApiResourceService.DeleteApiResourceAsync(name);
        Snackbar.Add(Localizer["Backoffice_ApiResources_Deleted"].Value, Severity.Success);
        await LoadAsync();
    }
}
